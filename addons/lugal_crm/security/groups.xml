<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================
             Lugal CRM Security Groups (Odoo 19 compatible)
             Hierarchy: Agent < Supervisor < Manager < General Manager
                        QA < QA Supervisor (separate track)
        ============================================================ -->

        <record id="group_lugal_crm_agent" model="res.groups">
            <field name="name">CRM Agent / موظف CRM</field>
            <field name="sequence">10</field>
            <field name="comment">Can reply to messages, handle calls, create tickets and tasks.</field>
        </record>

        <record id="group_lugal_crm_supervisor" model="res.groups">
            <field name="name">CRM Supervisor / مشرف CRM</field>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_lugal_crm_agent'))]"/>
            <field name="comment">All Agent permissions + view all agents data, assign tasks, manage follow-ups.</field>
        </record>

        <record id="group_lugal_crm_manager" model="res.groups">
            <field name="name">CRM Manager / مدير CRM</field>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('group_lugal_crm_supervisor'))]"/>
            <field name="comment">All Supervisor permissions + manage settings, branches, supply chain, full analytics.</field>
        </record>

        <!-- QA Track — defined before General Manager so ref() resolves correctly -->
        <record id="group_lugal_crm_qa" model="res.groups">
            <field name="name">CRM QA Auditor / مدقق CRM</field>
            <field name="sequence">50</field>
            <field name="comment">Can listen to recordings, review messages, score and write QA notes.</field>
        </record>

        <record id="group_lugal_crm_qa_supervisor" model="res.groups">
            <field name="name">CRM QA Supervisor / مشرف المدققين CRM</field>
            <field name="sequence">60</field>
            <field name="implied_ids" eval="[(4, ref('group_lugal_crm_qa'))]"/>
            <field name="comment">All QA permissions + view all QA reviewers productivity and manage QA assignments.</field>
        </record>

        <record id="group_lugal_crm_general_manager" model="res.groups">
            <field name="name">CRM General Manager / المدير العام CRM</field>
            <field name="sequence">40</field>
            <field name="implied_ids" eval="[(4, ref('group_lugal_crm_manager')), (4, ref('group_lugal_crm_qa_supervisor'))]"/>
            <field name="comment">Full system access: delete records, reset sequences, export data, manage audit logs.</field>
        </record>

    </data>
    <!-- TODO: remove - cherry-pick marker -->
</odoo>

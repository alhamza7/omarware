<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron: Auto-notify customers when requested items come in stock -->
        <record id="cron_notify_requested_items" model="ir.cron">
            <field name="name">Lugal CRM: Auto-notify Requested Items</field>
            <field name="model_id" ref="model_lugal_crm_requested_item"/>
            <field name="state">code</field>
            <field name="code">model._cron_notify_requested_items()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <!-- Cron: Flag SLA-breached messages every 5 minutes -->
        <record id="cron_flag_sla_breaches" model="ir.cron">
            <field name="name">Lugal CRM: Flag SLA-breached Messages</field>
            <field name="model_id" ref="model_lugal_crm_omnichannel_message"/>
            <field name="state">code</field>
            <field name="code">model._cron_flag_sla_breaches()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Cron: Compute and store daily KPI snapshots for all employees -->
        <record id="cron_daily_kpi_snapshot" model="ir.cron">
            <field name="name">Lugal CRM: Daily Employee KPI Snapshot</field>
            <field name="model_id" ref="model_lugal_crm_employee_kpi"/>
            <field name="state">code</field>
            <field name="code">model._cron_daily_kpi_snapshot()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Cron: Mark stale user presence (online→afk→offline) and broadcast via bus every 2 min -->
        <record id="cron_mark_stale_presence" model="ir.cron">
            <field name="name">Lugal CRM: Mark Stale User Presence</field>
            <field name="model_id" ref="model_lugal_crm_user_presence"/>
            <field name="state">code</field>
            <field name="code">model._cron_mark_stale_presence()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Cron: Fire scheduled marquee activation/expiry bus events every minute -->
        <record id="cron_marquee_scheduled_events" model="ir.cron">
            <field name="name">Lugal CRM: Marquee Scheduled Events</field>
            <field name="model_id" ref="model_lugal_crm_marquee"/>
            <field name="state">code</field>
            <field name="code">model._cron_fire_scheduled_events()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>

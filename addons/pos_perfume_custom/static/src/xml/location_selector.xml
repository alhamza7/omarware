<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    
    <!-- Location Selector Template -->
    <t t-name="pos_perfume_custom.LocationSelector">
        <div class="location-selector-container">
            <!-- Warehouse Selection -->
            <div class="warehouse-section mb-3">
                <label class="form-label fw-bold">
                    <i class="fa fa-warehouse me-2"/>
                    المستودع
                </label>
                <select class="form-select" 
                        t-model="state.selectedWarehouse"
                        t-on-change="(ev) => this.selectWarehouse(state.warehouses.find(w => w.id === parseInt(ev.target.value)))">
                    <option value="">-- اختر مستودع --</option>
                    <t t-foreach="state.warehouses" t-as="warehouse" t-key="warehouse.id">
                        <option t-att-value="warehouse.id" 
                                t-att-selected="state.selectedWarehouse?.id === warehouse.id">
                            <t t-esc="warehouse.name"/> 
                            (<t t-esc="warehouse.code"/>)
                        </option>
                    </t>
                </select>
            </div>
            
            <!-- Location Selection (Optional) -->
            <div class="location-section mb-3" t-if="state.locations.length > 0">
                <label class="form-label fw-bold">
                    <i class="fa fa-map-marker-alt me-2"/>
                    الموقع
                </label>
                <select class="form-select" 
                        t-model="state.selectedLocation"
                        t-on-change="(ev) => this.selectLocation(state.locations.find(l => l.id === parseInt(ev.target.value)))">
                    <t t-foreach="state.locations" t-as="location" t-key="location.id">
                        <option t-att-value="location.id"
                                t-att-selected="state.selectedLocation?.id === location.id">
                            <t t-esc="location.complete_name"/>
                        </option>
                    </t>
                </select>
            </div>
            
            <!-- Stock Information -->
            <div class="stock-info-section" t-if="state.stockInfo">
                <div class="card">
                    <div class="card-header bg-light">
                        <i class="fa fa-boxes me-2"/>
                        <strong>معلومات المخزون</strong>
                        <span class="badge bg-secondary float-end">
                            <t t-esc="state.stockInfo.source || 'SAP'"/>
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-4">
                                <div class="stock-metric">
                                    <div class="stock-label text-muted small">متوفر</div>
                                    <div class="stock-value fw-bold" 
                                         t-att-class="getStockStatusClass()">
                                        <t t-esc="formatQty(state.stockInfo.on_hand)"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stock-metric">
                                    <div class="stock-label text-muted small">محجوز</div>
                                    <div class="stock-value text-warning fw-bold">
                                        <t t-esc="formatQty(state.stockInfo.committed)"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stock-metric">
                                    <div class="stock-label text-muted small">متاح</div>
                                    <div class="stock-value text-success fw-bold">
                                        <t t-esc="formatQty(state.stockInfo.available)"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Stock Status Alert -->
                        <t t-if="state.stockInfo.available &lt;= 0">
                            <div class="alert alert-danger mt-2 mb-0 small" role="alert">
                                <i class="fa fa-exclamation-triangle me-1"/>
                                المنتج غير متوفر في المخزون
                            </div>
                        </t>
                        <t t-elif="state.stockInfo.available &lt; 10">
                            <div class="alert alert-warning mt-2 mb-0 small" role="alert">
                                <i class="fa fa-exclamation-circle me-1"/>
                                كمية محدودة متاحة
                            </div>
                        </t>
                    </div>
                </div>
            </div>
            
            <!-- Loading Indicator -->
            <div t-if="state.loading" class="text-center my-3">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </t>
    
</templates>


<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    
    <!-- Customer Search Template - Compact -->
    <t t-name="pos_perfume_custom.CustomerSearch">
        <div class="customer-search-container" style="position: relative; width: 100%;">
            <!-- Search Input - Compact Single Line -->
            <div style="position: relative;">
                <div style="display: flex; align-items: center; gap: 5px;">
                    <input 
                        t-ref="searchInput"
                        type="text"
                        class="form-control customer-search-input"
                        placeholder="🔍 Search customer..."
                        t-model="state.searchTerm"
                        t-on-input="onSearchInput"
                        t-on-focus="onFocus"
                        t-on-blur="onBlur"
                        t-on-keydown="onKeydown"
                        style="flex: 1; padding: 7px 35px 7px 10px; font-size: 12px; border: 1px solid #ccc; border-radius: 4px;"
                    />
                    <t t-if="state.selectedCustomer">
                        <button class="btn btn-sm" 
                                t-on-click.stop="clearSelection"
                                style="padding: 5px 8px; background: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer; flex-shrink: 0;"
                                title="Clear selection">
                            ✕
                        </button>
                    </t>
                </div>
            </div>
            
            <!-- Loading Indicator -->
            <div t-if="state.loading" class="text-center my-2">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
            
            <!-- Customer Dropdown -->
            <div class="customer-dropdown" t-if="state.showDropdown and state.customers.length > 0">
                <div class="dropdown-header bg-light p-2">
                    <strong>
                        <t t-if="state.searchTerm">نتائج البحث</t>
                        <t t-else="">العملاء الأخيرون</t>
                    </strong>
                </div>
                <div class="customers-list">
                    <t t-foreach="state.customers" t-as="customer" t-key="customer.id">
                        <div class="customer-item" t-on-click="() => this.selectCustomer(customer)">
                            <div class="customer-info">
                                <div class="customer-name fw-bold">
                                    <i class="fa fa-user-circle text-info me-2"/>
                                    <t t-esc="customer.name"/>
                                </div>
                                <div class="customer-details text-muted small">
                                    <t t-esc="getCustomerInfo(customer)"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
            
            <!-- Empty State -->
            <div class="empty-state text-center py-3" 
                 t-if="state.searchTerm and state.customers.length === 0 and !state.loading">
                <i class="fa fa-user-times fa-2x text-muted mb-2"/>
                <p class="text-muted small mb-0">لا توجد نتائج</p>
            </div>
        </div>
    </t>
    
</templates>


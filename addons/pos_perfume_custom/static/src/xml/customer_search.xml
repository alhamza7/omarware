<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    
    <!-- Customer Search Template - Similar to Product Search -->
    <t t-name="pos_perfume_custom.CustomerSearch">
        <div class="customer-search-container" style="position: relative; width: 100%;">
            <!-- Search Input with Arrow Button -->
            <div style="position: relative;">
                <input 
                    t-ref="searchInput"
                    type="text"
                    class="form-control customer-search-input"
                    placeholder="Search customer..."
                    t-model="state.searchTerm"
                    t-on-input="onSearchInput"
                    t-on-focus="onFocus"
                    t-on-blur="onBlur"
                    t-on-keydown="onKeydown"
                    t-att-style="state.selectedCustomer ? 'width: 100%; height: 36px; padding: 7px 32px 7px 12px; font-size: 14px; border: 1px solid #d1d5db; border-radius: 6px; background-color: white;' : 'width: 100%; height: 36px; padding: 7px 12px; font-size: 14px; border: 1px solid #d1d5db; border-radius: 6px; background-color: white;'"
                />
                <button t-if="state.selectedCustomer"
                        t-on-click.stop="openCustomerPopup"
                        title="View customer details"
                        style="position: absolute; right: 4px; top: 50%; transform: translateY(-50%); padding: 2px 4px; background: transparent; color: #2563eb; border: none; cursor: pointer; font-size: 12px; flex-shrink: 0; min-width: 20px; height: 22px; display: flex; align-items: center; justify-content: center; z-index: 10;"
                        onmouseover="this.style.color='#1d4ed8'"
                        onmouseout="this.style.color='#2563eb'">
                    ➡️
                </button>
            </div>
            
            <!-- Customer Dropdown - Similar to Product Dropdown -->
            <div t-if="state.showDropdown" 
                 class="customer-dropdown"
                 style="position: absolute; z-index: 1000; background: white; border: 1px solid #ccc; max-height: 300px; overflow-y: auto; width: 400px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); top: 100%; left: 0; margin-top: 2px;">
                <t t-if="state.loading" style="padding: 12px; text-align: center; color: #999;">
                    <i class="fa fa-spinner fa-spin"/> Searching...
                </t>
                <t t-elif="state.customers.length > 0">
                    <t t-foreach="state.customers" t-as="customer" t-key="customer.id">
                        <div t-on-click="() => this.selectCustomer(customer)"
                             t-att-class="this.isCustomerSelected(customer) ? 'customer-item selected' : 'customer-item'"
                             style="padding: 8px 12px; cursor: pointer; border-bottom: 1px solid #f0f0f0;"
                             onmouseover="this.style.background='#f5f5f5'"
                             onmouseout="this.style.background=''"
                             t-att-style="this.isCustomerSelected(customer) ? 'padding: 8px 12px; cursor: pointer; border-bottom: 1px solid #f0f0f0; background: #e3f2fd;' : 'padding: 8px 12px; cursor: pointer; border-bottom: 1px solid #f0f0f0;'">
                            <div style="font-weight: 600; color: #333;">
                                <t t-esc="customer.name"/>
                            </div>
                            <div style="font-size: 11px; color: #666;">
                                <t t-esc="getCustomerInfo(customer)"/>
                            </div>
                        </div>
                    </t>
                </t>
                <t t-elif="state.searchTerm and !state.loading">
                    <div style="padding: 12px; text-align: center; color: #999;">
                        No customers found
                    </div>
                </t>
            </div>
        </div>
    </t>
    
</templates>


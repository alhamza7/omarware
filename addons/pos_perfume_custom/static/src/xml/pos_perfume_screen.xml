<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- ============================================================ -->
    <!--           MAIN POS PERFUME SCREEN - EXACT MOCKUP             -->
    <!-- ============================================================ -->

    <t t-name="pos_perfume_custom.PosPerfumeScreen">
        <div class="pos-perfume-container">
            
            <!-- Header -->
            <div class="pos-header">
                <h1>🛒 NBS POS</h1>
                <div class="header-info">
                    <span class="user-info">
                        👤 User: <t t-esc="state.userName"/>
                    </span>
                    <span class="date-info">
                        📅 Date: <t t-esc="state.currentDate"/>
                    </span>
                    <span class="time-info">
                        🕐 Time: <t t-esc="state.currentTime"/>
                    </span>
                </div>
            </div>

            <!-- Main Container (50/50 Split) -->
            <div class="pos-main-container">
                
                <!-- ============= LEFT SECTION: ORDER LINES ============= -->
                <div class="order-section">
                    
                    <!-- Order Header -->
                    <div class="order-header">
                        <div style="display: flex; align-items: center; gap: 10px; flex: 1;">
                            <label style="font-weight: 600; min-width: 80px;">Customer:</label>
                            <div style="position: relative; flex: 1; max-width: 350px;">
                                <input type="text" 
                                       class="form-control customer-search"
                                       placeholder="Search customer..."
                                       t-att-value="state.currentOrder.partner ? state.currentOrder.partner.name : state.customerSearch"
                                       t-on-input.stop="(ev) => this.onCustomerSearch(ev)"
                                       t-on-focus.stop="(ev) => this.showCustomerList()"
                                       t-on-blur.stop="(ev) => this.hideCustomerList()"/>
                                
                                <!-- Customer Dropdown -->
                                <div class="customer-dropdown" 
                                     t-if="state.showCustomerDropdown and state.filteredCustomers.length">
                                    <t t-foreach="state.filteredCustomers" t-as="customer" t-key="customer.id">
                                        <div class="customer-option" 
                                             t-on-mousedown.stop="(ev) => this.selectCustomer(customer)">
                                            <div><strong t-esc="customer.name"/></div>
                                            <t t-if="customer.phone or customer.mobile">
                                                <small style="color: #666;">
                                                    📞 <t t-esc="customer.phone || customer.mobile"/>
                                                </small>
                                            </t>
                                        </div>
                                    </t>
                                </div>
                            </div>
                            
                            <!-- Add Customer Button -->
                            <button class="btn-add-customer" 
                                    t-on-click.stop="(ev) => this.openCustomerDialog()"
                                    title="Add new customer">
                                ➕ New Customer
                            </button>
                        </div>
                        
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <label style="font-weight: 600;">Order #:</label>
                            <input type="text" 
                                   class="form-control"
                                   t-att-value="state.currentOrder.orderNumber" 
                                   readonly="readonly" 
                                   style="width: 150px; background: #f5f5f5; text-align: center;"/>
                        </div>
                    </div>

                    <!-- Order Table -->
                    <div class="order-table-container">
                        <table class="order-table">
                            <thead>
                                <tr>
                                    <th style="width: 40px">#</th>
                                    <th style="width: 200px">Product</th>
                                    <th style="width: 100px">Warehouse</th>
                                    <th style="width: 80px">Quantity</th>
                                    <th style="width: 100px">Unit Price</th>
                                    <th style="width: 90px">Discount %</th>
                                    <th style="width: 100px">After Disc</th>
                                    <th style="width: 110px">Total</th>
                                    <th style="width: 50px">❌</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.currentOrder.lines" t-as="line" t-key="line.id">
                                    <tr>
                                        <!-- Row Number -->
                                        <td class="row-number">
                                            <t t-esc="line.rowNumber"/>
                                        </td>
                                        
                                        <!-- Product Name -->
                                        <td>
                                            <input type="text" 
                                                   t-att-value="line.productName"
                                                   t-att-placeholder="line.product ? '' : 'Select product...'"
                                                   readonly="readonly"
                                                   t-att-style="line.product ? 'color: #000;' : 'color: #999;'"
                                                   t-on-keydown="(ev) => this.handleCellKeyDown(ev, line_index, 1)"
                                                   class="order-cell-input"/>
                                        </td>
                                        
                                        <!-- Warehouse -->
                                        <td>
                                            <select class="order-cell-select"
                                                    t-att-value="line.warehouse"
                                                    t-on-change="(ev) => this.updateLine(line_index, 'warehouse', ev.target.value)"
                                                    t-on-keydown="(ev) => this.handleCellKeyDown(ev, line_index, 2)">
                                                <option value="WH1">WH1</option>
                                                <option value="WH2">WH2</option>
                                                <option value="WH3">WH3</option>
                                            </select>
                                        </td>
                                        
                                        <!-- Quantity -->
                                        <td>
                                            <input type="number" 
                                                   t-att-value="line.quantity"
                                                   t-on-input="(ev) => this.updateLine(line_index, 'quantity', parseFloat(ev.target.value) || 1)"
                                                   t-on-keydown="(ev) => this.handleCellKeyDown(ev, line_index, 3)"
                                                   t-on-focus="(ev) => ev.target.select()"
                                                   min="1" 
                                                   step="1"
                                                   class="order-cell-input"/>
                                        </td>
                                        
                                        <!-- Unit Price -->
                                        <td>
                                            <input type="number" 
                                                   t-att-value="line.unitPrice.toFixed(2)"
                                                   t-on-input="(ev) => this.updateLine(line_index, 'unitPrice', parseFloat(ev.target.value) || 0)"
                                                   t-on-keydown="(ev) => this.handleCellKeyDown(ev, line_index, 4)"
                                                   t-on-focus="(ev) => ev.target.select()"
                                                   step="0.01"
                                                   min="0"
                                                   class="order-cell-input"/>
                                        </td>
                                        
                                        <!-- Discount % -->
                                        <td>
                                            <input type="number" 
                                                   t-att-value="line.discountPercent"
                                                   t-on-input="(ev) => this.updateLine(line_index, 'discountPercent', parseFloat(ev.target.value) || 0)"
                                                   t-on-keydown="(ev) => this.handleCellKeyDown(ev, line_index, 5)"
                                                   t-on-focus="(ev) => ev.target.select()"
                                                   min="0" 
                                                   max="100"
                                                   step="0.1"
                                                   class="order-cell-input"/>
                                        </td>
                                        
                                        <!-- After Discount (readonly) -->
                                        <td>
                                            <input type="number" 
                                                   t-att-value="line.priceAfterDiscount.toFixed(2)"
                                                   readonly="readonly"
                                                   t-on-keydown="(ev) => this.handleCellKeyDown(ev, line_index, 6)"
                                                   class="order-cell-input readonly-cell discount-cell"/>
                                        </td>
                                        
                                        <!-- Total (readonly) -->
                                        <td>
                                            <input type="number" 
                                                   t-att-value="line.total.toFixed(2)"
                                                   readonly="readonly"
                                                   t-on-keydown="(ev) => this.handleCellKeyDown(ev, line_index, 7)"
                                                   class="order-cell-input readonly-cell total-cell"/>
                                        </td>
                                        
                                        <!-- Delete Button -->
                                        <td class="delete-cell" t-on-click="() => this.deleteLine(line_index)">
                                            🗑️
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <!-- Totals Section -->
                    <div class="totals-section">
                        <div class="total-row">
                            <span>Subtotal:</span>
                            <span><strong>$<t t-esc="state.currentOrder.totals.subtotal.toFixed(2)"/></strong></span>
                        </div>
                        <div class="total-row">
                            <span>Total Discount:</span>
                            <span style="color: #f44336;">
                                <strong>-$<t t-esc="state.currentOrder.totals.discount.toFixed(2)"/></strong>
                            </span>
                        </div>
                        <div class="total-row">
                            <span>Tax (0%):</span>
                            <span><strong>$<t t-esc="state.currentOrder.totals.tax.toFixed(2)"/></strong></span>
                        </div>
                        <div class="total-row grand-total">
                            <span>Grand Total:</span>
                            <span>$<t t-esc="state.currentOrder.totals.total_usd.toFixed(2)"/></span>
                        </div>
                        <div class="total-row" style="color: #714B67; border-top: 1px dashed #ccc; padding-top: 10px; margin-top: 5px;">
                            <span>Total in Iraqi Dinar:</span>
                            <span style="font-size: 16px;">
                                <strong><t t-esc="Math.floor(state.currentOrder.totals.total_iqd).toLocaleString('en-US')"/> IQD</strong>
                            </span>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="action-buttons">
                        <button class="action-btn btn-quotation" t-on-click="() => this.createQuotation()">
                            📋 Quotation
                        </button>
                        <button class="action-btn btn-sale-order" t-on-click="() => this.confirmSaleOrder()">
                            ✅ Sale Order
                        </button>
                        <button class="action-btn btn-draft" t-on-click="() => this.saveOrderDraft()">
                            💾 Draft
                        </button>
                        <button class="action-btn btn-cancel" t-on-click="() => this.cancelOrder()">
                            🚫 Cancel
                        </button>
                        <button class="action-btn btn-whatsapp" t-on-click="() => this.sendWhatsApp()">
                            📱 Send to WhatsApp
                        </button>
                    </div>
                </div>

                <!-- ============= RIGHT SECTION: PRODUCT SEARCH ============= -->
                <div class="search-section">
                    
                    <!-- Filters -->
                    <div class="filters-container">
                        <button class="filter-btn" 
                                t-att-class="{ active: state.activeFilter === 'all' }"
                                t-on-click="() => this.onFilterClick('all')">
                            📦 All Products
                        </button>
                        <button class="filter-btn"
                                t-att-class="{ active: state.activeFilter === '100ml' }"
                                t-on-click="() => this.onFilterClick('100ml')">
                            🧴 100ml
                        </button>
                        <button class="filter-btn"
                                t-att-class="{ active: state.activeFilter === '50ml' }"
                                t-on-click="() => this.onFilterClick('50ml')">
                            💧 50ml
                        </button>
                        <button class="filter-btn"
                                t-att-class="{ active: state.activeFilter === '1 Kilo' }"
                                t-on-click="() => this.onFilterClick('1 Kilo')">
                            ⚗️ 1 Kilo
                        </button>
                        <button class="filter-btn"
                                t-att-class="{ active: state.activeFilter === '100gm' }"
                                t-on-click="() => this.onFilterClick('100gm')">
                            🔬 100gm
                        </button>
                        <button class="filter-btn"
                                t-att-class="{ active: state.activeFilter === 'Givaudan' }"
                                t-on-click="() => this.onFilterClick('Givaudan')">
                            ✨ Givaudan
                        </button>
                        <button class="filter-btn"
                                t-att-class="{ active: state.activeFilter === 'Royal Essence' }"
                                t-on-click="() => this.onFilterClick('Royal Essence')">
                            👑 Royal Essence
                        </button>
                    </div>

                    <!-- Search Bar -->
                    <div class="search-bar">
                        <input type="text" 
                               class="search-input" 
                               placeholder="Search for product (Name, Code, Barcode)..."
                               t-att-value="state.searchTerm"
                               t-on-input="(ev) => this.onSearchInput(ev)"
                               t-on-keydown="(ev) => this.onSearchKeyDown(ev)"
                               t-ref="searchInput"/>
                        <span class="search-icon">🔍</span>
                    </div>

                    <!-- Products Table -->
                    <div class="products-table-container">
                        <t t-if="state.loading">
                            <div class="loading-spinner">
                                <i class="fa fa-spinner fa-spin"/> Loading products...
                            </div>
                        </t>
                        <t t-else="">
                            <table class="products-table">
                                <thead>
                                    <tr>
                                        <th style="width: 80px">Code</th>
                                        <th>Product Name</th>
                                        <th>Foreign Name</th>
                                        <th style="width: 100px">Brand</th>
                                        <th style="width: 90px">Unit</th>
                                        <th style="width: 90px">Price (USD)</th>
                                        <th style="width: 110px">Price (IQD)</th>
                                        <th style="width: 80px">Available</th>
                                        <th style="width: 200px">Warehouses</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.filteredProducts" t-as="product" t-key="product.id">
                                        <tr t-att-class="{ selected: product_index === state.selectedProductIndex }"
                                            t-on-dblclick="() => this.addProductToOrder(product)"
                                            t-on-click="() => this.state.selectedProductIndex = product_index">
                                            
                                            <td class="product-code">
                                                <t t-esc="product.default_code or '-'"/>
                                            </td>
                                            
                                            <td>
                                                <strong t-esc="product.name"/>
                                            </td>
                                            
                                            <td class="arabic-text">
                                                <t t-esc="product.foreign_name or '-'"/>
                                            </td>
                                            
                                            <td>
                                                <t t-esc="product.categ_id ? product.categ_id[1] : '-'"/>
                                            </td>
                                            
                                            <td>
                                                <t t-esc="product.uom_id ? product.uom_id[1] : '-'"/>
                                            </td>
                                            
                                            <td>
                                                $<t t-esc="product.list_price.toFixed(2)"/>
                                            </td>
                                            
                                            <td>
                                                <t t-esc="Math.floor(product.price_iqd).toLocaleString('en-US')"/> IQD
                                            </td>
                                            
                                            <td>
                                                <strong t-esc="Math.floor(product.qty_available)"/>
                                            </td>
                                            
                                            <td>
                                                <t t-foreach="product.warehouses || []" t-as="wh" t-key="wh.code">
                                                    <span class="warehouse-badge">
                                                        <t t-esc="wh.code"/>: <t t-esc="Math.floor(wh.quantity)"/>
                                                    </span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>


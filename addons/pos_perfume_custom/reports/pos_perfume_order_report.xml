<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Custom minimal layout for full page -->
        <template id="pos_perfume_minimal_layout" inherit_id="web.minimal_layout">
            <xpath expr="//head" position="inside">
                <!-- Arabic fonts -->
                <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&amp;family=Tajawal:wght@400;500;700&amp;display=swap" rel="stylesheet"/>
                <!-- Custom report styles -->
                <link rel="stylesheet" type="text/css" href="/pos_perfume_custom/static/src/css/report_style.css"/>
                <style>
                    @page {
                        margin: 0 !important;
                        padding: 0 !important;
                        size: A4;
                    }
                    body {
                        margin: 0 !important;
                        padding: 0 !important;
                        font-family: 'Cairo', 'Tajawal', 'Arial', sans-serif !important;
                        direction: rtl !important;
                    }
                    .page {
                        padding: 15mm !important;
                        margin: 0 !important;
                    }
                </style>
            </xpath>
        </template>
        
        <!-- Document template with full page layout -->
        <template id="report_pos_perfume_order_document">
            <t t-call="web.basic_layout">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang if doc.partner_id else None)"/>
                <div class="page" style="font-family: 'Cairo', 'Tajawal', Arial, sans-serif !important; direction: rtl !important;">
                    <!-- Header -->
                    <div class="row mb-4" style="border-bottom: 3px solid #007bff; padding-bottom: 15px;">
                        <div class="col-8">
                            <h2 style="margin: 0; font-weight: 700; color: #007bff;">
                                <span t-if="doc.state == 'draft'">مسودة طلب</span>
                                <span t-elif="doc.state == 'quotation'">عرض سعر</span>
                                <span t-elif="doc.state == 'sale'">فاتورة بيع</span>
                                <span t-else="">طلب</span>
                            </h2>
                            <h3 style="margin: 5px 0 0 0; font-weight: 600;">
                                <span t-field="doc.name"/>
                            </h3>
                        </div>
                        <div class="col-4 text-left" style="text-align: left !important;">
                            <img t-if="doc.company_id.logo" 
                                 t-att-src="image_data_uri(doc.company_id.logo)" 
                                 style="max-height: 80px; max-width: 200px;"
                                 alt="Logo"/>
                        </div>
                    </div>
                    
                    <!-- Customer and Date Info -->
                    <div class="row mb-4">
                        <div class="col-6">
                            <strong style="font-size: 14pt; color: #333;">العميل:</strong><br/>
                            <span t-field="doc.partner_id.name" style="font-size: 13pt;"/>
                        </div>
                        <div class="col-6">
                            <div t-if="doc.date">
                                <strong style="font-size: 14pt; color: #333;">التاريخ:</strong><br/>
                                <span t-field="doc.date" t-options='{"widget": "date"}' style="font-size: 13pt;"/>
                            </div>
                            <div t-if="doc.user_id" class="mt-2">
                                <strong style="font-size: 14pt; color: #333;">المندوب:</strong><br/>
                                <span t-field="doc.user_id.name" style="font-size: 13pt;"/>
                            </div>
                        </div>
                    </div>

                    <!-- Products Table -->
                    <table class="table table-bordered" style="margin-top: 20px; width: 100%;">
                        <thead style="background-color: #f8f9fa;">
                            <tr>
                                <th style="padding: 12px; font-weight: 700; font-size: 12pt; text-align: right;">المنتج</th>
                                <th style="padding: 12px; font-weight: 700; font-size: 12pt; text-align: center; width: 100px;">الكمية</th>
                                <th style="padding: 12px; font-weight: 700; font-size: 12pt; text-align: center; width: 120px;">السعر</th>
                                <th style="padding: 12px; font-weight: 700; font-size: 12pt; text-align: center; width: 120px;">المجموع</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.order_line_ids" t-as="line">
                                <tr>
                                    <td style="padding: 10px; line-height: 1.8;">
                                        <span t-if="line.custom_product_name" t-esc="line.custom_product_name"/>
                                        <span t-else="" t-field="line.product_id.name"/>
                                    </td>
                                    <td style="padding: 10px; text-align: center;">
                                        <span t-field="line.quantity"/>
                                    </td>
                                    <td style="padding: 10px; text-align: center;">
                                        <span t-field="line.unit_price" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                    <td style="padding: 10px; text-align: center; font-weight: 600;">
                                        <span t-field="line.line_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    
                    <!-- Totals Section -->
                    <div class="row mt-4">
                        <div class="col-7"></div>
                        <div class="col-5">
                            <table class="table table-borderless" style="margin-bottom: 0;">
                                <tr style="border-bottom: 1px solid #dee2e6;">
                                    <td style="padding: 8px; font-size: 12pt;">المجموع الجزئي</td>
                                    <td style="padding: 8px; text-align: center; font-size: 12pt;">
                                        <span t-field="doc.amount_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                                <tr t-if="doc.amount_discount > 0" style="border-bottom: 1px solid #dee2e6;">
                                    <td style="padding: 8px; font-size: 12pt; color: #d9534f;">الخصم</td>
                                    <td style="padding: 8px; text-align: center; font-size: 12pt; color: #d9534f;">
                                        <span t-field="doc.amount_discount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                                <tr style="border-top: 3px solid #007bff; background-color: #e7f3ff;">
                                    <td style="padding: 12px; font-size: 14pt; font-weight: 700;">المجموع الكلي</td>
                                    <td style="padding: 12px; text-align: center; font-size: 14pt; font-weight: 700; color: #007bff;">
                                        <span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Notes Section -->
                    <div t-if="doc.note" class="mt-4" style="padding: 15px; background-color: #f8f9fa; border-right: 4px solid #007bff; line-height: 1.8;">
                        <strong style="font-size: 13pt; color: #333;">ملاحظات:</strong><br/>
                        <span t-field="doc.note"/>
                    </div>
                </div>
            </t>
        </template>

        <!-- Raw template that calls html_container -->
        <template id="report_pos_perfume_order_raw">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="pos_perfume_custom.report_pos_perfume_order_document" t-lang="doc.partner_id.lang if doc.partner_id else None"/>
                </t>
            </t>
        </template>

        <!-- Main report template -->
        <record id="report_pos_perfume_order" model="ir.ui.view">
            <field name="name">report_pos_perfume_order</field>
            <field name="key">pos_perfume_custom.report_pos_perfume_order</field>
            <field name="type">qweb</field>
            <field name="arch" type="xml">
                <t t-name="pos_perfume_custom.report_pos_perfume_order">
                    <t t-call="pos_perfume_custom.report_pos_perfume_order_raw"/>
                </t>
            </field>
        </record>
    </data>
</odoo>

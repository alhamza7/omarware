<?xml version="1.0"?>
<odoo>
    <data noupdate="0">
        <!-- Professional POS Order Report Template - RTL - Fast PDF -->
        <template id="report_pos_perfume_order_simple">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <div class="article" dir="rtl" style="font-family: 'DejaVu Sans', Arial, sans-serif;">
                        <!-- Inline CSS for fast PDF generation -->
                        <style>
                            .invoice-header { background: #667eea; color: white; padding: 20px; margin-bottom: 20px; }
                            .invoice-header h1 { margin: 0; font-size: 28px; }
                            .order-number { font-size: 16px; margin-top: 5px; }
                            .info-card { background: #f8f9fa; border-right: 3px solid #667eea; padding: 15px; margin: 10px 0; }
                            .info-card h4 { color: #667eea; margin: 0 0 10px 0; text-align: right; font-size: 14px; }
                            .product-table { width: 100%; border-collapse: collapse; margin: 15px 0; }
                            .product-table thead { background: #667eea; color: white; }
                            .product-table th { padding: 10px 5px; border: 1px solid #ddd; text-align: center; }
                            .product-table td { padding: 8px 5px; border: 1px solid #ddd; }
                            .product-code-badge { background: #667eea; color: white; padding: 2px 8px; border-radius: 8px; font-size: 10px; margin-right: 5px; white-space: nowrap; }
                            .totals-section { background: #f8f9fa; padding: 15px; margin-top: 20px; }
                            .total-row { padding: 8px 0; border-bottom: 1px solid #ddd; }
                            .total-final { background: #667eea; color: white; padding: 12px; margin-top: 10px; font-size: 18px; text-align: center; }
                            .notes-section { background: #fff9e6; border-right: 3px solid #ffc107; padding: 10px; margin-top: 15px; text-align: right; }
                        </style>
                        
                        <!-- Header -->
                        <div class="invoice-header">
                            <table style="width: 100%;">
                                <tr>
                                    <td style="width: 70%; vertical-align: middle;">
                                        <h1>
                                            <t t-if="o.state == 'quotation'">عرض سعر</t>
                                            <t t-elif="o.state == 'sale'">فاتورة</t>
                                            <t t-else="">طلب</t>
                                        </h1>
                                        <div class="order-number">
                                            <span t-field="o.name"/>
                                            <t t-if="o.sap_doc_num">
                                                | SAP: <span t-field="o.sap_doc_num"/>
                                            </t>
                                        </div>
                                    </td>
                                    <td style="width: 30%; text-align: left; vertical-align: middle;">
                                        <img t-if="o.company_id.logo" 
                                             t-att-src="image_data_uri(o.company_id.logo)"
                                             style="max-height: 60px;"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        
                        <!-- Customer & Order Info -->
                        <table style="width: 100%; margin-top: 15px;">
                            <tr>
                                <td style="width: 50%; vertical-align: top; padding-left: 5px;">
                                    <div class="info-card">
                                        <h4>معلومات العميل</h4>
                                        <strong><span t-field="o.partner_id.name"/></strong><br/>
                                        <t t-if="o.partner_id.phone">
                                            <span t-field="o.partner_id.phone"/>
                                        </t>
                                    </div>
                                </td>
                                <td style="width: 50%; vertical-align: top; padding-right: 5px;">
                                    <div class="info-card">
                                        <h4>تفاصيل الطلب</h4>
                                        <strong>التاريخ:</strong> <span t-field="o.date" t-options='{"format": "dd/MM/yyyy"}'/><br/>
                                        <strong>البائع:</strong> <span t-field="o.user_id.name"/>
                                    </div>
                                </td>
                            </tr>
                        </table>
                        
                        <!-- Products Table -->
                        <table class="product-table">
                            <thead>
                                <tr>
                                    <th style="width: 5%;">#</th>
                                    <th style="width: 45%; text-align: right;">المنتج</th>
                                    <th style="width: 15%;">الكمية</th>
                                    <th style="width: 13%;">السعر</th>
                                    <th style="width: 10%;">الخصم</th>
                                    <th style="width: 12%;">المجموع</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="line_index" t-value="0"/>
                                <t t-foreach="o.order_line_ids" t-as="line">
                                    <t t-set="line_index" t-value="line_index + 1"/>
                                    <t t-set="code" t-value="line.product_code or ''"/>
                                    <t t-set="show_code" t-value="code[:1] in ['G', 'R'] or code[:2] in ['N1'] or code[:2] == 'FL' or code[:3] == 'ADF'"/>
                                    <tr>
                                        <td style="text-align: center;"><t t-esc="line_index"/></td>
                                        <td style="text-align: right;">
                                            <t t-if="line.custom_product_name">
                                                <t t-esc="line.custom_product_name"/>
                                            </t>
                                            <t t-else="">
                                                <span t-field="line.product_id.name"/>
                                            </t>
                                            <t t-if="show_code and code">
                                                <span class="product-code-badge"><t t-esc="code"/></span>
                                            </t>
                                        </td>
                                        <td style="text-align: center;">
                                            <strong><t t-esc="'{:.2f}'.format(line.quantity)"/></strong>
                                            <span t-field="line.product_uom_id.name"/>
                                        </td>
                                        <td style="text-align: center;"><t t-esc="'{:.2f}'.format(line.unit_price)"/> $</td>
                                        <td style="text-align: center;">
                                            <t t-if="line.discount_percent > 0">
                                                <strong style="color: #dc3545;"><t t-esc="'{:.0f}'.format(line.discount_percent)"/>%</strong>
                                            </t>
                                            <t t-else="">-</t>
                                        </td>
                                        <td style="text-align: center;"><strong><t t-esc="'{:.2f}'.format(line.line_total)"/> $</strong></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        
                        <!-- Totals -->
                        <table style="width: 50%; margin-right: 0; margin-left: auto;">
                            <tr>
                                <td class="totals-section">
                                    <div class="total-row">
                                        <table style="width: 100%;">
                                            <tr>
                                                <td style="text-align: right;"><strong>المجموع الفرعي:</strong></td>
                                                <td style="text-align: left;"><t t-esc="'{:.2f}'.format(o.amount_subtotal)"/> $</td>
                                            </tr>
                                            <tr t-if="o.amount_discount > 0">
                                                <td style="text-align: right;"><strong>الخصم:</strong></td>
                                                <td style="text-align: left; color: #dc3545;">-<t t-esc="'{:.2f}'.format(o.amount_discount)"/> $</td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="total-final">
                                        الإجمالي: <t t-esc="'{:.2f}'.format(o.amount_total)"/> $
                                    </div>
                                    <div t-if="o.amount_total_iqd > 0" style="text-align: center; margin-top: 10px; background: #e8f5e9; padding: 8px; border-radius: 5px;">
                                        <strong style="color: #2e7d32;">المجموع بالدينار: <t t-esc="'{:,.0f}'.format(o.amount_total_iqd)"/> د.ع</strong>
                                    </div>
                                </td>
                            </tr>
                        </table>
                        
                        <!-- Notes -->
                        <div t-if="o.note" class="notes-section">
                            <strong>ملاحظات:</strong><br/>
                            <span t-field="o.note"/>
                        </div>
                        
                        <!-- Footer -->
                        <div style="text-align: center; margin-top: 30px; padding-top: 15px; border-top: 2px solid #667eea;">
                            <p style="color: #667eea; font-size: 16px; font-weight: bold; margin: 0;">شكراً لتعاملكم معنا</p>
                        </div>
                    </div>
                </t>
            </t>
        </template>

        <!-- Main report wrapper -->
        <template id="report_pos_perfume_order">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="pos_perfume_custom.report_pos_perfume_order_simple"/>
                </t>
            </t>
        </template>
    </data>
</odoo>

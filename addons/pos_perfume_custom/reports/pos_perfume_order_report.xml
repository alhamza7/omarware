<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Inherit Sale Order Report and adapt it for POS Perfume Order -->
        <template id="report_pos_perfume_order_document" inherit_id="sale.report_saleorder_document">
            <!-- Replace sale.order with pos.perfume.order fields -->
            <xpath expr="//t[@t-set='doc']" position="replace">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang if doc.partner_id else None)"/>
                <t t-set="doc_model" t-value="'pos.perfume.order'"/>
            </xpath>
            
            <!-- Use custom_product_name if available -->
            <xpath expr="//span[@t-field='line.name']" position="replace">
                <span t-if="line.custom_product_name" t-esc="line.custom_product_name"/>
                <span t-else="" t-field="line.product_id.name"/>
            </xpath>
            
            <!-- Replace lines_to_report to use order_line_ids instead of _get_order_lines_to_report() -->
            <xpath expr="//t[@t-set='lines_to_report']" position="replace">
                <t t-set="lines_to_report" t-value="doc.order_line_ids"/>
            </xpath>
            
            <!-- Note: product_uom_qty, price_unit, and price_subtotal are computed fields 
                 that map to quantity, unit_price, and line_total respectively -->
            
            <!-- Disable taxes display -->
            <xpath expr="//t[@t-set='display_taxes']" position="replace">
                <t t-set="display_taxes" t-value="False"/>
            </xpath>
            
            <!-- Note: Totals are handled automatically by the template -->
        </template>

        <!-- Main report that uses the inherited sale template -->
        <template id="report_pos_perfume_order">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="pos_perfume_custom.report_pos_perfume_order_document" t-lang="doc.partner_id.lang if doc.partner_id else None"/>
                </t>
            </t>
        </template>
    </data>
</odoo>

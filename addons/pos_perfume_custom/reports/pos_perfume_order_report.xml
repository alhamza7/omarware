<?xml version="1.0"?>
<odoo>
    <data noupdate="0">
        <!-- Professional POS Order Report Template -->
        <template id="report_pos_perfume_order_simple">
            <t t-call="web.external_layout">
                <div class="page">
                    <!-- Custom CSS for professional look -->
                    <style>
                        .invoice-header {
                            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                            color: white;
                            padding: 30px;
                            border-radius: 10px 10px 0 0;
                            margin-bottom: 0;
                        }
                        .invoice-header h1 {
                            margin: 0;
                            font-size: 32px;
                            font-weight: 700;
                        }
                        .invoice-header .order-number {
                            font-size: 18px;
                            opacity: 0.9;
                            margin-top: 5px;
                        }
                        .info-card {
                            background: #f8f9fa;
                            border-left: 4px solid #667eea;
                            padding: 20px;
                            border-radius: 5px;
                            margin-bottom: 20px;
                        }
                        .info-card h4 {
                            color: #667eea;
                            font-weight: 600;
                            margin-bottom: 10px;
                            font-size: 16px;
                        }
                        .product-table {
                            border-radius: 8px;
                            overflow: hidden;
                            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
                        }
                        .product-table thead {
                            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                            color: white;
                        }
                        .product-table thead th {
                            padding: 15px 10px;
                            font-weight: 600;
                            border: none;
                        }
                        .product-table tbody td {
                            padding: 12px 10px;
                            border-bottom: 1px solid #e9ecef;
                        }
                        .product-table tbody tr:hover {
                            background-color: #f8f9fa;
                        }
                        .product-name {
                            font-weight: 600;
                            color: #2c3e50;
                        }
                        .product-code-badge {
                            display: inline-block;
                            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                            color: white;
                            padding: 3px 10px;
                            border-radius: 12px;
                            font-size: 11px;
                            font-weight: 600;
                            margin-left: 8px;
                            vertical-align: middle;
                        }
                        .totals-section {
                            background: #f8f9fa;
                            border-radius: 8px;
                            padding: 20px;
                            margin-top: 30px;
                        }
                        .total-row {
                            padding: 10px 0;
                            border-bottom: 1px solid #dee2e6;
                        }
                        .total-row.final {
                            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                            color: white;
                            padding: 15px 20px;
                            border-radius: 5px;
                            margin-top: 10px;
                            font-size: 20px;
                            font-weight: 700;
                        }
                        .notes-section {
                            background: #fff9e6;
                            border-left: 4px solid #ffc107;
                            padding: 15px;
                            border-radius: 5px;
                            margin-top: 20px;
                        }
                        .sap-badge {
                            background: #28a745;
                            color: white;
                            padding: 5px 15px;
                            border-radius: 20px;
                            font-size: 12px;
                            font-weight: 600;
                            display: inline-block;
                        }
                    </style>
                    
                    <!-- Professional Header -->
                    <div class="invoice-header">
                        <div class="row">
                            <div class="col-8">
                                <h1>
                                    <i class="fa fa-file-text-o"/> 
                                    <t t-if="o.state == 'quotation'">عرض سعر</t>
                                    <t t-elif="o.state == 'sale'">فاتورة</t>
                                    <t t-else="">طلب</t>
                                </h1>
                                <div class="order-number">
                                    <t t-field="o.name"/>
                                    <span t-if="o.sap_doc_num" class="sap-badge ml-3">
                                        SAP: <t t-field="o.sap_doc_num"/>
                                    </span>
                                </div>
                            </div>
                            <div class="col-4 text-right">
                                <img t-if="o.company_id.logo" 
                                     t-att-src="image_data_uri(o.company_id.logo)"
                                     style="max-height: 80px; max-width: 150px;"/>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Customer & Order Info -->
                    <div class="row mt-4">
                        <div class="col-6">
                            <div class="info-card">
                                <h4><i class="fa fa-user"/> معلومات العميل</h4>
                                <strong style="font-size: 16px; color: #2c3e50;">
                                    <t t-field="o.partner_id.name"/>
                                </strong><br/>
                                <div t-if="o.partner_id.street" class="mt-2">
                                    <i class="fa fa-map-marker text-muted"/> 
                                    <span t-field="o.partner_id.street"/>
                                </div>
                                <div t-if="o.partner_id.phone" class="mt-1">
                                    <i class="fa fa-phone text-muted"/> 
                                    <span t-field="o.partner_id.phone"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="info-card">
                                <h4><i class="fa fa-info-circle"/> تفاصيل الطلب</h4>
                                <div class="row">
                                    <div class="col-6">
                                        <strong>التاريخ:</strong><br/>
                                        <span t-field="o.date" t-options='{"format": "dd/MM/yyyy"}'/>
                                    </div>
                                    <div class="col-6">
                                        <strong>البائع:</strong><br/>
                                        <span t-field="o.user_id.name"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Products Table -->
                    <table class="table product-table mt-4">
                        <thead>
                            <tr>
                                <th style="width: 5%;">#</th>
                                <th style="width: 40%;">المنتج</th>
                                <th class="text-center" style="width: 15%;">الكمية</th>
                                <th class="text-right" style="width: 15%;">السعر</th>
                                <th class="text-center" style="width: 10%;">الخصم</th>
                                <th class="text-right" style="width: 15%;">المجموع</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="line_index" t-value="0"/>
                            <t t-foreach="o.order_line_ids" t-as="line">
                                <t t-set="line_index" t-value="line_index + 1"/>
                                <t t-set="code" t-value="line.product_code or ''"/>
                                <t t-set="show_code" t-value="code[:1] in ['G', 'R'] or code[:2] in ['N1'] or code[:2] == 'FL' or code[:3] == 'ADF'"/>
                                <tr>
                                    <td class="text-center" style="font-weight: 600; color: #667eea;">
                                        <t t-esc="line_index"/>
                                    </td>
                                    <td>
                                        <span class="product-name">
                                            <t t-if="line.custom_product_name">
                                                <t t-esc="line.custom_product_name"/>
                                            </t>
                                            <t t-else="">
                                                <t t-field="line.product_id.name"/>
                                            </t>
                                        </span>
                                        <t t-if="show_code and code">
                                            <span class="product-code-badge">
                                                <t t-esc="code"/>
                                            </span>
                                        </t>
                                    </td>
                                    <td class="text-center">
                                        <strong><t t-esc="'{:.2f}'.format(line.quantity)"/></strong>
                                        <br/>
                                        <small class="text-muted">
                                            <t t-field="line.product_uom_id.name"/>
                                        </small>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="'{:.2f}'.format(line.unit_price)"/> $
                                    </td>
                                    <td class="text-center">
                                        <t t-if="line.discount_percent > 0">
                                            <strong style="color: #dc3545;">
                                                <t t-esc="'{:.0f}'.format(line.discount_percent)"/>%
                                            </strong>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>
                                    <td class="text-right">
                                        <strong style="color: #667eea;">
                                            <t t-esc="'{:.2f}'.format(line.line_total)"/> $
                                        </strong>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    
                    <!-- Totals Section -->
                    <div class="row">
                        <div class="col-7"/>
                        <div class="col-5">
                            <div class="totals-section">
                                <div class="total-row">
                                    <div class="row">
                                        <div class="col-6"><strong>المجموع الفرعي:</strong></div>
                                        <div class="col-6 text-right">
                                            <t t-esc="'{:.2f}'.format(o.amount_subtotal)"/> $
                                        </div>
                                    </div>
                                </div>
                                <div t-if="o.amount_discount > 0" class="total-row">
                                    <div class="row">
                                        <div class="col-6"><strong style="color: #dc3545;">الخصم:</strong></div>
                                        <div class="col-6 text-right" style="color: #dc3545;">
                                            -<t t-esc="'{:.2f}'.format(o.amount_discount)"/> $
                                        </div>
                                    </div>
                                </div>
                                <div class="total-row final">
                                    <div class="row">
                                        <div class="col-6">الإجمالي:</div>
                                        <div class="col-6 text-right">
                                            <t t-esc="'{:.2f}'.format(o.amount_total)"/> $
                                        </div>
                                    </div>
                                </div>
                                <div t-if="o.amount_total_iqd > 0" class="mt-3 text-center" style="background: #e8f5e9; padding: 10px; border-radius: 5px;">
                                    <strong style="color: #2e7d32;">
                                        المجموع بالدينار: <t t-esc="'{:,.0f}'.format(o.amount_total_iqd)"/> د.ع
                                    </strong>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Notes Section -->
                    <div t-if="o.note" class="notes-section">
                        <strong><i class="fa fa-comment"/> ملاحظات:</strong><br/>
                        <p style="margin-top: 10px; margin-bottom: 0;">
                            <t t-field="o.note"/>
                        </p>
                    </div>
                    
                    <!-- Footer -->
                    <div class="text-center mt-5" style="padding-top: 30px; border-top: 2px solid #e9ecef;">
                        <p style="color: #667eea; font-size: 18px; font-weight: 600; margin: 0;">
                            شكراً لتعاملكم معنا
                        </p>
                        <p style="color: #6c757d; margin-top: 5px;">
                            Thank you for your business
                        </p>
                    </div>
                </div>
            </t>
        </template>

        <!-- Main report wrapper -->
        <template id="report_pos_perfume_order">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="pos_perfume_custom.report_pos_perfume_order_simple"/>
                </t>
            </t>
        </template>
    </data>
</odoo>

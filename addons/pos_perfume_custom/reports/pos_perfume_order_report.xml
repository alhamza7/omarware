<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Inherit Sale Order Report and adapt it for POS Perfume Order -->
        <template id="report_pos_perfume_order_document" inherit_id="sale.report_saleorder_document">
            <!-- Replace sale.order with pos.perfume.order fields -->
            <xpath expr="//t[@t-set='doc']" position="replace">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang if doc.partner_id else None)"/>
                <t t-set="doc_model" t-value="'pos.perfume.order'"/>
            </xpath>
            
            <!-- Use custom_product_name if available -->
            <xpath expr="//span[@t-field='line.name']" position="replace">
                <span t-if="line.custom_product_name" t-esc="line.custom_product_name"/>
                <span t-else="" t-field="line.product_id.name"/>
            </xpath>
            
            <!-- Replace order_line with order_line_ids -->
            <xpath expr="//t[@t-foreach='doc.order_line']" position="attributes">
                <attribute name="t-foreach">doc.order_line_ids</attribute>
            </xpath>
            
            <!-- Adjust quantity field -->
            <xpath expr="//span[@t-field='line.product_uom_qty']" position="replace">
                <span t-field="line.quantity"/>
            </xpath>
            
            <!-- Adjust price field -->
            <xpath expr="//span[@t-field='line.price_unit']" position="replace">
                <span t-field="line.unit_price"/>
            </xpath>
            
            <!-- Adjust subtotal field -->
            <xpath expr="//span[@t-field='line.price_subtotal']" position="replace">
                <span t-field="line.line_total"/>
            </xpath>
            
            <!-- Remove tax column if exists -->
            <xpath expr="//th[@name='th_taxes']" position="replace"/>
            <xpath expr="//td[@name='td_taxes']" position="replace"/>
            
            <!-- Adjust totals -->
            <xpath expr="//span[@t-field='doc.amount_untaxed']" position="replace">
                <span t-field="doc.amount_subtotal"/>
            </xpath>
            
            <!-- Remove tax total if exists -->
            <xpath expr="//tr[@class='border-black o_tax_line']" position="replace"/>
            <xpath expr="//tr[@class='border-black o_total']//span[@t-field='doc.amount_total']" position="attributes">
                <attribute name="t-field">doc.amount_total</attribute>
            </xpath>
        </template>

        <!-- Main report that uses the inherited sale template -->
        <template id="report_pos_perfume_order">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="pos_perfume_custom.report_pos_perfume_order_document" t-lang="doc.partner_id.lang if doc.partner_id else None"/>
                </t>
            </t>
        </template>
    </data>
</odoo>

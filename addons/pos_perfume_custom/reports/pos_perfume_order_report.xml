<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="report_pos_perfume_order" model="ir.ui.view">
            <field name="name">report_pos_perfume_order</field>
            <field name="key">pos_perfume_custom.report_pos_perfume_order</field>
            <field name="type">qweb</field>
            <field name="arch" type="xml">
                <t t-name="pos_perfume_custom.report_pos_perfume_order">
                    <t t-call="web.html_container">
                        <t t-foreach="docs" t-as="doc">
                            <style>
                                @charset "UTF-8";
                                body { direction: rtl; font-family: 'Arial', 'Tahoma', 'DejaVu Sans', sans-serif; }
                            </style>
                            <div class="page" dir="rtl" lang="ar" style="font-family: 'Arial', 'Tahoma', 'DejaVu Sans', sans-serif; padding: 20px; direction: rtl;">
                                <h2 style="background: #000; color: #d4af37; padding: 15px; text-align: center; margin: 0 0 20px 0;">
                                    <span t-if="doc.state == 'draft'">مسودة طلب #</span>
                                    <span t-elif="doc.state == 'sale'">فاتورة بيع #</span>
                                    <span t-else="">طلب #</span>
                                    <span t-field="doc.name"/>
                                </h2>
                                
                                <div style="background: #f8f9fa; padding: 15px; margin-bottom: 20px; border: 2px solid #000;">
                                    <h3 style="margin: 0 0 10px 0; color: #000;">معلومات العميل</h3>
                                    <p style="margin: 5px 0;"><strong>الاسم:</strong> <span t-field="doc.partner_id.name"/></p>
                                    <p t-if="doc.partner_id.phone" style="margin: 5px 0;"><strong>الهاتف:</strong> <span t-field="doc.partner_id.phone"/></p>
                                    <p t-if="doc.date" style="margin: 5px 0;"><strong>التاريخ:</strong> <span t-field="doc.date"/></p>
                                    <p t-if="doc.user_id" style="margin: 5px 0;"><strong>المندوب:</strong> <span t-field="doc.user_id.name"/></p>
                                    <p t-if="doc.sap_doc_num" style="margin: 5px 0;"><strong>رقم SAP:</strong> <span t-field="doc.sap_doc_num"/></p>
                                </div>

                                <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px; border: 2px solid #000;">
                                    <thead>
                                        <tr style="background: #000; color: #d4af37;">
                                            <th style="border: 1px solid #000; padding: 10px; text-align: center;">ت</th>
                                            <th style="border: 1px solid #000; padding: 10px; text-align: right;">المنتج</th>
                                            <th style="border: 1px solid #000; padding: 10px; text-align: center;">الكمية</th>
                                            <th style="border: 1px solid #000; padding: 10px; text-align: center;">السعر</th>
                                            <th style="border: 1px solid #000; padding: 10px; text-align: center;">المجموع</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="num" t-value="0"/>
                                        <t t-foreach="doc.order_line_ids" t-as="line">
                                            <t t-set="num" t-value="num + 1"/>
                                            <tr>
                                                <td style="border: 1px solid #ddd; padding: 8px; text-align: center;"><t t-esc="num"/></td>
                                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;"><span t-field="line.product_id.name"/></td>
                                                <td style="border: 1px solid #ddd; padding: 8px; text-align: center;"><span t-field="line.quantity"/></td>
                                                <td style="border: 1px solid #ddd; padding: 8px; text-align: center;"><span t-field="line.unit_price"/></td>
                                                <td style="border: 1px solid #ddd; padding: 8px; text-align: center;"><span t-field="line.line_total"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>

                                <div style="text-align: left; margin-bottom: 20px;">
                                    <table style="width: 300px; margin-right: 0; margin-left: auto; border: 2px solid #000;">
                                        <tr style="background: #f8f9fa;">
                                            <td style="padding: 10px; border: 1px solid #000;"><strong>المجموع الجزئي:</strong></td>
                                            <td style="padding: 10px; border: 1px solid #000; text-align: left;"><span t-field="doc.amount_subtotal"/></td>
                                        </tr>
                                        <tr t-if="doc.amount_discount > 0" style="background: #fff5f5;">
                                            <td style="padding: 10px; border: 1px solid #000;"><strong>الخصم:</strong></td>
                                            <td style="padding: 10px; border: 1px solid #000; text-align: left; color: #dc2626;"><span t-field="doc.amount_discount"/></td>
                                        </tr>
                                        <tr style="background: #000; color: #d4af37;">
                                            <td style="padding: 12px; border: 1px solid #000;"><strong>المجموع الكلي:</strong></td>
                                            <td style="padding: 12px; border: 1px solid #000; text-align: left; font-size: 16px;"><strong><span t-field="doc.amount_total"/></strong></td>
                                        </tr>
                                    </table>
                                </div>

                                <div t-if="doc.note" style="border: 2px solid #d4af37; padding: 15px; margin-bottom: 20px; background: #fffbeb;">
                                    <strong>ملاحظات:</strong>
                                    <p style="margin: 8px 0 0 0;"><span t-field="doc.note"/></p>
                                </div>

                                <div style="background: #000; color: white; padding: 15px; text-align: center; border: 2px solid #d4af37;">
                                    <p style="margin: 0; color: #d4af37; font-size: 16px;"><strong>شكراً لتعاملكم معنا</strong></p>
                                </div>
                            </div>
                        </t>
                    </t>
                </t>
            </field>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Document template -->
        <template id="report_pos_perfume_order_document">
            <t t-call="web.external_layout">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang if doc.partner_id else None)"/>
                <t t-set="layout_document_title">
                    <span t-if="doc.state == 'draft'">مسودة طلب #</span>
                    <span t-elif="doc.state == 'sale'">فاتورة بيع #</span>
                    <span t-else="">طلب #</span>
                    <span t-field="doc.name"/>
                </t>
                <div class="page">
                    <div class="oe_structure"/>
                    
                    <div class="row mb-4" id="informations">
                        <div t-if="doc.date" class="col" name="informations_date">
                            <strong>التاريخ</strong>
                            <div t-field="doc.date" t-options='{"widget": "date"}'/>
                        </div>
                        <div t-if="doc.user_id" class="col" name="informations_salesperson">
                            <strong>المندوب</strong>
                            <div t-field="doc.user_id.name"/>
                        </div>
                    </div>

                    <div class="oe_structure"></div>
                    <table class="o_has_total_table table o_main_table table-borderless">
                        <thead>
                            <tr>
                                <th name="th_description" class="text-start">المنتج</th>
                                <th name="th_quantity" class="text-end text-nowrap">الكمية</th>
                                <th name="th_priceunit" class="text-end text-nowrap">السعر</th>
                                <th name="th_subtotal" class="text-end">المجموع</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.order_line_ids" t-as="line">
                                <tr>
                                    <td class="text-start">
                                        <span t-field="line.display_product_name"/>
                                    </td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.unit_price"/></td>
                                    <td class="text-end"><span t-field="line.line_total"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div class="clearfix" name="so_total_summary">
                        <div id="total" class="row mt-n3" name="total">
                            <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                                <table class="o_total_table table table-borderless">
                                    <tr class="o_subtotal">
                                        <td>المجموع الجزئي</td>
                                        <td class="text-end"><span t-field="doc.amount_subtotal"/></td>
                                    </tr>
                                    <tr t-if="doc.amount_discount > 0" class="o_taxes">
                                        <td>الخصم</td>
                                        <td class="text-end"><span t-field="doc.amount_discount"/></td>
                                    </tr>
                                    <tr class="o_total">
                                        <td><strong>المجموع الكلي</strong></td>
                                        <td class="text-end"><strong><span t-field="doc.amount_total"/></strong></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="oe_structure"></div>

                    <div t-if="doc.note">
                        <span t-field="doc.note" name="order_note"/>
                    </div>
                    
                    <div class="oe_structure"/>
                    <!-- Auto-print when report opens in browser -->
                    <script type="text/javascript">
                        window.addEventListener('load', function () {
                            try {
                                window.print();
                            } catch (e) {
                                // ignore
                            }
                        });
                    </script>
                </div>
            </t>
        </template>

        <!-- Raw template that calls html_container -->
        <template id="report_pos_perfume_order_raw">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="pos_perfume_custom.report_pos_perfume_order_document" t-lang="doc.partner_id.lang if doc.partner_id else None"/>
                </t>
            </t>
        </template>

        <!-- Main report template -->
        <record id="report_pos_perfume_order" model="ir.ui.view">
            <field name="name">report_pos_perfume_order</field>
            <field name="key">pos_perfume_custom.report_pos_perfume_order</field>
            <field name="type">qweb</field>
            <field name="arch" type="xml">
                <t t-name="pos_perfume_custom.report_pos_perfume_order">
                    <t t-call="pos_perfume_custom.report_pos_perfume_order_raw"/>
                </t>
            </field>
        </record>
    </data>
</odoo>

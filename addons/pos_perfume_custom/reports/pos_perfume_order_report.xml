<?xml version="1.0"?>
<odoo>
    <data>
        <!-- Professional Black Arabic Invoice Design -->
        <t t-name="pos_perfume_custom.report_pos_perfume_order">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="doc">
                    <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang if doc.partner_id else None)"/>
                    <div class="page" dir="rtl" style="font-family: 'Cairo', 'Tajawal', 'Arial', sans-serif;">
                        <main>
                            <div class="oe_structure"/>
                            
                            <!-- Black Header -->
                            <div style="background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%); color: white; padding: 20px; border-radius: 8px; margin-bottom: 20px; border: 3px solid #d4af37;">
                                <div style="display: grid; grid-template-columns: 1fr 2fr 1fr; gap: 15px; align-items: center;">
                                    <!-- Company Logo -->
                                    <div style="text-align: right;">
                                        <t t-if="doc.company_id and doc.company_id.logo">
                                            <img t-att-src="image_data_uri(doc.company_id.logo)" 
                                                 style="max-height: 70px; max-width: 140px; filter: brightness(0) invert(1);"/>
                                        </t>
                                    </div>
                                    
                                    <!-- Title -->
                                    <div style="text-align: center;">
                                        <div style="background: linear-gradient(135deg, #d4af37, #f4e5a5, #d4af37); padding: 12px 35px; border-radius: 8px; box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4); display: inline-block;">
                                            <h2 style="margin: 0; font-size: 24px; color: #000; font-weight: bold;">
                                                <span t-if="doc.state == 'draft'">مسودة طلب #</span>
                                                <span t-elif="doc.state == 'quotation'">عرض سعر #</span>
                                                <span t-elif="doc.state == 'sale'">فاتورة بيع #</span>
                                                <span t-else="">طلب #</span>
                                                <span t-field="doc.name"/>
                                            </h2>
                                        </div>
                                    </div>
                                    
                                    <!-- Company Info -->
                                    <div style="text-align: left;">
                                        <t t-if="doc.company_id">
                                            <h3 style="margin: 0 0 6px 0; font-size: 18px; color: #d4af37; font-weight: bold;">
                                                <span t-field="doc.company_id.name"/>
                                            </h3>
                                            <p style="margin: 0 0 3px 0; font-size: 11px; color: #bbb;">
                                                <span t-if="doc.company_id.phone" t-field="doc.company_id.phone"/>
                                            </p>
                                            <p style="margin: 0; font-size: 10px; color: #999;">
                                                <span t-if="doc.company_id.email" t-field="doc.company_id.email"/>
                                            </p>
                                        </t>
                                    </div>
                                </div>
                                
                                <!-- Info Bar -->
                                <div style="margin-top: 15px; padding-top: 12px; border-top: 2px solid #333;">
                                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; font-size: 11px;">
                                        <div t-if="doc.date">
                                            <span style="color: #d4af37; margin-left: 6px;">📅 التاريخ:</span>
                                            <span t-field="doc.date" t-options='{"widget": "datetime"}'/>
                                        </div>
                                        <div t-if="doc.user_id">
                                            <span style="color: #d4af37; margin-left: 6px;">👤 المندوب:</span>
                                            <span t-field="doc.user_id"/>
                                        </div>
                                        <div t-if="doc.sap_doc_num">
                                            <span style="color: #d4af37; margin-left: 6px;">🔢 رقم SAP:</span>
                                            <span style="font-weight: bold;" t-field="doc.sap_doc_num"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Customer Information -->
                            <div class="mb-4" style="border: 2px solid #1a1a1a; border-radius: 8px; overflow: hidden;">
                                <div style="background: linear-gradient(135deg, #1a1a1a, #000); color: #d4af37; padding: 10px 15px; font-size: 14px; font-weight: bold;">
                                    معلومات العميل
                                </div>
                                <div style="padding: 15px; background: linear-gradient(to bottom, #f8f9fa, white);">
                                    <div class="row">
                                        <div class="col-6">
                                            <strong>📋 العميل</strong>
                                            <div t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                                            <p t-if="doc.partner_id and doc.partner_id.phone" class="mb-0">
                                                <i class="fa fa-phone"/> <span t-field="doc.partner_id.phone"/>
                                            </p>
                                            <p t-if="doc.partner_id and doc.partner_id.email" class="mb-0">
                                                <i class="fa fa-envelope"/> <span t-field="doc.partner_id.email"/>
                                            </p>
                                        </div>
                                        <div class="col-6">
                                            <div t-if="doc.date" class="mb-2">
                                                <strong>📅 تاريخ الطلب</strong>
                                                <div t-field="doc.date" t-options='{"widget": "datetime"}'/>
                                            </div>
                                            <div t-if="doc.user_id" class="mb-2">
                                                <strong>👤 المندوب</strong>
                                                <div t-field="doc.user_id"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="oe_structure"/>

                            <!-- Products Table -->
                            <div style="border: 3px solid #1a1a1a; border-radius: 8px; overflow: hidden; margin-bottom: 20px;">
                                <table class="o_has_total_table table o_main_table" style="margin: 0; border: none;">
                                    <thead style="display: table-row-group; background: linear-gradient(135deg, #000, #1a1a1a, #000); color: #d4af37;">
                                        <tr style="border-bottom: 3px solid #d4af37;">
                                            <th class="text-center" style="color: #d4af37; padding: 12px 8px; border-left: 2px solid #333; width: 40px;">ت</th>
                                            <th class="text-start" style="color: #d4af37; padding: 12px 12px; border-left: 2px solid #333;">المنتج</th>
                                            <th class="text-end" style="color: #d4af37; padding: 12px 8px; border-left: 2px solid #333; width: 100px;">المستودع</th>
                                            <th class="text-end" style="color: #d4af37; padding: 12px 8px; border-left: 2px solid #333; width: 70px;">الوحدة</th>
                                            <th class="text-end" style="color: #d4af37; padding: 12px 8px; border-left: 2px solid #333; width: 70px;">الكمية</th>
                                            <th class="text-end" style="color: #d4af37; padding: 12px 8px; border-left: 2px solid #333; width: 80px;">السعر</th>
                                            <th class="text-end" style="color: #d4af37; padding: 12px 8px; border-left: 2px solid #333; width: 60px;">خصم%</th>
                                            <th class="text-end" style="color: #d4af37; padding: 12px 8px; width: 90px;">المجموع</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="row_index" t-value="0"/>
                                        <t t-foreach="doc.order_line_ids" t-as="line">
                                            <t t-set="row_index" t-value="row_index + 1"/>
                                            <tr t-att-style="'background: ' + ('#ffffff' if row_index % 2 == 1 else '#f8f9fa') + '; border-top: 1px solid #e0e0e0;'">
                                                <td class="text-center" style="padding: 10px 8px; border-left: 1px solid #ddd; color: #666; font-size: 10px; font-weight: bold;">
                                                    <t t-esc="row_index"/>
                                                </td>
                                                <td style="padding: 10px 12px; border-left: 1px solid #ddd;">
                                                    <span t-if="line.product_id" t-field="line.product_id.name" style="font-weight: 600; color: #1a1a1a;"/>
                                                    <t t-if="line.product_code">
                                                        <br/><small class="text-muted" style="font-size: 9px;">كود: <span t-field="line.product_code"/></small>
                                                    </t>
                                                </td>
                                                <td class="text-end" style="padding: 10px 8px; border-left: 1px solid #ddd; font-size: 10px;">
                                                    <span t-if="line.warehouse_id" t-field="line.warehouse_id.name"/>
                                                </td>
                                                <td class="text-end" style="padding: 10px 8px; border-left: 1px solid #ddd; font-size: 10px;">
                                                    <span t-if="line.product_uom_id" t-field="line.product_uom_id.name"/>
                                                </td>
                                                <td class="text-end" style="padding: 10px 8px; border-left: 1px solid #ddd; font-size: 10px; font-weight: bold;">
                                                    <span t-field="line.quantity"/>
                                                </td>
                                                <td class="text-end" style="padding: 10px 8px; border-left: 1px solid #ddd; font-size: 10px;">
                                                    <span t-if="doc.currency_id" t-field="line.unit_price" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                                    <span t-if="not doc.currency_id" t-field="line.unit_price"/>
                                                </td>
                                                <td class="text-end" style="padding: 10px 8px; border-left: 1px solid #ddd; color: #dc2626; font-size: 10px; font-weight: bold;">
                                                    <span t-if="line.discount_percent &gt; 0" t-field="line.discount_percent"/>
                                                    <span t-if="line.discount_percent &gt; 0">%</span>
                                                    <span t-if="not (line.discount_percent &gt; 0)">-</span>
                                                </td>
                                                <td class="text-end" style="padding: 10px 8px; color: #16a34a; font-weight: bold; font-size: 11px;">
                                                    <span t-if="doc.currency_id" t-field="line.line_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                                    <span t-if="not doc.currency_id" t-field="line.line_total"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                    <tfoot>
                                        <tr style="background: linear-gradient(to left, #f8f9fa, white); border-top: 2px solid #ddd;">
                                            <td colspan="7" class="text-end" style="padding: 10px 15px;"><strong>المجموع الجزئي:</strong></td>
                                            <td class="text-end" style="padding: 10px 15px; font-weight: 600;">
                                                <span t-field="doc.amount_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr t-if="doc.amount_discount &gt; 0" style="background: linear-gradient(to left, #fff5f5, white); border-top: 1px solid #ddd;">
                                            <td colspan="7" class="text-end" style="padding: 10px 15px;"><strong>الخصم:</strong></td>
                                            <td class="text-end" style="padding: 10px 15px; color: #dc2626; font-weight: 600;">
                                                <span t-field="doc.amount_discount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr style="background: linear-gradient(135deg, #000, #1a1a1a); color: #d4af37; border-top: 3px solid #d4af37;">
                                            <td colspan="7" class="text-end" style="padding: 12px 15px; font-size: 15px;"><strong>💰 المجموع الكلي:</strong></td>
                                            <td class="text-end" style="padding: 12px 15px; font-size: 16px;">
                                                <strong>
                                                    <span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                                </strong>
                                            </td>
                                        </tr>
                                        <tr t-if="doc.amount_total_iqd" style="background: linear-gradient(to left, #fef3c7, #fef9e7); border-top: 2px solid #d4af37;">
                                            <td colspan="7" class="text-end" style="padding: 10px 15px;"><strong>💵 المجموع (دينار عراقي):</strong></td>
                                            <td class="text-end" style="padding: 10px 15px; color: #92400e; font-weight: 700;">
                                                <strong>
                                                    <span t-field="doc.amount_total_iqd" t-options='{"widget": "monetary", "display_currency": doc.currency_iqd_id}'/>
                                                </strong>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <!-- Notes -->
                            <div t-if="doc.note" class="mt-4" style="border: 2px solid #d4af37; background: linear-gradient(to bottom, #fffbeb, white); padding: 12px; border-radius: 8px;">
                                <strong style="color: #1a1a1a; font-size: 13px;">📝 ملاحظات:</strong>
                                <p t-field="doc.note" t-options='{"widget": "text"}' style="margin: 8px 0 0 0; font-size: 11px; color: #555; white-space: pre-line;"/>
                            </div>

                            <!-- Footer -->
                            <div class="mt-4" style="padding: 15px; background: linear-gradient(135deg, #1a1a1a, #000); border-radius: 8px; text-align: center; color: white; border: 2px solid #d4af37;">
                                <p style="margin: 0 0 8px 0; font-size: 15px; color: #d4af37; font-weight: bold;">
                                    ✨ شكراً لتعاملكم معنا ✨
                                </p>
                                <p style="margin: 0 0 6px 0; font-size: 11px; color: #ddd;" t-if="doc.company_id and doc.company_id.phone">
                                    للاستفسارات: <span t-field="doc.company_id.phone"/>
                                </p>
                                <p style="margin: 0; font-size: 9px; color: #999;">
                                    فاتورة صادرة من نظام محاسبة إلكتروني معتمد • Powered by Odoo
                                </p>
                            </div>
                        </main>
                    </div>
                </t>
            </t>
        </t>

        <!-- Report Action -->
        <record id="action_report_pos_perfume_order" model="ir.actions.report">
            <field name="name">طلب العطور (احترافي أسود)</field>
            <field name="model">pos.perfume.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">pos_perfume_custom.report_pos_perfume_order</field>
            <field name="report_file">pos_perfume_custom.report_pos_perfume_order</field>
            <field name="print_report_name">'طلب - %s' % (object.name)</field>
            <field name="paperformat_id" ref="base.paperformat_a4"/>
        </record>
    </data>
</odoo>

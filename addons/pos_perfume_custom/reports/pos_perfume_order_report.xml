<?xml version="1.0"?>
<odoo>
    <data>
        <template id="report_pos_perfume_order">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        <h2>
                            <span t-if="doc.state == 'draft'">مسودة طلب # </span>
                            <span t-elif="doc.state == 'sale'">فاتورة بيع # </span>
                            <span t-else="">طلب # </span>
                            <span t-field="doc.name"/>
                        </h2>
                        
                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>العميل:</strong>
                                <div t-if="doc.partner_id">
                                    <div><span t-field="doc.partner_id.name"/></div>
                                    <div t-if="doc.partner_id.phone">
                                        هاتف: <span t-field="doc.partner_id.phone"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div t-if="doc.date">
                                    <strong>التاريخ:</strong> <span t-field="doc.date"/>
                                </div>
                                <div t-if="doc.user_id">
                                    <strong>المندوب:</strong> <span t-field="doc.user_id.name"/>
                                </div>
                                <div t-if="doc.sap_doc_num">
                                    <strong>رقم SAP:</strong> <span t-field="doc.sap_doc_num"/>
                                </div>
                            </div>
                        </div>

                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th>ت</th>
                                    <th>المنتج</th>
                                    <th>الكمية</th>
                                    <th>السعر</th>
                                    <th>المجموع</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="line_num" t-value="0"/>
                                <tr t-foreach="doc.order_line_ids" t-as="line">
                                    <t t-set="line_num" t-value="line_num + 1"/>
                                    <td><t t-esc="line_num"/></td>
                                    <td><span t-field="line.product_id.name"/></td>
                                    <td><span t-field="line.quantity"/></td>
                                    <td><span t-field="line.unit_price"/></td>
                                    <td><span t-field="line.line_total"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row">
                            <div class="col-6 offset-6">
                                <table class="table table-sm">
                                    <tr>
                                        <td><strong>المجموع الجزئي:</strong></td>
                                        <td class="text-end"><span t-field="doc.amount_subtotal"/></td>
                                    </tr>
                                    <tr t-if="doc.amount_discount and doc.amount_discount > 0">
                                        <td><strong>الخصم:</strong></td>
                                        <td class="text-end"><span t-field="doc.amount_discount"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>المجموع الكلي:</strong></td>
                                        <td class="text-end"><strong><span t-field="doc.amount_total"/></strong></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div t-if="doc.note" class="mt-4">
                            <strong>ملاحظات:</strong>
                            <p><span t-field="doc.note"/></p>
                        </div>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>

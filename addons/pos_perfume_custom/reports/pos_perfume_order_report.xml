<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Template -->
    <template id="report_pos_perfume_order">
        <t t-call="web.external_layout">
            <t t-foreach="docs" t-as="doc">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang if doc.partner_id else None)" />
                <div class="page">
                    <main>
                    <div class="oe_structure"/>

                    <h2>
                        <span t-if="doc.state == 'draft'">Draft Order # </span>
                        <span t-elif="doc.state == 'quotation'">Quotation # </span>
                        <span t-elif="doc.state == 'sale'">Sale Order # </span>
                        <span t-else="">Order # </span>
                        <span t-field="doc.name">PO0000</span>
                    </h2>

                <div class="row mb-4" id="informations">
                    <div class="col-6">
                        <strong>Customer</strong>
                        <div t-field="doc.partner_id" 
                             t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}' />
                        <p t-if="doc.partner_id and doc.partner_id.phone" class="mb-0">
                            <i class="fa fa-phone"/> <span t-field="doc.partner_id.phone"/>
                        </p>
                        <p t-if="doc.partner_id and doc.partner_id.email" class="mb-0">
                            <i class="fa fa-envelope"/> <span t-field="doc.partner_id.email"/>
                        </p>
                    </div>
                    <div class="col-6">
                        <div t-if="doc.date" class="mb-2">
                            <strong>Order Date</strong>
                            <div t-field="doc.date" t-options='{"widget": "datetime"}'/>
                        </div>
                        <div t-if="doc.user_id" class="mb-2">
                            <strong>Salesperson</strong>
                            <div t-field="doc.user_id"/>
                        </div>
                    </div>
                </div>

                <div class="oe_structure"></div>
                <table class="o_has_total_table table o_main_table table-borderless">
                    <thead style="display: table-row-group">
                        <tr>
                            <th class="text-start">Product</th>
                            <th class="text-end">Warehouse</th>
                            <th class="text-end">UoM</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Disc.%</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.order_line_ids" t-as="line">
                            <tr>
                                <td>
                                    <span t-if="line.product_id" t-field="line.product_id.name"/>
                                    <t t-if="line.product_code">
                                        <br/><small class="text-muted">Code: <span t-field="line.product_code"/></small>
                                    </t>
                                </td>
                                <td class="text-end">
                                    <span t-if="line.warehouse_id" t-field="line.warehouse_id.name"/>
                                </td>
                                <td class="text-end">
                                    <span t-if="line.product_uom_id" t-field="line.product_uom_id.name"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.quantity"/>
                                </td>
                                <td class="text-end">
                                    <span t-if="doc.currency_id" t-field="line.unit_price" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    <span t-if="not doc.currency_id" t-field="line.unit_price"/>
                                </td>
                                <td class="text-end">
                                    <span t-if="line.discount_percent > 0" t-field="line.discount_percent"/>%
                                </td>
                                <td class="text-end">
                                    <span t-if="doc.currency_id" t-field="line.line_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    <span t-if="not doc.currency_id" t-field="line.line_total"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="6" class="text-end"><strong>Subtotal:</strong></td>
                            <td class="text-end">
                                <span t-field="doc.amount_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                        </tr>
                        <tr t-if="doc.amount_discount > 0">
                            <td colspan="6" class="text-end"><strong>Discount:</strong></td>
                            <td class="text-end">
                                <span t-field="doc.amount_discount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6" class="text-end"><strong>Total:</strong></td>
                            <td class="text-end">
                                <strong>
                                    <span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </strong>
                            </td>
                        </tr>
                        <tr t-if="doc.amount_total_iqd">
                            <td colspan="6" class="text-end"><strong>Total (IQD):</strong></td>
                            <td class="text-end">
                                <strong>
                                    <span t-field="doc.amount_total_iqd" t-options='{"widget": "monetary", "display_currency": doc.currency_iqd_id}'/>
                                </strong>
                            </td>
                        </tr>
                    </tfoot>
                </table>

                <div t-if="doc.note" class="mt-4">
                    <strong>Notes:</strong>
                    <p t-field="doc.note" t-options='{"widget": "text"}'/>
                </div>
                    </main>
            </div>
            </t>
        </t>
    </template>

    <!-- Report Action -->
    <record id="action_report_pos_perfume_order" model="ir.actions.report">
        <field name="name">POS Perfume Order</field>
        <field name="model">pos.perfume.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_perfume_custom.report_pos_perfume_order</field>
        <field name="report_file">pos_perfume_custom.report_pos_perfume_order</field>
        <field name="print_report_name">'Order - %s' % (object.name)</field>
    </record>

</odoo>

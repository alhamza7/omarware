<?xml version="1.0"?>
<odoo>
    <data noupdate="0">
        <!-- Simple POS Order Report Template -->
        <template id="report_pos_perfume_order_simple">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="oe_structure"/>
                    
                    <!-- Header -->
                    <h2>
                        <span t-if="o.state == 'quotation'">Quotation</span>
                        <span t-elif="o.state == 'sale'">Order</span>
                        <span t-else="">Order</span>
                        <span t-field="o.name"/>
                    </h2>
                    
                    <!-- Order Info -->
                    <div class="row mt-4 mb-4">
                        <div class="col-6">
                            <strong>Customer:</strong><br/>
                            <address t-field="o.partner_id" 
                                t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                            <div t-if="o.partner_id.phone">
                                <i class="fa fa-phone"/> <span t-field="o.partner_id.phone"/>
                            </div>
                        </div>
                        <div class="col-6">
                            <strong>Order Date:</strong> <span t-field="o.date"/><br/>
                            <strong>Salesperson:</strong> <span t-field="o.user_id"/><br/>
                            <div t-if="o.sap_doc_num">
                                <strong>SAP Document:</strong> <span t-field="o.sap_doc_num"/>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Order Lines -->
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th class="text-left">Product</th>
                                <th class="text-right">Quantity</th>
                                <th class="text-right">Unit Price</th>
                                <th class="text-right">Disc %</th>
                                <th class="text-right">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.order_line_ids" t-as="line">
                                <tr>
                                    <td>
                                        <span t-if="line.custom_product_name" t-field="line.custom_product_name"/>
                                        <span t-else="" t-field="line.product_id.name"/>
                                        <div class="text-muted small" t-if="line.product_code">
                                            Code: <span t-field="line.product_code"/>
                                        </div>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.quantity"/>
                                        <span t-field="line.product_uom_id.name" class="small"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.unit_price" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.discount_percent"/>%
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.line_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    
                    <!-- Totals -->
                    <div class="clearfix">
                        <div class="row">
                            <div class="col-6"/>
                            <div class="col-6">
                                <table class="table table-sm">
                                    <tr>
                                        <td><strong>Subtotal:</strong></td>
                                        <td class="text-right">
                                            <span t-field="o.amount_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.amount_discount > 0">
                                        <td><strong>Discount:</strong></td>
                                        <td class="text-right">
                                            -<span t-field="o.amount_discount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr class="border-black">
                                        <td><strong>Total:</strong></td>
                                        <td class="text-right">
                                            <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.amount_total_iqd > 0">
                                        <td><strong>Total (IQD):</strong></td>
                                        <td class="text-right">
                                            <span t-esc="'{:,.0f}'.format(o.amount_total_iqd)"/> IQD
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Notes -->
                    <div t-if="o.note" class="mt-4">
                        <strong>Notes:</strong>
                        <p t-field="o.note"/>
                    </div>
                    
                    <div class="oe_structure"/>
                </div>
            </t>
        </template>

        <!-- Main report wrapper -->
        <template id="report_pos_perfume_order">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="pos_perfume_custom.report_pos_perfume_order_simple"/>
                </t>
            </t>
        </template>
    </data>
</odoo>

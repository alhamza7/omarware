<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Report Action -->
        <record id="action_report_pos_perfume_arabic" model="ir.actions.report">
            <field name="name">فاتورة POS</field>
            <field name="model">pos.perfume.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">pos_perfume_custom.pos_order_arabic_document</field>
            <field name="print_report_name">'Invoice_%s' % (object.name)</field>
            <field name="binding_model_id" ref="model_pos_perfume_order"/>
            <field name="binding_type">report</field>
        </record>

        <!-- Main Template -->
        <template id="pos_order_arabic_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <div class="article o_report_layout_standard" style="direction: rtl; font-family: 'DejaVu Sans', 'Arial', sans-serif; padding: 20px; width: 100%; box-sizing: border-box;">
                    
                    <!-- Header -->
                    <table style="width: 100%; margin-bottom: 20px; border-bottom: 3px solid #2c3e50; border-collapse: collapse; table-layout: fixed;">
                        <tr>
                            <td style="width: 30%; vertical-align: middle;">
                                <img t-if="o.env.company.logo" 
                                     t-att-src="image_data_uri(o.env.company.logo)"
                                     style="max-height: 100px; max-width: 200px;"/>
                            </td>
                            <td style="width: 70%; text-align: center; vertical-align: middle;">
                                <h2 style="margin: 5px 0; color: #2c3e50; font-size: 22px;">
                                    <t t-esc="o.env.company.name"/>
                                </h2>
                                <h1 style="margin: 10px 0; color: #3498db; font-size: 26px;">
                                    <t t-if="o.state == 'quotation'">عرض سعر</t>
                                    <t t-elif="o.state == 'sale'">فاتورة</t>
                                    <t t-else="">طلب</t>
                                </h1>
                            </td>
                        </tr>
                    </table>
                    
                    <!-- Order Info -->
                    <table style="width: 100%; margin-bottom: 20px; border-collapse: separate; border-spacing: 12px 0; table-layout: fixed;">
                        <tr>
                            <td style="width: 50%; padding: 0; vertical-align: top;">
                                <table style="width: 100%; border: 2px solid #2c3e50; background: #ecf0f1; border-collapse: collapse; table-layout: fixed;">
                                    <tr>
                                        <td style="padding: 10px; width: 40%; text-align: right; border-bottom: 1px solid #bdc3c7; white-space: nowrap;"><strong>رقم الطلب:</strong></td>
                                        <td style="padding: 10px; text-align: center; border-bottom: 1px solid #bdc3c7; font-weight: bold;"><span style="direction:ltr; unicode-bidi:bidi-override; display:inline-block;"><t t-esc="o.name"/></span></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 10px; text-align: right; border-bottom: 1px solid #bdc3c7; white-space: nowrap;"><strong>التاريخ:</strong></td>
                                        <td style="padding: 10px; text-align: center; border-bottom: 1px solid #bdc3c7;"><span style="direction:ltr; unicode-bidi:bidi-override; display:inline-block;"><t t-esc="o.date.strftime('%Y-%m-%d') if o.date else ''"/></span></td>
                                    </tr>
                                    <tr t-if="o.sap_doc_num">
                                        <td style="padding: 10px; text-align: right; background: #d5f4e6; white-space: nowrap;"><strong style="color: #27ae60;">رقم فاتورة SAP:</strong></td>
                                        <td style="padding: 10px; text-align: center; background: #d5f4e6; font-weight: bold; font-size: 18px; color: #27ae60;"><span style="direction:ltr; unicode-bidi:bidi-override; display:inline-block;"><t t-esc="o.sap_doc_num"/></span></td>
                                    </tr>
                                </table>
                            </td>
                            <td style="width: 50%; padding: 0; vertical-align: top;">
                                <table style="width: 100%; border: 2px solid #2c3e50; background: #ecf0f1; border-collapse: collapse; table-layout: fixed;">
                                    <tr>
                                        <td style="padding: 10px; width: 40%; text-align: right; border-bottom: 1px solid #bdc3c7; white-space: nowrap;"><strong>البائع:</strong></td>
                                        <td style="padding: 10px; text-align: center; border-bottom: 1px solid #bdc3c7;"><t t-esc="o.user_id.name"/></td>
                                    </tr>
                                    <tr t-if="o.invoice_type">
                                        <td style="padding: 10px; text-align: right; border-bottom: 1px solid #bdc3c7; white-space: nowrap;"><strong>نوع الفاتورة:</strong></td>
                                        <td style="padding: 10px; text-align: center; border-bottom: 1px solid #bdc3c7;"><t t-esc="dict(o._fields['invoice_type'].selection).get(o.invoice_type, '')"/></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                    
                    <!-- Customer Info -->
                    <div style="background: #ecf0f1; padding: 15px; border: 2px solid #2c3e50; margin-bottom: 20px;">
                        <h4 style="margin: 0 0 10px 0; padding-bottom: 8px; border-bottom: 2px solid #2c3e50; text-align: right;">معلومات العميل</h4>
                        <table style="width: 100%;">
                            <tr>
                                <td style="width: 15%; text-align: right; padding: 5px;"><strong>الاسم:</strong></td>
                                <td style="width: 35%; text-align: right; padding: 5px;"><t t-esc="o.partner_id.name"/></td>
                                <td style="width: 15%; text-align: right; padding: 5px;" t-if="o.partner_id.phone"><strong>الهاتف:</strong></td>
                                <td style="width: 35%; text-align: right; padding: 5px;" t-if="o.partner_id.phone"><t t-esc="o.partner_id.phone"/></td>
                            </tr>
                            <tr t-if="o.partner_id.street">
                                <td style="text-align: right; padding: 5px;"><strong>العنوان:</strong></td>
                                <td colspan="3" style="text-align: right; padding: 5px;"><t t-esc="o.partner_id.street"/></td>
                            </tr>
                        </table>
                    </div>
                    
                    <!-- Products Table -->
                    <div style="margin-bottom: 20px;">
                        <h4 style="margin: 0 0 10px 0; padding-bottom: 8px; border-bottom: 2px solid #2c3e50; text-align: right;">تفاصيل الطلب</h4>
                        <table style="width: 100%; border: 2px solid #2c3e50; border-collapse: collapse;">
                            <thead style="background: #34495e; color: white;">
                                <tr>
                                    <th style="padding: 10px; text-align: center; width: 5%;">#</th>
                                    <th style="padding: 10px; text-align: right; width: 42%;">اسم المنتج</th>
                                    <th style="padding: 10px; text-align: center; width: 13%;">الكمية</th>
                                    <th style="padding: 10px; text-align: center; width: 13%;">السعر</th>
                                    <th style="padding: 10px; text-align: center; width: 10%;">الخصم %</th>
                                    <th style="padding: 10px; text-align: center; width: 17%;">المجموع</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="line_num" t-value="0"/>
                                <tr t-foreach="o.order_line_ids" t-as="line">
                                    <t t-set="line_num" t-value="line_num + 1"/>
                                    <td style="padding: 8px; text-align: center; border: 1px solid #bdc3c7; background: #ecf0f1; font-weight: bold;">
                                        <t t-esc="line_num"/>
                                    </td>
                                    <td style="padding: 8px; text-align: right; border: 1px solid #bdc3c7;">
                                        <strong><t t-if="line.custom_product_name" t-esc="line.custom_product_name"/><t t-else="" t-esc="line.product_id.name"/></strong>
                                        <br t-if="line.product_code"/>
                                        <small style="color: #7f8c8d;" t-if="line.product_code">كود: <t t-esc="line.product_code"/></small>
                                    </td>
                                    <td style="padding: 8px; text-align: center; border: 1px solid #bdc3c7;">
                                        <t t-esc="'{:.2f}'.format(line.quantity)"/> <t t-esc="line.product_uom_id.name"/>
                                    </td>
                                    <td style="padding: 8px; text-align: center; border: 1px solid #bdc3c7;">
                                        $<t t-esc="'{:.2f}'.format(line.unit_price)"/>
                                    </td>
                                    <td style="padding: 8px; text-align: center; border: 1px solid #bdc3c7;">
                                        <t t-if="line.discount_percent &gt; 0"><strong style="color: #e74c3c;"><t t-esc="'{:.0f}'.format(line.discount_percent)"/>%</strong></t>
                                        <t t-else="">-</t>
                                    </td>
                                    <td style="padding: 8px; text-align: center; border: 1px solid #bdc3c7; background: #ecf0f1; font-weight: bold;">
                                        $<t t-esc="'{:.2f}'.format(line.line_total)"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    
                    <!-- Totals + Notes (NO floats to avoid overlap in wkhtmltopdf) -->
                    <table style="width: 100%; margin-bottom: 20px; border-collapse: separate; border-spacing: 12px 0; table-layout: fixed;">
                        <tr>
                            <!-- Totals (right side in RTL) -->
                            <td style="width: 50%; padding: 0; vertical-align: top;">
                                <table style="width: 100%; border: 2px solid #2c3e50; border-collapse: collapse; table-layout: fixed;">
                                    <tr style="background: #ecf0f1;">
                                        <td style="padding: 10px; text-align: right; border-bottom: 1px solid #bdc3c7; white-space: nowrap;"><strong>المجموع الفرعي:</strong></td>
                                        <td style="padding: 10px; text-align: center; border-bottom: 1px solid #bdc3c7; font-weight: bold;">
                                            <span style="direction:ltr; unicode-bidi:bidi-override; display:inline-block;">$<t t-esc="'{:.2f}'.format(o.amount_subtotal)"/></span>
                                        </td>
                                    </tr>
                                    <tr t-if="o.amount_discount &gt; 0" style="background: #ecf0f1;">
                                        <td style="padding: 10px; text-align: right; border-bottom: 1px solid #bdc3c7; white-space: nowrap;"><strong style="color: #e74c3c;">الخصم:</strong></td>
                                        <td style="padding: 10px; text-align: center; border-bottom: 1px solid #bdc3c7; color: #e74c3c; font-weight: bold;">
                                            <span style="direction:ltr; unicode-bidi:bidi-override; display:inline-block;">-$<t t-esc="'{:.2f}'.format(o.amount_discount)"/></span>
                                        </td>
                                    </tr>
                                    <tr style="background: #3498db; color: white;">
                                        <td style="padding: 12px; text-align: right; white-space: nowrap;"><strong style="font-size: 16px;">المجموع الكلي:</strong></td>
                                        <td style="padding: 12px; text-align: center;"><strong style="font-size: 18px;">
                                            <span style="direction:ltr; unicode-bidi:bidi-override; display:inline-block;">$<t t-esc="'{:.2f}'.format(o.amount_total)"/></span>
                                        </strong></td>
                                    </tr>
                                    <tr style="background: #27ae60; color: white;">
                                        <td style="padding: 12px; text-align: right; white-space: nowrap;"><strong>المجموع بالدينار:</strong></td>
                                        <td style="padding: 12px; text-align: center;"><strong style="font-size: 17px;">
                                            <span style="direction:ltr; unicode-bidi:bidi-override; display:inline-block;"><t t-esc="'{:,.0f}'.format(o.amount_total_iqd)"/></span> د.ع
                                        </strong></td>
                                    </tr>
                                </table>
                            </td>
                            <!-- Notes -->
                            <td style="width: 50%; padding: 0; vertical-align: top;">
                                <div t-if="o.note" style="border: 2px solid #f39c12; background: #fef5e7; padding: 12px; min-height: 110px; box-sizing: border-box;">
                                    <strong style="color: #d68910;">ملاحظات:</strong>
                                    <p style="margin: 8px 0 0 0; color: #7d6608; text-align: right;"><t t-esc="o.note"/></p>
                                </div>
                            </td>
                        </tr>
                    </table>
                    
                    <!-- Footer -->
                    <div style="margin-top: 40px; padding-top: 15px; border-top: 3px solid #2c3e50; text-align: center;">
                        <p style="margin: 5px 0; font-size: 16px; color: #3498db; font-weight: bold;">شكراً لتعاملكم معنا</p>
                        <p style="margin: 5px 0; font-size: 13px; color: #95a5a6;">Thank you for your business</p>
                    </div>
                    
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>


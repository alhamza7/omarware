<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Paperformat: add extra right margin to avoid RTL clipping in wkhtmltopdf -->
        <record id="paperformat_pos_perfume_rtl" model="report.paperformat">
            <field name="name">POS Perfume RTL</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">15</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <!-- Report Action -->
        <record id="action_report_pos_perfume_arabic" model="ir.actions.report">
            <field name="name">فاتورة POS</field>
            <field name="model">pos.perfume.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">pos_perfume_custom.pos_order_arabic_document</field>
            <field name="print_report_name">'Invoice_%s' % (object.name)</field>
            <field name="binding_model_id" ref="model_pos_perfume_order"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="pos_perfume_custom.paperformat_pos_perfume_rtl"/>
        </record>

        <!-- Main Template -->
        <template id="pos_order_arabic_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <!-- Use a fixed-width container (mm) to keep ALL blocks aligned consistently in wkhtmltopdf -->
                    <div style="direction: rtl; font-family: 'DejaVu Sans', 'Arial', sans-serif; width: 100%; box-sizing: border-box; line-height: 1.45;">
                    <div class="pos_container" style="width: 180mm; margin: 0 auto; padding: 0 4mm; box-sizing: border-box;">

                    <!-- PDF-safe styling (avoid overlap in wkhtmltopdf) -->
                    <style type="text/css">
                        .pos_pdf_safe * { box-sizing: border-box; }
                        .pos_pdf_safe { direction: rtl; }
                        /* IMPORTANT: don't force table-layout:fixed on ALL tables (wkhtmltopdf can miscompute widths in RTL) */
                        .pos_pdf_safe table { width: 100%; border-collapse: collapse; }
                        .pos_pdf_safe td, .pos_pdf_safe th {
                            vertical-align: top;
                            word-wrap: break-word;
                            word-break: break-word;
                            white-space: normal;
                            overflow: visible; /* IMPORTANT: avoid clipping RTL glyphs */
                        }
                        .pos_ltr_num { direction: ltr; unicode-bidi: bidi-override; display: inline-block; }
                        /* Don't clip containers, let content expand vertically */
                        .pos_box { background: #ecf0f1; border: 2px solid #2c3e50; padding: 12px 14px; overflow: visible; width: 100%; }
                        /* Small info tables: let browser size columns naturally */
                        .pos_box table { table-layout: auto; }
                        .pos_title { margin: 0; color: #3498db; font-size: 24px; font-weight: 700; }
                        .pos_company { margin: 0; color: #2c3e50; font-size: 20px; font-weight: 700; }
                        .pos_section_h { margin: 0 0 8px 0; padding-bottom: 6px; border-bottom: 2px solid #2c3e50; text-align: right; font-size: 16px; color: #2c3e50; }
                        /* Use fixed px label width for PDF stability */
                        .pos_cell_label { width: 120px; text-align: right; padding: 8px; border-bottom: 1px solid #bdc3c7; }
                        .pos_cell_value { text-align: center; padding: 8px; border-bottom: 1px solid #bdc3c7; }
                        .pos_no_border_bottom { border-bottom: none !important; }
                        /* IMPORTANT: give right padding in RTL so labels don't touch border and get clipped */
                        .pos_field_label { width: 110px; padding: 6px 12px; text-align: right; white-space: nowrap; }
                        .pos_field_value { padding: 6px 12px; text-align: right; word-wrap: break-word; word-break: break-word; }
                        .pos_table_head th { font-size: 13px; padding: 8px 6px !important; }
                        .pos_table_body td { font-size: 13px; padding: 8px 6px !important; }
                        .pos_td_num { text-align: center; }
                        .pos_td_name { text-align: right; }
                        .pos_products { table-layout: fixed; }
                        .pos_totals { table-layout: fixed; }
                    </style>

                    <div class="pos_pdf_safe">
                    
                    <!-- Header -->
                    <table style="margin-bottom: 18px; border-bottom: 3px solid #2c3e50;">
                        <tr>
                            <td style="width: 30%; vertical-align: middle; text-align: right; padding-bottom: 8px; padding-right: 6px;">
                                <img t-if="o.env.company.logo" 
                                     t-att-src="image_data_uri(o.env.company.logo)"
                                     style="max-height: 100px; max-width: 200px;"/>
                            </td>
                            <td style="width: 70%; text-align: center; vertical-align: middle; padding-bottom: 8px;">
                                <h2 class="pos_company">
                                    <t t-esc="o.env.company.name"/>
                                </h2>
                                <h1 class="pos_title">
                                    <t t-if="o.state == 'quotation'">عرض سعر</t>
                                    <t t-elif="o.state == 'sale'">فاتورة</t>
                                    <t t-else="">طلب</t>
                                </h1>
                            </td>
                        </tr>
                    </table>
                    
                    <!-- Order Info (no cell padding on columns; use inner margin to avoid overflow) -->
                    <table style="margin-bottom: 18px; table-layout: fixed;">
                        <tr>
                            <td style="width: 50%; padding: 0 6px 0 0; vertical-align: top;">
                                <div class="pos_box">
                                <table>
                                    <tr>
                                        <td class="pos_cell_label"><strong>رقم الطلب:</strong></td>
                                        <td class="pos_cell_value" style="font-weight: bold;"><span class="pos_ltr_num"><t t-esc="o.name"/></span></td>
                                    </tr>
                                    <tr>
                                        <td class="pos_cell_label"><strong>التاريخ:</strong></td>
                                        <td class="pos_cell_value"><span class="pos_ltr_num"><t t-esc="o.date.strftime('%Y-%m-%d') if o.date else ''"/></span></td>
                                    </tr>
                                    <tr t-if="o.sap_doc_num">
                                        <td class="pos_cell_label pos_no_border_bottom" style="background:#d5f4e6;"><strong style="color:#27ae60;">رقم فاتورة SAP:</strong></td>
                                        <td class="pos_cell_value pos_no_border_bottom" style="background:#d5f4e6; font-weight: bold; font-size: 18px; color:#27ae60;"><span class="pos_ltr_num"><t t-esc="o.sap_doc_num"/></span></td>
                                    </tr>
                                </table>
                                </div>
                            </td>
                            <td style="width: 50%; padding: 0 0 0 6px; vertical-align: top;">
                                <div class="pos_box">
                                <table>
                                    <tr>
                                        <td class="pos_cell_label"><strong>البائع:</strong></td>
                                        <td class="pos_cell_value"><t t-esc="o.user_id.name"/></td>
                                    </tr>
                                    <tr t-if="o.invoice_type">
                                        <td class="pos_cell_label pos_no_border_bottom"><strong>نوع الفاتورة:</strong></td>
                                        <td class="pos_cell_value pos_no_border_bottom"><t t-esc="dict(o._fields['invoice_type'].selection).get(o.invoice_type, '')"/></td>
                                    </tr>
                                </table>
                                </div>
                            </td>
                        </tr>
                    </table>
                    
                    <!-- Customer Info -->
                    <div class="pos_box" style="margin-bottom: 18px;">
                        <h4 class="pos_section_h">معلومات العميل</h4>
                        <table style="width: 100%; border-collapse: collapse; table-layout: fixed;">
                            <tr>
                                <td class="pos_field_label"><strong>الاسم:</strong></td>
                                <td class="pos_field_value"><t t-esc="o.partner_id.name"/></td>
                                <td class="pos_field_label"><strong>الهاتف:</strong></td>
                                <td class="pos_field_value">
                                    <t t-if="o.partner_id.phone">
                                        <span class="pos_ltr_num"><t t-esc="o.partner_id.phone"/></span>
                                    </t>
                                    <!-- NOTE: XML doesn't support &nbsp; entity, use numeric nbsp instead -->
                                    <t t-else="">&#160;</t>
                                </td>
                            </tr>
                            <tr t-if="o.partner_id.street">
                                <td class="pos_field_label"><strong>العنوان:</strong></td>
                                <td class="pos_field_value" colspan="3"><t t-esc="o.partner_id.street"/></td>
                            </tr>
                        </table>
                    </div>
                    
                    <!-- Products Table -->
                    <div style="margin-bottom: 20px;">
                        <h4 class="pos_section_h">تفاصيل الطلب</h4>
                        <table class="pos_products" style="width: 100%; border: 2px solid #2c3e50; border-collapse: collapse;">
                            <colgroup>
                                <col style="width:34px;"/>
                                <col/> <!-- اسم المنتج -->
                                <col style="width:90px;"/>
                                <col style="width:90px;"/>
                                <col style="width:80px;"/>
                                <col style="width:110px;"/>
                            </colgroup>
                            <thead class="pos_table_head" style="background: #34495e; color: white;">
                                <tr>
                                    <th style="text-align: center; width: 34px;">#</th>
                                    <th style="text-align: right;">اسم المنتج</th>
                                    <th style="text-align: center; width: 90px;">الكمية</th>
                                    <th style="text-align: center; width: 90px;">السعر</th>
                                    <th style="text-align: center; width: 80px;">الخصم %</th>
                                    <th style="text-align: center; width: 110px;">المجموع</th>
                                </tr>
                            </thead>
                            <tbody class="pos_table_body">
                                <t t-set="line_num" t-value="0"/>
                                <tr t-foreach="o.order_line_ids" t-as="line">
                                    <t t-set="line_num" t-value="line_num + 1"/>
                                    <td class="pos_td_num" style="border: 1px solid #bdc3c7; background: #ecf0f1; font-weight: bold;">
                                        <t t-esc="line_num"/>
                                    </td>
                                    <td class="pos_td_name" style="border: 1px solid #bdc3c7;">
                                        <div style="font-weight: 700;">
                                            <t t-if="line.custom_product_name" t-esc="line.custom_product_name"/>
                                            <t t-else="" t-esc="line.product_id.name"/>
                                        </div>
                                        <div t-if="line.product_code" style="color: #7f8c8d; font-size: 11px; margin-top: 2px;">
                                            كود: <span class="pos_ltr_num"><t t-esc="line.product_code"/></span>
                                        </div>
                                    </td>
                                    <td class="pos_td_num" style="border: 1px solid #bdc3c7;">
                                        <span class="pos_ltr_num"><t t-esc="'{:.2f}'.format(line.quantity)"/></span>
                                        <div style="font-size: 11px; color: #2c3e50; margin-top: 2px;">
                                            <t t-esc="line.product_uom_id.name"/>
                                        </div>
                                    </td>
                                    <td class="pos_td_num" style="border: 1px solid #bdc3c7;">
                                        <span class="pos_ltr_num">$<t t-esc="'{:.2f}'.format(line.unit_price)"/></span>
                                    </td>
                                    <td class="pos_td_num" style="border: 1px solid #bdc3c7;">
                                        <t t-if="line.discount_percent &gt; 0"><strong style="color: #e74c3c;"><t t-esc="'{:.0f}'.format(line.discount_percent)"/>%</strong></t>
                                        <t t-else="">-</t>
                                    </td>
                                    <td class="pos_td_num" style="border: 1px solid #bdc3c7; background: #ecf0f1; font-weight: bold;">
                                        <span class="pos_ltr_num">$<t t-esc="'{:.2f}'.format(line.line_total)"/></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    
                    <!-- Totals + Notes (NO floats / NO border-spacing to avoid overlap in wkhtmltopdf) -->
                    <table style="width: 100%; margin-bottom: 20px; table-layout: fixed;">
                        <tr>
                            <!-- Totals (right side in RTL) -->
                            <td style="width: 50%; padding: 0 0 0 6px; vertical-align: top;">
                                <div>
                                <table class="pos_totals" style="width: 100%; border: 2px solid #2c3e50; border-collapse: collapse;">
                                    <tr style="background: #ecf0f1;">
                                        <td style="padding: 10px; width: 55%; text-align: right; border-bottom: 1px solid #bdc3c7;"><strong>المجموع الفرعي:</strong></td>
                                        <td style="padding: 10px; text-align: center; border-bottom: 1px solid #bdc3c7; font-weight: bold;">
                                            <span class="pos_ltr_num">$<t t-esc="'{:.2f}'.format(o.amount_subtotal)"/></span>
                                        </td>
                                    </tr>
                                    <tr t-if="o.amount_discount &gt; 0" style="background: #ecf0f1;">
                                        <td style="padding: 10px; width: 55%; text-align: right; border-bottom: 1px solid #bdc3c7;"><strong style="color: #e74c3c;">الخصم:</strong></td>
                                        <td style="padding: 10px; text-align: center; border-bottom: 1px solid #bdc3c7; color: #e74c3c; font-weight: bold;">
                                            <span class="pos_ltr_num">-$<t t-esc="'{:.2f}'.format(o.amount_discount)"/></span>
                                        </td>
                                    </tr>
                                    <tr style="background: #3498db; color: white;">
                                        <td style="padding: 12px; width: 55%; text-align: right;"><strong style="font-size: 16px;">المجموع الكلي:</strong></td>
                                        <td style="padding: 12px; text-align: center;"><strong style="font-size: 18px;">
                                            <span class="pos_ltr_num">$<t t-esc="'{:.2f}'.format(o.amount_total)"/></span>
                                        </strong></td>
                                    </tr>
                                    <tr style="background: #27ae60; color: white;">
                                        <td style="padding: 12px; width: 55%; text-align: right;"><strong>المجموع بالدينار:</strong></td>
                                        <td style="padding: 12px; text-align: center;"><strong style="font-size: 17px;">
                                            <span class="pos_ltr_num"><t t-esc="'{:,.0f}'.format(o.amount_total_iqd)"/></span> د.ع
                                        </strong></td>
                                    </tr>
                                </table>
                                </div>
                            </td>
                            <!-- Notes -->
                            <td style="width: 50%; padding: 0 6px 0 0; vertical-align: top;">
                                <div>
                                <div t-if="o.note" style="border: 2px solid #f39c12; background: #fef5e7; padding: 12px; min-height: 110px; box-sizing: border-box;">
                                    <strong style="color: #d68910;">ملاحظات:</strong>
                                    <p style="margin: 8px 0 0 0; color: #7d6608; text-align: right;"><t t-esc="o.note"/></p>
                                </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                    
                    <!-- Footer -->
                    <div style="margin-top: 40px; padding-top: 15px; border-top: 3px solid #2c3e50; text-align: center;">
                        <p style="margin: 5px 0; font-size: 16px; color: #3498db; font-weight: bold;">شكراً لتعاملكم معنا</p>
                        <p style="margin: 5px 0; font-size: 13px; color: #95a5a6;">Thank you for your business</p>
                    </div>
                    
                    </div>
                    </div>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>


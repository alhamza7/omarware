<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!--     POS Perfume Order - Simple Default Report (Odoo Style)   -->
    <!-- ============================================================ -->
    
    <!-- Report Action -->
    <record id="action_report_pos_perfume_order_simple" model="ir.actions.report">
        <field name="name">POS Order Receipt</field>
        <field name="model">pos.perfume.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_perfume_custom.report_pos_perfume_order_simple</field>
        <field name="report_file">pos_perfume_custom.report_pos_perfume_order_simple</field>
        <field name="print_report_name">'Order - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_pos_perfume_order"/>
        <field name="binding_type">report</field>
    </record>
    
    <!-- Report Template -->
    <template id="report_pos_perfume_order_simple">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" dir="rtl" style="font-family: 'Arial', 'Tahoma', sans-serif;">
                        
                        <!-- Header with Logo and Title -->
                        <div class="row" style="border-bottom: 3px solid #667eea; padding-bottom: 15px; margin-bottom: 20px;">
                            <div class="col-12 text-center">
                                <h1 style="color: #667eea; font-weight: bold; margin-bottom: 10px;">
                                    <span t-if="o.state == 'quotation'">عرض سعر</span>
                                    <span t-elif="o.state == 'sale'">فاتورة</span>
                                    <span t-else="">طلب مبدئي</span>
                                </h1>
                            </div>
                        </div>
                        
                        <!-- Order Info Cards -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; border-right: 4px solid #667eea;">
                                    <div style="margin-bottom: 8px;">
                                        <strong style="color: #667eea;">رقم الطلب:</strong>
                                        <span t-field="o.name" style="font-size: 16px; font-weight: bold;"/>
                                    </div>
                                    <div style="margin-bottom: 8px;">
                                        <strong style="color: #667eea;">التاريخ:</strong>
                                        <span t-field="o.date" t-options="{'widget': 'date'}"/>
                                    </div>
                                    <div t-if="o.sap_doc_number" style="margin-bottom: 8px;">
                                        <strong style="color: #28a745;">رقم فاتورة SAP:</strong>
                                        <span t-field="o.sap_doc_number" style="font-weight: bold; color: #28a745;"/>
                                    </div>
                                    <div t-if="o.sap_doc_entry" style="margin-bottom: 8px;">
                                        <strong style="color: #666;">SAP Doc Entry:</strong>
                                        <span t-field="o.sap_doc_entry"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; border-right: 4px solid #28a745;">
                                    <div style="margin-bottom: 8px;">
                                        <strong style="color: #28a745;">البائع:</strong>
                                        <span t-field="o.user_id.name"/>
                                    </div>
                                    <div t-if="o.invoice_type" style="margin-bottom: 8px;">
                                        <strong style="color: #28a745;">نوع الفاتورة:</strong>
                                        <span t-field="o.invoice_type"/>
                                    </div>
                                    <div t-if="o.exchange_rate" style="margin-bottom: 8px;">
                                        <strong style="color: #666;">سعر الصرف:</strong>
                                        <span t-field="o.exchange_rate"/> IQD/USD
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Customer Info -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div style="background: #fff; padding: 15px; border: 2px solid #e9ecef; border-radius: 8px;">
                                    <h4 style="color: #667eea; margin-bottom: 10px; border-bottom: 2px solid #e9ecef; padding-bottom: 5px;">
                                        معلومات العميل
                                    </h4>
                                    <div class="row">
                                        <div class="col-6">
                                            <strong>الاسم:</strong> <span t-field="o.partner_id.name"/>
                                        </div>
                                        <div class="col-6" t-if="o.partner_id.phone">
                                            <strong>الهاتف:</strong> <span t-field="o.partner_id.phone"/>
                                        </div>
                                    </div>
                                    <div class="row mt-2" t-if="o.partner_id.street">
                                        <div class="col-12">
                                            <strong>العنوان:</strong> <span t-field="o.partner_id.street"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Order Lines Table -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h4 style="color: #667eea; margin-bottom: 15px; border-bottom: 2px solid #e9ecef; padding-bottom: 5px;">
                                    تفاصيل الطلب
                                </h4>
                                <table class="table table-bordered" style="border: 2px solid #e9ecef;">
                                    <thead style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                                        <tr>
                                            <th class="text-center" style="padding: 12px; border: 1px solid rgba(255,255,255,0.3);">#</th>
                                            <th class="text-right" style="padding: 12px; border: 1px solid rgba(255,255,255,0.3);">اسم المنتج</th>
                                            <th class="text-center" style="padding: 12px; border: 1px solid rgba(255,255,255,0.3);">الكمية</th>
                                            <th class="text-center" style="padding: 12px; border: 1px solid rgba(255,255,255,0.3);">السعر</th>
                                            <th class="text-center" style="padding: 12px; border: 1px solid rgba(255,255,255,0.3);">الخصم %</th>
                                            <th class="text-center" style="padding: 12px; border: 1px solid rgba(255,255,255,0.3);">المجموع</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="line_index" t-value="0"/>
                                        <tr t-foreach="o.order_line_ids" t-as="line" style="border-bottom: 1px solid #e9ecef;">
                                            <t t-set="line_index" t-value="line_index + 1"/>
                                            <td class="text-center" style="padding: 10px; font-weight: bold; background: #f8f9fa;">
                                                <span t-esc="line_index"/>
                                            </td>
                                            <td class="text-right" style="padding: 10px;">
                                                <!-- Use custom_product_name if set, otherwise use product name -->
                                                <strong>
                                                    <span t-if="line.custom_product_name" t-field="line.custom_product_name"/>
                                                    <span t-else="" t-field="line.product_id.name"/>
                                                </strong>
                                                <br/>
                                                <small class="text-muted" t-if="line.product_code">
                                                    كود: <span t-field="line.product_code"/>
                                                </small>
                                            </td>
                                            <td class="text-center" style="padding: 10px;">
                                                <span t-field="line.quantity"/>
                                                <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                            </td>
                                            <td class="text-center" style="padding: 10px;">
                                                <span t-field="line.unit_price" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                            <td class="text-center" style="padding: 10px; color: #dc3545;">
                                                <span t-if="line.discount_percent &gt; 0">
                                                    <strong><span t-field="line.discount_percent"/>%</strong>
                                                </span>
                                                <span t-else="">-</span>
                                            </td>
                                            <td class="text-center" style="padding: 10px; font-weight: bold; background: #f8f9fa;">
                                                <span t-field="line.line_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        
                        <!-- Totals -->
                        <div class="row mt-4">
                            <div class="col-6">
                                <!-- Notes Section -->
                                <div t-if="o.note" style="background: #fff3cd; padding: 15px; border-radius: 8px; border-right: 4px solid #ffc107;">
                                    <strong style="color: #856404;">ملاحظات:</strong>
                                    <p style="margin-top: 8px; margin-bottom: 0; color: #856404;" t-field="o.note"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; border: 2px solid #e9ecef;">
                                    <table class="table table-sm" style="margin-bottom: 0;">
                                        <tr style="border-bottom: 1px solid #dee2e6;">
                                            <td class="text-right" style="padding: 8px;">
                                                <strong>المجموع الفرعي:</strong>
                                            </td>
                                            <td class="text-center" style="padding: 8px; font-size: 16px;">
                                                <span t-field="o.amount_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr t-if="o.amount_discount &gt; 0" style="color: #dc3545; border-bottom: 1px solid #dee2e6;">
                                            <td class="text-right" style="padding: 8px;">
                                                <strong>الخصم:</strong>
                                            </td>
                                            <td class="text-center" style="padding: 8px; font-size: 16px;">
                                                -<span t-field="o.amount_discount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr t-if="o.amount_tax &gt; 0" style="border-bottom: 1px solid #dee2e6;">
                                            <td class="text-right" style="padding: 8px;">
                                                <strong>الضريبة:</strong>
                                            </td>
                                            <td class="text-center" style="padding: 8px; font-size: 16px;">
                                                <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                                            <td class="text-right" style="padding: 12px; border: none;">
                                                <strong style="font-size: 18px;">المجموع الكلي:</strong>
                                            </td>
                                            <td class="text-center" style="padding: 12px; border: none;">
                                                <strong style="font-size: 20px;">
                                                    <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </strong>
                                            </td>
                                        </tr>
                                        <tr t-if="o.amount_total_iqd" style="background: #d4edda; color: #155724;">
                                            <td class="text-right" style="padding: 12px; border: none;">
                                                <strong style="font-size: 16px;">المجموع بالدينار العراقي:</strong>
                                            </td>
                                            <td class="text-center" style="padding: 12px; border: none;">
                                                <strong style="font-size: 18px;">
                                                    <span t-field="o.amount_total_iqd" t-options='{"widget": "monetary", "display_currency": o.currency_iqd_id}'/>
                                                </strong>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                        
                        
                        <!-- Footer -->
                        <div class="row mt-5" style="border-top: 3px solid #667eea; padding-top: 20px;">
                            <div class="col-12 text-center">
                                <p style="color: #667eea; font-size: 16px; font-weight: bold; margin-bottom: 5px;">
                                    شكراً لتعاملكم معنا
                                </p>
                                <p style="color: #999; font-size: 14px; margin-bottom: 0;">
                                    Thank you for your business
                                </p>
                            </div>
                        </div>
                        
                        <!-- Print Info -->
                        <div class="row mt-3">
                            <div class="col-12 text-center">
                                <small style="color: #999; font-size: 11px;">
                                    تاريخ الطباعة: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                                    <span t-if="o.sap_synced" style="margin-right: 20px; color: #28a745;">
                                        ✓ متزامن مع SAP
                                    </span>
                                </small>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!--     POS Perfume Order - Professional Arabic Report           -->
    <!-- ============================================================ -->
    
    <!-- Report Action -->
    <record id="action_report_pos_perfume_order_simple" model="ir.actions.report">
        <field name="name">فاتورة POS</field>
        <field name="model">pos.perfume.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_perfume_custom.report_pos_perfume_order_simple</field>
        <field name="report_file">pos_perfume_custom.report_pos_perfume_order_simple</field>
        <field name="print_report_name">'Invoice_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_pos_perfume_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>
    
    <!-- Report Template -->
    <template id="report_pos_perfume_order_simple">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="direction: rtl; font-family: 'DejaVu Sans', 'Arial', 'Tahoma', sans-serif; font-size: 13px; color: #000;">
                    
                    <!-- Header with Company Logo and Info -->
                    <div style="margin-bottom: 25px; padding-bottom: 15px; border-bottom: 3px solid #2c3e50; display: table; width: 100%;">
                        <div style="display: table-cell; width: 30%; vertical-align: middle; text-align: right;">
                            <!-- Company Logo - Larger -->
                            <img t-if="o.env.company.logo" 
                                 t-att-src="image_data_uri(o.env.company.logo)" 
                                 style="max-height: 100px; max-width: 200px;"
                                 alt="Logo"/>
                        </div>
                        <div style="display: table-cell; width: 70%; vertical-align: middle; text-align: center;">
                            <!-- Company Name and Title -->
                            <h3 style="margin: 0 0 8px 0; color: #2c3e50; font-size: 20px; font-weight: bold;">
                                <t t-esc="o.env.company.name"/>
                            </h3>
                            <h2 style="margin: 0; color: #3498db; font-size: 24px; font-weight: bold;">
                                <t t-if="o.state == 'quotation'">عرض سعر</t>
                                <t t-elif="o.state == 'sale'">فاتورة</t>
                                <t t-else="">طلب مبدئي</t>
                            </h2>
                        </div>
                    </div>
                    
                    <!-- Order Information -->
                    <div style="margin-bottom: 20px; display: table; width: 100%;">
                        <div style="display: table-cell; width: 50%; padding-left: 10px;">
                            <table style="width: 100%; border: 2px solid #2c3e50; background: #ecf0f1; border-collapse: collapse;">
                                <tr>
                                    <td style="padding: 10px; border-bottom: 1px solid #bdc3c7; width: 40%; text-align: right;">
                                        <strong style="color: #2c3e50;">رقم الطلب:</strong>
                                    </td>
                                    <td style="padding: 10px; border-bottom: 1px solid #bdc3c7; text-align: center; font-weight: bold; font-size: 15px;">
                                        <t t-esc="o.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 10px; border-bottom: 1px solid #bdc3c7; text-align: right;">
                                        <strong style="color: #2c3e50;">التاريخ:</strong>
                                    </td>
                                    <td style="padding: 10px; border-bottom: 1px solid #bdc3c7; text-align: center;">
                                        <t t-esc="o.date.strftime('%Y-%m-%d') if o.date else ''"/>
                                    </td>
                                </tr>
                                <tr t-if="o.sap_doc_num">
                                    <td style="padding: 10px; background: #d5f4e6; text-align: right;">
                                        <strong style="color: #27ae60;">رقم فاتورة SAP:</strong>
                                    </td>
                                    <td style="padding: 10px; background: #d5f4e6; text-align: center; font-weight: bold; font-size: 18px; color: #27ae60;">
                                        <t t-esc="o.sap_doc_num"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div style="display: table-cell; width: 50%; padding-right: 10px;">
                            <table style="width: 100%; border: 2px solid #2c3e50; background: #ecf0f1; border-collapse: collapse;">
                                <tr>
                                    <td style="padding: 10px; border-bottom: 1px solid #bdc3c7; width: 40%; text-align: right;">
                                        <strong style="color: #2c3e50;">البائع:</strong>
                                    </td>
                                    <td style="padding: 10px; border-bottom: 1px solid #bdc3c7; text-align: center;">
                                        <t t-esc="o.user_id.name"/>
                                    </td>
                                </tr>
                                <tr t-if="o.invoice_type">
                                    <td style="padding: 10px; border-bottom: 1px solid #bdc3c7; text-align: right;">
                                        <strong style="color: #2c3e50;">نوع الفاتورة:</strong>
                                    </td>
                                    <td style="padding: 10px; border-bottom: 1px solid #bdc3c7; text-align: center;">
                                        <t t-esc="dict(o._fields['invoice_type'].selection).get(o.invoice_type, o.invoice_type)"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 10px; text-align: right;">
                                        <strong style="color: #2c3e50;">سعر الصرف:</strong>
                                    </td>
                                    <td style="padding: 10px; text-align: center;">
                                        <t t-esc="'{:,.0f}'.format(o.exchange_rate)"/> د.ع
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    
                    <!-- Customer Information -->
                    <div style="margin-bottom: 20px;">
                        <div style="background: #ecf0f1; padding: 15px; border: 2px solid #2c3e50;">
                            <h4 style="margin: 0 0 10px 0; padding-bottom: 8px; border-bottom: 2px solid #2c3e50; color: #2c3e50; text-align: right;">
                                معلومات العميل
                            </h4>
                            <table style="width: 100%; border-collapse: collapse;">
                                <tr>
                                    <td style="width: 15%; padding: 5px; text-align: right;">
                                        <strong>الاسم:</strong>
                                    </td>
                                    <td style="width: 35%; padding: 5px; text-align: right;">
                                        <t t-esc="o.partner_id.name"/>
                                    </td>
                                    <td style="width: 15%; padding: 5px; text-align: right;" t-if="o.partner_id.phone">
                                        <strong>الهاتف:</strong>
                                    </td>
                                    <td style="width: 35%; padding: 5px; text-align: right;" t-if="o.partner_id.phone">
                                        <t t-esc="o.partner_id.phone"/>
                                    </td>
                                </tr>
                                <tr t-if="o.partner_id.street">
                                    <td style="padding: 5px; text-align: right;">
                                        <strong>العنوان:</strong>
                                    </td>
                                    <td colspan="3" style="padding: 5px; text-align: right;">
                                        <t t-esc="o.partner_id.street"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                        
                    <!-- Products Table -->
                    <div style="margin-bottom: 20px;">
                        <h4 style="margin: 0 0 10px 0; padding-bottom: 8px; border-bottom: 2px solid #2c3e50; color: #2c3e50; text-align: right;">
                            تفاصيل الطلب
                        </h4>
                        <table style="width: 100%; border-collapse: collapse; border: 2px solid #2c3e50;">
                            <thead>
                                <tr style="background: #34495e; color: white;">
                                    <th style="padding: 10px; text-align: center; border: 1px solid #2c3e50; width: 5%;">#</th>
                                    <th style="padding: 10px; text-align: right; border: 1px solid #2c3e50; width: 42%;">اسم المنتج</th>
                                    <th style="padding: 10px; text-align: center; border: 1px solid #2c3e50; width: 13%;">الكمية</th>
                                    <th style="padding: 10px; text-align: center; border: 1px solid #2c3e50; width: 13%;">السعر</th>
                                    <th style="padding: 10px; text-align: center; border: 1px solid #2c3e50; width: 10%;">الخصم %</th>
                                    <th style="padding: 10px; text-align: center; border: 1px solid #2c3e50; width: 17%;">المجموع</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="line_index" t-value="0"/>
                                <tr t-foreach="o.order_line_ids" t-as="line">
                                    <t t-set="line_index" t-value="line_index + 1"/>
                                    <td style="padding: 8px; text-align: center; border: 1px solid #bdc3c7; background: #ecf0f1; font-weight: bold;">
                                        <t t-esc="line_index"/>
                                    </td>
                                    <td style="padding: 8px; text-align: right; border: 1px solid #bdc3c7;">
                                        <strong>
                                            <t t-if="line.custom_product_name" t-esc="line.custom_product_name"/>
                                            <t t-else="" t-esc="line.product_id.name"/>
                                        </strong>
                                        <br t-if="line.product_code"/>
                                        <small style="color: #7f8c8d;" t-if="line.product_code">
                                            كود: <t t-esc="line.product_code"/>
                                        </small>
                                    </td>
                                    <td style="padding: 8px; text-align: center; border: 1px solid #bdc3c7;">
                                        <t t-esc="'{:.2f}'.format(line.quantity)"/>
                                        <t t-esc="line.product_uom_id.name" groups="uom.group_uom"/>
                                    </td>
                                    <td style="padding: 8px; text-align: center; border: 1px solid #bdc3c7;">
                                        $<t t-esc="'{:.2f}'.format(line.unit_price)"/>
                                    </td>
                                    <td style="padding: 8px; text-align: center; border: 1px solid #bdc3c7;">
                                        <t t-if="line.discount_percent &gt; 0">
                                            <strong style="color: #e74c3c;">
                                                <t t-esc="'{:.0f}'.format(line.discount_percent)"/>%
                                            </strong>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>
                                    <td style="padding: 8px; text-align: center; border: 1px solid #bdc3c7; background: #ecf0f1; font-weight: bold;">
                                        $<t t-esc="'{:.2f}'.format(line.line_total)"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                        
                    <!-- Totals and Notes -->
                    <div style="display: table; width: 100%; margin-bottom: 20px;">
                        <div style="display: table-cell; width: 50%; padding-left: 10px; vertical-align: top;">
                            <!-- Notes -->
                            <div t-if="o.note" style="border: 2px solid #f39c12; background: #fef5e7; padding: 12px; min-height: 100px;">
                                <strong style="color: #d68910; font-size: 14px;">ملاحظات:</strong>
                                <p style="margin: 8px 0 0 0; color: #7d6608; text-align: right;">
                                    <t t-esc="o.note"/>
                                </p>
                            </div>
                        </div>
                        <div style="display: table-cell; width: 50%; padding-right: 10px;">
                            <!-- Totals Table -->
                            <table style="width: 100%; border: 2px solid #2c3e50; border-collapse: collapse;">
                                <tr style="background: #ecf0f1;">
                                    <td style="padding: 10px; text-align: right; border-bottom: 1px solid #bdc3c7;">
                                        <strong>المجموع الفرعي:</strong>
                                    </td>
                                    <td style="padding: 10px; text-align: center; border-bottom: 1px solid #bdc3c7; font-weight: bold;">
                                        $<t t-esc="'{:.2f}'.format(o.amount_subtotal)"/>
                                    </td>
                                </tr>
                                <tr t-if="o.amount_discount &gt; 0" style="background: #ecf0f1;">
                                    <td style="padding: 10px; text-align: right; border-bottom: 1px solid #bdc3c7;">
                                        <strong style="color: #e74c3c;">الخصم:</strong>
                                    </td>
                                    <td style="padding: 10px; text-align: center; border-bottom: 1px solid #bdc3c7; color: #e74c3c; font-weight: bold;">
                                        -$<t t-esc="'{:.2f}'.format(o.amount_discount)"/>
                                    </td>
                                </tr>
                                <tr t-if="o.amount_tax &gt; 0" style="background: #ecf0f1;">
                                    <td style="padding: 10px; text-align: right; border-bottom: 1px solid #bdc3c7;">
                                        <strong>الضريبة:</strong>
                                    </td>
                                    <td style="padding: 10px; text-align: center; border-bottom: 1px solid #bdc3c7; font-weight: bold;">
                                        $<t t-esc="'{:.2f}'.format(o.amount_tax)"/>
                                    </td>
                                </tr>
                                <tr style="background: #3498db; color: white;">
                                    <td style="padding: 12px; text-align: right;">
                                        <strong style="font-size: 16px;">المجموع الكلي:</strong>
                                    </td>
                                    <td style="padding: 12px; text-align: center;">
                                        <strong style="font-size: 18px;">
                                            $<t t-esc="'{:.2f}'.format(o.amount_total)"/>
                                        </strong>
                                    </td>
                                </tr>
                                <tr t-if="o.amount_total_iqd" style="background: #27ae60; color: white;">
                                    <td style="padding: 12px; text-align: right;">
                                        <strong style="font-size: 15px;">المجموع بالدينار العراقي:</strong>
                                    </td>
                                    <td style="padding: 12px; text-align: center;">
                                        <strong style="font-size: 17px;">
                                            <t t-esc="'{:,.0f}'.format(o.amount_total_iqd)"/> د.ع
                                        </strong>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    
                    <!-- Footer -->
                    <div style="margin-top: 40px; padding-top: 15px; border-top: 3px solid #2c3e50; text-align: center;">
                        <p style="margin: 5px 0; font-size: 16px; color: #3498db; font-weight: bold;">
                            شكراً لتعاملكم معنا
                        </p>
                        <p style="margin: 5px 0; font-size: 13px; color: #95a5a6;">
                            Thank you for your business
                        </p>
                        <p style="margin-top: 12px; font-size: 10px; color: #7f8c8d;" t-if="o.sap_synced">
                            متزامن مع نظام SAP ✓
                        </p>
                    </div>
                    
                </div>
            </t>
        </t>
    </template>
</odoo>


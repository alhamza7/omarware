<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!--     POS Perfume Order - Simple Default Report (Odoo Style)   -->
    <!-- ============================================================ -->
    
    <!-- Report Action -->
    <record id="action_report_pos_perfume_order_simple" model="ir.actions.report">
        <field name="name">POS Order Receipt</field>
        <field name="model">pos.perfume.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_perfume_custom.report_pos_perfume_order_simple</field>
        <field name="report_file">pos_perfume_custom.report_pos_perfume_order_simple</field>
        <field name="print_report_name">'Order - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_pos_perfume_order"/>
        <field name="binding_type">report</field>
    </record>
    
    <!-- Report Template -->
    <template id="report_pos_perfume_order_simple">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Header -->
                        <div class="row mt-4">
                            <div class="col-6">
                                <h2>
                                    <span t-if="o.state == 'quotation'">Quotation</span>
                                    <span t-elif="o.state == 'sale'">Order</span>
                                    <span t-else="">Draft Order</span>
                                    <span t-field="o.name"/>
                                </h2>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Date:</strong> <span t-field="o.date" t-options="{'widget': 'date'}"/><br/>
                                <strong>Salesperson:</strong> <span t-field="o.user_id.name"/>
                            </div>
                        </div>
                        
                        <!-- Customer Info -->
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Customer:</strong><br/>
                                <div t-field="o.partner_id" 
                                     t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email"], "no_marker": True}'/>
                            </div>
                            <div class="col-6" t-if="o.invoice_type">
                                <strong>Invoice Type:</strong>
                                <span t-field="o.invoice_type"/>
                            </div>
                        </div>
                        
                        <!-- Order Lines Table -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <table class="table table-sm table-bordered">
                                    <thead style="background-color: #f8f9fa;">
                                        <tr>
                                            <th class="text-start">#</th>
                                            <th class="text-start">Product</th>
                                            <th class="text-center">Warehouse</th>
                                            <th class="text-end">Quantity</th>
                                            <th class="text-end">Unit Price</th>
                                            <th class="text-end">Discount %</th>
                                            <th class="text-end">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="line_index" t-value="0"/>
                                        <tr t-foreach="o.order_line_ids" t-as="line">
                                            <t t-set="line_index" t-value="line_index + 1"/>
                                            <td class="text-start">
                                                <span t-esc="line_index"/>
                                            </td>
                                            <td class="text-start">
                                                <!-- Use custom_product_name if set, otherwise use product name -->
                                                <span t-if="line.custom_product_name" t-field="line.custom_product_name"/>
                                                <span t-else="" t-field="line.product_id.name"/>
                                                <br/>
                                                <small class="text-muted" t-if="line.product_code">
                                                    Code: <span t-field="line.product_code"/>
                                                </small>
                                            </td>
                                            <td class="text-center">
                                                <span t-field="line.warehouse_id.name"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.quantity"/>
                                                <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.unit_price" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.discount_percent"/>%
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.line_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        
                        <!-- Totals -->
                        <div class="row">
                            <div class="col-7"></div>
                            <div class="col-5">
                                <table class="table table-sm">
                                    <tr>
                                        <td class="text-end"><strong>Subtotal:</strong></td>
                                        <td class="text-end">
                                            <span t-field="o.amount_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.amount_discount &gt; 0" style="color: #dc3545;">
                                        <td class="text-end"><strong>Discount:</strong></td>
                                        <td class="text-end">
                                            -<span t-field="o.amount_discount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.amount_tax &gt; 0">
                                        <td class="text-end"><strong>Tax:</strong></td>
                                        <td class="text-end">
                                            <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr style="border-top: 2px solid #000; font-size: 1.2em;">
                                        <td class="text-end"><strong>Total:</strong></td>
                                        <td class="text-end">
                                            <strong>
                                                <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </strong>
                                        </td>
                                    </tr>
                                    <tr t-if="o.amount_total_iqd" style="background-color: #f8f9fa; color: #28a745; font-size: 1.1em;">
                                        <td class="text-end"><strong>Total (IQD):</strong></td>
                                        <td class="text-end">
                                            <strong>
                                                <span t-field="o.amount_total_iqd" t-options='{"widget": "monetary", "display_currency": o.currency_iqd_id}'/>
                                            </strong>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        
                        <!-- Notes -->
                        <div class="row mt-3" t-if="o.note">
                            <div class="col-12">
                                <strong>Notes:</strong>
                                <p t-field="o.note"/>
                            </div>
                        </div>
                        
                        <!-- SAP Info -->
                        <div class="row mt-2" t-if="o.sap_doc_number">
                            <div class="col-12">
                                <small class="text-muted">
                                    SAP Document: <span t-field="o.sap_doc_number"/>
                                </small>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>


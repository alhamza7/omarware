<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!--     POS Perfume Order - Professional Arabic Report           -->
    <!-- ============================================================ -->
    
    <!-- Report Action -->
    <record id="action_report_pos_perfume_order_simple" model="ir.actions.report">
        <field name="name">فاتورة POS</field>
        <field name="model">pos.perfume.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_perfume_custom.report_pos_perfume_order_simple</field>
        <field name="report_file">pos_perfume_custom.report_pos_perfume_order_simple</field>
        <field name="print_report_name">'Invoice_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_pos_perfume_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>
    
    <!-- Report Template -->
    <template id="report_pos_perfume_order_simple">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page pos-arabic-report">
                    
                    <!-- Header with Company Logo and Info -->
                    <div class="row" style="margin-bottom: 25px; padding-bottom: 15px; border-bottom: 2px solid #2c3e50;">
                        <div class="col-3">
                            <!-- Company Logo - Larger -->
                            <img t-if="o.env.company.logo" 
                                 t-att-src="image_data_uri(o.env.company.logo)" 
                                 style="max-height: 120px; max-width: 250px; display: block;"
                                 alt="شعار الشركة"/>
                        </div>
                        <div class="col-9 text-center">
                            <!-- Company Name and Title -->
                            <h3 style="margin: 0 0 5px 0; color: #2c3e50; font-size: 22px; font-weight: bold;">
                                <span t-field="o.env.company.name"/>
                            </h3>
                            <h2 style="margin: 5px 0; color: #3498db; font-size: 26px; font-weight: bold;">
                                <span t-if="o.state == 'quotation'">عرض سعر</span>
                                <span t-elif="o.state == 'sale'">فاتورة</span>
                                <span t-else="">طلب مبدئي</span>
                            </h2>
                        </div>
                    </div>
                    
                    <!-- Order Information -->
                    <div class="row" style="margin-bottom: 25px;">
                        <div class="col-6">
                            <table style="width: 100%; border: 2px solid #2c3e50; background: #ecf0f1;">
                                <tr>
                                    <td style="padding: 12px; border-bottom: 1px solid #bdc3c7; width: 40%;">
                                        <strong style="color: #2c3e50; font-size: 14px;">رقم الطلب:</strong>
                                    </td>
                                    <td style="padding: 12px; border-bottom: 1px solid #bdc3c7; font-weight: bold; font-size: 16px;">
                                        <span t-field="o.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 12px; border-bottom: 1px solid #bdc3c7;">
                                        <strong style="color: #2c3e50; font-size: 14px;">التاريخ:</strong>
                                    </td>
                                    <td style="padding: 12px; border-bottom: 1px solid #bdc3c7; font-size: 14px;">
                                        <span t-field="o.date" t-options="{'widget': 'date'}"/>
                                    </td>
                                </tr>
                                <tr t-if="o.sap_doc_num">
                                    <td style="padding: 12px; background: #d5f4e6;">
                                        <strong style="color: #27ae60; font-size: 15px;">رقم فاتورة SAP:</strong>
                                    </td>
                                    <td style="padding: 12px; background: #d5f4e6; font-weight: bold; font-size: 20px; color: #27ae60;">
                                        <span t-esc="o.sap_doc_num"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-6">
                            <table style="width: 100%; border: 2px solid #2c3e50; background: #ecf0f1;">
                                <tr>
                                    <td style="padding: 12px; border-bottom: 1px solid #bdc3c7; width: 40%;">
                                        <strong style="color: #2c3e50; font-size: 14px;">البائع:</strong>
                                    </td>
                                    <td style="padding: 12px; border-bottom: 1px solid #bdc3c7; font-size: 14px;">
                                        <span t-field="o.user_id.name"/>
                                    </td>
                                </tr>
                                <tr t-if="o.invoice_type">
                                    <td style="padding: 12px; border-bottom: 1px solid #bdc3c7;">
                                        <strong style="color: #2c3e50; font-size: 14px;">نوع الفاتورة:</strong>
                                    </td>
                                    <td style="padding: 12px; border-bottom: 1px solid #bdc3c7; font-size: 14px;">
                                        <span t-field="o.invoice_type"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 12px;">
                                        <strong style="color: #2c3e50; font-size: 14px;">سعر الصرف:</strong>
                                    </td>
                                    <td style="padding: 12px; font-size: 14px;">
                                        <span t-esc="'{:,.2f}'.format(o.exchange_rate)"/> د.ع
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    
                    <!-- Customer Information -->
                    <div class="row" style="margin-bottom: 25px;">
                        <div class="col-12">
                            <div style="background: #ecf0f1; padding: 15px; border: 1px solid #bdc3c7;">
                                <h4 style="margin: 0 0 10px 0; padding-bottom: 8px; border-bottom: 2px solid #2c3e50; color: #2c3e50; font-size: 18px;">
                                    معلومات العميل
                                </h4>
                                <table style="width: 100%;">
                                    <tr>
                                        <td style="width: 20%; padding: 5px;">
                                            <strong>الاسم:</strong>
                                        </td>
                                        <td style="padding: 5px;">
                                            <span t-field="o.partner_id.name"/>
                                        </td>
                                        <td style="width: 20%; padding: 5px;" t-if="o.partner_id.phone">
                                            <strong>الهاتف:</strong>
                                        </td>
                                        <td style="padding: 5px;" t-if="o.partner_id.phone">
                                            <span t-field="o.partner_id.phone"/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.partner_id.street">
                                        <td style="padding: 5px;">
                                            <strong>العنوان:</strong>
                                        </td>
                                        <td colspan="3" style="padding: 5px;">
                                            <span t-field="o.partner_id.street"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                        
                    <!-- Products Table -->
                    <div class="row" style="margin-bottom: 25px;">
                        <div class="col-12">
                            <h4 style="margin: 0 0 10px 0; padding-bottom: 8px; border-bottom: 2px solid #2c3e50; color: #2c3e50; font-size: 18px;">
                                تفاصيل الطلب
                            </h4>
                            <table style="width: 100%; border-collapse: collapse; border: 1px solid #2c3e50;">
                                <thead>
                                    <tr style="background: #34495e; color: white;">
                                        <th style="padding: 12px; text-align: center; border: 1px solid #2c3e50; width: 5%;">#</th>
                                        <th style="padding: 12px; text-align: right; border: 1px solid #2c3e50; width: 40%;">اسم المنتج</th>
                                        <th style="padding: 12px; text-align: center; border: 1px solid #2c3e50; width: 12%;">الكمية</th>
                                        <th style="padding: 12px; text-align: center; border: 1px solid #2c3e50; width: 13%;">السعر</th>
                                        <th style="padding: 12px; text-align: center; border: 1px solid #2c3e50; width: 10%;">الخصم %</th>
                                        <th style="padding: 12px; text-align: center; border: 1px solid #2c3e50; width: 15%;">المجموع</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="line_index" t-value="0"/>
                                    <tr t-foreach="o.order_line_ids" t-as="line">
                                        <t t-set="line_index" t-value="line_index + 1"/>
                                        <td style="padding: 10px; text-align: center; border: 1px solid #bdc3c7; background: #ecf0f1; font-weight: bold;">
                                            <span t-esc="line_index"/>
                                        </td>
                                        <td style="padding: 10px; text-align: right; border: 1px solid #bdc3c7;">
                                            <strong>
                                                <span t-if="line.custom_product_name" t-field="line.custom_product_name"/>
                                                <span t-else="" t-field="line.product_id.name"/>
                                            </strong>
                                            <br t-if="line.product_code"/>
                                            <small style="color: #7f8c8d;" t-if="line.product_code">
                                                كود: <span t-field="line.product_code"/>
                                            </small>
                                        </td>
                                        <td style="padding: 10px; text-align: center; border: 1px solid #bdc3c7;">
                                            <span t-field="line.quantity"/>
                                            <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                        </td>
                                        <td style="padding: 10px; text-align: center; border: 1px solid #bdc3c7;">
                                            <span t-field="line.unit_price" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td style="padding: 10px; text-align: center; border: 1px solid #bdc3c7;">
                                            <span t-if="line.discount_percent &gt; 0" style="color: #e74c3c; font-weight: bold;">
                                                <span t-field="line.discount_percent"/>%
                                            </span>
                                            <span t-else="">-</span>
                                        </td>
                                        <td style="padding: 10px; text-align: center; border: 1px solid #bdc3c7; background: #ecf0f1; font-weight: bold;">
                                            <span t-field="line.line_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                        
                    <!-- Totals and Notes -->
                    <div class="row">
                        <div class="col-6">
                            <!-- Notes -->
                            <div t-if="o.note" style="border: 1px solid #f39c12; background: #fef5e7; padding: 12px;">
                                <strong style="color: #d68910;">ملاحظات:</strong>
                                <p style="margin: 8px 0 0 0; color: #7d6608;" t-field="o.note"/>
                            </div>
                        </div>
                        <div class="col-6">
                            <!-- Totals Table -->
                            <table style="width: 100%; border: 1px solid #2c3e50;">
                                <tr style="background: #ecf0f1;">
                                    <td style="padding: 10px; text-align: right; border-bottom: 1px solid #bdc3c7;">
                                        <strong>المجموع الفرعي:</strong>
                                    </td>
                                    <td style="padding: 10px; text-align: center; border-bottom: 1px solid #bdc3c7; font-size: 16px; font-weight: bold;">
                                        <span t-field="o.amount_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <tr t-if="o.amount_discount &gt; 0" style="background: #ecf0f1;">
                                    <td style="padding: 10px; text-align: right; border-bottom: 1px solid #bdc3c7;">
                                        <strong style="color: #e74c3c;">الخصم:</strong>
                                    </td>
                                    <td style="padding: 10px; text-align: center; border-bottom: 1px solid #bdc3c7; color: #e74c3c; font-weight: bold;">
                                        -<span t-field="o.amount_discount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <tr t-if="o.amount_tax &gt; 0" style="background: #ecf0f1;">
                                    <td style="padding: 10px; text-align: right; border-bottom: 1px solid #bdc3c7;">
                                        <strong>الضريبة:</strong>
                                    </td>
                                    <td style="padding: 10px; text-align: center; border-bottom: 1px solid #bdc3c7; font-weight: bold;">
                                        <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <tr style="background: #3498db; color: white;">
                                    <td style="padding: 12px; text-align: right; border: none;">
                                        <strong style="font-size: 18px;">المجموع الكلي:</strong>
                                    </td>
                                    <td style="padding: 12px; text-align: center; border: none;">
                                        <strong style="font-size: 20px;">
                                            <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </strong>
                                    </td>
                                </tr>
                                <tr t-if="o.amount_total_iqd" style="background: #27ae60; color: white;">
                                    <td style="padding: 12px; text-align: right; border: none;">
                                        <strong style="font-size: 16px;">المجموع بالدينار العراقي:</strong>
                                    </td>
                                    <td style="padding: 12px; text-align: center; border: none;">
                                        <strong style="font-size: 18px;">
                                            <t t-esc="'{:,.0f}'.format(o.amount_total_iqd)"/> د.ع
                                        </strong>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    
                    <!-- Footer -->
                    <div style="margin-top: 40px; padding-top: 20px; border-top: 3px solid #2c3e50; text-align: center;">
                        <p style="margin: 5px 0; font-size: 18px; color: #3498db; font-weight: bold;">
                            شكراً لتعاملكم معنا
                        </p>
                        <p style="margin: 5px 0; font-size: 14px; color: #95a5a6;">
                            Thank you for your business
                        </p>
                        <p style="margin-top: 15px; font-size: 11px; color: #7f8c8d;" t-if="o.sap_synced">
                            ✓ تم التزامن مع نظام SAP
                        </p>
                    </div>
                    
                </div>
            </t>
        </t>
    </template>
</odoo>


<?xml version="1.0"?>
<odoo>
    <data>
        <!-- Inherit Sales Configuration Settings -->
        <record id="res_config_settings_view_form_inherit_pos_perfume" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.pos.perfume</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='sale_settings']" position="inside">
                    <h2>إعدادات POS Perfume</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <i class="fa fa-dollar"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="default_exchange_rate_usd_iqd" string="سعر الصرف الافتراضي"/>
                                <div class="text-muted">
                                    معامل التحويل من الدولار إلى الدينار العراقي للفواتير الجديدة
                                </div>
                                <div class="content-group mt16">
                                    <div class="row">
                                        <label for="default_exchange_rate_usd_iqd" 
                                               string="1 USD = " 
                                               class="col-lg-3 o_light_label"/>
                                        <field name="default_exchange_rate_usd_iqd" 
                                               widget="float"
                                               class="oe_inline"/>
                                        <span class="o_form_label oe_inline"> IQD</span>
                                    </div>
                                    <div class="row mt8">
                                        <div class="col-12">
                                            <div class="alert alert-info" role="alert">
                                                <i class="fa fa-info-circle"/> 
                                                <strong>ملاحظة:</strong> 
                                                هذا السعر سيُستخدم افتراضياً لجميع الفواتير الجديدة. 
                                                يمكنك تغيير السعر لكل فاتورة على حدة عند الحاجة.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>


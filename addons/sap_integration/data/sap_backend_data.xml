<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default SAP Backend Configuration -->
        <record id="sap_backend_default" model="sap.backend">
            <field name="name">Default SAP Backend</field>
            <field name="base_url">https://your-sap-server.com:50000/b1s/v1</field>
            <field name="username">your_username</field>
            <field name="password">your_password</field>
            <field name="company_db">YOUR_COMPANY_DB</field>
            <field name="active">False</field>
            <field name="sync_customers">True</field>
            <field name="sync_products">True</field>
            <field name="sync_quotations">True</field>
            <field name="sync_sales">True</field>
            <field name="sync_invoices">True</field>
            <field name="batch_size">100</field>
            <field name="timeout">30</field>
            <field name="retry_attempts">3</field>
        </record>
    </data>
</odoo>



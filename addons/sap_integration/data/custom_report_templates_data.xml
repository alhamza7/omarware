<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Default Template: Arabic Sales Invoice (IQD) -->
        <record id="template_arabic_sales_invoice_iqd" model="custom.report.template">
            <field name="name">فاتورة مبيعات عربية (دينار)</field>
            <field name="code">AR_SALES_INV_IQD</field>
            <field name="report_type">sale_order</field>
            <field name="language">ar_SA</field>
            <field name="currency_id" ref="base.IQD"/>
            <field name="show_currency_name" eval="True"/>
            <field name="currency_position">after</field>
            
            <!-- Page Settings -->
            <field name="page_width">210</field>
            <field name="page_height">297</field>
            <field name="margin_top">15</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            
            <!-- Header -->
            <field name="show_header" eval="True"/>
            <field name="show_logo" eval="True"/>
            <field name="logo_position">left</field>
            <field name="show_company_info" eval="True"/>
            <field name="company_info_position">right</field>
            
            <!-- Title -->
            <field name="show_title" eval="True"/>
            <field name="title_text">فاتورة مبيعات</field>
            <field name="title_alignment">center</field>
            <field name="title_font_size">24</field>
            
            <!-- Table -->
            <field name="show_table" eval="True"/>
            <field name="table_header_bg">#4A90E2</field>
            <field name="alternate_row_colors" eval="True"/>
            
            <!-- Totals -->
            <field name="show_totals" eval="True"/>
            <field name="totals_position">right</field>
            
            <!-- Footer -->
            <field name="show_footer" eval="True"/>
            <field name="show_page_number" eval="True"/>
        </record>
        
        <!-- Default Template: English Sales Invoice (USD) -->
        <record id="template_english_sales_invoice_usd" model="custom.report.template">
            <field name="name">Sales Invoice English (USD)</field>
            <field name="code">EN_SALES_INV_USD</field>
            <field name="report_type">sale_order</field>
            <field name="language">en_US</field>
            <field name="currency_id" ref="base.USD"/>
            <field name="title_text">Sales Invoice</field>
            <field name="show_header" eval="True"/>
            <field name="show_table" eval="True"/>
            <field name="show_totals" eval="True"/>
        </record>
        
        <!-- Default Template: Bilingual Quotation -->
        <record id="template_bilingual_quotation" model="custom.report.template">
            <field name="name">عرض سعر ثنائي اللغة / Bilingual Quotation</field>
            <field name="code">BILINGUAL_QUOTE</field>
            <field name="report_type">quotation</field>
            <field name="language">both</field>
            <field name="title_text">عرض سعر / Quotation</field>
        </record>
        
        <!-- Default Template: POS Receipt -->
        <record id="template_pos_receipt" model="custom.report.template">
            <field name="name">إيصال POS</field>
            <field name="code">POS_RECEIPT</field>
            <field name="report_type">pos_order</field>
            <field name="page_width">80</field>
            <field name="page_height">210</field>
            <field name="title_text">إيصال بيع</field>
        </record>
        
        <!-- Default Table Columns for Sales -->
        <record id="col_item_no" model="custom.report.column">
            <field name="template_id" ref="template_arabic_sales_invoice_iqd"/>
            <field name="name">#</field>
            <field name="technical_name">sequence</field>
            <field name="sequence">1</field>
            <field name="width">5</field>
            <field name="alignment">center</field>
        </record>
        
        <record id="col_product_name" model="custom.report.column">
            <field name="template_id" ref="template_arabic_sales_invoice_iqd"/>
            <field name="name">المنتج</field>
            <field name="technical_name">product_id.name</field>
            <field name="sequence">2</field>
            <field name="width">40</field>
            <field name="alignment">left</field>
        </record>
        
        <record id="col_quantity" model="custom.report.column">
            <field name="template_id" ref="template_arabic_sales_invoice_iqd"/>
            <field name="name">الكمية</field>
            <field name="technical_name">product_uom_qty</field>
            <field name="sequence">3</field>
            <field name="width">10</field>
            <field name="alignment">center</field>
        </record>
        
        <record id="col_unit_price" model="custom.report.column">
            <field name="template_id" ref="template_arabic_sales_invoice_iqd"/>
            <field name="name">السعر</field>
            <field name="technical_name">price_unit</field>
            <field name="sequence">4</field>
            <field name="width">15</field>
            <field name="alignment">right</field>
            <field name="is_monetary" eval="True"/>
            <field name="decimal_places">2</field>
        </record>
        
        <record id="col_discount" model="custom.report.column">
            <field name="template_id" ref="template_arabic_sales_invoice_iqd"/>
            <field name="name">الخصم %</field>
            <field name="technical_name">discount</field>
            <field name="sequence">5</field>
            <field name="width">10</field>
            <field name="alignment">center</field>
        </record>
        
        <record id="col_subtotal" model="custom.report.column">
            <field name="template_id" ref="template_arabic_sales_invoice_iqd"/>
            <field name="name">المجموع</field>
            <field name="technical_name">price_subtotal</field>
            <field name="sequence">6</field>
            <field name="width">20</field>
            <field name="alignment">right</field>
            <field name="is_monetary" eval="True"/>
            <field name="show_total" eval="True"/>
            <field name="total_function">sum</field>
        </record>
        
        <!-- Default Totals -->
        <record id="total_subtotal" model="custom.report.total">
            <field name="template_id" ref="template_arabic_sales_invoice_iqd"/>
            <field name="name">المجموع الجزئي</field>
            <field name="technical_name">amount_untaxed</field>
            <field name="sequence">1</field>
        </record>
        
        <record id="total_tax" model="custom.report.total">
            <field name="template_id" ref="template_arabic_sales_invoice_iqd"/>
            <field name="name">الضريبة</field>
            <field name="technical_name">amount_tax</field>
            <field name="sequence">2</field>
        </record>
        
        <record id="total_grand" model="custom.report.total">
            <field name="template_id" ref="template_arabic_sales_invoice_iqd"/>
            <field name="name">المجموع الإجمالي</field>
            <field name="technical_name">amount_total</field>
            <field name="sequence">3</field>
            <field name="font_size">14</field>
            <field name="font_weight">bold</field>
            <field name="color">#4A90E2</field>
        </record>
        
    </data>
</odoo>


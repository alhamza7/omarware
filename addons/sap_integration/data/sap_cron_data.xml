<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- SAP Daily Auto-Sync Cron Job -->
        <record id="ir_cron_sap_daily_sync" model="ir.cron">
            <field name="name">SAP Daily Auto-Sync</field>
            <field name="model_id" ref="model_sap_auto_sync"/>
            <field name="state">code</field>
            <field name="code">model.run_daily_sync()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=2, minute=0, second=0)"/>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>
        
        <!-- SAP Alert Check Cron Job -->
        <record id="ir_cron_sap_alert_check" model="ir.cron">
            <field name="name">SAP Alert Check</field>
            <field name="model_id" ref="model_sap_alert_rule"/>
            <field name="state">code</field>
            <field name="code">model.check_all_rules()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        
        <!-- SAP Performance Cleanup Cron Job -->
        <record id="ir_cron_sap_performance_cleanup" model="ir.cron">
            <field name="name">SAP Performance Metrics Cleanup</field>
            <field name="model_id" ref="model_sap_performance_metrics"/>
            <field name="state">code</field>
            <field name="code">model.search([('timestamp', '&lt;', datetime.now() - timedelta(days=90))]).unlink()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        
        <!-- SAP Sync Log Cleanup Cron Job -->
        <record id="ir_cron_sap_sync_log_cleanup" model="ir.cron">
            <field name="name">SAP Sync Log Cleanup</field>
            <field name="model_id" ref="model_sap_sync_log"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_old_logs(days=30)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        
        <!-- SAP Health Check Cron Job -->
        <record id="ir_cron_sap_health_check" model="ir.cron">
            <field name="name">SAP Health Check</field>
            <field name="model_id" ref="model_sap_dashboard_enhanced"/>
            <field name="state">code</field>
            <field name="code">model.run_health_check()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!-- SAP Realtime Fast-Poll Sync — runs every 2 minutes -->
        <!-- Fetches only items changed since last run using UpdateDate/UpdateTime filter -->
        <record id="ir_cron_sap_realtime_sync" model="ir.cron">
            <field name="name">SAP Realtime Sync (Prices + Stock + Products + Customers)</field>
            <field name="model_id" ref="model_sap_realtime_sync"/>
            <field name="state">code</field>
            <field name="code">model.cron_run_fast_sync()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
        </record>

        <!-- SAP IQD/USD Exchange Rate Sync — runs every 30 minutes -->
        <!-- Reads DocRate from latest IQD document in SAP and updates ir.config_parameter + res.currency.rate -->
        <record id="ir_cron_sap_exchange_rate_sync" model="ir.cron">
            <field name="name">SAP Exchange Rate Sync (IQD/USD)</field>
            <field name="model_id" ref="model_sap_exchange_rate_sync"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_exchange_rate()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
        </record>

    </data>
</odoo>

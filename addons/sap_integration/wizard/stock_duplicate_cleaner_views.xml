<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Stock Duplicate Cleaner Form View -->
    <record id="view_stock_duplicate_cleaner_form" model="ir.ui.view">
        <field name="name">stock.duplicate.cleaner.form</field>
        <field name="model">stock.duplicate.cleaner</field>
        <field name="arch" type="xml">
            <form string="تنظيف المخزون المكرر">
                <group>
                    <field name="duplicate_count" readonly="1"/>
                    <field name="duplicate_info" readonly="1" widget="text"/>
                </group>
                <footer>
                    <button name="action_check_duplicates" string="فحص السجلات المكررة" 
                            type="object" class="btn-primary"/>
                    <button name="action_clean_duplicates" string="حذف السجلات المكررة" 
                            type="object" class="btn-danger"
                            confirm="هل أنت متأكد من حذف جميع السجلات المكررة؟ سيتم الاحتفاظ بأحدث سجل فقط."/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_stock_duplicate_cleaner" model="ir.actions.act_window">
        <field name="name">تنظيف المخزون المكرر</field>
        <field name="res_model">stock.duplicate.cleaner</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <!-- Menu Item -->
    <menuitem id="menu_stock_duplicate_cleaner"
              name="تنظيف المخزون المكرر"
              parent="menu_sap_tools"
              action="action_stock_duplicate_cleaner"
              sequence="100"/>

</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Comprehensive SAP Import Wizard -->
    <record id="view_sap_import_wizard_form" model="ir.ui.view">
        <field name="name">sap.import.wizard.form</field>
        <field name="model">sap.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Data from SAP">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                
                <div class="alert alert-success" role="alert" style="margin: 10px;" invisible="state != 'done'">
                    <h4>✅ Import Completed Successfully!</h4>
                    <p>Go to <strong>"Import Results"</strong> tab below to see the summary and detailed logs.</p>
                </div>
                
                <div class="alert alert-warning" role="alert" style="margin: 10px;" invisible="state != 'error'">
                    <h4>⚠️ Import Completed with Errors</h4>
                    <p>Go to <strong>"Import Results"</strong> tab below to see what went wrong.</p>
                </div>
                
                <group>
                    <group string="SAP Connection">
                        <field name="backend_id"/>
                    </group>
                </group>
                
                <notebook>
                    <page string="Import Options" invisible="state in ('done', 'error')">
                        <group>
                            <group string="Master Data">
                                <field name="import_customers"/>
                                <field name="import_products"/>
                                <field name="import_uoms"/>
                                <field name="import_warehouses"/>
                                <field name="import_pricelists"/>
                            </group>
                            <group string="Transactional Data">
                                <field name="import_quotations"/>
                                <field name="import_sales_orders"/>
                                <field name="import_invoices"/>
                            </group>
                        </group>
                        
                        <group>
                            <group string="Import Limits">
                                <field name="customer_limit" invisible="not import_customers"/>
                                <field name="product_limit" invisible="not import_products"/>
                                <field name="batch_size" string="Batch Size (Records per page)"/>
                            </group>
                            <group string="Logging Options">
                                <field name="show_logs"/>
                            </group>
                        </group>
                        
                        <div class="alert alert-info" role="alert">
                            <strong>Import Order:</strong> The wizard will import data in the following order:
                            <ol>
                                <li>Units of Measure (required for products)</li>
                                <li>Warehouses</li>
                                <li>Customers</li>
                                <li>Products</li>
                                <li>Pricelists</li>
                                <li>Quotations</li>
                                <li>Sales Orders</li>
                                <li>Invoices</li>
                            </ol>
                        </div>
                    </page>
                    
                    <page string="Import Results" autofocus="state in ('done', 'error')">
                        <div class="alert alert-info" role="alert" style="margin-bottom: 10px;" invisible="result_message">
                            <strong>ℹ️ No Results Yet</strong><br/>
                            Start an import from the "Import Options" tab to see results here.
                        </div>
                        
                        <div class="alert alert-success" role="alert" style="margin-bottom: 10px;" invisible="not result_message">
                            <strong>✓ Import Completed!</strong> See summary and detailed logs below.
                        </div>
                        
                        <group string="📊 Summary" invisible="not result_message">
                            <field name="result_message" readonly="1" nolabel="1" widget="text" 
                                   style="font-size: 13px; padding: 10px; background-color: #f8f9fa; border-radius: 5px;"/>
                        </group>
                        
                        <separator string="Detailed Import Log"/>
                        <group>
                            <field name="show_logs" string="Show Detailed Logs" widget="boolean_toggle"/>
                        </group>
                        
                        <field name="import_log" 
                               invisible="not show_logs"
                               readonly="1" 
                               nolabel="1" 
                               widget="text"
                               placeholder="Import logs will appear here after you start the import process..."
                               style="font-family: 'Courier New', monospace; font-size: 11px; background-color: #1e1e1e; color: #d4d4d4; padding: 15px; border-radius: 5px; min-height: 500px; max-height: 600px; white-space: pre-wrap; overflow-y: auto; border: 1px solid #444;"/>
                    </page>
                </notebook>
                
                <footer>
                    <button name="action_import_all" 
                            string="Import All" 
                            type="object" 
                            class="btn-success"
                            invisible="state in ('done', 'error')"/>
                    <button name="action_import_selected" 
                            string="Import Selected" 
                            type="object" 
                            class="btn-primary"
                            invisible="state in ('done', 'error')"/>
                    <button name="action_view_results" 
                            string="📊 View Detailed Results" 
                            type="object" 
                            class="btn-info"
                            invisible="state not in ('done', 'error')"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Main Action for Import Wizard -->
    <record id="action_sap_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Data from SAP</field>
        <field name="res_model">sap.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <!-- Menu Item for Import Wizard -->
    <menuitem id="menu_sap_import_wizard"
              name="Import from SAP"
              parent="sap_integration.menu_sap_tools"
              action="action_sap_import_wizard"
              sequence="10"/>
    
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Clear Pricelist Wizard Form -->
    <record id="view_sap_clear_pricelist_wizard_form" model="ir.ui.view">
        <field name="name">sap.clear.pricelist.wizard.form</field>
        <field name="model">sap.clear.pricelist.wizard</field>
        <field name="arch" type="xml">
            <form string="Clear SAP Pricelist Items">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <p><strong>⚠️ تحذير: عملية حذف دائمة</strong></p>
                        <p>سيتم حذف جميع:</p>
                        <ul>
                            <li>Pricelist Items من SAP Price Lists</li>
                            <li>SAP Product Pricelist Sync Records</li>
                        </ul>
                        <p>لا يمكن التراجع عن هذه العملية!</p>
                    </div>
                    
                    <group>
                        <field name="confirm"/>
                    </group>
                </sheet>
                <footer>
                    <button string="حذف الكل" 
                            name="action_clear_pricelists" 
                            type="object" 
                            class="btn-danger"
                            confirm="هل أنت متأكد من حذف جميع pricelist items؟"/>
                    <button string="إلغاء" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sap_clear_pricelist" model="ir.actions.act_window">
        <field name="name">Clear SAP Pricelists</field>
        <field name="res_model">sap.clear.pricelist.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_sap_clear_pricelist"
              name="Clear SAP Pricelists"
              parent="menu_sap_tools"
              action="action_sap_clear_pricelist"
              sequence="99"/>
</odoo>




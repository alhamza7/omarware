<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Conflict Resolution Wizard Form View -->
        <record id="view_sap_conflict_resolution_wizard_form" model="ir.ui.view">
            <field name="name">sap.conflict.resolution.wizard.form</field>
            <field name="model">sap.conflict.resolution.wizard</field>
            <field name="arch" type="xml">
                <form string="Resolve Sync Conflict">
                    <sheet>
                        <div class="oe_title">
                            <h1>Resolve Sync Conflict</h1>
                        </div>
                        
                        <!-- Basic Information -->
                        <group>
                            <group>
                                <field name="synced_data_id" readonly="1"/>
                                <field name="backend_id" readonly="1"/>
                                <field name="model_name" readonly="1"/>
                                <field name="external_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="conflict_reason" readonly="1"/>
                            </group>
                        </group>
                        
                        <!-- Data Comparison -->
                        <group string="Data Comparison">
                            <group>
                                <label for="sap_data" string="SAP Data"/>
                                <field name="sap_data" widget="text" readonly="1" nolabel="1"/>
                            </group>
                            <group>
                                <label for="odoo_data" string="Odoo Data"/>
                                <field name="odoo_data" widget="text" readonly="1" nolabel="1"/>
                            </group>
                        </group>
                        
                        <!-- Resolution Options -->
                        <group string="Resolution Options">
                            <field name="resolution_type" required="1"/>
                            <field name="resolution_notes" required="resolution_type == 'manual'"/>
                        </group>
                        
                        <!-- Field-level Resolution -->
                        <group string="Field-level Resolution" invisible="resolution_type != 'merged'">
                            <field name="field_resolutions" widget="one2many" nolabel="1">
                                <list editable="bottom">
                                    <field name="field_name"/>
                                    <field name="sap_value"/>
                                    <field name="odoo_value"/>
                                    <field name="resolution"/>
                                    <field name="custom_value" invisible="resolution != 'custom'" required="resolution == 'custom'"/>
                                </list>
                            </field>
                        </group>
                        
                        <!-- Preview -->
                        <group string="Resolution Preview" invisible="not preview_data">
                            <field name="preview_data" widget="text" readonly="1"/>
                        </group>
                        
                        <footer>
                            <button name="action_resolve_conflict" 
                                    string="Resolve Conflict" 
                                    type="object" 
                                    class="btn-primary"/>
                            <button string="Cancel" 
                                    class="btn-secondary" 
                                    special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Conflict Resolution Wizard Action -->
        <record id="action_sap_conflict_resolution_wizard" model="ir.actions.act_window">
            <field name="name">Resolve Sync Conflict</field>
            <field name="res_model">sap.conflict.resolution.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        
    </data>
</odoo>


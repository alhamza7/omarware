<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- SAP UoM Mapping Tree View -->
        <record id="view_sap_uom_mapping_tree" model="ir.ui.view">
            <field name="name">sap.uom.mapping.tree</field>
            <field name="model">sap.uom.mapping</field>
            <field name="arch" type="xml">
                <tree string="SAP UoM Mappings" 
                      decoration-success="validation_status=='valid'"
                      decoration-warning="validation_status=='warning'"
                      decoration-danger="validation_status=='error'"
                      create="true" edit="true">
                    
                    <field name="name"/>
                    <field name="sap_uom_code"/>
                    <field name="sap_uom_name"/>
                    <field name="odoo_uom_id"/>
                    <field name="conversion_factor"/>
                    <field name="inverse_factor"/>
                    <field name="uom_category"/>
                    <field name="usage_type"/>
                    <field name="precision_digits"/>
                    <field name="rounding_method"/>
                    <field name="validation_status" widget="badge"/>
                    <field name="active" widget="boolean_toggle"/>
                    
                    <button name="action_validate_mapping" 
                            type="object" 
                            icon="fa-check" 
                            string="Validate"
                            attrs="{'invisible': [('validation_status', '=', 'valid')]}"/>
                    <button name="action_test_conversion" 
                            type="object" 
                            icon="fa-calculator" 
                            string="Test Conversion"/>
                </tree>
            </field>
        </record>
        
        <!-- SAP UoM Mapping Form View -->
        <record id="view_sap_uom_mapping_form" model="ir.ui.view">
            <field name="name">sap.uom.mapping.form</field>
            <field name="model">sap.uom.mapping</field>
            <field name="arch" type="xml">
                <form string="SAP UoM Mapping">
                    <header>
                        <button name="action_validate_mapping" 
                                type="object" 
                                string="Validate Mapping"
                                class="btn-primary"/>
                        <button name="action_test_conversion" 
                                type="object" 
                                string="Test Conversion"
                                class="btn-secondary"/>
                        <field name="validation_status" widget="statusbar" statusbar_visible="valid,warning,error"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="sap_uom_code" required="1"/>
                                <field name="sap_uom_name"/>
                                <field name="odoo_uom_id" required="1"/>
                                <field name="uom_category" required="1"/>
                                <field name="usage_type" required="1"/>
                            </group>
                            <group>
                                <field name="conversion_factor" required="1"/>
                                <field name="inverse_factor" readonly="1"/>
                                <field name="precision_digits"/>
                                <field name="rounding_method"/>
                                <field name="active"/>
                            </group>
                        </group>
                        
                        <group string="Validation Information">
                            <field name="validation_message" readonly="1"/>
                        </group>
                        
                        <notebook>
                            <page string="Conversion Details" name="conversion_details">
                                <group>
                                    <field name="conversion_factor"/>
                                    <field name="inverse_factor"/>
                                    <field name="precision_digits"/>
                                    <field name="rounding_method"/>
                                </group>
                            </page>
                            
                            <page string="Usage Information" name="usage_info">
                                <group>
                                    <field name="usage_type"/>
                                    <field name="uom_category"/>
                                    <field name="active"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- SAP UoM Mapping Search View -->
        <record id="view_sap_uom_mapping_search" model="ir.ui.view">
            <field name="name">sap.uom.mapping.search</field>
            <field name="model">sap.uom.mapping</field>
            <field name="arch" type="xml">
                <search string="SAP UoM Mappings">
                    <field name="name"/>
                    <field name="sap_uom_code"/>
                    <field name="sap_uom_name"/>
                    <field name="odoo_uom_id"/>
                    <field name="uom_category"/>
                    <field name="usage_type"/>
                    
                    <filter string="Valid" name="valid" domain="[('validation_status', '=', 'valid')]"/>
                    <filter string="Warning" name="warning" domain="[('validation_status', '=', 'warning')]"/>
                    <filter string="Error" name="error" domain="[('validation_status', '=', 'error')]"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                    
                    <group expand="0" string="Group By">
                        <filter string="UoM Category" name="group_category" context="{'group_by': 'uom_category'}"/>
                        <filter string="Usage Type" name="group_usage_type" context="{'group_by': 'usage_type'}"/>
                        <filter string="Validation Status" name="group_validation_status" context="{'group_by': 'validation_status'}"/>
                        <filter string="Odoo UoM" name="group_odoo_uom" context="{'group_by': 'odoo_uom_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- SAP Product UoM Tree View -->
        <record id="view_sap_product_uom_tree" model="ir.ui.view">
            <field name="name">sap.product.uom.tree</field>
            <field name="model">sap.product.uom</field>
            <field name="arch" type="xml">
                <tree string="Product UoM Mappings" 
                      decoration-success="is_primary"
                      create="true" edit="true">
                    
                    <field name="product_id"/>
                    <field name="sap_uom_code"/>
                    <field name="sap_uom_name"/>
                    <field name="odoo_uom_id"/>
                    <field name="usage_type"/>
                    <field name="conversion_factor"/>
                    <field name="precision_digits"/>
                    <field name="is_primary" widget="boolean_toggle"/>
                    <field name="sequence"/>
                    <field name="active" widget="boolean_toggle"/>
                    
                    <button name="action_set_primary" 
                            type="object" 
                            icon="fa-star" 
                            string="Set Primary"
                            attrs="{'invisible': [('is_primary', '=', True)]}"/>
                    <button name="action_test_conversion" 
                            type="object" 
                            icon="fa-calculator" 
                            string="Test Conversion"/>
                </tree>
            </field>
        </record>
        
        <!-- SAP Product UoM Form View -->
        <record id="view_sap_product_uom_form" model="ir.ui.view">
            <field name="name">sap.product.uom.form</field>
            <field name="model">sap.product.uom</field>
            <field name="arch" type="xml">
                <form string="Product UoM Mapping">
                    <header>
                        <button name="action_set_primary" 
                                type="object" 
                                string="Set as Primary"
                                class="btn-primary"
                                attrs="{'invisible': [('is_primary', '=', True)]}"/>
                        <button name="action_test_conversion" 
                                type="object" 
                                string="Test Conversion"
                                class="btn-secondary"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="product_id" required="1"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="sap_uom_code" required="1"/>
                                <field name="sap_uom_name"/>
                                <field name="odoo_uom_id" required="1"/>
                                <field name="usage_type" required="1"/>
                                <field name="is_primary"/>
                            </group>
                            <group>
                                <field name="conversion_factor" required="1"/>
                                <field name="precision_digits"/>
                                <field name="sequence"/>
                                <field name="active"/>
                            </group>
                        </group>
                        
                        <group string="SAP Information">
                            <field name="sap_uom_category"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- UoM Conversion Test Wizard Form -->
        <record id="view_sap_uom_conversion_test_wizard_form" model="ir.ui.view">
            <field name="name">sap.uom.conversion.test.wizard.form</field>
            <field name="model">sap.uom.conversion.test.wizard</field>
            <field name="arch" type="xml">
                <form string="UoM Conversion Test">
                    <sheet>
                        <div class="oe_title">
                            <h1>UoM Conversion Test</h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="product_id"/>
                                <field name="from_uom" required="1"/>
                                <field name="to_uom" required="1"/>
                                <field name="quantity" required="1"/>
                            </group>
                            <group>
                                <field name="usage_type"/>
                            </group>
                        </group>
                        
                        <group string="Test Results" attrs="{'invisible': [('converted_quantity', '=', 0)]}">
                            <group>
                                <field name="conversion_factor" readonly="1"/>
                                <field name="converted_quantity" readonly="1"/>
                                <field name="precision_digits" readonly="1"/>
                                <field name="rounding_method" readonly="1"/>
                            </group>
                            <group>
                                <field name="is_valid" readonly="1"/>
                                <field name="error_message" readonly="1"/>
                            </group>
                        </group>
                        
                        <group string="Conversion Chain" attrs="{'invisible': [('conversion_chain', '=', False)]}">
                            <field name="conversion_chain" readonly="1" widget="text"/>
                        </group>
                        
                        <footer>
                            <button name="action_test_conversion" 
                                    string="Test Conversion" 
                                    type="object" 
                                    class="btn-primary"/>
                            <button name="action_validate_mapping" 
                                    string="Validate Mapping" 
                                    type="object" 
                                    class="btn-secondary"
                                    attrs="{'invisible': [('product_id', '=', False)]}"/>
                            <button name="action_create_conversion_rule" 
                                    string="Create Rule" 
                                    type="object" 
                                    class="btn-success"
                                    attrs="{'invisible': [('is_valid', '=', False)]}"/>
                            <button string="Cancel" 
                                    class="btn-secondary" 
                                    special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Actions -->
        <record id="action_sap_uom_mapping" model="ir.actions.act_window">
            <field name="name">SAP UoM Mappings</field>
            <field name="res_model">sap.uom.mapping</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_sap_uom_mapping_search"/>
            <field name="context">{'search_default_active': 1}</field>
        </record>
        
        <record id="action_sap_product_uom" model="ir.actions.act_window">
            <field name="name">Product UoM Mappings</field>
            <field name="res_model">sap.product.uom</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_active': 1}</field>
        </record>
        
        <record id="action_sap_uom_conversion_test" model="ir.actions.act_window">
            <field name="name">UoM Conversion Test</field>
            <field name="res_model">sap.uom.conversion.test.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        
        <!-- Menu Items -->
        <menuitem id="menu_sap_uom_management"
                  name="UoM Management"
                  parent="menu_sap_integration"
                  action="action_sap_uom_mapping"
                  sequence="70"/>
        
        <menuitem id="menu_sap_uom_mappings"
                  name="UoM Mappings"
                  parent="menu_sap_uom_management"
                  action="action_sap_uom_mapping"
                  sequence="10"/>
        
        <menuitem id="menu_sap_product_uom"
                  name="Product UoM Mappings"
                  parent="menu_sap_uom_management"
                  action="action_sap_product_uom"
                  sequence="20"/>
        
        <menuitem id="menu_sap_uom_conversion_test"
                  name="Conversion Test"
                  parent="menu_sap_uom_management"
                  action="action_sap_uom_conversion_test"
                  sequence="30"/>
        
    </data>
</odoo>

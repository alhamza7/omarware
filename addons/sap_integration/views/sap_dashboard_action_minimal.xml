<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Minimal, Odoo 19–compatible dashboard action used by menu_sap_dashboard.
         NOTE: use form-only view_mode because there is no custom tree view
         defined for sap.dashboard yet, and Odoo 19 complains if 'tree' is
         listed without a corresponding view. -->
    <record id="action_sap_dashboard" model="ir.actions.act_window">
        <field name="name">SAP Dashboard</field>
        <!-- Keep the original model so we can later plug a nicer view if needed -->
        <field name="res_model">sap.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>

</odoo>



<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- SAP Quotation Sync Tree View -->
        <record id="view_sap_quotation_sync_tree" model="ir.ui.view">
            <field name="name">sap.quotation.sync.tree</field>
            <field name="model">sap.quotation.sync</field>
            <field name="arch" type="xml">
                <list string="Quotation Sync" 
                      decoration-success="sync_status == 'success'" 
                      decoration-danger="sync_status == 'error'">
                    <field name="backend_id"/>
                    <field name="odoo_quotation_id"/>
                    <field name="sap_quotation_id"/>
                    <field name="sync_status" widget="badge"/>
                    <field name="sync_direction"/>
                    <field name="last_sync"/>
                </list>
            </field>
        </record>
        
        <!-- SAP Quotation Sync Form View -->
        <record id="view_sap_quotation_sync_form" model="ir.ui.view">
            <field name="name">sap.quotation.sync.form</field>
            <field name="model">sap.quotation.sync</field>
            <field name="arch" type="xml">
                <form string="Quotation Sync">
                    <header>
                        <field name="sync_status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="backend_id"/>
                                <field name="odoo_quotation_id"/>
                                <field name="sap_quotation_id"/>
                            </group>
                            <group>
                                <field name="sync_direction"/>
                                <field name="last_sync"/>
                                <field name="retry_count"/>
                                <field name="max_retries"/>
                            </group>
                        </group>
                        <group string="Error" invisible="not error_message">
                            <field name="error_message"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- SAP Quotation Sync Action -->
        <record id="action_sap_quotation_sync" model="ir.actions.act_window">
            <field name="name">Quotation Sync</field>
            <field name="res_model">sap.quotation.sync</field>
            <field name="view_mode">list,form</field>
        </record>
        
        <!-- Menu Item -->
        <menuitem id="menu_sap_quotation_sync"
                  name="Quotation Sync"
                  parent="menu_sap_integration"
                  action="action_sap_quotation_sync"
                  sequence="50"/>
        
    </data>
</odoo>






<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- SAP Auto Sync Form View -->
        <record id="view_sap_auto_sync_form" model="ir.ui.view">
            <field name="name">sap.auto.sync.form</field>
            <field name="model">sap.auto.sync</field>
            <field name="arch" type="xml">
                <form string="SAP Auto Sync">
                    <header>
                        <button name="action_manual_sync" 
                                string="🔄 Sync Now" 
                                type="object" 
                                class="oe_highlight"/>
                        <field name="last_sync_status" widget="badge" 
                               decoration-success="last_sync_status == 'success'"
                               decoration-danger="last_sync_status == 'failed'"
                               decoration-warning="last_sync_status == 'running'"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                                <field name="active" widget="boolean_button" options='{"terminology": "active"}'/>
                            </button>
                        </div>
                        
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="e.g. Daily SAP Sync"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group string="Configuration">
                                <field name="backend_id"/>
                                <field name="batch_size"/>
                                <field name="product_limit"/>
                            </group>
                            <group string="Last Sync">
                                <field name="last_sync_date"/>
                                <field name="total_synced"/>
                                <field name="total_errors"/>
                            </group>
                        </group>
                        
                        <group string="Sync Options">
                            <group>
                                <field name="sync_uom_groups"/>
                                <field name="sync_products"/>
                                <field name="sync_commercial_flags"/>
                                <field name="force_enable_sales_pos"/>
                                <field name="deactivate_odoo_not_in_sap"/>
                            </group>
                            <group>
                                <field name="sync_pricelists"/>
                                <field name="sync_warehouse"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Last Sync Log" name="log">
                                <field name="last_sync_log" widget="text" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- SAP Auto Sync Tree View -->
        <record id="view_sap_auto_sync_tree" model="ir.ui.view">
            <field name="name">sap.auto.sync.tree</field>
            <field name="model">sap.auto.sync</field>
            <field name="arch" type="xml">
                <list string="SAP Auto Sync">
                    <field name="name"/>
                    <field name="backend_id"/>
                    <field name="active" widget="boolean_toggle"/>
                    <field name="last_sync_date"/>
                    <field name="last_sync_status" widget="badge" 
                           decoration-success="last_sync_status == 'success'"
                           decoration-danger="last_sync_status == 'failed'"
                           decoration-warning="last_sync_status == 'running'"/>
                    <field name="total_synced"/>
                    <field name="total_errors"/>
                </list>
            </field>
        </record>
        
        <!-- SAP Auto Sync Action -->
        <record id="action_sap_auto_sync" model="ir.actions.act_window">
            <field name="name">SAP Auto Sync</field>
            <field name="res_model">sap.auto.sync</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    إنشاء تكوين للتزامن التلقائي مع SAP
                </p>
                <p>
                    سيتم تشغيل التزامن تلقائياً كل يوم في الساعة 2:00 صباحاً.<br/>
                    يمكنك أيضاً تشغيل التزامن يدوياً باستخدام زر "Sync Now".
                </p>
            </field>
        </record>
        
        <!-- Add to SAP Menu -->
        <menuitem id="menu_sap_auto_sync"
                  name="Auto Sync"
                  parent="sap_integration.menu_sap_configuration"
                  action="action_sap_auto_sync"
                  sequence="60"/>
        
    </data>
</odoo>


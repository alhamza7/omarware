<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Overview Graph View -->
        <record id="view_sap_synced_data_overview_graph" model="ir.ui.view">
            <field name="name">sap.synced.data.overview.graph</field>
            <field name="model">sap.synced.data</field>
            <field name="arch" type="xml">
                <graph string="Sync Status Overview" type="bar" stacked="True">
                    <field name="last_sync_date" type="row" interval="day"/>
                    <field name="sync_status" type="groupBy"/>
                    <field name="id" type="measure"/>
                </graph>
            </field>
        </record>
        
        <!-- Status Pivot View -->
        <record id="view_sap_synced_data_status_pivot" model="ir.ui.view">
            <field name="name">sap.synced.data.status.pivot</field>
            <field name="model">sap.synced.data</field>
            <field name="arch" type="xml">
                <pivot string="Sync Status by Model">
                    <field name="backend_id" type="row"/>
                    <field name="model_name" type="col"/>
                    <field name="sync_status" type="col"/>
                    <field name="id" type="measure"/>
                    <field name="sync_count" type="measure"/>
                    <field name="error_count" type="measure"/>
                </pivot>
            </field>
        </record>
        
        <!-- Quick Stats View -->
        <record id="view_sap_synced_data_quick_stats" model="ir.ui.view">
            <field name="name">sap.synced.data.quick.stats</field>
            <field name="model">sap.synced.data</field>
            <field name="arch" type="xml">
                <kanban string="Quick Stats" class="o_kanban_dashboard">
                    <field name="sync_status"/>
                    <field name="model_name"/>
                    <field name="backend_id"/>
                    <field name="sync_count"/>
                    <field name="error_count"/>
                    <field name="is_stale"/>
                    
                    <templates>
                        <t t-name="kanban-box">
                            <div class="o_kanban_card o_kanban_global_click">
                                <div class="o_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="model_name"/>
                                            </strong>
                                        </div>
                                        <div class="o_kanban_record_subtitle">
                                            <field name="backend_id"/>
                                        </div>
                                    </div>
                                    
                                    <div class="o_kanban_record_body">
                                        <div class="text-muted">
                                            <field name="sync_status" widget="label_selection"/>
                                        </div>
                                        <div class="text-muted">
                                            Syncs: <field name="sync_count"/>
                                        </div>
                                        <div t-if="record.error_count.value > 0" class="text-danger">
                                            <i class="fa fa-exclamation-triangle"/> <field name="error_count"/> errors
                                        </div>
                                        <div t-if="record.is_stale.value" class="text-warning">
                                            <i class="fa fa-clock-o"/> Stale
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Recent Activity View -->
        <record id="view_sap_synced_data_recent_activity" model="ir.ui.view">
            <field name="name">sap.synced.data.recent.activity</field>
            <field name="model">sap.synced.data</field>
            <field name="arch" type="xml">
                <list string="Recent Activity" decoration-success="sync_status == 'success'" 
                      decoration-danger="sync_status == 'failed'" 
                      decoration-warning="sync_status in ['pending', 'needs_attention']"
                      create="false" edit="false">
                    <field name="display_name"/>
                    <field name="backend_id"/>
                    <field name="model_name"/>
                    <field name="sync_status"/>
                    <field name="last_sync_date"/>
                    <field name="error_count"/>
                    <field name="is_stale"/>
                </list>
            </field>
        </record>
        
        <!-- Dashboard Actions -->
        <record id="action_sap_synced_data_dashboard" model="ir.actions.act_window">
            <field name="name">Synced Data Dashboard</field>
            <field name="res_model">sap.synced.data</field>
            <field name="view_mode">list,kanban,form,pivot,graph</field>
        </record>
        
        <record id="action_sap_synced_data_quick_stats" model="ir.actions.act_window">
            <field name="name">Quick Stats</field>
            <field name="res_model">sap.synced.data</field>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="view_sap_synced_data_quick_stats"/>
            <field name="context">{'group_by': ['model_name', 'sync_status']}</field>
        </record>
        
        <record id="action_sap_synced_data_recent_activity" model="ir.actions.act_window">
            <field name="name">Recent Activity</field>
            <field name="res_model">sap.synced.data</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_sap_synced_data_recent_activity"/>
            
        </record>
        
        <!-- Dashboard Menu Items -->
        <menuitem id="menu_sap_synced_data_dashboard"
                  name="Dashboard"
                  parent="menu_sap_synced_data"
                  action="action_sap_synced_data_dashboard"
                  sequence="5"/>
        
        <menuitem id="menu_sap_synced_data_quick_stats"
                  name="Quick Stats"
                  parent="menu_sap_synced_data"
                  action="action_sap_synced_data_quick_stats"
                  sequence="6"/>
        
        <menuitem id="menu_sap_synced_data_recent_activity"
                  name="Recent Activity"
                  parent="menu_sap_synced_data"
                  action="action_sap_synced_data_recent_activity"
                  sequence="7"/>
        
    </data>
</odoo>

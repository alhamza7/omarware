<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SAP Dashboard Form View -->
    <record id="view_sap_dashboard_form" model="ir.ui.view">
        <field name="name">sap.dashboard.form</field>
        <field name="model">sap.dashboard</field>
        <field name="arch" type="xml">
            <form string="SAP Integration Dashboard" create="false" delete="false">
                <header>
                    <button name="action_refresh_stats" 
                            string="🔄 Refresh Statistics" 
                            type="object" 
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span>📊 SAP Integration Dashboard</span>
                        </h1>
                    </div>
                    
                    <!-- Backend Statistics -->
                    <group name="backend_stats" string="🔌 Backend Status">
                        <div class="row">
                            <div class="col-4">
                                <div class="oe_stat_button" style="background-color: #e8f5e9; padding: 15px; border-radius: 8px; text-align: center;">
                                    <div style="font-size: 32px; font-weight: bold; color: #2e7d32;">
                                        <field name="total_backends" readonly="1"/>
                                    </div>
                                    <div style="font-size: 14px; color: #666;">Total Backends</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="oe_stat_button" style="background-color: #e3f2fd; padding: 15px; border-radius: 8px; text-align: center;">
                                    <div style="font-size: 32px; font-weight: bold; color: #1976d2;">
                                        <field name="active_backends" readonly="1"/>
                                    </div>
                                    <div style="font-size: 14px; color: #666;">Active Backends</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="oe_stat_button" style="background-color: #f3e5f5; padding: 15px; border-radius: 8px; text-align: center;">
                                    <div style="font-size: 32px; font-weight: bold; color: #7b1fa2;">
                                        <field name="connected_backends" readonly="1"/>
                                    </div>
                                    <div style="font-size: 14px; color: #666;">Connected</div>
                                </div>
                            </div>
                        </div>
                    </group>
                    
                    <!-- Sync Statistics -->
                    <group name="sync_stats" string="📦 Synchronized Records">
                        <div class="row mt-3">
                            <div class="col-3">
                                <button name="action_view_partners" 
                                        type="object" 
                                        class="oe_stat_button"
                                        style="background-color: #fff3e0; width: 100%; padding: 20px; border-radius: 8px;">
                                    <div style="text-align: center;">
                                        <div style="font-size: 36px; font-weight: bold; color: #f57c00;">
                                            <field name="total_partners" readonly="1"/>
                                        </div>
                                        <div style="font-size: 14px; color: #666;">👥 Partners</div>
                                        <div style="font-size: 12px; color: #999;">
                                            <field name="partners_last_week" readonly="1"/> this week
                                        </div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-3">
                                <button name="action_view_products" 
                                        type="object" 
                                        class="oe_stat_button"
                                        style="background-color: #e0f2f1; width: 100%; padding: 20px; border-radius: 8px;">
                                    <div style="text-align: center;">
                                        <div style="font-size: 36px; font-weight: bold; color: #00796b;">
                                            <field name="total_products" readonly="1"/>
                                        </div>
                                        <div style="font-size: 14px; color: #666;">📦 Products</div>
                                        <div style="font-size: 12px; color: #999;">
                                            <field name="products_last_week" readonly="1"/> this week
                                        </div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-3">
                                <button name="action_view_orders" 
                                        type="object" 
                                        class="oe_stat_button"
                                        style="background-color: #fce4ec; width: 100%; padding: 20px; border-radius: 8px;">
                                    <div style="text-align: center;">
                                        <div style="font-size: 36px; font-weight: bold; color: #c2185b;">
                                            <field name="total_orders" readonly="1"/>
                                        </div>
                                        <div style="font-size: 14px; color: #666;">🛒 Orders</div>
                                        <div style="font-size: 12px; color: #999;">
                                            <field name="orders_last_week" readonly="1"/> this week
                                        </div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-3">
                                <div class="oe_stat_button" style="background-color: #f1f8e9; padding: 20px; border-radius: 8px; text-align: center;">
                                    <div style="font-size: 36px; font-weight: bold; color: #558b2f;">
                                        <field name="total_invoices" readonly="1"/>
                                    </div>
                                    <div style="font-size: 14px; color: #666;">🧾 Invoices</div>
                                </div>
                            </div>
                        </div>
                    </group>
                    
                    <!-- Error Statistics -->
                    <group name="error_stats" string="⚠️ Error Statistics">
                        <div class="row mt-3">
                            <div class="col-6">
                                <button name="action_view_errors" 
                                        type="object" 
                                        class="oe_stat_button"
                                        style="background-color: #ffebee; width: 100%; padding: 20px; border-radius: 8px;">
                                    <div style="text-align: center;">
                                        <div style="font-size: 36px; font-weight: bold; color: #d32f2f;">
                                            <field name="total_errors" readonly="1"/>
                                        </div>
                                        <div style="font-size: 14px; color: #666;">❌ Total Errors</div>
                                        <div style="font-size: 12px; color: #999;">Click to view details</div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-6">
                                <div class="oe_stat_button" style="background-color: #fff9c4; padding: 20px; border-radius: 8px; text-align: center;">
                                    <div style="font-size: 36px; font-weight: bold; color: #f57f17;">
                                        <field name="errors_last_week" readonly="1"/>
                                    </div>
                                    <div style="font-size: 14px; color: #666;">⚠️ Errors This Week</div>
                                </div>
                            </div>
                        </div>
                    </group>
                    
                    <!-- Performance Metrics -->
                    <group name="performance" string="⚡ Performance Metrics">
                        <group>
                            <field name="last_sync_date" readonly="1"/>
                            <field name="avg_sync_time" readonly="1" widget="float_time"/>
                        </group>
                    </group>
                    
                    <!-- Quick Actions -->
                    <group name="quick_actions" string="⚡ Quick Actions">
                        <div class="row mt-2">
                            <div class="col-12">
                                <div class="alert alert-info">
                                    <strong>💡 Tip:</strong> Click on the statistics above to view detailed records.<br/>
                                    Use the <strong>Bulk Import</strong> menu to import data from SAP.
                                </div>
                            </div>
                        </div>
                    </group>
                    
                </sheet>
            </form>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="action_sap_dashboard" model="ir.actions.act_window">
        <field name="name">SAP Dashboard</field>
        <field name="res_model">sap.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'create': False, 'delete': False}</field>
    </record>

    <!-- Root Menu -->
    <menuitem id="menu_sap_integration"
              name="SAP Integration"
              sequence="10"
              action="action_sap_dashboard"/>

    <!-- Management Tools Menu - Defined here to ensure it's available before wizards -->
    <menuitem id="menu_sap_tools"
              name="🔧 Management Tools"
              parent="menu_sap_integration"
              sequence="40"/>

    <!-- All other menu items moved here from sap_menu_structure.xml to fix Odoo 19 XML schema validation -->
    <!-- SAP Integration Menu Items -->
    <menuitem id="menu_sap_dashboard"
              name="📊 Dashboard"
              parent="menu_sap_integration"
              action="action_sap_dashboard"
              sequence="1"/>

    <!-- Configuration Section -->
    <menuitem id="menu_sap_configuration"
                  name="⚙️ Configuration"
                  parent="menu_sap_integration"
                  sequence="10"/>

    <menuitem id="menu_sap_backend"
              name="SAP Backends"
              parent="menu_sap_configuration"
              action="action_sap_backend"
              sequence="1"/>

    <menuitem id="menu_sap_connector"
              name="SAP Connectors"
              parent="menu_sap_configuration"
              action="action_sap_connector"
              sequence="2"/>

    <menuitem id="menu_sap_uom_sync"
              name="UoM Mapping"
              parent="menu_sap_configuration"
              action="action_sap_uom_mapping"
              sequence="3"/>

    <menuitem id="menu_sap_pricelist_sync"
              name="Pricelist Mapping"
              parent="menu_sap_configuration"
              action="action_sap_pricelist_sync"
              sequence="4"/>

    <!-- Synchronization Section -->
    <menuitem id="menu_sap_sync"
              name="🔄 Synchronization"
              parent="menu_sap_integration"
              sequence="20"/>

    <menuitem id="menu_sap_customer_sync"
              name="Customers"
              parent="menu_sap_sync"
              action="action_sap_customer_sync"
              sequence="1"/>

    <menuitem id="menu_sap_product_sync"
              name="Products"
              parent="menu_sap_sync"
              action="action_sap_product_sync"
              sequence="2"/>

    <menuitem id="menu_sap_quotation_sync"
              name="Quotations"
              parent="menu_sap_sync"
              action="action_sap_quotation_sync"
              sequence="3"/>

    <menuitem id="menu_sap_sale_sync"
              name="Sales Orders"
              parent="menu_sap_sync"
              action="action_sap_sale_sync"
              sequence="4"/>

    <menuitem id="menu_sap_warehouse" 
              name="Warehouses" 
              parent="menu_sap_sync" 
              action="action_sap_warehouse"
              sequence="5"/>

    <!-- Data Management Section -->
    <menuitem id="menu_sap_data_management"
              name="📦 Data Management"
              parent="menu_sap_integration"
              sequence="30"/>
    
    <!-- New: Complete Product Migration -->
    <menuitem id="menu_sap_product_extended"
              name="Extended Product Info"
              parent="menu_sap_data_management"
              action="action_sap_product_extended"
              sequence="1"/>
    
    <menuitem id="menu_sap_sync_foreign_names"
              name="Sync Foreign Names to Products"
              parent="menu_sap_data_management"
              action="action_sync_all_foreign_names_to_products_wizard"
              sequence="1.5"/>
    
    <menuitem id="menu_sap_product_pricelist_sync"
              name="Product Pricelist Sync"
              parent="menu_sap_data_management"
              action="action_sap_product_pricelist_sync"
              sequence="2"/>

    <menuitem id="menu_sap_product_warehouse_info"
              name="Product Warehouse Info"
              parent="menu_sap_data_management"
              action="action_sap_product_warehouse_info"
              sequence="3"/>

    <!-- Bindings Submenu -->
    <menuitem id="menu_sap_bindings"
              name="Bindings"
              parent="menu_sap_data_management"
              sequence="1"/>

    <menuitem id="menu_sap_customer_binding"
              name="Customer Bindings"
              parent="menu_sap_bindings"
              action="action_sap_customer_binding"
              sequence="1"/>

    <menuitem id="menu_sap_product_binding"
              name="Product Bindings"
              parent="menu_sap_bindings"
              action="action_sap_product_binding"
              sequence="2"/>

    <!-- Synced Data -->
    <menuitem id="menu_sap_synced_data"
              name="Synced Data"
              parent="menu_sap_data_management"
              sequence="2"/>

    <menuitem id="menu_sap_synced_data_dashboard"
              name="Dashboard"
              parent="menu_sap_synced_data"
              action="action_sap_synced_data_dashboard"
              sequence="1"/>

    <menuitem id="menu_sap_synced_data_quick_stats"
              name="Quick Stats"
              parent="menu_sap_synced_data"
              action="action_sap_synced_data_quick_stats"
              sequence="2"/>

    <menuitem id="menu_sap_synced_data_recent_activity"
              name="Recent Activity"
              parent="menu_sap_synced_data"
              action="action_sap_synced_data_recent_activity"
              sequence="3"/>

    <menuitem id="menu_sap_synced_data_failed"
              name="Failed Syncs"
              parent="menu_sap_synced_data"
              action="action_sap_synced_data_failed"
              sequence="4"/>

    <menuitem id="menu_sap_synced_data_conflicts"
              name="Sync Conflicts"
              parent="menu_sap_synced_data"
              action="action_sap_synced_data_conflicts"
              sequence="5"/>

    <menuitem id="menu_sap_synced_data_stale"
              name="Stale Records"
              parent="menu_sap_synced_data"
              action="action_sap_synced_data_stale"
              sequence="6"/>

    <!-- Sync Logs -->
    <menuitem id="menu_sap_sync_log"
              name="Sync Logs"
              parent="menu_sap_data_management"
              action="action_sap_sync_log"
              sequence="3"/>

    <!-- Sync Management -->
    <menuitem id="menu_sap_sync_management"
              name="Sync Management"
              parent="menu_sap_tools"
              sequence="1"/>

    <menuitem id="menu_sap_batch_processing"
              name="Batch Processing"
              parent="menu_sap_sync_management"
              action="action_sap_batch_processing"
              sequence="1"/>

    <menuitem id="menu_sap_retry_mechanism"
              name="Retry Mechanism"
              parent="menu_sap_sync_management"
              action="action_sap_retry_mechanism"
              sequence="2"/>

    <!-- UoM Management -->
    <menuitem id="menu_sap_uom_management"
              name="UoM Management"
              parent="menu_sap_tools"
              sequence="2"/>

    <menuitem id="menu_sap_product_uom"
              name="Product UoM Mappings"
              parent="menu_sap_uom_management"
              action="action_sap_product_uom"
              sequence="2"/>

    <menuitem id="menu_sap_uom_conversion_test"
              name="Conversion Test"
              parent="menu_sap_uom_management"
              action="action_sap_uom_conversion_test"
              sequence="3"/>

    <!-- User Management Section -->
    <menuitem id="menu_sap_user_management"
              name="👥 User Management"
              parent="menu_sap_integration"
              sequence="50"/>

    <!-- Monitoring &amp; Analytics Section -->
    <menuitem id="menu_sap_monitoring"
              name="📈 Monitoring &amp; Analytics"
              parent="menu_sap_integration"
              sequence="60"/>

    <menuitem id="menu_sap_dashboard_control"
              name="Dashboard Control"
              parent="menu_sap_monitoring"
              action="action_sap_dashboard_control"
              sequence="1"/>

    <!-- Analysis &amp; Monitoring -->
    <menuitem id="menu_sap_analysis"
              name="Analysis &amp; Reports"
              parent="menu_sap_monitoring"
              sequence="2"/>

    <menuitem id="menu_sap_error_analysis"
              name="Error Analysis"
              parent="menu_sap_analysis"
              action="action_sap_error_analysis"
              sequence="1"/>

</odoo>




<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View -->
        <record id="view_sap_exchange_rate_sync_list" model="ir.ui.view">
            <field name="name">sap.exchange.rate.sync.list</field>
            <field name="model">sap.exchange.rate.sync</field>
            <field name="arch" type="xml">
                <list string="SAP Exchange Rate Sync"
                      decoration-danger="last_sync_status == 'failed'"
                      decoration-success="last_sync_status == 'success'"
                      decoration-muted="last_sync_status == 'no_change'">
                    <field name="backend_id" string="SAP Backend"/>
                    <field name="active" widget="boolean_toggle"/>
                    <field name="last_rate" string="Rate (IQD/USD)" widget="float" digits="[12,2]"/>
                    <field name="last_sync_at" string="Last Sync"/>
                    <field name="last_sync_status" string="Status" widget="badge"
                           decoration-danger="last_sync_status == 'failed'"
                           decoration-success="last_sync_status == 'success'"
                           decoration-muted="last_sync_status == 'no_change'"/>
                    <field name="total_runs" string="Runs"/>
                    <field name="total_errors" string="Errors"/>
                    <button name="action_sync_now" string="Sync Now" type="object"
                            icon="fa-refresh" class="btn-sm btn-primary"/>
                    <button name="action_set_rate_1560_new_only" string="1560 للجديد فقط" type="object"
                            icon="fa-money" class="btn-sm btn-secondary"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_sap_exchange_rate_sync_form" model="ir.ui.view">
            <field name="name">sap.exchange.rate.sync.form</field>
            <field name="model">sap.exchange.rate.sync</field>
            <field name="arch" type="xml">
                <form string="SAP Exchange Rate Sync">
                    <header>
                        <button name="action_sync_now"
                                string="Sync Now"
                                type="object"
                                class="btn-primary"/>
                        <button name="action_set_rate_1560_new_only"
                                string="تعيين 1560 للجديد فقط"
                                type="object"
                                class="btn-secondary"
                                title="سعر الصرف 1560 للفواتير والـ POS الجديد فقط — لا يغيّر الفواتير القديمة"/>
                        <field name="last_sync_status" widget="statusbar"
                               statusbar_visible="success,no_change,failed"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                                invisible="active"/>
                        <group>
                            <group string="Configuration">
                                <field name="backend_id" string="SAP Backend"/>
                                <field name="active" string="Active"/>
                            </group>
                            <group string="Last Result">
                                <field name="last_rate" string="Rate IQD/USD" readonly="1"
                                       widget="float" digits="[12,2]"/>
                                <field name="last_sync_at" string="Last Sync" readonly="1"/>
                                <field name="total_runs" string="Total Runs" readonly="1"/>
                                <field name="total_errors" string="Errors" readonly="1"/>
                            </group>
                        </group>
                        <group string="Log">
                            <field name="last_sync_log" nolabel="1" readonly="1" widget="text"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_sap_exchange_rate_sync" model="ir.actions.act_window">
            <field name="name">SAP Exchange Rate Sync</field>
            <field name="res_model">sap.exchange.rate.sync</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No exchange rate sync configured yet</p>
                <p>Create a config to auto-sync the IQD/USD rate from SAP every 30 minutes.</p>
            </field>
        </record>

    </data>
</odoo>

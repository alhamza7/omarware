<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom Report Template Form View -->
    <record id="view_custom_report_template_form" model="ir.ui.view">
        <field name="name">custom.report.template.form</field>
        <field name="model">custom.report.template</field>
        <field name="arch" type="xml">
            <form string="Custom Report Template">
                <header>
                    <button name="action_preview" string="معاينة / Preview" type="object" class="btn-primary"/>
                    <button name="action_duplicate" string="نسخ / Duplicate" type="object"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="اسم القالب..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="report_type"/>
                            <field name="sequence"/>
                            <field name="language"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="show_currency_name"/>
                            <field name="currency_position"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <!-- Page Settings -->
                        <page string="إعدادات الصفحة" name="page_settings">
                            <group>
                                <group string="حجم الورق">
                                    <field name="paper_format_id"/>
                                    <field name="orientation"/>
                                    <field name="page_width"/>
                                    <field name="page_height"/>
                                </group>
                                <group string="الهوامش">
                                    <field name="margin_top"/>
                                    <field name="margin_bottom"/>
                                    <field name="margin_left"/>
                                    <field name="margin_right"/>
                                </group>
                            </group>
                            <group>
                                <group string="صفحات متعددة">
                                    <field name="repeat_header"/>
                                    <field name="repeat_table_header"/>
                                    <field name="max_rows_per_page"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- Header -->
                        <page string="الترويسة" name="header">
                            <group>
                                <field name="show_header"/>
                                <field name="header_height"/>
                            </group>
                            <group string="الشعار">
                                <field name="show_logo"/>
                                <field name="logo_position"/>
                                <field name="logo_width"/>
                            </group>
                            <group string="معلومات الشركة">
                                <field name="show_company_info"/>
                                <field name="company_info_position"/>
                            </group>
                            <separator string="HTML مخصص"/>
                            <field name="header_html" widget="html"/>
                        </page>
                        
                        <!-- Title -->
                        <page string="العنوان" name="title">
                            <group>
                                <group>
                                    <field name="show_title"/>
                                    <field name="title_text"/>
                                    <field name="title_alignment"/>
                                </group>
                                <group>
                                    <field name="title_font_size"/>
                                    <field name="title_color" widget="color"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- Customer & Document Info -->
                        <page string="معلومات العميل والمستند" name="info">
                            <group string="معلومات العميل">
                                <field name="show_customer_info"/>
                                <field name="customer_info_position"/>
                                <field name="customer_fields" widget="many2many_tags"/>
                            </group>
                            <group string="معلومات المستند">
                                <field name="show_document_info"/>
                                <field name="document_info_position"/>
                                <field name="document_fields" widget="many2many_tags"/>
                            </group>
                        </page>
                        
                        <!-- Table -->
                        <page string="جدول المنتجات" name="table">
                            <group>
                                <field name="show_table"/>
                            </group>
                            <group string="تنسيق الجدول">
                                <group>
                                    <field name="table_header_bg" widget="color"/>
                                    <field name="table_header_color" widget="color"/>
                                    <field name="table_border_color" widget="color"/>
                                </group>
                                <group>
                                    <field name="table_row_height"/>
                                    <field name="table_font_size"/>
                                    <field name="alternate_row_colors"/>
                                </group>
                            </group>
                            <group string="ألوان الصفوف" attrs="{'invisible': [('alternate_row_colors', '=', False)]}">
                                <field name="row_color_1" widget="color"/>
                                <field name="row_color_2" widget="color"/>
                            </group>
                            <separator string="أعمدة الجدول"/>
                            <field name="table_columns">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="technical_name"/>
                                    <field name="width"/>
                                    <field name="alignment"/>
                                    <field name="is_monetary"/>
                                    <field name="decimal_places" attrs="{'invisible': [('is_monetary', '=', False)]}"/>
                                    <field name="show_total"/>
                                    <field name="total_function" attrs="{'invisible': [('show_total', '=', False)]}"/>
                                    <field name="visible"/>
                                </tree>
                            </field>
                        </page>
                        
                        <!-- Totals -->
                        <page string="المجاميع" name="totals">
                            <group>
                                <field name="show_totals"/>
                                <field name="totals_position"/>
                            </group>
                            <separator string="حقول المجاميع"/>
                            <field name="totals_fields">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="technical_name"/>
                                    <field name="font_size"/>
                                    <field name="font_weight"/>
                                    <field name="color" widget="color"/>
                                    <field name="visible"/>
                                </tree>
                            </field>
                        </page>
                        
                        <!-- Sections -->
                        <page string="أقسام إضافية" name="sections">
                            <field name="sections">
                                <tree>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="position"/>
                                    <field name="content_type"/>
                                    <field name="visible"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="name"/>
                                            <field name="sequence"/>
                                            <field name="position"/>
                                            <field name="content_type"/>
                                        </group>
                                        <group>
                                            <field name="visible"/>
                                            <field name="height"/>
                                        </group>
                                    </group>
                                    <group string="المحتوى">
                                        <field name="content_html" widget="html" attrs="{'invisible': [('content_type', '!=', 'html')]}"/>
                                        <field name="content_text" attrs="{'invisible': [('content_type', '!=', 'text')]}"/>
                                        <field name="content_field" attrs="{'invisible': [('content_type', '!=', 'field')]}"/>
                                    </group>
                                    <group string="التنسيق">
                                        <field name="background_color" widget="color"/>
                                        <field name="border"/>
                                        <field name="border_color" widget="color" attrs="{'invisible': [('border', '=', False)]}"/>
                                        <field name="padding"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        
                        <!-- Footer -->
                        <page string="التذييل" name="footer">
                            <group>
                                <field name="show_footer"/>
                                <field name="footer_height"/>
                                <field name="show_page_number"/>
                            </group>
                            <separator string="HTML مخصص"/>
                            <field name="footer_html" widget="html"/>
                        </page>
                        
                        <!-- Background & Watermark -->
                        <page string="الخلفية والعلامة المائية" name="background">
                            <group string="صورة الخلفية">
                                <field name="background_image" widget="image"/>
                                <field name="background_filename" invisible="1"/>
                                <field name="background_opacity"/>
                            </group>
                            <group string="العلامة المائية">
                                <field name="watermark_text"/>
                                <field name="watermark_angle"/>
                            </group>
                        </page>
                        
                        <!-- Custom CSS -->
                        <page string="CSS مخصص" name="custom_css">
                            <field name="custom_css" widget="ace" options="{'mode': 'css'}"/>
                        </page>
                        
                        <!-- Statistics -->
                        <page string="إحصائيات" name="stats">
                            <group>
                                <field name="usage_count"/>
                                <field name="last_used"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_custom_report_template_tree" model="ir.ui.view">
        <field name="name">custom.report.template.tree</field>
        <field name="model">custom.report.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="report_type"/>
                <field name="language"/>
                <field name="currency_id"/>
                <field name="usage_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_custom_report_template" model="ir.actions.act_window">
        <field name="name">قوالب التقارير المخصصة</field>
        <field name="res_model">custom.report.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_custom_report_designer"
              name="مصمم التقارير"
              parent="menu_sap_tools"
              action="action_custom_report_template"
              sequence="200"/>

</odoo>


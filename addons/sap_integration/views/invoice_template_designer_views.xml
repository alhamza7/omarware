<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_invoice_template_designer_list" model="ir.ui.view">
        <field name="name">invoice.template.designer.list</field>
        <field name="model">invoice.template.designer</field>
        <field name="arch" type="xml">
            <list string="Invoice Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="template_type"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="usage_count"/>
                <field name="active" widget="boolean_toggle"/>
                <button name="action_open_designer" string="Open Designer" type="object" icon="fa-paint-brush" class="btn-primary"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_invoice_template_designer_form" model="ir.ui.view">
        <field name="name">invoice.template.designer.form</field>
        <field name="model">invoice.template.designer</field>
        <field name="arch" type="xml">
            <form string="Invoice Template">
                <header>
                    <button name="action_open_designer" string="Open Visual Designer" type="object" class="oe_highlight" icon="fa-paint-brush"/>
                    <button name="action_preview" string="Preview" type="object" icon="fa-eye"/>
                    <button name="action_duplicate" string="Duplicate" type="object" icon="fa-copy"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Template Name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="template_type"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_default"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="usage_count"/>
                            <field name="last_used"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Canvas Settings" name="canvas">
                            <group>
                                <group string="Size">
                                    <field name="canvas_width"/>
                                    <field name="canvas_height"/>
                                    <field name="canvas_unit"/>
                                    <field name="orientation"/>
                                </group>
                                <group string="Margins">
                                    <field name="margin_top"/>
                                    <field name="margin_bottom"/>
                                    <field name="margin_left"/>
                                    <field name="margin_right"/>
                                </group>
                            </group>
                            <group>
                                <group string="Background">
                                    <field name="background_color" widget="color"/>
                                    <field name="background_image" widget="image" filename="background_filename"/>
                                    <field name="background_filename" invisible="1"/>
                                    <field name="background_opacity"/>
                                </group>
                                <group string="Grid">
                                    <field name="show_grid"/>
                                    <field name="grid_size"/>
                                    <field name="snap_to_grid"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Elements" name="elements">
                            <field name="elements">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="element_type"/>
                                    <field name="x"/>
                                    <field name="y"/>
                                    <field name="width"/>
                                    <field name="height"/>
                                    <field name="field_name" invisible="element_type != 'field'"/>
                                    <field name="static_text" invisible="element_type != 'text'"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="Design JSON" name="json">
                            <field name="design_json" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_invoice_template_designer" model="ir.actions.act_window">
        <field name="name">Invoice Designer</field>
        <field name="res_model">invoice.template.designer</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_invoice_designer"
              name="Invoice Designer"
              parent="menu_sap_tools"
              action="action_invoice_template_designer"
              sequence="201"/>

</odoo>


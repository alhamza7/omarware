<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Simple Tree View -->
    <record id="view_custom_report_template_tree_simple" model="ir.ui.view">
        <field name="name">custom.report.template.tree.simple</field>
        <field name="model">custom.report.template</field>
        <field name="arch" type="xml">
            <tree string="Custom Report Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="report_type"/>
                <field name="language"/>
                <field name="currency_id"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Simple Form View -->
    <record id="view_custom_report_template_form_simple" model="ir.ui.view">
        <field name="name">custom.report.template.form.simple</field>
        <field name="model">custom.report.template</field>
        <field name="arch" type="xml">
            <form string="Custom Report Template">
                <header>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="اسم القالب..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="report_type"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="language"/>
                            <field name="currency_id"/>
                            <field name="show_currency_name"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="الإعدادات الأساسية" name="basic">
                            <group>
                                <group string="الترويسة">
                                    <field name="show_header"/>
                                    <field name="show_logo"/>
                                    <field name="show_company_info"/>
                                </group>
                                <group string="العنوان">
                                    <field name="show_title"/>
                                    <field name="title_text"/>
                                </group>
                            </group>
                            <group>
                                <group string="الجدول">
                                    <field name="show_table"/>
                                </group>
                                <group string="المجاميع">
                                    <field name="show_totals"/>
                                </group>
                            </group>
                        </page>
                        <page string="معلومات" name="info">
                            <group>
                                <field name="usage_count"/>
                                <field name="last_used"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_custom_report_template_simple" model="ir.actions.act_window">
        <field name="name">قوالب التقارير المخصصة</field>
        <field name="res_model">custom.report.template</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_custom_report_template_tree_simple"/>
    </record>

    <!-- Menu -->
    <menuitem id="menu_custom_report_designer"
              name="مصمم التقارير"
              parent="menu_sap_tools"
              action="action_custom_report_template_simple"
              sequence="200"/>
</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SAP Backend Tree View -->
    <record id="view_sap_backend_tree" model="ir.ui.view">
        <field name="name">sap.backend.tree</field>
        <field name="model">sap.backend</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="base_url"/>
                <field name="company_db"/>
                <field name="connection_status"/>
                <field name="last_connection"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- SAP Backend Form View -->
    <record id="view_sap_backend_form" model="ir.ui.view">
        <field name="name">sap.backend.form</field>
        <field name="model">sap.backend</field>
        <field name="arch" type="xml">
            <form>

                <header>
                    <button name="test_connection" string="Test Connection" type="object" class="btn-primary"/>
                    <button name="sync_all_data" string="Full Sync" type="object" class="btn-secondary"/>
                    <button name="sync_incremental_all" string="⚡ Incremental Sync" type="object" class="btn-success" invisible="not enable_incremental_sync"/>
                    <field name="connection_status" widget="statusbar" statusbar_visible="connected,disconnected,error"/>
                </header>                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="test_connection" type="object" class="oe_stat_button" icon="fa-plug">
                            <field name="connection_status" widget="statinfo" string="Status"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="SAP Backend Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="base_url"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="company_db"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="verify_ssl"/>
                            <field name="last_connection"/>
                            <field name="error_message" widget="text" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sync Settings">
                            <group string="Manual Sync">
                                <group>
                                    <field name="sync_customers"/>
                                    <field name="sync_products"/>
                                    <field name="sync_quotations"/>
                                </group>
                                <group>
                                    <field name="sync_sales"/>
                                    <field name="sync_invoices"/>
                                </group>
                            </group>
                        </page>
                        <page string="Auto Sync / Export">
                            <group>
                                <div class="alert alert-info" role="alert">
                                    <strong>⚡ Auto Export</strong><br/>
                                    When enabled, new/updated records will be automatically exported to SAP in real-time.
                                </div>
                            </group>
                            <group>
                                <group>
                                    <field name="auto_export_partners"/>
                                    <field name="auto_export_products"/>
                                </group>
                                <group>
                                    <field name="auto_export_orders"/>
                                    <field name="auto_import_on_read"/>
                                </group>
                            </group>
                            <group>
                                <div class="alert alert-warning" role="alert">
                                    <strong>⚠️ تحذير</strong><br/>
                                    Auto-export يتطلب تنفيذ دوال Create/Update في SAP Service Layer.<br/>
                                    تأكد من اختبار الإعدادات قبل التفعيل في الإنتاج.
                                </div>
                            </group>
                        </page>
                        <page string="Advanced Settings">
                            <group>
                                <group>
                                    <field name="batch_size"/>
                                    <field name="timeout"/>
                                    <field name="retry_attempts"/>
                                </group>
                            </group>
                        </page>
                        <page string="Incremental Sync">
                            <group>
                                <div class="alert alert-info" role="alert">
                                    <strong>⚡ Incremental Sync</strong><br/>
                                    Only sync records modified since the last synchronization.<br/>
                                    This significantly reduces load on SAP and improves performance.
                                </div>
                            </group>
                            <group>
                                <group>
                                    <field name="enable_incremental_sync"/>
                                    <field name="incremental_sync_days"/>
                                </group>
                                <group>
                                    <button name="sync_incremental_partners" 
                                            string="Sync Partners" 
                                            type="object" 
                                            class="btn-primary"
                                            invisible="not enable_incremental_sync"/>
                                    <button name="sync_incremental_products" 
                                            string="Sync Products" 
                                            type="object" 
                                            class="btn-primary"
                                            invisible="not enable_incremental_sync"/>
                                </group>
                            </group>
                            <group string="Last Sync Dates" invisible="not enable_incremental_sync">
                                <group>
                                    <field name="last_partner_sync" readonly="1"/>
                                    <field name="last_product_sync" readonly="1"/>
                                </group>
                                <group>
                                    <field name="last_order_sync" readonly="1"/>
                                    <field name="last_invoice_sync" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SAP Backend Action -->
    <record id="action_sap_backend" model="ir.actions.act_window">
        <field name="name">SAP Backends</field>
        <field name="res_model">sap.backend</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first SAP Backend!
            </p>
            <p>
                Configure your SAP Service Layer connection to start synchronizing data.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_sap_backend"
              name="SAP Backends"
              parent="menu_sap_integration"
              action="action_sap_backend"
              sequence="10"/>
</odoo>






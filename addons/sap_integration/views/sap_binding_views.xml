<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SAP Customer Binding Views -->
    <record id="view_sap_customer_binding_list" model="ir.ui.view">
        <field name="name">sap.res.partner.list</field>
        <field name="model">sap.res.partner</field>
        <field name="arch" type="xml">
            <list string="SAP Customer Bindings" create="false">
                <field name="odoo_id"/>
                <field name="external_id"/>
                <field name="backend_id"/>
                <field name="sap_card_name"/>
                <field name="sap_card_type"/>
                <field name="sync_date"/>
            </list>
        </field>
    </record>

    <record id="view_sap_customer_binding_form" model="ir.ui.view">
        <field name="name">sap.res.partner.form</field>
        <field name="model">sap.res.partner</field>
        <field name="arch" type="xml">
            <form string="SAP Customer Binding">
                <sheet>
                    <group>
                        <group>
                            <field name="odoo_id"/>
                            <field name="external_id"/>
                            <field name="backend_id"/>
                        </group>
                        <group>
                            <field name="sap_card_name"/>
                            <field name="sap_card_type"/>
                            <field name="sync_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sap_customer_binding" model="ir.actions.act_window">
        <field name="name">SAP Customer Bindings</field>
        <field name="res_model">sap.res.partner</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- SAP Product Binding Views -->
    <record id="view_sap_product_binding_list" model="ir.ui.view">
        <field name="name">sap.product.product.list</field>
        <field name="model">sap.product.product</field>
        <field name="arch" type="xml">
            <list string="SAP Product Bindings" create="false">
                <field name="odoo_id"/>
                <field name="external_id"/>
                <field name="backend_id"/>
                <field name="sap_item_name"/>
                <field name="sap_item_type"/>
                <field name="sync_date"/>
            </list>
        </field>
    </record>

    <record id="view_sap_product_binding_form" model="ir.ui.view">
        <field name="name">sap.product.product.form</field>
        <field name="model">sap.product.product</field>
        <field name="arch" type="xml">
            <form string="SAP Product Binding">
                <sheet>
                    <group>
                        <group>
                            <field name="odoo_id"/>
                            <field name="external_id"/>
                            <field name="backend_id"/>
                        </group>
                        <group>
                            <field name="sap_item_name"/>
                            <field name="sap_item_type"/>
                            <field name="sync_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sap_product_binding" model="ir.actions.act_window">
        <field name="name">SAP Product Bindings</field>
        <field name="res_model">sap.product.product</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

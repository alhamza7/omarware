<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- SAP Dashboard Control Form View -->
        <record id="view_sap_dashboard_control_form" model="ir.ui.view">
            <field name="name">sap.dashboard.control.form</field>
            <field name="model">sap.dashboard.control</field>
            <field name="arch" type="xml">
                <form string="SAP Dashboard Control">
                    <sheet>
                        <div class="oe_title">
                            <h1>SAP Integration Dashboard</h1>
                        </div>
                        
                        <!-- Overview Metrics -->
                        <group string="Overview Metrics">
                            <group>
                                <field name="total_syncs" readonly="1"/>
                                <field name="successful_syncs" readonly="1"/>
                                <field name="failed_syncs" readonly="1"/>
                                <field name="success_rate" readonly="1"/>
                            </group>
                            <group>
                                <field name="active_backends" readonly="1"/>
                                <field name="total_errors" readonly="1"/>
                                <field name="critical_errors" readonly="1"/>
                                <field name="average_response_time" readonly="1"/>
                            </group>
                        </group>
                        
                        <!-- Sync Status -->
                        <group string="Sync Status">
                            <field name="sync_status" widget="text"/>
                        </group>
                        
                        <!-- Recent Activities -->
                        <group string="Recent Activities">
                            <field name="recent_activities" widget="text"/>
                        </group>
                        
                        <!-- Active Alerts -->
                        <group string="Active Alerts">
                            <field name="alerts" widget="text"/>
                        </group>
                        
                        <!-- Performance Metrics -->
                        <group string="Performance Metrics">
                            <field name="performance_metrics" widget="text"/>
                        </group>
                        
                        <!-- System Health -->
                        <group string="System Health">
                            <field name="system_health" widget="text"/>
                        </group>
                        
                        <!-- Configuration Summary -->
                        <group string="Configuration Summary">
                            <field name="configuration" widget="text"/>
                        </group>
                        
                        <!-- Charts -->
                        <group string="Charts">
                            <field name="charts" widget="text"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- SAP User Role Tree View -->
        <record id="view_sap_user_role_tree" model="ir.ui.view">
            <field name="name">sap.user.role.tree</field>
            <field name="model">sap.user.role</field>
            <field name="arch" type="xml">
                <list string="SAP User Roles" create="true" edit="true">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="description"/>
                    <field name="can_view_dashboard"/>
                    <field name="can_manage_sync"/>
                    <field name="can_configure_backend"/>
                    <field name="can_manage_mappings"/>
                    <field name="can_view_logs"/>
                    <field name="can_manage_alerts"/>
                    <field name="can_export_data"/>
                    <field name="can_manage_users"/>
                    <field name="backend_access"/>
                    <field name="active" widget="boolean_toggle"/>
                    
                    <button name="action_assign_permissions" 
                            type="object" 
                            icon="fa-users" 
                            string="Assign Permissions"/>
                </list>
            </field>
        </record>
        
        <!-- SAP User Role Form View -->
        <record id="view_sap_user_role_form" model="ir.ui.view">
            <field name="name">sap.user.role.form</field>
            <field name="model">sap.user.role</field>
            <field name="arch" type="xml">
                <form string="SAP User Role">
                    <header>
                        <button name="action_assign_permissions" 
                                type="object" 
                                string="Assign Permissions"
                                class="btn-primary"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" required="1"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="code" required="1"/>
                                <field name="sequence"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="backend_access" required="1"/>
                            </group>
                        </group>
                        
                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>
                        
                        <notebook>
                            <page string="Permissions" name="permissions">
                                <group>
                                    <group>
                                        <field name="can_view_dashboard"/>
                                        <field name="can_manage_sync"/>
                                        <field name="can_configure_backend"/>
                                        <field name="can_manage_mappings"/>
                                    </group>
                                    <group>
                                        <field name="can_view_logs"/>
                                        <field name="can_manage_alerts"/>
                                        <field name="can_export_data"/>
                                        <field name="can_manage_users"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- SAP User Permission Tree View -->
        <record id="view_sap_user_permission_tree" model="ir.ui.view">
            <field name="name">sap.user.permission.tree</field>
            <field name="model">sap.user.permission</field>
            <field name="arch" type="xml">
                <list string="SAP User Permissions" create="true" edit="true">
                    <field name="user_id"/>
                    <field name="role_id"/>
                    <field name="backend_ids" widget="many2many_tags"/>
                    <field name="granted_by"/>
                    <field name="granted_date"/>
                    <field name="expires_date"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>
        
        <!-- SAP User Permission Form View -->
        <record id="view_sap_user_permission_form" model="ir.ui.view">
            <field name="name">sap.user.permission.form</field>
            <field name="model">sap.user.permission</field>
            <field name="arch" type="xml">
                <form string="SAP User Permission">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="user_id" required="1"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="role_id" required="1"/>
                                <field name="backend_ids" widget="many2many_tags"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="granted_by" readonly="1"/>
                                <field name="granted_date" readonly="1"/>
                                <field name="expires_date"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- SAP User Activity Log Tree View -->
        <record id="view_sap_user_activity_log_tree" model="ir.ui.view">
            <field name="name">sap.user.activity.log.tree</field>
            <field name="model">sap.user.activity.log</field>
            <field name="arch" type="xml">
                <list string="SAP User Activities" 
                      decoration-info="activity_type=='login'"
                      decoration-success="activity_type=='sync_start'"
                      decoration-warning="activity_type=='sync_stop'"
                      decoration-danger="activity_type=='permission_revoke'">
                    <field name="user_id"/>
                    <field name="activity_type"/>
                    <field name="activity_description"/>
                    <field name="activity_date"/>
                    <field name="backend_id"/>
                    <field name="ip_address"/>
                </list>
            </field>
        </record>
        
        <!-- SAP User Activity Log Search View -->
                <!-- User Permission Wizard Form -->
        <record id="view_sap_user_permission_wizard_form" model="ir.ui.view">
            <field name="name">sap.user.permission.wizard.form</field>
            <field name="model">sap.user.permission.wizard</field>
            <field name="arch" type="xml">
                <form string="User Permission Management">
                    <sheet>
                        <div class="oe_title">
                            <h1>User Permission Management</h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="user_id" required="1"/>
                                <field name="role_id" required="1"/>
                                <field name="backend_access_type" required="1"/>
                            </group>
                            <group>
                                <field name="expires_hours"/>
                                <field name="expires_date"/>
                            </group>
                        </group>
                        
                        <group string="Backend Access" invisible="backend_access_type == 'none'">
                            <field name="backend_ids" widget="many2many_tags"/>
                        </group>
                        
                        <group string="Current Permissions" invisible="not current_permissions">
                            <field name="current_permissions" widget="text" readonly="1"/>
                        </group>
                        
                        <footer>
                            <button name="action_grant_permission" 
                                    string="Grant Permission" 
                                    type="object" 
                                    class="btn-primary"/>
                            <button name="action_revoke_permission" 
                                    string="Revoke Permission" 
                                    type="object" 
                                    class="btn-warning"/>
                            <button name="action_view_user_permissions" 
                                    string="View User Permissions" 
                                    type="object" 
                                    class="btn-secondary"/>
                            <button name="action_bulk_assign_permissions" 
                                    string="Bulk Assign" 
                                    type="object" 
                                    class="btn-info"/>
                            <button string="Cancel" 
                                    class="btn-secondary" 
                                    special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Bulk Permission Wizard Form -->
        <record id="view_sap_bulk_permission_wizard_form" model="ir.ui.view">
            <field name="name">sap.bulk.permission.wizard.form</field>
            <field name="model">sap.bulk.permission.wizard</field>
            <field name="arch" type="xml">
                <form string="Bulk Permission Assignment">
                    <sheet>
                        <div class="oe_title">
                            <h1>Bulk Permission Assignment</h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="role_id" required="1"/>
                                <field name="user_selection_type" required="1"/>
                            </group>
                            <group>
                                <field name="backend_access_type" required="1"/>
                                <field name="expires_date"/>
                            </group>
                        </group>
                        
                        <group string="User Selection" invisible="user_selection_type == 'all'">
                            <field name="user_ids" widget="many2many_tags" 
                                   invisible="user_selection_type != 'specific'"/>
                            <field name="group_id" 
                                   invisible="user_selection_type != 'group'"/>
                        </group>
                        
                        <group string="Backend Access" invisible="backend_access_type == 'none'">
                            <field name="backend_ids" widget="many2many_tags"/>
                        </group>
                        
                        <group string="Assignment Results" invisible="not assignment_results">
                            <field name="assignment_results" widget="text" readonly="1"/>
                        </group>
                        
                        <footer>
                            <button name="action_assign_permissions" 
                                    string="Assign Permissions" 
                                    type="object" 
                                    class="btn-primary"/>
                            <button string="Cancel" 
                                    class="btn-secondary" 
                                    special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Actions -->
        <record id="action_sap_dashboard_control" model="ir.actions.act_window">
            <field name="name">SAP Dashboard Control</field>
            <field name="res_model">sap.dashboard.control</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
        </record>
        
        <record id="action_sap_user_role" model="ir.actions.act_window">
            <field name="name">SAP User Roles</field>
            <field name="res_model">sap.user.role</field>
            <field name="view_mode">list,form</field></record>
        
        <record id="action_sap_user_permission" model="ir.actions.act_window">
            <field name="name">SAP User Permissions</field>
            <field name="res_model">sap.user.permission</field>
            <field name="view_mode">list,form</field></record>
        
        <record id="action_sap_user_activity_log" model="ir.actions.act_window">
            <field name="name">SAP User Activities</field>
            <field name="res_model">sap.user.activity.log</field>
            <field name="view_mode">list,form</field>
                        <field name="context">{'search_default_today': 1}</field>
        </record>
        
        <record id="action_sap_user_permission_wizard" model="ir.actions.act_window">
            <field name="name">User Permission Management</field>
            <field name="res_model">sap.user.permission.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        
        <record id="action_sap_bulk_permission_wizard" model="ir.actions.act_window">
            <field name="name">Bulk Permission Assignment</field>
            <field name="res_model">sap.bulk.permission.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        
        <!-- Menu Items -->
        <menuitem id="menu_sap_dashboard_control"
                  name="Dashboard Control"
                  parent="menu_sap_integration"
                  action="action_sap_dashboard_control"
                  sequence="80"/>
        
        <menuitem id="menu_sap_user_management"
                  name="User Management"
                  parent="menu_sap_integration"
                  action="action_sap_user_role"
                  sequence="90"/>
        
        <menuitem id="menu_sap_user_roles"
                  name="User Roles"
                  parent="menu_sap_user_management"
                  action="action_sap_user_role"
                  sequence="10"/>
        
        <menuitem id="menu_sap_user_permissions"
                  name="User Permissions"
                  parent="menu_sap_user_management"
                  action="action_sap_user_permission"
                  sequence="20"/>
        
        <menuitem id="menu_sap_user_activities"
                  name="User Activities"
                  parent="menu_sap_user_management"
                  action="action_sap_user_activity_log"
                  sequence="30"/>
        
        <menuitem id="menu_sap_user_permission_wizard"
                  name="Permission Management"
                  parent="menu_sap_user_management"
                  action="action_sap_user_permission_wizard"
                  sequence="40"/>
        
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Warehouse Info Tree View -->
        <record id="view_sap_product_warehouse_info_tree" model="ir.ui.view">
            <field name="name">sap.product.warehouse.info.tree</field>
            <field name="model">sap.product.warehouse.info</field>
            <field name="arch" type="xml">
                <list string="Product Warehouse Info"
                      decoration-success="sync_status=='synced'"
                      decoration-danger="sync_status=='error'">
                    <field name="product_name"/>
                    <field name="product_code"/>
                    <field name="warehouse_name"/>
                    <field name="sap_warehouse_code"/>
                    <field name="last_in_stock"/>
                    <field name="last_committed"/>
                    <field name="last_available"/>
                    <field name="current_qty_available"/>
                    <field name="minimum_stock"/>
                    <field name="maximum_stock"/>
                    <field name="last_sync_date"/>
                    <field name="sync_status" widget="badge"/>
                    <button name="action_view_stock_quant" type="object" icon="fa-cubes" string="Stock"/>
                    <button name="action_view_orderpoint" type="object" icon="fa-refresh" string="Reorder" invisible="not orderpoint_id"/>
                </list>
            </field>
        </record>
        
        <!-- Warehouse Info Form View -->
        <record id="view_sap_product_warehouse_info_form" model="ir.ui.view">
            <field name="name">sap.product.warehouse.info.form</field>
            <field name="model">sap.product.warehouse.info</field>
            <field name="arch" type="xml">
                <form string="Product Warehouse Info">
                    <header>
                        <button name="action_sync_from_sap" string="Sync from SAP" type="object" class="btn-primary"/>
                        <button name="action_view_stock_quant" string="View Stock" type="object" class="btn-info"/>
                        <button name="action_view_orderpoint" string="View Reorder Rule" type="object" class="btn-secondary" invisible="not orderpoint_id"/>
                        <field name="sync_status" widget="statusbar"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="product_id" readonly="1"/></h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="warehouse_id"/>
                                <field name="backend_id"/>
                                <field name="sap_warehouse_code"/>
                                <field name="sap_warehouse_name"/>
                            </group>
                            <group>
                                <field name="default_bin"/>
                                <field name="orderpoint_id" readonly="1"/>
                                <field name="last_sync_date" readonly="1"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="SAP Quantities (Last Sync)">
                                <group>
                                    <group>
                                        <field name="last_in_stock"/>
                                        <field name="last_committed"/>
                                        <field name="last_ordered"/>
                                        <field name="last_available"/>
                                    </group>
                                </group>
                            </page>
                            
                            <page string="Odoo Quantities (Current)">
                                <group>
                                    <group>
                                        <field name="current_qty_available"/>
                                        <field name="current_qty_reserved"/>
                                    </group>
                                </group>
                            </page>
                            
                            <page string="Reorder Settings">
                                <group>
                                    <group>
                                        <field name="minimum_stock"/>
                                        <field name="maximum_stock"/>
                                    </group>
                                    <group>
                                        <field name="min_order"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Action -->
        <record id="action_sap_product_warehouse_info" model="ir.actions.act_window">
            <field name="name">Product Warehouse Info</field>
            <field name="res_model">sap.product.warehouse.info</field>
            <field name="view_mode">list,form</field>
        </record>
        
    </data>
</odoo>












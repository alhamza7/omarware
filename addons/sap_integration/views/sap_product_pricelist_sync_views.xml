<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Pricelist Sync Tree View -->
        <record id="view_sap_product_pricelist_sync_tree" model="ir.ui.view">
            <field name="name">sap.product.pricelist.sync.tree</field>
            <field name="model">sap.product.pricelist.sync</field>
            <field name="arch" type="xml">
                <list string="Product Pricelist Sync" 
                      decoration-success="sync_status=='synced'"
                      decoration-danger="sync_status=='error'">
                    <field name="product_name"/>
                    <field name="product_code"/>
                    <field name="sap_pricelist_num"/>
                    <field name="sap_pricelist_name"/>
                    <field name="odoo_pricelist_id"/>
                    <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="uom_id"/>
                    <field name="last_sync_date"/>
                    <field name="sync_status" widget="badge"/>
                    <button name="action_view_pricelist" type="object" icon="fa-external-link" string="Pricelist"/>
                </list>
            </field>
        </record>
        
        <!-- Pricelist Sync Form View -->
        <record id="view_sap_product_pricelist_sync_form" model="ir.ui.view">
            <field name="name">sap.product.pricelist.sync.form</field>
            <field name="model">sap.product.pricelist.sync</field>
            <field name="arch" type="xml">
                <form string="Product Pricelist Sync">
                    <header>
                        <button name="action_sync_from_sap" string="Sync from SAP" type="object" class="btn-primary"/>
                        <button name="action_view_pricelist" string="View Pricelist" type="object" class="btn-secondary"/>
                        <button name="action_view_pricelist_item" string="View Item" type="object" class="btn-info" invisible="not odoo_pricelist_item_id"/>
                        <field name="sync_status" widget="statusbar"/>
                    </header>
                    
                    <sheet>
                        <group>
                            <group>
                                <field name="product_id"/>
                                <field name="backend_id"/>
                                <field name="sap_pricelist_num"/>
                                <field name="sap_pricelist_name"/>
                            </group>
                            <group>
                                <field name="odoo_pricelist_id"/>
                                <field name="odoo_pricelist_item_id"/>
                                <field name="price"/>
                                <field name="currency_id"/>
                            </group>
                        </group>
                        
                        <group string="UoM Specific">
                            <group>
                                <field name="uom_id"/>
                                <field name="uom_code"/>
                            </group>
                            <group>
                                <field name="factor"/>
                                <field name="base_num"/>
                            </group>
                        </group>
                        
                        <group string="Validity">
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        
                        <group string="Sync Info">
                            <field name="last_sync_date" readonly="1"/>
                            <field name="sync_error_message" readonly="1" invisible="not sync_error_message"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Action -->
        <record id="action_sap_product_pricelist_sync" model="ir.actions.act_window">
            <field name="name">Product Pricelist Sync</field>
            <field name="res_model">sap.product.pricelist.sync</field>
            <field name="view_mode">list,form</field>
        </record>
        
    </data>
</odoo>












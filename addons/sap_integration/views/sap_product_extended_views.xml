<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Extended Product Info Tree View -->
        <record id="view_sap_product_extended_tree" model="ir.ui.view">
            <field name="name">sap.product.extended.tree</field>
            <field name="model">sap.product.extended</field>
            <field name="arch" type="xml">
                <list string="Extended Product Information" 
                      decoration-success="sync_status=='synced'"
                      decoration-warning="sync_status=='pending'"
                      decoration-danger="sync_status=='error'">
                    <field name="product_id"/>
                    <field name="sap_item_code"/>
                    <field name="foreign_name"/>
                    <field name="manufacturer_id"/>
                    <field name="items_group_name"/>
                    <field name="manage_batch_numbers" widget="boolean_toggle"/>
                    <field name="manage_serial_numbers" widget="boolean_toggle"/>
                    <field name="last_sync_date"/>
                    <field name="sync_status" widget="badge"/>
                    <button name="action_sync_from_sap" type="object" icon="fa-refresh" string="Sync"/>
                    <button name="action_view_product" type="object" icon="fa-external-link" string="Product"/>
                </list>
            </field>
        </record>
        
        <!-- Extended Product Info Form View -->
        <record id="view_sap_product_extended_form" model="ir.ui.view">
            <field name="name">sap.product.extended.form</field>
            <field name="model">sap.product.extended</field>
            <field name="arch" type="xml">
                <form string="Extended Product Information">
                    <header>
                        <button name="action_sync_from_sap" string="Sync from SAP" type="object" class="btn-primary"/>
                        <button name="action_view_product" string="View Product" type="object" class="btn-secondary"/>
                        <field name="sync_status" widget="statusbar" statusbar_visible="pending,synced,error"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="product_id" readonly="1"/></h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="backend_id"/>
                                <field name="sap_item_code"/>
                            </group>
                            <group>
                                <field name="last_sync_date" readonly="1"/>
                                <field name="sync_error_message" readonly="1" invisible="sync_status != 'error'"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Foreign Names &amp; Manufacturer">
                                <group>
                                    <group>
                                        <field name="foreign_name"/>
                                        <field name="foreign_name_2"/>
                                    </group>
                                    <group>
                                        <field name="manufacturer_id"/>
                                        <field name="manufacturer_catalog_no"/>
                                        <field name="supplier_catalog_no"/>
                                    </group>
                                </group>
                            </page>
                            
                            <page string="Dimensions &amp; Weights">
                                <group string="Primary Dimensions">
                                    <group>
                                        <field name="length1"/>
                                        <field name="width1"/>
                                        <field name="height1"/>
                                    </group>
                                    <group>
                                        <field name="dimension_unit_id"/>
                                        <field name="weight_unit_id"/>
                                        <field name="volume_unit_id"/>
                                        <field name="total_volume" readonly="1"/>
                                    </group>
                                </group>
                                <group string="Alternative Dimensions">
                                    <group>
                                        <field name="length2"/>
                                        <field name="width2"/>
                                        <field name="height2"/>
                                    </group>
                                </group>
                            </page>
                            
                            <page string="Inventory Management">
                                <group>
                                    <group>
                                        <field name="manage_batch_numbers"/>
                                        <field name="manage_serial_numbers"/>
                                        <field name="manage_stock_by_warehouse"/>
                                    </group>
                                    <group>
                                        <field name="purchase_item"/>
                                        <field name="sales_item"/>
                                        <field name="inventory_item"/>
                                    </group>
                                </group>
                                <group string="Stock Levels">
                                    <group>
                                        <field name="min_level"/>
                                        <field name="max_level"/>
                                    </group>
                                    <group>
                                        <field name="reorder_quantity"/>
                                        <field name="lead_time"/>
                                    </group>
                                </group>
                                <group string="Default Warehouse">
                                    <field name="default_warehouse_id"/>
                                    <field name="default_warehouse_code"/>
                                </group>
                            </page>
                            
                            <page string="Financial">
                                <group>
                                    <group>
                                        <field name="tax_code_ar"/>
                                        <field name="tax_code_ap"/>
                                    </group>
                                    <group>
                                        <field name="commission_group_code"/>
                                        <field name="commission_percent"/>
                                        <field name="customs_group_code"/>
                                    </group>
                                </group>
                            </page>
                            
                            <page string="Additional Info">
                                <group>
                                    <field name="items_group_code"/>
                                    <field name="items_group_name"/>
                                    <field name="sap_item_type"/>
                                    <field name="ship_type"/>
                                </group>
                                <group>
                                    <field name="user_text" widget="text"/>
                                    <field name="remarks" widget="text"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Action -->
        <record id="action_sap_product_extended" model="ir.actions.act_window">
            <field name="name">Extended Product Info</field>
            <field name="res_model">sap.product.extended</field>
            <field name="view_mode">list,form</field>
        </record>
        
    </data>
</odoo>












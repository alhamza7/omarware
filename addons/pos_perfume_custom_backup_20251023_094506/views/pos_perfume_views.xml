<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Form View - Add Arabic Name -->
    <record id="product_template_form_view_inherit_perfume" model="ir.ui.view">
        <field name="name">product.template.form.inherit.perfume</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="name_arabic" string="الاسم العربي" placeholder="أدخل الاسم العربي للمنتج هنا"/>
            </field>
        </field>
    </record>
</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ULTRAMSG Message Views -->
    <record id="view_ultramsg_message_tree" model="ir.ui.view">
        <field name="name">ultramsg.message.tree</field>
        <field name="model">ultramsg.message</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Messages" decoration-success="state=='sent'" decoration-danger="state=='failed'" decoration-muted="state=='draft'">
                <field name="name"/>
                <field name="create_date" string="Date"/>
                <field name="phone"/>
                <field name="message_type"/>
                <field name="res_name" string="Related Document"/>
                <field name="state" widget="badge" decoration-success="state=='sent'" decoration-danger="state=='failed'" decoration-info="state=='sending'"/>
                <field name="sent_date"/>
            </list>
        </field>
    </record>
    
    <record id="view_ultramsg_message_form" model="ir.ui.view">
        <field name="name">ultramsg.message.form</field>
        <field name="model">ultramsg.message</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Message">
                <header>
                    <button name="action_send_message" string="Send Message" type="object" 
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sending,sent,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="phone" placeholder="07800114976"/>
                            <field name="message_type"/>
                            <field name="res_name" string="Related Document" readonly="1"/>
                        </group>
                        <group>
                            <field name="sent_date" readonly="1"/>
                            <field name="ultramsg_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Message Content">
                        <field name="message_body" nolabel="1" placeholder="Message text..."/>
                    </group>
                    <group string="Document" invisible="message_type != 'document'">
                        <field name="document_url"/>
                        <field name="document_name"/>
                    </group>
                    <group string="Response" invisible="state in ['draft', 'sending']">
                        <field name="ultramsg_response" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Error" invisible="state != 'failed'">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <!-- ULTRAMSG Config Views -->
    <record id="view_ultramsg_config_tree" model="ir.ui.view">
        <field name="name">ultramsg.config.tree</field>
        <field name="model">ultramsg.config</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="ULTRAMSG Configurations">
                <field name="name"/>
                <field name="instance_id"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="total_messages_sent"/>
                <field name="total_messages_failed"/>
            </list>
        </field>
    </record>
    
    <record id="view_ultramsg_config_form" model="ir.ui.view">
        <field name="name">ultramsg.config.form</field>
        <field name="model">ultramsg.config</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="ULTRAMSG Configuration">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="ULTRAMSG Configuration"/>
                        </h1>
                    </div>
                    <group>
                        <group string="API Credentials">
                            <field name="instance_id" placeholder="instance12345"/>
                            <field name="api_token" password="True" placeholder="your_api_token_here"/>
                            <field name="api_url"/>
                        </group>
                        <group string="Settings">
                            <field name="phone_prefix" placeholder="964"/>
                        </group>
                    </group>
                    <group>
                        <group string="Statistics">
                            <field name="total_messages_sent" readonly="1"/>
                            <field name="total_messages_failed" readonly="1"/>
                        </group>
                    </group>
                    
                    <!-- Testing Interface -->
                    <notebook>
                        <page string="اختبار الإرسال" name="test_send">
                            <div class="o_form_sheet_bg">
                                <div class="ultramsg_test_interface" style="padding: 20px;">
                                    <h3 style="margin-bottom: 20px;">واجهة اختبار إرسال الرسائل</h3>
                                    
                                    <div class="row">
                                        <div class="col-12 col-md-6">
                                            <div class="form-group">
                                                <div><strong>رقم الهاتف</strong></div>
                                                <input type="text" id="test_phone" class="form-control" placeholder="07800114976" style="margin-bottom: 10px;"/>
                                                <small class="text-muted">أدخل رقم الهاتف بدون رمز الدولة (سيتم إضافته تلقائياً)</small>
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <div class="form-group">
                                                <div><strong>نوع الرسالة</strong></div>
                                                <select id="test_message_type" class="form-control" style="margin-bottom: 10px;">
                                                    <option value="text">نص</option>
                                                    <option value="document">مستند</option>
                                                    <option value="image">صورة</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="form-group">
                                                <div><strong>نص الرسالة</strong></div>
                                                <textarea id="test_message_body" class="form-control" rows="4" placeholder="أدخل نص الرسالة هنا..." style="margin-bottom: 10px;"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="row" id="test_document_fields" style="display: none;">
                                        <div class="col-12 col-md-6">
                                            <div class="form-group">
                                                <div><strong>رابط المستند/الصورة</strong></div>
                                                <input type="text" id="test_document_url" class="form-control" placeholder="https://example.com/document.pdf" style="margin-bottom: 10px;"/>
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <div class="form-group">
                                                <div><strong>اسم الملف</strong></div>
                                                <input type="text" id="test_document_name" class="form-control" placeholder="document.pdf" style="margin-bottom: 10px;"/>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="row">
                                        <div class="col-12">
                                            <button type="button" class="btn btn-primary" id="test_send_button" style="margin-top: 10px;">
                                                <i class="fa fa-paper-plane"/> إرسال رسالة تجريبية
                                            </button>
                                        </div>
                                    </div>
                                    
                                    <div class="row" style="margin-top: 20px;">
                                        <div class="col-12">
                                            <div id="test_result" style="display: none; padding: 15px; border-radius: 5px; margin-top: 15px;">
                                                <h5 id="test_result_title"></h5>
                                                <div id="test_result_message"></div>
                                                <div id="test_result_details" style="margin-top: 10px; font-size: 12px; color: #666;"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Actions -->
    <record id="action_ultramsg_message" model="ir.actions.act_window">
        <field name="name">WhatsApp Messages</field>
        <field name="res_model">ultramsg.message</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No WhatsApp messages yet
            </p>
            <p>
                WhatsApp messages sent via ULTRAMSG will appear here.
            </p>
        </field>
    </record>
    
    <record id="action_ultramsg_config" model="ir.actions.act_window">
        <field name="name">ULTRAMSG Configuration</field>
        <field name="res_model">ultramsg.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No ULTRAMSG configuration found
            </p>
            <p>
                Create a configuration with your ULTRAMSG Instance ID and API Token.
            </p>
        </field>
    </record>
    
    <!-- Menu Items -->
    <menuitem id="menu_ultramsg_root"
              name="WhatsApp Integration"
              web_icon="ultramsg_integration,static/description/icon.png"
              sequence="90"/>
    
    <menuitem id="menu_ultramsg_messages"
              name="Messages Log"
              parent="menu_ultramsg_root"
              action="action_ultramsg_message"
              sequence="10"/>
    
    <menuitem id="menu_ultramsg_config"
              name="Configuration"
              parent="menu_ultramsg_root"
              action="action_ultramsg_config"
              sequence="20"/>
    
    <menuitem id="menu_ultramsg_dashboard"
              name="Dashboard"
              parent="menu_ultramsg_root"
              sequence="5"/>
    
</odoo>


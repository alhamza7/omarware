<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    
    <t t-name="lugal_ai.LugalChatTemplate">
        <div class="lugal_chat_container">
            <!-- Header -->
            <div class="lugal_chat_header">
                <h3>🧠 Lugal AI</h3>
                <div class="lugal_chat_actions">
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="toggleHistory">
                        <i class="fa fa-history"/> History
                    </button>
                    <button class="btn btn-sm btn-outline-danger" t-on-click="clearChat">
                        <i class="fa fa-trash"/> Clear
                    </button>
                </div>
            </div>
            
            <!-- Stats Bar -->
            <div class="lugal_chat_stats" t-if="state.stats">
                <span>📊 Total: <t t-esc="state.stats.total_conversations"/></span>
                <span>⚡ Cached: <t t-esc="state.stats.cached_responses"/></span>
                <span>⏱️ Avg: <t t-esc="Math.round(state.stats.avg_response_time)"/>ms</span>
            </div>
            
            <!-- History Sidebar -->
            <div class="lugal_chat_history_sidebar" t-if="state.showHistory">
                <div class="lugal_chat_history_header">
                    <h4>Recent Conversations</h4>
                    <button class="btn-close" t-on-click="toggleHistory"/>
                </div>
                <div class="lugal_chat_history_list">
                    <div class="lugal_chat_history_item" 
                         t-foreach="state.history" 
                         t-as="conv" 
                         t-key="conv.id"
                         t-on-click="() => this.loadHistoryItem(conv)">
                        <div class="lugal_chat_history_question" t-esc="conv.question"/>
                        <div class="lugal_chat_history_meta">
                            <span t-esc="conv.create_date"/>
                            <span class="badge bg-secondary" t-esc="conv.category"/>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Messages -->
            <div class="lugal_chat_messages" t-ref="chatContainer">
                <t t-foreach="state.messages" t-as="msg" t-key="msg_index">
                    <!-- User Message -->
                    <div class="lugal_chat_message lugal_chat_message_user" t-if="msg.type === 'user'">
                        <div class="lugal_chat_message_content">
                            <div class="lugal_chat_message_text" t-esc="msg.text"/>
                            <div class="lugal_chat_message_time" t-esc="msg.timestamp.toLocaleTimeString()"/>
                        </div>
                        <div class="lugal_chat_message_avatar">👤</div>
                    </div>
                    
                    <!-- AI Message -->
                    <div class="lugal_chat_message lugal_chat_message_ai" t-if="msg.type === 'ai'">
                        <div class="lugal_chat_message_avatar">🧠</div>
                        <div class="lugal_chat_message_content">
                            <div class="lugal_chat_message_header">
                                <span class="badge bg-primary" t-if="msg.category" t-esc="msg.category"/>
                                <span class="badge bg-success" t-if="msg.was_cached">⚡ Cached</span>
                                <span class="text-muted" t-if="msg.response_time">
                                    <t t-esc="Math.round(msg.response_time)"/>ms
                                </span>
                            </div>
                            <div class="lugal_chat_message_text" t-esc="msg.text"/>
                            <div class="lugal_chat_message_footer">
                                <div class="lugal_chat_message_time" t-esc="msg.timestamp.toLocaleTimeString()"/>
                                <div class="lugal_chat_message_rating" t-if="msg.conversation_id">
                                    <button class="btn btn-sm btn-link" t-on-click="() => this.rateMessage(msg, 5)" title="Excellent">🤩</button>
                                    <button class="btn btn-sm btn-link" t-on-click="() => this.rateMessage(msg, 4)" title="Very Good">😊</button>
                                    <button class="btn btn-sm btn-link" t-on-click="() => this.rateMessage(msg, 3)" title="Good">🙂</button>
                                    <button class="btn btn-sm btn-link" t-on-click="() => this.rateMessage(msg, 2)" title="Poor">😐</button>
                                    <button class="btn btn-sm btn-link" t-on-click="() => this.rateMessage(msg, 1)" title="Very Poor">👎</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Error Message -->
                    <div class="lugal_chat_message lugal_chat_message_error" t-if="msg.type === 'error'">
                        <div class="alert alert-danger">
                            <i class="fa fa-exclamation-triangle"/> <t t-esc="msg.text"/>
                        </div>
                    </div>
                </t>
                
                <!-- Loading Indicator -->
                <div class="lugal_chat_loading" t-if="state.isLoading">
                    <div class="lugal_chat_message_avatar">🧠</div>
                    <div class="lugal_chat_typing">
                        <span></span><span></span><span></span>
                    </div>
                </div>
            </div>
            
            <!-- Input -->
            <div class="lugal_chat_input_container">
                <textarea 
                    class="form-control lugal_chat_input" 
                    placeholder="Ask Lugal AI anything..."
                    t-model="state.inputText"
                    t-on-keydown="onInputKeydown"
                    rows="2"/>
                <button 
                    class="btn btn-primary lugal_chat_send_btn" 
                    t-on-click="sendMessage"
                    t-att-disabled="!state.inputText.trim() || state.isLoading">
                    <i class="fa fa-paper-plane"/>
                </button>
            </div>
        </div>
    </t>
    
</templates>


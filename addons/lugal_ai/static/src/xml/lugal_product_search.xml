<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    
    <t t-name="lugal_ai.LugalProductSearchTemplate">
        <div class="lugal_product_search_container">
            <!-- Header -->
            <div class="lugal_product_search_header">
                <h3>🔍 Product Search</h3>
                <button class="btn btn-primary" t-on-click="askAI">
                    <i class="fa fa-magic"/> Ask AI
                </button>
            </div>
            
            <!-- Search Bar -->
            <div class="lugal_product_search_bar">
                <div class="input-group">
                    <input 
                        type="text" 
                        class="form-control" 
                        placeholder="Search products or ask a question..."
                        t-model="state.searchQuery"
                        t-on-keydown="onSearchKeydown"/>
                    <button class="btn btn-primary" t-on-click="searchProducts">
                        <i class="fa fa-search"/>
                    </button>
                </div>
            </div>
            
            <!-- Filters -->
            <div class="lugal_product_filters">
                <select class="form-select" t-model="state.filters.category_id" t-on-change="() => this.searchProducts()">
                    <option value="">All Categories</option>
                    <option t-foreach="state.categories" t-as="cat" t-key="cat.id" t-att-value="cat.id">
                        <t t-esc="cat.name"/>
                    </option>
                </select>
                
                <input type="number" class="form-control" placeholder="Min Price" 
                       t-model="state.filters.min_price" 
                       t-on-change="() => this.searchProducts()"/>
                
                <input type="number" class="form-control" placeholder="Max Price" 
                       t-model="state.filters.max_price" 
                       t-on-change="() => this.searchProducts()"/>
                
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" 
                           t-model="state.filters.available_only"
                           t-on-change="() => this.searchProducts()"/>
                    <label class="form-check-label">Available Only</label>
                </div>
                
                <button class="btn btn-sm btn-outline-secondary" t-on-click="clearFilters">
                    <i class="fa fa-times"/> Clear
                </button>
            </div>
            
            <!-- AI Suggestion -->
            <div class="alert alert-info lugal_ai_suggestion" t-if="state.aiSuggestion">
                <i class="fa fa-lightbulb-o"/> <strong>AI:</strong> <t t-esc="state.aiSuggestion"/>
            </div>
            
            <!-- Results Count -->
            <div class="lugal_product_count">
                Found <strong><t t-esc="state.totalCount"/></strong> products
            </div>
            
            <!-- Loading -->
            <div class="text-center p-5" t-if="state.isLoading">
                <i class="fa fa-spinner fa-spin fa-3x"/>
                <p>Searching...</p>
            </div>
            
            <!-- Product Grid -->
            <div class="lugal_product_grid" t-if="!state.isLoading">
                <div class="lugal_product_card" 
                     t-foreach="state.products" 
                     t-as="product" 
                     t-key="product.id"
                     t-on-click="() => this.selectProduct(product)">
                    <div class="lugal_product_image">
                        <img t-if="product.image_url" t-att-src="product.image_url" t-att-alt="product.name"/>
                        <div t-else="" class="lugal_product_no_image">📦</div>
                    </div>
                    <div class="lugal_product_info">
                        <h5 class="lugal_product_name" t-esc="product.name"/>
                        <div class="lugal_product_code" t-if="product.default_code">
                            Code: <t t-esc="product.default_code"/>
                        </div>
                        <div class="lugal_product_price">
                            <t t-esc="formatCurrency(product.list_price)"/>
                        </div>
                        <div class="lugal_product_qty" t-att-class="{'text-success': product.qty_available > 0, 'text-danger': product.qty_available &lt;= 0}">
                            <i class="fa fa-cube"/> <t t-esc="formatNumber(product.qty_available)"/> <t t-esc="product.uom_name"/>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Product Details Modal -->
            <div class="modal fade show d-block" t-if="state.selectedProduct" style="background: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" t-esc="state.selectedProduct.name"/>
                            <button type="button" class="btn-close" t-on-click="closeProductDetails"/>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <img t-if="state.selectedProduct.image_urls" 
                                         t-att-src="state.selectedProduct.image_urls.large" 
                                         class="img-fluid"/>
                                    <div t-else="" class="text-center p-5 bg-light">📦</div>
                                </div>
                                <div class="col-md-8">
                                    <table class="table">
                                        <tr>
                                            <th>Price:</th>
                                            <td><t t-esc="formatCurrency(state.selectedProduct.list_price)"/></td>
                                        </tr>
                                        <tr>
                                            <th>Code:</th>
                                            <td t-esc="state.selectedProduct.default_code"/>
                                        </tr>
                                        <tr>
                                            <th>Barcode:</th>
                                            <td t-esc="state.selectedProduct.barcode"/>
                                        </tr>
                                        <tr>
                                            <th>Category:</th>
                                            <td t-esc="state.selectedProduct.category"/>
                                        </tr>
                                        <tr>
                                            <th>Available:</th>
                                            <td><t t-esc="formatNumber(state.selectedProduct.qty_available)"/> <t t-esc="state.selectedProduct.uom_name"/></td>
                                        </tr>
                                        <tr t-if="state.selectedProduct.sales_stats">
                                            <th>Total Sold:</th>
                                            <td t-esc="formatNumber(state.selectedProduct.sales_stats.total_sold)"/>
                                            </td>
                                        </tr>
                                    </table>
                                    
                                    <div t-if="state.selectedProduct.description" class="mt-3">
                                        <h6>Description:</h6>
                                        <p t-esc="state.selectedProduct.description"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-primary" t-on-click="() => this.openProductForm(state.selectedProduct.id)">
                                Open in Odoo
                            </button>
                            <button class="btn btn-secondary" t-on-click="closeProductDetails">
                                Close
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
    
</templates>


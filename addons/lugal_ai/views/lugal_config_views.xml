<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Lugal Config Form View -->
    <record id="view_lugal_config_form" model="ir.ui.view">
        <field name="name">lugal.config.form</field>
        <field name="model">lugal.config</field>
        <field name="arch" type="xml">
            <form string="Lugal AI Configuration">
                <header>
                    <button name="action_test_connection" string="Test Connection" type="object" class="oe_highlight"/>
                    <field name="is_active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Configuration Name"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Gemini API Settings">
                            <field name="gemini_api_key" password="True"/>
                            <field name="gemini_model"/>
                            <field name="temperature"/>
                        </group>
                        <group string="Token Limits">
                            <field name="max_input_tokens"/>
                            <field name="max_output_tokens"/>
                        </group>
                    </group>
                    
                    <group string="Features">
                        <group>
                            <field name="enable_caching"/>
                            <field name="cache_duration_hours" invisible="not enable_caching"/>
                        </group>
                        <group>
                            <field name="enable_question_indexing"/>
                            <field name="enable_conversation_history"/>
                            <field name="default_language"/>
                        </group>
                    </group>
                    
                    <group string="System Prompt">
                        <field name="system_prompt" nolabel="1" widget="text"/>
                    </group>
                    
                    <group string="Last Test" invisible="not last_test_date">
                        <field name="last_test_date"/>
                        <field name="last_test_status"/>
                        <field name="last_test_message" widget="text" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Lugal Config Tree View -->
    <record id="view_lugal_config_tree" model="ir.ui.view">
        <field name="name">lugal.config.list</field>
        <field name="model">lugal.config</field>
        <field name="arch" type="xml">
            <list string="Lugal AI Configurations">
                <field name="name"/>
                <field name="gemini_model"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="last_test_status"/>
                <field name="last_test_date"/>
            </list>
        </field>
    </record>
    
    <!-- Lugal Config Action -->
    <record id="action_lugal_config" model="ir.actions.act_window">
        <field name="name">Lugal AI Configuration</field>
        <field name="res_model">lugal.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure Lugal AI
            </p>
            <p>
                Set up your Gemini API credentials and system settings.
            </p>
        </field>
    </record>
    
</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Lugal Conversation Form View -->
    <record id="view_lugal_conversation_form" model="ir.ui.view">
        <field name="name">lugal.conversation.form</field>
        <field name="model">lugal.conversation</field>
        <field name="arch" type="xml">
            <form string="Conversation" create="false" edit="false">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_context_data" type="object" class="oe_stat_button" icon="fa-code" string="Context Data" invisible="not context_data"/>
                    </div>
                    
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="partner_id"/>
                            <field name="user_role"/>
                            <field name="create_date"/>
                        </group>
                        <group>
                            <field name="category"/>
                            <field name="question_index_id"/>
                            <field name="similarity_score" invisible="not question_index_id"/>
                            <field name="was_cached"/>
                        </group>
                    </group>
                    
                    <group string="Question">
                        <field name="question" nolabel="1" widget="text"/>
                        <field name="question_language"/>
                    </group>
                    
                    <group string="Answer">
                        <field name="answer" nolabel="1" widget="text"/>
                    </group>
                    
                    <group>
                        <group string="Performance">
                            <field name="response_time_ms"/>
                            <field name="input_tokens"/>
                            <field name="output_tokens"/>
                            <field name="total_tokens"/>
                        </group>
                        <group string="Data Used">
                            <field name="data_models_used"/>
                            <field name="records_count"/>
                        </group>
                    </group>
                    
                    <group string="User Feedback" invisible="not user_rating">
                        <field name="user_rating"/>
                        <field name="user_feedback" nolabel="1" widget="text"/>
                    </group>
                    
                    <group string="Error" invisible="status != 'failed'">
                        <field name="error_message" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Lugal Conversation List View -->
    <record id="view_lugal_conversation_tree" model="ir.ui.view">
        <field name="name">lugal.conversation.list</field>
        <field name="model">lugal.conversation</field>
        <field name="arch" type="xml">
            <list string="Conversations" create="false">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="display_name"/>
                <field name="category"/>
                <field name="status" decoration-success="status=='success'" decoration-danger="status=='failed'" decoration-info="status=='cached'"/>
                <field name="response_time_ms"/>
                <field name="total_tokens"/>
                <field name="user_rating"/>
            </list>
        </field>
    </record>
    
    <!-- Lugal Conversation Action -->
    <record id="action_lugal_conversation" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">lugal.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No conversations yet
            </p>
            <p>
                Start chatting with Lugal AI to see your conversation history here.
            </p>
        </field>
    </record>
    
</odoo>

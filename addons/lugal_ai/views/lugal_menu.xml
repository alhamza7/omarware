<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Main Menu -->
    <menuitem id="menu_lugal_ai_root"
              name="Lugal AI"
              sequence="10"
              web_icon="lugal_ai,static/description/icon.png"/>
    
    <!-- Chat Submenu -->
    <menuitem id="menu_lugal_ai_chat"
              name="Chat"
              parent="menu_lugal_ai_root"
              sequence="1"
              action="action_open_chat"/>
    
    <!-- Product Search Submenu -->
    <menuitem id="menu_lugal_ai_product_search"
              name="Product Search"
              parent="menu_lugal_ai_root"
              sequence="2"
              action="action_open_product_search"/>
    
    <!-- Conversations Submenu -->
    <menuitem id="menu_lugal_ai_conversations"
              name="Conversations"
              parent="menu_lugal_ai_root"
              sequence="10"
              action="action_lugal_conversation"/>
    
    <!-- Configuration Menu -->
    <menuitem id="menu_lugal_ai_config"
              name="Configuration"
              parent="menu_lugal_ai_root"
              sequence="100"
              groups="base.group_system"/>
    
    <menuitem id="menu_lugal_ai_config_settings"
              name="Settings"
              parent="menu_lugal_ai_config"
              sequence="1"
              action="action_lugal_config"
              groups="base.group_system"/>
    
    <menuitem id="menu_lugal_ai_question_index"
              name="Question Index"
              parent="menu_lugal_ai_config"
              sequence="2"
              action="action_lugal_question_index"
              groups="base.group_system"/>
    
    <!-- Client Actions for Chat and Product Search -->
    <record id="action_open_chat" model="ir.actions.client">
        <field name="name">Lugal AI Chat</field>
        <field name="tag">lugal_chat</field>
        <field name="target">current</field>
    </record>
    
    <record id="action_open_product_search" model="ir.actions.client">
        <field name="name">Product Search</field>
        <field name="tag">lugal_product_search</field>
        <field name="target">current</field>
    </record>
    
</odoo>


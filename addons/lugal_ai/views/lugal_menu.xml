<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Main Menu -->
    <menuitem id="menu_lugal_ai_root"
              name="Lugal AI"
              sequence="10"
              web_icon="lugal_ai,static/description/icon.png"/>
    
    <!-- Chat Client Action -->
    <record id="action_lugal_chat" model="ir.actions.client">
        <field name="name">Lugal AI Chat</field>
        <field name="tag">lugal_chat</field>
        <field name="target">current</field>
    </record>
    
    <menuitem id="menu_lugal_ai_chat"
              name="💬 AI Chat"
              parent="menu_lugal_ai_root"
              sequence="1"
              action="action_lugal_chat"/>
    
    <!-- Conversations Submenu -->
    <menuitem id="menu_lugal_ai_conversations"
              name="Conversations"
              parent="menu_lugal_ai_root"
              sequence="10"
              action="action_lugal_conversation"/>
    
    <!-- Configuration Menu -->
    <menuitem id="menu_lugal_ai_config"
              name="Configuration"
              parent="menu_lugal_ai_root"
              sequence="100"
              groups="base.group_system"/>
    
    <menuitem id="menu_lugal_ai_config_settings"
              name="Settings"
              parent="menu_lugal_ai_config"
              sequence="1"
              action="action_lugal_config"
              groups="base.group_system"/>
    
    <menuitem id="menu_lugal_ai_question_index"
              name="Question Index"
              parent="menu_lugal_ai_config"
              sequence="2"
              action="action_lugal_question_index"
              groups="base.group_system"/>
    
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Lugal Question Index Form View -->
    <record id="view_lugal_question_index_form" model="ir.ui.view">
        <field name="name">lugal.question.index.form</field>
        <field name="model">lugal.question.index</field>
        <field name="arch" type="xml">
            <form string="Question Index">
                <header>
                    <button name="action_view_usage_stats" string="View Stats" type="object" class="oe_highlight"/>
                    <field name="is_active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="question_pattern"/>
                            <field name="category"/>
                            <field name="allowed_roles"/>
                        </group>
                        <group>
                            <field name="usage_count"/>
                            <field name="last_used_date"/>
                            <field name="avg_response_time"/>
                        </group>
                    </group>
                    
                    <group string="Multilingual Patterns">
                        <field name="question_pattern_ar" placeholder="Pattern in Arabic"/>
                        <field name="question_pattern_en" placeholder="Pattern in English"/>
                    </group>
                    
                    <group string="Answer Template">
                        <field name="answer_template" nolabel="1" widget="text"/>
                    </group>
                    
                    <group>
                        <group string="Required Data">
                            <field name="required_data_models" placeholder="product.product,sale.order"/>
                            <field name="required_fields" widget="text" nolabel="1" placeholder="name,price,qty"/>
                        </group>
                        <group string="Sample Questions">
                            <field name="sample_questions" widget="text" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Lugal Question Index Tree View -->
    <record id="view_lugal_question_index_tree" model="ir.ui.view">
        <field name="name">lugal.question.index.tree</field>
        <field name="model">lugal.question.index</field>
        <field name="arch" type="xml">
            <tree string="Question Index">
                <field name="question_pattern"/>
                <field name="category"/>
                <field name="usage_count"/>
                <field name="last_used_date"/>
                <field name="avg_response_time"/>
                <field name="is_active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    
    <!-- Lugal Question Index Action -->
    <record id="action_lugal_question_index" model="ir.actions.act_window">
        <field name="name">Question Index</field>
        <field name="res_model">lugal.question.index</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Question Patterns
            </p>
            <p>
                Define common question patterns for faster, more consistent AI responses.
            </p>
        </field>
    </record>
    
</odoo>


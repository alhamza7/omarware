<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Default Permissions -->
        <record id="permission_admin" model="lugal.permission">
            <field name="role">admin</field>
            <field name="can_access_sales" eval="True"/>
            <field name="can_access_products" eval="True"/>
            <field name="can_access_customers" eval="True"/>
            <field name="can_access_employees" eval="True"/>
            <field name="can_access_analytics" eval="True"/>
            <field name="can_access_operations" eval="True"/>
            <field name="can_access_inventory" eval="True"/>
            <field name="can_access_accounting" eval="True"/>
            <field name="own_data_only" eval="False"/>
            <field name="assigned_data_only" eval="False"/>
            <field name="max_queries_per_hour" eval="1000"/>
            <field name="max_records_per_query" eval="500"/>
            <field name="description">Full access to all data and analytics</field>
        </record>
        
        <record id="permission_employee" model="lugal.permission">
            <field name="role">employee</field>
            <field name="can_access_sales" eval="True"/>
            <field name="can_access_products" eval="True"/>
            <field name="can_access_customers" eval="True"/>
            <field name="can_access_employees" eval="False"/>
            <field name="can_access_analytics" eval="True"/>
            <field name="can_access_operations" eval="False"/>
            <field name="can_access_inventory" eval="True"/>
            <field name="can_access_accounting" eval="False"/>
            <field name="own_data_only" eval="True"/>
            <field name="assigned_data_only" eval="True"/>
            <field name="max_queries_per_hour" eval="200"/>
            <field name="max_records_per_query" eval="100"/>
            <field name="description">Limited access to own sales and assigned customers</field>
        </record>
        
        <record id="permission_customer" model="lugal.permission">
            <field name="role">customer</field>
            <field name="can_access_sales" eval="False"/>
            <field name="can_access_products" eval="True"/>
            <field name="can_access_customers" eval="False"/>
            <field name="can_access_employees" eval="False"/>
            <field name="can_access_analytics" eval="False"/>
            <field name="can_access_operations" eval="False"/>
            <field name="can_access_inventory" eval="True"/>
            <field name="can_access_accounting" eval="False"/>
            <field name="own_data_only" eval="True"/>
            <field name="assigned_data_only" eval="True"/>
            <field name="max_queries_per_hour" eval="50"/>
            <field name="max_records_per_query" eval="50"/>
            <field name="description">Restricted to product information and own orders</field>
        </record>
        
        <!-- Common Question Patterns - Arabic -->
        <record id="question_pattern_product_availability_ar" model="lugal.question.index">
            <field name="question_pattern">هل المنتج متوفر؟</field>
            <field name="question_pattern_ar">هل المنتج [اسم_المنتج] متوفر؟</field>
            <field name="question_pattern_en">Is product [product_name] available?</field>
            <field name="category">product</field>
            <field name="required_data_models">product.product</field>
            <field name="required_fields">name,qty_available</field>
            <field name="allowed_roles">admin,employee,customer</field>
            <field name="sample_questions">هل منتج ABC متوفر؟
هل يوجد لديكم المنتج XYZ؟
هل متوفر منتج كذا؟</field>
        </record>
        
        <record id="question_pattern_product_price_ar" model="lugal.question.index">
            <field name="question_pattern">ما سعر المنتج؟</field>
            <field name="question_pattern_ar">كم سعر المنتج [اسم_المنتج]؟</field>
            <field name="question_pattern_en">What is the price of [product_name]?</field>
            <field name="category">product</field>
            <field name="required_data_models">product.product</field>
            <field name="required_fields">name,list_price,currency_id</field>
            <field name="allowed_roles">admin,employee,customer</field>
            <field name="sample_questions">كم سعر المنتج ABC؟
ما هو سعر XYZ؟
بكم منتج كذا؟</field>
        </record>
        
        <record id="question_pattern_sales_today_ar" model="lugal.question.index">
            <field name="question_pattern">كم المبيعات اليوم؟</field>
            <field name="question_pattern_ar">كم إجمالي المبيعات اليوم؟</field>
            <field name="question_pattern_en">What are total sales today?</field>
            <field name="category">sales</field>
            <field name="required_data_models">sale.order</field>
            <field name="required_fields">date_order,amount_total,state</field>
            <field name="allowed_roles">admin,employee</field>
            <field name="sample_questions">كم مبيعات اليوم؟
ما هو إجمالي المبيعات اليوم؟
كم بعنا اليوم؟</field>
        </record>
        
        <record id="question_pattern_top_products_ar" model="lugal.question.index">
            <field name="question_pattern">ما أكثر المنتجات مبيعاً؟</field>
            <field name="question_pattern_ar">ما هي أكثر المنتجات مبيعاً؟</field>
            <field name="question_pattern_en">What are the top-selling products?</field>
            <field name="category">analytical</field>
            <field name="required_data_models">sale.order.line,product.product</field>
            <field name="required_fields">product_id,product_uom_qty,price_subtotal</field>
            <field name="allowed_roles">admin,employee</field>
            <field name="sample_questions">ما أكثر منتج مبيعاً؟
أي المنتجات الأكثر مبيعاً؟
ما هو المنتج الأكثر طلباً؟</field>
        </record>
        
        <!-- Common Question Patterns - English -->
        <record id="question_pattern_order_status_en" model="lugal.question.index">
            <field name="question_pattern">What is my order status?</field>
            <field name="question_pattern_ar">ما حالة طلبي؟</field>
            <field name="question_pattern_en">What is the status of my order?</field>
            <field name="category">sales</field>
            <field name="required_data_models">sale.order</field>
            <field name="required_fields">name,state,date_order,partner_id</field>
            <field name="allowed_roles">admin,employee,customer</field>
            <field name="sample_questions">What is my order status?
Where is my order?
When will my order arrive?</field>
        </record>
        
        <record id="question_pattern_customer_count_ar" model="lugal.question.index">
            <field name="question_pattern">كم عدد العملاء؟</field>
            <field name="question_pattern_ar">كم عدد العملاء الكلي؟</field>
            <field name="question_pattern_en">How many customers do we have?</field>
            <field name="category">customer</field>
            <field name="required_data_models">res.partner</field>
            <field name="required_fields">customer_rank</field>
            <field name="allowed_roles">admin,employee</field>
            <field name="sample_questions">كم عدد العملاء؟
كم زبون لدينا؟
ما هو عدد العملاء الإجمالي؟</field>
        </record>
        
    </data>
</odoo>


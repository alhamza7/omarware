<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Inherit Settings View to Add Fragrantica Settings -->
    <record id="res_config_settings_view_form_fragrantica" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fragrantica</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Add Fragrantica settings section -->
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Fragrantica" string="Fragrantica" data-key="lugal_fragrantica">
                    <h2>Fragrantica Integration</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="fragrantica_auto_scraping_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="fragrantica_auto_scraping_enabled"/>
                                <div class="text-muted">
                                    Enable automatic scraping of Fragrantica perfumes from pending requests.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="fragrantica_scraping_method"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="fragrantica_scraping_method"/>
                                <div class="text-muted">
                                    Choose the method for scraping Fragrantica perfumes.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    
</odoo>

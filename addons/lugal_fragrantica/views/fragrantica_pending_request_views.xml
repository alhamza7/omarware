<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Pending Request List View -->
    <record id="view_fragrantica_pending_request_list" model="ir.ui.view">
        <field name="name">fragrantica.pending.request.list</field>
        <field name="model">fragrantica.pending.request</field>
        <field name="arch" type="xml">
            <list string="Pending Requests" decoration-info="state == 'pending'" 
                  decoration-success="state == 'completed'" decoration-danger="state == 'failed'">
                <field name="create_date"/>
                <field name="fragrantica_url"/>
                <field name="product_id"/>
                <field name="state"/>
                <field name="requested_by"/>
            </list>
        </field>
    </record>
    
    <!-- Pending Request Form View -->
    <record id="view_fragrantica_pending_request_form" model="ir.ui.view">
        <field name="name">fragrantica.pending.request.form</field>
        <field name="model">fragrantica.pending.request</field>
        <field name="arch" type="xml">
            <form string="Pending Request">
                <header>
                    <button name="action_mark_completed" string="Mark as Completed" 
                            type="object" invisible="state not in ['pending', 'processing']" class="oe_highlight"/>
                    <button name="action_mark_failed" string="Mark as Failed" 
                            type="object" invisible="state not in ['pending', 'processing']"/>
                    <button name="action_retry" string="Retry" 
                            type="object" invisible="state != 'failed'"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="pending,processing,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="fragrantica_url" widget="url"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="requested_by"/>
                            <field name="create_date"/>
                            <field name="completed_date"/>
                        </group>
                    </group>
                    
                    <group>
                        <field name="notes" placeholder="Additional notes..."/>
                        <field name="error_message" invisible="not error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    
    <!-- Pending Request Action -->
    <record id="action_fragrantica_pending_request" model="ir.actions.act_window">
        <field name="name">Pending Requests</field>
        <field name="res_model">fragrantica.pending.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No pending requests!
            </p>
            <p>
                Requests are created when users link products to perfumes that don't exist in the database yet.
            </p>
        </field>
    </record>

</odoo>


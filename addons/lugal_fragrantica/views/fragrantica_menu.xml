    <menuitem id="menu_fragrantica_root" 
              name="Fragrantica" 
              sequence="100"
              groups="base.group_user"/>
    
    <!-- Perfumes Menu -->
    <menuitem id="menu_fragrantica_perfumes" 
              name="Perfumes" 
              parent="menu_fragrantica_root" 

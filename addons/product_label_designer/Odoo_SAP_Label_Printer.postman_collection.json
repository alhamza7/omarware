{
  "info": {
    "name": "Odoo SAP Label Printer API",
    "description": "Collection for testing SAP Label Printer integration with Odoo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "odoo_url",
      "value": "http://localhost:8070",
      "type": "string"
    },
    {
      "key": "sap_url",
      "value": "https://192.168.15.50:50000/b1s/v1",
      "type": "string"
    },
    {
      "key": "sap_username",
      "value": "YOUR_SAP_USERNAME",
      "type": "string"
    },
    {
      "key": "sap_password",
      "value": "YOUR_SAP_PASSWORD",
      "type": "string"
    },
    {
      "key": "sap_company_db",
      "value": "YOUR_COMPANY_DB",
      "type": "string"
    },
    {
      "key": "odoo_db",
      "value": "lugal",
      "type": "string"
    },
    {
      "key": "odoo_login",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "odoo_password",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "template_id",
      "value": "3",
      "type": "string"
    },
    {
      "key": "sap_session_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "odoo_session_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. SAP Service Layer",
      "item": [
        {
          "name": "1.1 Login to SAP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"sap_session_id\", jsonData.SessionId);",
                  "    console.log(\"SAP Session ID saved: \" + jsonData.SessionId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"UserName\": \"{{sap_username}}\",\n  \"Password\": \"{{sap_password}}\",\n  \"CompanyDB\": \"{{sap_company_db}}\"\n}"
            },
            "url": {
              "raw": "{{sap_url}}/Login",
              "host": ["{{sap_url}}"],
              "path": ["Login"]
            }
          },
          "response": []
        },
        {
          "name": "1.2 Search Product by Barcode (Main Items)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "B1SESSION={{sap_session_id}}"
              }
            ],
            "url": {
              "raw": "{{sap_url}}/Items?$filter=BarCode eq '20493' or ItemCode eq '20493'&$top=1",
              "host": ["{{sap_url}}"],
              "path": ["Items"],
              "query": [
                {
                  "key": "$filter",
                  "value": "BarCode eq '20493' or ItemCode eq '20493'"
                },
                {
                  "key": "$top",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.3 Get Items with UoM Sub-Units",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "B1SESSION={{sap_session_id}}"
              }
            ],
            "url": {
              "raw": "{{sap_url}}/Items?$select=ItemCode,ItemName,ItemPrices,UoMGroupEntry&$expand=ItemUnitOfMeasurementCollection&$top=100",
              "host": ["{{sap_url}}"],
              "path": ["Items"],
              "query": [
                {
                  "key": "$select",
                  "value": "ItemCode,ItemName,ItemPrices,UoMGroupEntry"
                },
                {
                  "key": "$expand",
                  "value": "ItemUnitOfMeasurementCollection"
                },
                {
                  "key": "$top",
                  "value": "100"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.4 Get Specific Item with UoM",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "B1SESSION={{sap_session_id}}"
              }
            ],
            "url": {
              "raw": "{{sap_url}}/Items('ITEM_CODE')?$select=ItemCode,ItemName,ItemPrices&$expand=ItemUnitOfMeasurementCollection",
              "host": ["{{sap_url}}"],
              "path": ["Items('ITEM_CODE')"],
              "query": [
                {
                  "key": "$select",
                  "value": "ItemCode,ItemName,ItemPrices"
                },
                {
                  "key": "$expand",
                  "value": "ItemUnitOfMeasurementCollection"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Odoo Authentication",
      "item": [
        {
          "name": "2.1 Login to Odoo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var cookies = pm.cookies.all();",
                  "    for (var i = 0; i < cookies.length; i++) {",
                  "        if (cookies[i].name === 'session_id') {",
                  "            pm.collectionVariables.set(\"odoo_session_id\", cookies[i].value);",
                  "            console.log(\"Odoo Session ID saved: \" + cookies[i].value);",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"db\": \"{{odoo_db}}\",\n    \"login\": \"{{odoo_login}}\",\n    \"password\": \"{{odoo_password}}\"\n  },\n  \"id\": 1\n}"
            },
            "url": {
              "raw": "{{odoo_url}}/web/session/authenticate",
              "host": ["{{odoo_url}}"],
              "path": ["web", "session", "authenticate"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Odoo SAP Label Printer",
      "item": [
        {
          "name": "3.1 SAP Product Lookup (by Barcode)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "session_id={{odoo_session_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"barcode\": \"20493\",\n    \"template_id\": {{template_id}}\n  },\n  \"id\": 1\n}"
            },
            "url": {
              "raw": "{{odoo_url}}/sap/label/lookup",
              "host": ["{{odoo_url}}"],
              "path": ["sap", "label", "lookup"]
            }
          },
          "response": []
        },
        {
          "name": "3.2 Print Label",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "session_id={{odoo_session_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"product_id\": 123,\n    \"template_id\": {{template_id}}\n  },\n  \"id\": 2\n}"
            },
            "url": {
              "raw": "{{odoo_url}}/sap/label/print",
              "host": ["{{odoo_url}}"],
              "path": ["sap", "label", "print"]
            }
          },
          "response": []
        },
        {
          "name": "3.3 Get SAP Label Printer Page",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "session_id={{odoo_session_id}}"
              }
            ],
            "url": {
              "raw": "{{odoo_url}}/sap/label/printer",
              "host": ["{{odoo_url}}"],
              "path": ["sap", "label", "printer"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Test Different Barcodes",
      "item": [
        {
          "name": "Test Barcode: 20493",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "session_id={{odoo_session_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"barcode\": \"20493\",\n    \"template_id\": {{template_id}}\n  },\n  \"id\": 1\n}"
            },
            "url": {
              "raw": "{{odoo_url}}/sap/label/lookup",
              "host": ["{{odoo_url}}"],
              "path": ["sap", "label", "lookup"]
            }
          },
          "response": []
        },
        {
          "name": "Test Barcode: 4479",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "session_id={{odoo_session_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"barcode\": \"4479\",\n    \"template_id\": {{template_id}}\n  },\n  \"id\": 1\n}"
            },
            "url": {
              "raw": "{{odoo_url}}/sap/label/lookup",
              "host": ["{{odoo_url}}"],
              "path": ["sap", "label", "lookup"]
            }
          },
          "response": []
        },
        {
          "name": "Test Barcode: 7749",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "session_id={{odoo_session_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"barcode\": \"7749\",\n    \"template_id\": {{template_id}}\n  },\n  \"id\": 1\n}"
            },
            "url": {
              "raw": "{{odoo_url}}/sap/label/lookup",
              "host": ["{{odoo_url}}"],
              "path": ["sap", "label", "lookup"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}


<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Quick Print Wizard View -->
    <record id="view_quick_print_wizard_form" model="ir.ui.view">
        <field name="name">quick.print.wizard.form</field>
        <field name="model">quick.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Quick Print Labels">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <i class="fa fa-print"/> Print Product Labels
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Template &amp; Settings">
                            <field name="template_id" options="{'no_create': True}"/>
                            <field name="print_mode" widget="radio"/>
                            <field name="copies"/>
                        </group>
                        <group string="Selected Products">
                            <field name="product_count" readonly="1"/>
                            <button name="action_add_all_products" string="Add All Products" type="object" class="btn-link"/>
                            <button name="action_clear_products" string="Clear Selection" type="object" class="btn-link"/>
                        </group>
                    </group>
                    
                    <group string="Quick Filters (Optional)">
                        <group>
                            <field name="filter_category_id" placeholder="Filter by category..."/>
                        </group>
                        <group>
                            <field name="filter_has_barcode"/>
                            <field name="filter_has_foreign_name"/>
                        </group>
                    </group>
                    
                    <group string="Selected Products" name="products">
                        <field name="product_ids" nolabel="1" widget="many2many">
                            <list>
                                <field name="default_code"/>
                                <field name="name"/>
                                <field name="foreign_name"/>
                                <field name="list_price"/>
                                <field name="barcode"/>
                            </list>
                        </field>
                    </group>
                    
                    <div class="alert alert-info" style="margin-top: 15px;" invisible="product_count == 0">
                        <p>
                            <i class="fa fa-info-circle"/> 
                            <strong>Ready to print:</strong> Total labels to print
                        </p>
                        <p style="font-size: 14px;">
                            Products × Copies = Labels
                        </p>
                    </div>
                    
                    <div class="alert alert-warning" style="margin-top: 10px;" invisible="product_count != 0">
                        <p>
                            <i class="fa fa-exclamation-triangle"/> 
                            <strong>No products selected!</strong>
                        </p>
                        <p>Use filters or select products manually below.</p>
                    </div>
                    
                </sheet>
                <footer>
                    <button name="action_preview" string="Preview in Browser" type="object" class="btn-secondary" icon="fa-eye"/>
                    <button name="action_print" string="Download PDF" type="object" class="btn-primary" icon="fa-download"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open Quick Print from Menu -->
    <record id="action_quick_print_labels" model="ir.actions.act_window">
        <field name="name">Quick Print Labels</field>
        <field name="res_model">quick.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_quick_print" name="Quick Print" parent="product_label_designer.menu_label_root"
              action="action_quick_print_labels" sequence="5"/>

</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form -->
    <record id="view_print_label_wizard_form" model="ir.ui.view">
        <field name="name">print.label.wizard.form</field>
        <field name="model">print.label.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Product Labels">
                <sheet>
                    <group>
                        <field name="product_ids" widget="many2many_tags"/>
                        <field name="template_id"/>
                        <field name="print_mode" widget="radio"/>
                        <field name="copies"/>
                    </group>
                    <group invisible="print_mode != 'a4_sheet'">
                        <div class="alert alert-info">
                            <p><i class="fa fa-info-circle"/> <strong>A4 Sheet Mode:</strong></p>
                            <p>Multiple labels will be arranged on A4 paper according to template settings.</p>
                            <p>Labels per page: <field name="template_id" readonly="1" invisible="1"/></p>
                        </div>
                    </group>
                </sheet>
                <footer>
                    <button name="action_preview" string="Preview" type="object" class="btn-secondary" icon="fa-eye"/>
                    <button name="action_print" string="Print PDF" type="object" class="btn-primary" icon="fa-print"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for Product -->
    <record id="action_print_label_wizard_product" model="ir.actions.act_window">
        <field name="name">Print Labels</field>
        <field name="res_model">print.label.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_type">action</field>
    </record>

</odoo>


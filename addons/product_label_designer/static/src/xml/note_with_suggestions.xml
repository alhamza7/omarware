<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="product_label_designer.NoteWithSuggestionsField" owl="1">
        <t t-if="props.readonly">
            <span t-esc="props.record.data[props.name] || ''" />
        </t>
        <t t-else="">
            <div class="position-relative" style="width: 100%;">
                <input
                    class="o_input"
                    t-att-id="props.id"
                    type="text"
                    t-att-value="props.record.data[props.name] || ''"
                    t-att-placeholder="props.placeholder"
                    t-on-input="onInput"
                    t-on-focus="onFocus"
                    t-on-blur="onBlur"
                    t-ref="input"
                />
                <ul 
                    class="dropdown-menu position-absolute" 
                    style="max-height: 200px; overflow-y: auto; z-index: 1050; width: 100%; top: 100%; left: 0; display: block;"
                    t-if="state.showSuggestions"
                >
                    <li t-foreach="state.filteredSuggestions" t-as="suggestion" t-key="suggestion.value">
                        <a 
                            class="dropdown-item" 
                            href="#" 
                            t-on-click.prevent="() => this.selectSuggestion(suggestion)"
                        >
                            <t t-esc="suggestion.label"/>
                        </a>
                    </li>
                </ul>
            </div>
        </t>
    </t>
</templates>


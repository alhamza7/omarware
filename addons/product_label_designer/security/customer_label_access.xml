<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Customer Label Template Access -->
    <record id="access_customer_label_template_user" model="ir.model.access">
        <field name="name">customer.label.template.user</field>
        <field name="model_id" search="[('model', '=', 'customer.label.template')]" model="ir.model"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="access_customer_label_template_manager" model="ir.model.access">
        <field name="name">customer.label.template.manager</field>
        <field name="model_id" search="[('model', '=', 'customer.label.template')]" model="ir.model"/>
        <field name="group_id" ref="base.group_system"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Print Customer Label Wizard Access -->
    <record id="access_print_customer_label_wizard_user" model="ir.model.access">
        <field name="name">print.customer.label.wizard.user</field>
        <field name="model_id" search="[('model', '=', 'print.customer.label.wizard')]" model="ir.model"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Print Customer Label Wizard Line Access -->
    <record id="access_print_customer_label_wizard_line_user" model="ir.model.access">
        <field name="name">print.customer.label.wizard.line.user</field>
        <field name="model_id" search="[('model', '=', 'print.customer.label.wizard.line')]" model="ir.model"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>


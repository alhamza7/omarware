<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SIMPLE LABEL REPORT (for SAP printing) -->
    <template id="report_label_simple">
        <t t-call="web.basic_layout">
            <t t-set="template" t-value="env['product.label.template'].browse(int(data.get('template_id'))) if data and data.get('template_id') else env['product.label.template'].get_default_template()"/>
            <t t-set="copies" t-value="int(data.get('copies', 1)) if data else 1"/>
            
            <style>
                * { margin: 0; padding: 0; box-sizing: border-box; }
                body { margin: 0; padding: 0; }
                
                .product-label {
                    width: <t t-esc="template.label_width"/>mm;
                    height: <t t-esc="template.label_height"/>mm;
                    background-color: <t t-esc="template.bg_color"/>;
                    position: relative;
                    font-family: Arial, 'DejaVu Sans', sans-serif;
                    color: <t t-esc="template.text_color"/>;
                    page-break-after: always;
                    overflow: hidden;
                }
                
                .label-content {
                    position: relative;
                    z-index: 1;
                    width: 100%;
                    height: 100%;
                }
                
                .product-name {
                    position: absolute;
                    left: <t t-esc="template.name_x"/>mm;
                    top: <t t-esc="template.name_y"/>mm;
                    font-size: <t t-esc="template.font_size_name"/>pt;
                    font-weight: <t t-esc="'bold' if template.name_bold else 'normal'"/>;
                    text-align: <t t-esc="template.name_align"/>;
                    direction: rtl;
                }
                
                .product-code {
                    position: absolute;
                    left: <t t-esc="template.code_x"/>mm;
                    top: <t t-esc="template.code_y"/>mm;
                    font-size: <t t-esc="template.font_size_code"/>pt;
                    font-weight: <t t-esc="'bold' if template.code_bold else 'normal'"/>;
                    text-align: <t t-esc="template.code_align"/>;
                }
                
                .product-price {
                    position: absolute;
                    left: <t t-esc="template.price_x"/>mm;
                    top: <t t-esc="template.price_y"/>mm;
                    font-size: <t t-esc="template.font_size_price"/>pt;
                    color: <t t-esc="template.price_color"/>;
                    font-weight: <t t-esc="'bold' if template.price_bold else 'normal'"/>;
                    text-align: <t t-esc="template.price_align"/>;
                }
                
                .product-barcode {
                    position: absolute;
                    left: <t t-esc="template.barcode_x"/>mm;
                    top: <t t-esc="template.barcode_y"/>mm;
                }
            </style>
            
            <t t-foreach="docs" t-as="o">
                <t t-foreach="range(copies)" t-as="copy">
                    <div class="product-label">
                        <div class="label-content">
                            <!-- Product Name (Arabic) -->
                            <t t-if="template.show_name">
                                <div class="product-name">
                                    <t t-esc="o.name"/>
                                </div>
                            </t>
                            
                            <!-- Product Code -->
                            <t t-if="template.show_code and o.default_code">
                                <div class="product-code">
                                    <t t-esc="o.default_code"/>
                                </div>
                            </t>
                            
                            <!-- Price -->
                            <t t-if="template.show_price">
                                <div class="product-price">
                                    <t t-esc="'%.2f' % o.list_price"/>
                                </div>
                            </t>
                            
                            <!-- Barcode -->
                            <t t-if="template.show_barcode and o.barcode">
                                <div class="product-barcode">
                                    <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', o.barcode, 200, 50)" style="max-width: 100%; height: auto;"/>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- SIMPLE LABEL REPORT HTML (for direct printing with auto-print) -->
    <template id="report_label_simple_html">
        <t t-call="web.html_container">
            <t t-set="template" t-value="env['product.label.template'].browse(int(data.get('template_id'))) if data and data.get('template_id') else env['product.label.template'].get_default_template()"/>
            <t t-set="copies" t-value="int(data.get('copies', 1)) if data else 1"/>
            
            <style>
                /* Import MCS_Taybah font from Google Fonts or alternative Arabic font */
                @import url('https://fonts.googleapis.com/css2?family=Markazi+Text:wght@400;700&amp;display=swap');
                /* Fallback: Try to use local MCS_Taybah if installed */
                @font-face {
                    font-family: 'MCS_Taybah_Local';
                    src: local('MCS_Taybah S_U Normal'), local('MCS Taybah'), local('mcs_taybah');
                    font-weight: normal;
                    font-style: normal;
                }
                
                @page {
                    size: <t t-esc="template.label_width"/>mm <t t-esc="template.label_height"/>mm;
                    margin: 0;
                    padding: 0;
                }
                
                * { 
                    margin: 0; 
                    padding: 0; 
                    box-sizing: border-box; 
                }
                
                html, body { 
                    margin: 0; 
                    padding: 0;
                    width: <t t-esc="template.label_width"/>mm;
                    height: <t t-esc="template.label_height"/>mm;
                }
                
                .product-label {
                    width: <t t-esc="template.label_width"/>mm;
                    height: <t t-esc="template.label_height"/>mm;
                    background-color: <t t-esc="template.bg_color"/>;
                    position: relative;
                    font-family: 'MCS_Taybah_Local', 'Markazi Text', 'Arial', 'DejaVu Sans', sans-serif;
                    color: <t t-esc="template.text_color"/>;
                    page-break-after: always;
                    overflow: hidden;
                    display: block;
                }
                
                .product-label:last-child {
                    page-break-after: avoid;
                }
                
                .label-content {
                    position: relative;
                    z-index: 1;
                    width: 100%;
                    height: 100%;
                }
                
                .product-name {
                    position: absolute;
                    left: <t t-esc="template.name_x"/>mm;
                    top: <t t-esc="template.name_y"/>mm;
                    width: <t t-esc="template.label_width - template.name_x - 5"/>mm;
                    font-family: 'MCS_Taybah_Local', 'Markazi Text', 'Arial', 'DejaVu Sans', sans-serif !important;
                    font-size: <t t-esc="template.font_size_name"/>pt;
                    font-weight: <t t-esc="'bold' if template.name_bold else 'normal'"/>;
                    text-align: center !important;
                    direction: ltr !important;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    transform: rotate(<t t-esc="template.name_rotation or 0"/>deg);
                    transform-origin: left top;
                }
                
                /* Auto font sizing based on text length */
                .product-name.short-text {
                    font-size: calc(<t t-esc="template.font_size_name"/> * 1.5)pt !important;
                }
                
                .product-name.long-text {
                    font-size: calc(<t t-esc="template.font_size_name"/> * 0.7)pt !important;
                }
                
                .product-code {
                    position: absolute;
                    left: <t t-esc="template.code_x"/>mm;
                    top: <t t-esc="template.code_y"/>mm;
                    font-family: 'MCS_Taybah_Local', 'Markazi Text', 'Arial', 'DejaVu Sans', sans-serif;
                    font-size: <t t-esc="template.font_size_code"/>pt;
                    font-weight: <t t-esc="'bold' if template.code_bold else 'normal'"/>;
                    text-align: <t t-esc="template.code_align"/>;
                    transform: rotate(<t t-esc="template.code_rotation or 0"/>deg);
                    transform-origin: left top;
                }
                
                .product-price {
                    position: absolute;
                    left: <t t-esc="template.price_x"/>mm;
                    top: <t t-esc="template.price_y"/>mm;
                    font-family: 'MCS_Taybah_Local', 'Markazi Text', 'Arial', 'DejaVu Sans', sans-serif;
                    font-size: <t t-esc="template.font_size_price"/>pt;
                    color: <t t-esc="template.price_color"/>;
                    font-weight: <t t-esc="'bold' if template.price_bold else 'normal'"/>;
                    text-align: <t t-esc="template.price_align"/>;
                    transform: rotate(<t t-esc="template.price_rotation or 0"/>deg);
                    transform-origin: left top;
                }
                
                .product-barcode {
                    position: absolute;
                    left: <t t-esc="template.barcode_x"/>mm;
                    top: <t t-esc="template.barcode_y"/>mm;
                    width: <t t-esc="template.barcode_width or 60"/>mm;
                    height: <t t-esc="template.barcode_height or 12"/>mm;
                    transform: rotate(<t t-esc="template.barcode_rotation or 0"/>deg) scale(<t t-esc="template.barcode_scale or 1"/>);
                    transform-origin: left top;
                }
                
                .product-barcode img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                    display: block;
                }
                
                @media print {
                    @page {
                        size: <t t-esc="template.label_width"/>mm <t t-esc="template.label_height"/>mm;
                        margin: 0;
                    }
                    
                    html, body {
                        width: <t t-esc="template.label_width"/>mm;
                        height: <t t-esc="template.label_height"/>mm;
                        margin: 0;
                        padding: 0;
                    }
                    
                    .product-label {
                        width: <t t-esc="template.label_width"/>mm;
                        height: <t t-esc="template.label_height"/>mm;
                        page-break-after: always;
                    }
                    
                    .product-label:last-child {
                        page-break-after: avoid;
                    }
                }
            </style>
            
            <t t-foreach="docs" t-as="o">
                <t t-foreach="range(copies)" t-as="copy">
                    <div class="product-label">
                        <div class="label-content">
                            <!-- Product Name (Arabic) with auto font sizing -->
                            <t t-if="template.show_name">
                                <t t-set="name_length" t-value="len(o.name or '')"/>
                                <t t-set="size_class" t-value="'short-text' if name_length &lt; 15 else ('long-text' if name_length &gt; 30 else '')"/>
                                <div t-attf-class="product-name {{size_class}}">
                                    <t t-esc="o.name"/>
                                </div>
                            </t>
                            
                            <!-- Product Code (optional) -->
                            <t t-if="template.show_code and o.default_code">
                                <div class="product-code">
                                    <t t-esc="o.default_code"/>
                                </div>
                            </t>
                            
                            <!-- Price -->
                            <t t-if="template.show_price">
                                <div class="product-price">
                                    <t t-esc="'%.2f' % o.list_price"/>
                                </div>
                            </t>
                            
                            <!-- Barcode - Now using QR Code -->
                            <t t-if="template.show_barcode">
                                <t t-set="raw_barcode" t-value="data.get('scanned_barcode') or o.barcode"/>
                                <!-- Clean barcode: remove leading/trailing slashes and spaces -->
                                <t t-set="display_barcode" t-value="raw_barcode.strip().strip('/') if raw_barcode else ''"/>
                                <!-- Create QR content: Product Code + Barcode -->
                                <t t-set="qr_content" t-value="'%s|%s' % (o.default_code or 'N/A', display_barcode)"/>
                                <t t-if="display_barcode">
                                    <div class="product-barcode">
                                        <!-- Debug: Show content -->
                                        <div style="position: absolute; bottom: -15px; left: 0; font-size: 7pt; color: #666;">
                                            <t t-esc="display_barcode"/>
                                        </div>
                                        <!-- QR Code with product code and barcode -->
                                        <img t-attf-src="/report/barcode/QR/{{qr_content}}?width=300&amp;height=300" style="width: 100%; height: 100%; object-fit: contain;"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <!-- Debug: No barcode -->
                                    <div style="position: absolute; left: 5mm; top: 10mm; font-size: 10pt; color: red;">
                                        No barcode (raw: <t t-esc="raw_barcode or 'None'"/>)
                                    </div>
                                </t>
                            </t>
                            
                            <!-- Optional: QR Code field (if show_qr is enabled separately) -->
                            <t t-if="template.show_qr and not template.show_barcode">
                                <t t-set="raw_barcode" t-value="data.get('scanned_barcode') or o.barcode"/>
                                <t t-set="display_barcode" t-value="raw_barcode.strip().strip('/') if raw_barcode else ''"/>
                                <t t-set="qr_content" t-value="'%s|%s' % (o.default_code or 'N/A', display_barcode)"/>
                                <t t-if="display_barcode">
                                    <div t-attf-style="position: absolute; left: {{template.qr_x}}mm; top: {{template.qr_y}}mm; width: {{template.qr_size}}mm; height: {{template.qr_size}}mm; transform: rotate({{template.qr_rotation or 0}}deg); transform-origin: left top;">
                                        <img t-attf-src="/report/barcode/QR/{{qr_content}}?width=300&amp;height=300" style="width: 100%; height: 100%; object-fit: contain;"/>
                                    </div>
                                </t>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
            
            <!-- Auto-print script -->
            <script type="text/javascript">
                window.addEventListener('load', function() {
                    setTimeout(function() {
                        window.print();
                    }, 500);
                });
            </script>
        </t>
    </template>

    <!-- SIMPLE TEST TEMPLATE -->
    <template id="report_product_label_simple_test">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div style="page-break-after: always;">
                    <h1>Product: <t t-esc="o.name"/></h1>
                    <p>Code: <t t-esc="o.default_code"/></p>
                    <p>Price: <t t-esc="o.list_price"/></p>
                </div>
            </t>
        </t>
    </template>

</odoo>


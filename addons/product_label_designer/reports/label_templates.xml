<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Main Label Template - Single Labels -->
    <template id="report_product_label">
        <t t-call="web.basic_layout">
            <t t-set="template" t-value="env['product.label.template'].browse(int(data.get('template_id'))) if data and data.get('template_id') else env['product.label.template'].get_default_template()"/>
            <t t-set="copies" t-value="int(data.get('copies', 1)) if data else 1"/>
            
            <style>
                * { margin: 0; padding: 0; box-sizing: border-box; }
                body { margin: 0; padding: 0; }
                
                .product-label {
                    width: <t t-esc="template.label_width"/>mm;
                    height: <t t-esc="template.label_height"/>mm;
                    background-color: <t t-esc="template.bg_color"/>;
                    position: relative;
                    font-family: Arial, 'DejaVu Sans', sans-serif;
                    color: <t t-esc="template.text_color"/>;
                    page-break-after: always;
                    overflow: hidden;
                }
                
                .label-bg {
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    z-index: 0;
                    background-size: cover;
                    background-position: center;
                }
                
                .label-content {
                    position: relative;
                    z-index: 1;
                    width: 100%;
                    height: 100%;
                }
                
                .logo {
                    position: absolute;
                    left: <t t-esc="template.logo_x"/>mm;
                    top: <t t-esc="template.logo_y"/>mm;
                    width: <t t-esc="template.logo_width"/>mm;
                    height: <t t-esc="template.logo_height"/>mm;
                    object-fit: contain;
                }
                
                .product-name {
                    position: absolute;
                    left: <t t-esc="template.name_x"/>mm;
                    top: <t t-esc="template.name_y"/>mm;
                    font-size: <t t-esc="template.font_size_name"/>pt;
                    font-weight: <t t-esc="'bold' if template.name_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.name_italic else 'normal'"/>;
                    text-align: <t t-esc="template.name_align"/>;
                    direction: rtl;
                }
                
                .product-foreign-name {
                    position: absolute;
                    left: <t t-esc="template.foreign_name_x"/>mm;
                    top: <t t-esc="template.foreign_name_y"/>mm;
                    font-size: <t t-esc="template.font_size_foreign_name"/>pt;
                    font-weight: <t t-esc="'bold' if template.foreign_name_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.foreign_name_italic else 'normal'"/>;
                    text-align: <t t-esc="template.foreign_name_align"/>;
                    direction: ltr;
                }
                
                .product-code {
                    position: absolute;
                    left: <t t-esc="template.code_x"/>mm;
                    top: <t t-esc="template.code_y"/>mm;
                    font-size: <t t-esc="template.font_size_code"/>pt;
                    font-weight: <t t-esc="'bold' if template.code_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.code_italic else 'normal'"/>;
                    text-align: <t t-esc="template.code_align"/>;
                }
                
                .product-price {
                    position: absolute;
                    left: <t t-esc="template.price_x"/>mm;
                    top: <t t-esc="template.price_y"/>mm;
                    font-size: <t t-esc="template.font_size_price"/>pt;
                    color: <t t-esc="template.price_color"/>;
                    font-weight: <t t-esc="'bold' if template.price_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.price_italic else 'normal'"/>;
                    text-align: <t t-esc="template.price_align"/>;
                }
                
                .product-barcode {
                    position: absolute;
                    left: <t t-esc="template.barcode_x"/>mm;
                    top: <t t-esc="template.barcode_y"/>mm;
                }
                
                .product-barcode img {
                    max-width: 60mm;
                    height: auto;
                }
                
                .product-qr {
                    position: absolute;
                    left: <t t-esc="template.qr_x"/>mm;
                    top: <t t-esc="template.qr_y"/>mm;
                }
                
                .product-qr img {
                    width: <t t-esc="template.qr_size"/>mm;
                    height: <t t-esc="template.qr_size"/>mm;
                    image-rendering: crisp-edges;
                }
            </style>
            
            <div class="page">
                <t t-foreach="docs" t-as="product">
                    <t t-foreach="range(copies)" t-as="copy">
                        <div class="product-label">
                            <!-- Background -->
                            <t t-if="template.background_image">
                                <div class="label-bg" t-attf-style="background-image: url(data:image/png;base64,#{template.background_image.decode()});"/>
                            </t>
                            
                            <div class="label-content">
                                <!-- Logo -->
                                <t t-if="template.show_logo and template.logo_image">
                                    <img class="logo" t-attf-src="data:image/png;base64,#{template.logo_image.decode()}" alt="Logo"/>
                                </t>
                                
                                <!-- Product Name -->
                                <t t-if="template.show_name">
                                    <div class="product-name">
                                        <t t-esc="product.name"/>
                                    </div>
                                </t>
                                
                                <!-- Foreign Name -->
                                <t t-if="template.show_foreign_name and product.foreign_name">
                                    <div class="product-foreign-name">
                                        <t t-esc="product.foreign_name"/>
                                    </div>
                                </t>
                                
                                <!-- Product Code -->
                                <t t-if="template.show_code and product.default_code">
                                    <div class="product-code">
                                        <t t-esc="product.default_code"/>
                                    </div>
                                </t>
                                
                                <!-- Price -->
                                <t t-if="template.show_price">
                                    <div class="product-price">
                                        <t t-esc="'%.2f' % product.list_price"/>
                                        <t t-if="template.show_currency_symbol">
                                            <t t-esc="' ' + env.company.currency_id.symbol"/>
                                        </t>
                                    </div>
                                </t>
                                
                                <!-- Barcode -->
                                <t t-if="template.show_barcode and product.barcode">
                                    <div class="product-barcode">
                                        <img t-att-src="'/report/barcode/Code128/%s?humanreadable=1&amp;width=300&amp;height=50' % product.barcode" alt="Barcode"/>
                                    </div>
                                </t>
                                
                                <!-- QR Code -->
                                <t t-if="template.show_qr">
                                    <t t-set="qr_value" t-value="product.barcode or product.default_code or str(product.id)"/>
                                    <t t-set="qr_px" t-value="int(template.qr_size * 3.78)"/>
                                    <div class="product-qr">
                                        <img t-att-src="'/report/barcode/QR/%s?width=%s&amp;height=%s' % (qr_value, qr_px, qr_px)" alt="QR Code"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </t>
            </div>
        </t>
    </template>

    <!-- A4 Sheet Template - Multiple Labels -->
    <template id="report_product_label_a4">
        <t t-call="web.basic_layout">
            <t t-set="template" t-value="env['product.label.template'].browse(int(data.get('template_id'))) if data and data.get('template_id') else env['product.label.template'].get_default_template()"/>
            <t t-set="copies" t-value="int(data.get('copies', 1)) if data else 1"/>
            <t t-set="per_row" t-value="int(template.labels_per_row)"/>
            <t t-set="per_col" t-value="int(template.labels_per_column)"/>
            <t t-set="margin" t-value="float(template.label_margin)"/>
            
            <style>
                * { margin: 0; padding: 0; box-sizing: border-box; }
                body { margin: 0; padding: 0; }
                
                .a4-sheet {
                    width: 210mm;
                    min-height: 297mm;
                    padding: 5mm;
                    page-break-after: always;
                }
                
                .labels-grid {
                    display: grid;
                    grid-template-columns: repeat(<t t-esc="per_row"/>, <t t-esc="template.label_width"/>mm);
                    grid-template-rows: repeat(<t t-esc="per_col"/>, <t t-esc="template.label_height"/>mm);
                    gap: <t t-esc="margin"/>mm;
                    justify-content: center;
                }
                
                .product-label {
                    width: <t t-esc="template.label_width"/>mm;
                    height: <t t-esc="template.label_height"/>mm;
                    background-color: <t t-esc="template.bg_color"/>;
                    position: relative;
                    font-family: Arial, 'DejaVu Sans', sans-serif;
                    color: <t t-esc="template.text_color"/>;
                    overflow: hidden;
                }
                
                .label-bg {
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    z-index: 0;
                    background-size: cover;
                    background-position: center;
                }
                
                .label-content {
                    position: relative;
                    z-index: 1;
                    width: 100%;
                    height: 100%;
                }
                
                .logo {
                    position: absolute;
                    left: <t t-esc="template.logo_x"/>mm;
                    top: <t t-esc="template.logo_y"/>mm;
                    width: <t t-esc="template.logo_width"/>mm;
                    height: <t t-esc="template.logo_height"/>mm;
                    object-fit: contain;
                }
                
                .product-name {
                    position: absolute;
                    left: <t t-esc="template.name_x"/>mm;
                    top: <t t-esc="template.name_y"/>mm;
                    font-size: <t t-esc="template.font_size_name"/>pt;
                    font-weight: <t t-esc="'bold' if template.name_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.name_italic else 'normal'"/>;
                    text-align: <t t-esc="template.name_align"/>;
                    direction: rtl;
                    max-width: <t t-esc="template.label_width - template.name_x - 5"/>mm;
                }
                
                .product-foreign-name {
                    position: absolute;
                    left: <t t-esc="template.foreign_name_x"/>mm;
                    top: <t t-esc="template.foreign_name_y"/>mm;
                    font-size: <t t-esc="template.font_size_foreign_name"/>pt;
                    font-weight: <t t-esc="'bold' if template.foreign_name_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.foreign_name_italic else 'normal'"/>;
                    text-align: <t t-esc="template.foreign_name_align"/>;
                    direction: ltr;
                    max-width: <t t-esc="template.label_width - template.foreign_name_x - 5"/>mm;
                }
                
                .product-code {
                    position: absolute;
                    left: <t t-esc="template.code_x"/>mm;
                    top: <t t-esc="template.code_y"/>mm;
                    font-size: <t t-esc="template.font_size_code"/>pt;
                    font-weight: <t t-esc="'bold' if template.code_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.code_italic else 'normal'"/>;
                    text-align: <t t-esc="template.code_align"/>;
                }
                
                .product-price {
                    position: absolute;
                    left: <t t-esc="template.price_x"/>mm;
                    top: <t t-esc="template.price_y"/>mm;
                    font-size: <t t-esc="template.font_size_price"/>pt;
                    color: <t t-esc="template.price_color"/>;
                    font-weight: <t t-esc="'bold' if template.price_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.price_italic else 'normal'"/>;
                    text-align: <t t-esc="template.price_align"/>;
                }
                
                .product-barcode {
                    position: absolute;
                    left: <t t-esc="template.barcode_x"/>mm;
                    top: <t t-esc="template.barcode_y"/>mm;
                }
                
                .product-barcode img {
                    max-width: <t t-esc="template.label_width - template.barcode_x - 5"/>mm;
                    height: auto;
                }
                
                .product-qr {
                    position: absolute;
                    left: <t t-esc="template.qr_x"/>mm;
                    top: <t t-esc="template.qr_y"/>mm;
                }
                
                .product-qr img {
                    width: <t t-esc="template.qr_size"/>mm;
                    height: <t t-esc="template.qr_size"/>mm;
                    image-rendering: crisp-edges;
                }
            </style>
            
            <div class="page">
                <t t-set="labels_per_page" t-value="per_row * per_col"/>
                <t t-set="all_labels" t-value="[]"/>
                
                <!-- Create label list -->
                <t t-foreach="docs" t-as="product">
                    <t t-foreach="range(copies)" t-as="copy">
                        <t t-set="dummy" t-value="all_labels.append(product)"/>
                    </t>
                </t>
                
                <!-- Split into pages -->
                <t t-set="total_labels" t-value="len(all_labels)"/>
                <t t-set="pages" t-value="(total_labels + labels_per_page - 1) // labels_per_page"/>
                
                <t t-foreach="range(pages)" t-as="page_num">
                    <div class="a4-sheet">
                        <div class="labels-grid">
                            <t t-set="start" t-value="page_num * labels_per_page"/>
                            <t t-set="end" t-value="min((page_num + 1) * labels_per_page, total_labels)"/>
                            
                            <t t-foreach="all_labels[start:end]" t-as="product">
                                <div class="product-label">
                                    <!-- Background -->
                                    <t t-if="template.background_image">
                                        <div class="label-bg" t-attf-style="background-image: url(data:image/png;base64,#{template.background_image.decode()});"/>
                                    </t>
                                    
                                    <div class="label-content">
                                        <!-- Logo -->
                                        <t t-if="template.show_logo and template.logo_image">
                                            <img class="logo" t-attf-src="data:image/png;base64,#{template.logo_image.decode()}" alt="Logo"/>
                                        </t>
                                        
                                        <!-- Product Name -->
                                        <t t-if="template.show_name">
                                            <div class="product-name">
                                                <t t-esc="product.name"/>
                                            </div>
                                        </t>
                                        
                                        <!-- Foreign Name -->
                                        <t t-if="template.show_foreign_name and product.foreign_name">
                                            <div class="product-foreign-name">
                                                <t t-esc="product.foreign_name"/>
                                            </div>
                                        </t>
                                        
                                        <!-- Product Code -->
                                        <t t-if="template.show_code and product.default_code">
                                            <div class="product-code">
                                                <t t-esc="product.default_code"/>
                                            </div>
                                        </t>
                                        
                                        <!-- Price -->
                                        <t t-if="template.show_price">
                                            <div class="product-price">
                                                <t t-esc="'%.2f' % product.list_price"/>
                                                <t t-if="template.show_currency_symbol">
                                                    <t t-esc="' ' + env.company.currency_id.symbol"/>
                                                </t>
                                            </div>
                                        </t>
                                        
                                        <!-- Barcode -->
                                        <t t-if="template.show_barcode and product.barcode">
                                            <div class="product-barcode">
                                                <img t-att-src="'/report/barcode/Code128/%s?humanreadable=1&amp;width=200&amp;height=40' % product.barcode" alt="Barcode"/>
                                            </div>
                                        </t>
                                        
                                        <!-- QR Code -->
                                        <t t-if="template.show_qr">
                                            <t t-set="qr_value" t-value="product.barcode or product.default_code or str(product.id)"/>
                                            <t t-set="qr_px" t-value="int(template.qr_size * 3.78)"/>
                                            <div class="product-qr">
                                                <img t-att-src="'/report/barcode/QR/%s?width=%s&amp;height=%s' % (qr_value, qr_px, qr_px)" alt="QR Code"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                            
                            <!-- Fill empty cells -->
                            <t t-set="remaining" t-value="labels_per_page - (end - start)"/>
                            <t t-foreach="range(remaining)" t-as="empty">
                                <div class="product-label" style="border: 1px dashed #ccc;"/>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>

</odoo>

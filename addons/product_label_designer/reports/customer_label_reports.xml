<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Report Action - Single Labels -->
    <record id="action_report_customer_label" model="ir.actions.report">
        <field name="name">Customer Labels</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">product_label_designer.report_customer_label</field>
        <field name="report_file">product_label_designer.report_customer_label</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="product_label_designer.paperformat_label_80x60"/>
    </record>

    <!-- Report Action - A4 Sheet -->
    <record id="action_report_customer_label_a4" model="ir.actions.report">
        <field name="name">Customer Labels (A4 Sheet)</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">product_label_designer.report_customer_label_a4</field>
        <field name="report_file">product_label_designer.report_customer_label_a4</field>
        <field name="paperformat_id" ref="product_label_designer.paperformat_a4"/>
    </record>

</odoo>



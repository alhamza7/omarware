<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Main Label Template - Single Labels -->
    <template id="report_customer_label">
        <t t-call="web.basic_layout">
            <t t-set="template" t-value="template or env['customer.label.template'].get_default_template()"/>
            <t t-set="copies" t-value="copies or 1"/>
            <t t-set="customer_data" t-value="customer_data or {}"/>
            <t t-set="note" t-value="note or ''"/>
            
            <style>
                * { margin: 0; padding: 0; box-sizing: border-box; }
                body { margin: 0; padding: 0; }
                
                .customer-label {
                    width: <t t-esc="template.label_width"/>mm;
                    height: <t t-esc="template.label_height"/>mm;
                    background-color: <t t-esc="template.bg_color"/>;
                    position: relative;
                    font-family: Arial, 'DejaVu Sans', sans-serif;
                    color: <t t-esc="template.text_color"/>;
                    page-break-after: always;
                    overflow: hidden;
                }
                
                .label-bg {
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    z-index: 0;
                    background-size: cover;
                    background-position: center;
                }
                
                .label-content {
                    position: relative;
                    z-index: 1;
                    width: 100%;
                    height: 100%;
                }
                
                .logo {
                    position: absolute;
                    left: <t t-esc="template.logo_x"/>mm;
                    top: <t t-esc="template.logo_y"/>mm;
                    width: <t t-esc="template.logo_width"/>mm;
                    height: <t t-esc="template.logo_height"/>mm;
                    object-fit: contain;
                }
                
                .customer-name {
                    position: absolute;
                    left: <t t-esc="template.name_x"/>mm;
                    top: <t t-esc="template.name_y"/>mm;
                    font-size: <t t-esc="template.font_size_name"/>pt;
                    font-weight: <t t-esc="'bold' if template.name_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.name_italic else 'normal'"/>;
                    text-align: <t t-esc="template.name_align"/>;
                    direction: rtl;
                }
                
                .customer-phone {
                    position: absolute;
                    left: <t t-esc="template.phone_x"/>mm;
                    top: <t t-esc="template.phone_y"/>mm;
                    font-size: <t t-esc="template.font_size_phone"/>pt;
                    font-weight: <t t-esc="'bold' if template.phone_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.phone_italic else 'normal'"/>;
                    text-align: <t t-esc="template.phone_align"/>;
                    direction: rtl;
                }
                
                .customer-mobile {
                    position: absolute;
                    left: <t t-esc="template.mobile_x"/>mm;
                    top: <t t-esc="template.mobile_y"/>mm;
                    font-size: <t t-esc="template.font_size_mobile"/>pt;
                    font-weight: <t t-esc="'bold' if template.mobile_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.mobile_italic else 'normal'"/>;
                    text-align: <t t-esc="template.mobile_align"/>;
                    direction: rtl;
                }
                
                .customer-invoice-type {
                    position: absolute;
                    left: <t t-esc="template.invoice_type_x"/>mm;
                    top: <t t-esc="template.invoice_type_y"/>mm;
                    font-size: <t t-esc="template.font_size_invoice_type"/>pt;
                    font-weight: <t t-esc="'bold' if template.invoice_type_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.invoice_type_italic else 'normal'"/>;
                    text-align: <t t-esc="template.invoice_type_align"/>;
                    direction: rtl;
                }
            </style>
            
            <div class="page">
                <t t-foreach="docs" t-as="partner">
                    <t t-foreach="range(copies)" t-as="copy">
                        <div class="customer-label">
                            <!-- Background -->
                            <t t-if="template.background_image">
                                <div class="label-bg" t-attf-style="background-image: url(data:image/png;base64,#{template.background_image.decode()});"/>
                            </t>
                            
                            <div class="label-content">
                                <!-- Logo -->
                                <t t-if="template.show_logo and template.logo_image">
                                    <img class="logo" t-attf-src="data:image/png;base64,#{template.logo_image.decode()}" alt="Logo"/>
                                </t>
                                
                                <!-- Customer Name -->
                                <t t-if="template.show_name">
                                    <div class="customer-name">
                                        <t t-esc="partner.name"/>
                                    </div>
                                </t>
                                
                                <!-- Phone -->
                                <t t-if="template.show_phone">
                                    <t t-set="customer_info" t-value="customer_data.get(str(partner.id), {})"/>
                                    <t t-set="phone_value" t-value="customer_info.get('phone', '') or partner.phone or ''"/>
                                    <t t-if="phone_value">
                                        <div class="customer-phone">
                                            <t t-esc="'هاتف: ' + phone_value"/>
                                        </div>
                                    </t>
                                </t>
                                
                                <!-- Mobile -->
                                <t t-if="template.show_mobile">
                                    <t t-set="customer_info" t-value="customer_data.get(str(partner.id), {})"/>
                                    <t t-set="mobile_value" t-value="customer_info.get('mobile', '') or partner.mobile or ''"/>
                                    <t t-if="mobile_value">
                                        <div class="customer-mobile">
                                            <t t-esc="'موبايل: ' + mobile_value"/>
                                        </div>
                                    </t>
                                </t>
                                
                                <!-- Invoice Type -->
                                <t t-if="template.show_invoice_type">
                                    <t t-set="customer_info" t-value="customer_data.get(str(partner.id), {})"/>
                                    <t t-set="invoice_type_display" t-value="customer_info.get('invoice_type_display', '') or partner.get_invoice_type_display_name() or ''"/>
                                    <t t-if="invoice_type_display">
                                        <div class="customer-invoice-type">
                                            <t t-esc="'نوع الفاتورة: ' + invoice_type_display"/>
                                        </div>
                                    </t>
                                </t>
                                
                                <!-- Notes -->
                                <t t-if="note">
                                    <div class="customer-note" style="position: absolute; left: 5mm; top: 50mm; font-size: 10pt; color: #666; direction: rtl;">
                                        <t t-esc="'ملاحظات: ' + note"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </t>
            </div>
        </t>
    </template>

    <!-- A4 Sheet Template - Multiple Labels -->
    <template id="report_customer_label_a4">
        <t t-call="web.basic_layout">
            <!-- Data is already processed by report model -->
            <t t-set="per_row" t-value="int(template.labels_per_row)"/>
            <t t-set="per_col" t-value="int(template.labels_per_column)"/>
            <t t-set="margin" t-value="float(template.label_margin)"/>
            
            <style>
                * { margin: 0; padding: 0; box-sizing: border-box; }
                body { margin: 0; padding: 0; }
                
                .a4-sheet {
                    width: 210mm;
                    min-height: 297mm;
                    padding: 5mm;
                    page-break-after: always;
                }
                
                .labels-grid {
                    display: grid;
                    grid-template-columns: repeat(<t t-esc="per_row"/>, <t t-esc="template.label_width"/>mm);
                    grid-template-rows: repeat(<t t-esc="per_col"/>, <t t-esc="template.label_height"/>mm);
                    gap: <t t-esc="margin"/>mm;
                    justify-content: center;
                }
                
                .customer-label {
                    width: <t t-esc="template.label_width"/>mm;
                    height: <t t-esc="template.label_height"/>mm;
                    background-color: <t t-esc="template.bg_color"/>;
                    position: relative;
                    font-family: Arial, 'DejaVu Sans', sans-serif;
                    color: <t t-esc="template.text_color"/>;
                    overflow: hidden;
                }
                
                .label-bg {
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    z-index: 0;
                    background-size: cover;
                    background-position: center;
                }
                
                .label-content {
                    position: relative;
                    z-index: 1;
                    width: 100%;
                    height: 100%;
                }
                
                .logo {
                    position: absolute;
                    left: <t t-esc="template.logo_x"/>mm;
                    top: <t t-esc="template.logo_y"/>mm;
                    width: <t t-esc="template.logo_width"/>mm;
                    height: <t t-esc="template.logo_height"/>mm;
                    object-fit: contain;
                }
                
                .customer-name {
                    position: absolute;
                    left: <t t-esc="template.name_x"/>mm;
                    top: <t t-esc="template.name_y"/>mm;
                    font-size: <t t-esc="template.font_size_name"/>pt;
                    font-weight: <t t-esc="'bold' if template.name_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.name_italic else 'normal'"/>;
                    text-align: <t t-esc="template.name_align"/>;
                    direction: rtl;
                    max-width: <t t-esc="template.label_width - template.name_x - 5"/>mm;
                }
                
                .customer-phone {
                    position: absolute;
                    left: <t t-esc="template.phone_x"/>mm;
                    top: <t t-esc="template.phone_y"/>mm;
                    font-size: <t t-esc="template.font_size_phone"/>pt;
                    font-weight: <t t-esc="'bold' if template.phone_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.phone_italic else 'normal'"/>;
                    text-align: <t t-esc="template.phone_align"/>;
                    direction: rtl;
                    max-width: <t t-esc="template.label_width - template.phone_x - 5"/>mm;
                }
                
                .customer-mobile {
                    position: absolute;
                    left: <t t-esc="template.mobile_x"/>mm;
                    top: <t t-esc="template.mobile_y"/>mm;
                    font-size: <t t-esc="template.font_size_mobile"/>pt;
                    font-weight: <t t-esc="'bold' if template.mobile_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.mobile_italic else 'normal'"/>;
                    text-align: <t t-esc="template.mobile_align"/>;
                    direction: rtl;
                    max-width: <t t-esc="template.label_width - template.mobile_x - 5"/>mm;
                }
                
                .customer-invoice-type {
                    position: absolute;
                    left: <t t-esc="template.invoice_type_x"/>mm;
                    top: <t t-esc="template.invoice_type_y"/>mm;
                    font-size: <t t-esc="template.font_size_invoice_type"/>pt;
                    font-weight: <t t-esc="'bold' if template.invoice_type_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.invoice_type_italic else 'normal'"/>;
                    text-align: <t t-esc="template.invoice_type_align"/>;
                    direction: rtl;
                    max-width: <t t-esc="template.label_width - template.invoice_type_x - 5"/>mm;
                }
            </style>
            
            <div class="page">
                <t t-set="labels_per_page" t-value="per_row * per_col"/>
                <t t-set="all_labels" t-value="[]"/>
                
                <!-- Create label list -->
                <t t-foreach="docs" t-as="partner">
                    <t t-foreach="range(copies)" t-as="copy">
                        <t t-set="dummy" t-value="all_labels.append(partner)"/>
                    </t>
                </t>
                
                <!-- Split into pages -->
                <t t-set="total_labels" t-value="len(all_labels)"/>
                <t t-set="pages" t-value="(total_labels + labels_per_page - 1) // labels_per_page"/>
                
                <t t-foreach="range(pages)" t-as="page_num">
                    <div class="a4-sheet">
                        <div class="labels-grid">
                            <t t-set="start" t-value="page_num * labels_per_page"/>
                            <t t-set="end" t-value="min((page_num + 1) * labels_per_page, total_labels)"/>
                            
                            <t t-foreach="all_labels[start:end]" t-as="partner">
                                <div class="customer-label">
                                    <!-- Background -->
                                    <t t-if="template.background_image">
                                        <div class="label-bg" t-attf-style="background-image: url(data:image/png;base64,#{template.background_image.decode()});"/>
                                    </t>
                                    
                                    <div class="label-content">
                                        <!-- Logo -->
                                        <t t-if="template.show_logo and template.logo_image">
                                            <img class="logo" t-attf-src="data:image/png;base64,#{template.logo_image.decode()}" alt="Logo"/>
                                        </t>
                                        
                                        <!-- Customer Name -->
                                        <t t-if="template.show_name">
                                            <div class="customer-name">
                                                <t t-esc="partner.name"/>
                                            </div>
                                        </t>
                                        
                                        <!-- Phone -->
                                        <t t-if="template.show_phone">
                                            <t t-set="customer_info" t-value="customer_data.get(str(partner.id), {})"/>
                                            <t t-set="phone_value" t-value="customer_info.get('phone', '') or partner.phone or ''"/>
                                            <t t-if="phone_value">
                                                <div class="customer-phone">
                                                    <t t-esc="'هاتف: ' + phone_value"/>
                                                </div>
                                            </t>
                                        </t>
                                        
                                        <!-- Mobile -->
                                        <t t-if="template.show_mobile">
                                            <t t-set="customer_info" t-value="customer_data.get(str(partner.id), {})"/>
                                            <t t-set="mobile_value" t-value="customer_info.get('mobile', '') or partner.mobile or ''"/>
                                            <t t-if="mobile_value">
                                                <div class="customer-mobile">
                                                    <t t-esc="'موبايل: ' + mobile_value"/>
                                                </div>
                                            </t>
                                        </t>
                                        
                                        <!-- Invoice Type -->
                                        <t t-if="template.show_invoice_type">
                                            <t t-set="customer_info" t-value="customer_data.get(str(partner.id), {})"/>
                                            <t t-set="invoice_type_display" t-value="customer_info.get('invoice_type_display', '') or partner.get_invoice_type_display_name() or ''"/>
                                            <t t-if="invoice_type_display">
                                                <div class="customer-invoice-type">
                                                    <t t-esc="'نوع الفاتورة: ' + invoice_type_display"/>
                                                </div>
                                            </t>
                                        </t>
                                        
                                        <!-- Notes -->
                                        <t t-if="note">
                                            <div class="customer-note" style="position: absolute; left: 5mm; top: 50mm; font-size: 10pt; color: #666; direction: rtl; max-width: 70mm;">
                                                <t t-esc="'ملاحظات: ' + note"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                            
                            <!-- Fill empty cells -->
                            <t t-set="remaining" t-value="labels_per_page - (end - start)"/>
                            <t t-foreach="range(remaining)" t-as="empty">
                                <div class="customer-label" style="border: 1px dashed #ccc;"/>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>

</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Main Label Template - Single Labels -->
    <template id="report_customer_label">
        <t t-call="web.basic_layout">
            <t t-set="template" t-value="template or env['customer.label.template'].get_default_template()"/>
            <t t-set="copies" t-value="copies or 1"/>
            <t t-set="customer_data" t-value="customer_data or {}"/>
            <t t-set="note" t-value="note or ''"/>
            
            <style>
                * { margin: 0; padding: 0; box-sizing: border-box; }
                body { 
                    margin: 0; 
                    padding: 0; 
                    /* Override inherited direction - each element controls its own direction */
                    direction: ltr !important;
                }
                
                .customer-label {
                    width: <t t-esc="template.label_width"/>mm;
                    height: <t t-esc="template.label_height"/>mm;
                    background-color: <t t-esc="template.bg_color"/>;
                    position: relative;
                    font-family: Arial, 'DejaVu Sans', sans-serif;
                    color: <t t-esc="template.text_color"/>;
                    page-break-after: always;
                    overflow: hidden;
                }
                
                .label-bg {
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    z-index: 0;
                    background-size: cover;
                    background-position: center;
                }
                
                .label-content {
                    position: relative;
                    z-index: 1;
                    width: 100%;
                    height: 100%;
                }
                
                .logo {
                    position: absolute;
                    left: <t t-esc="template.logo_x"/>mm;
                    top: <t t-esc="template.logo_y"/>mm;
                    width: <t t-esc="template.logo_width"/>mm;
                    height: <t t-esc="template.logo_height"/>mm;
                    object-fit: contain;
                }
                
                .customer-name {
                    position: absolute;
                    top: <t t-esc="template.name_y"/>mm;
                    font-size: <t t-esc="template.font_size_name"/>pt;
                    font-weight: <t t-esc="'bold' if template.name_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.name_italic else 'normal'"/>;
                    color: <t t-esc="template.name_color or template.text_color or '#000000'"/>;
                    direction: <t t-esc="template.name_direction or 'rtl'"/> !important;
                    unicode-bidi: isolate;
                    left: 0;
                    right: 0;
                    padding-left: <t t-esc="template.name_x"/>mm;
                    padding-right: 5mm;
                    text-align: <t t-esc="template.name_align"/>;
                }
                
                .customer-phone {
                    position: absolute;
                    top: <t t-esc="template.phone_y"/>mm;
                    font-size: <t t-esc="template.font_size_phone"/>pt;
                    font-weight: <t t-esc="'bold' if template.phone_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.phone_italic else 'normal'"/>;
                    color: <t t-esc="template.phone_color or template.text_color or '#000000'"/>;
                    direction: <t t-esc="template.phone_direction or 'rtl'"/> !important;
                    unicode-bidi: isolate;
                    left: 0;
                    right: 0;
                    padding-left: <t t-esc="template.phone_x"/>mm;
                    padding-right: 5mm;
                    text-align: <t t-esc="template.phone_align"/>;
                }
                
                .customer-mobile {
                    position: absolute;
                    top: <t t-esc="template.mobile_y"/>mm;
                    font-size: <t t-esc="template.font_size_mobile"/>pt;
                    font-weight: <t t-esc="'bold' if template.mobile_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.mobile_italic else 'normal'"/>;
                    color: <t t-esc="template.mobile_color or template.text_color or '#000000'"/>;
                    direction: <t t-esc="template.mobile_direction or 'rtl'"/> !important;
                    unicode-bidi: isolate;
                    left: 0;
                    right: 0;
                    padding-left: <t t-esc="template.mobile_x"/>mm;
                    padding-right: 5mm;
                    text-align: <t t-esc="template.mobile_align"/>;
                }
                
                .customer-invoice-type {
                    position: absolute;
                    top: <t t-esc="template.invoice_type_y"/>mm;
                    font-size: <t t-esc="template.font_size_invoice_type"/>pt;
                    font-weight: <t t-esc="'bold' if template.invoice_type_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.invoice_type_italic else 'normal'"/>;
                    color: <t t-esc="template.invoice_type_color or template.text_color or '#000000'"/>;
                    direction: <t t-esc="template.invoice_type_direction or 'rtl'"/> !important;
                    unicode-bidi: isolate;
                    left: 0;
                    right: 0;
                    padding-left: <t t-esc="template.invoice_type_x"/>mm;
                    padding-right: 5mm;
                    text-align: <t t-esc="template.invoice_type_align"/>;
                }
                
                .customer-note {
                    position: absolute;
                    top: <t t-esc="template.note_y"/>mm;
                    font-size: <t t-esc="template.font_size_note"/>pt;
                    font-weight: <t t-esc="'bold' if template.note_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.note_italic else 'normal'"/>;
                    color: <t t-esc="template.note_color or template.text_color or '#000000'"/>;
                    direction: <t t-esc="template.note_direction or 'rtl'"/> !important;
                    unicode-bidi: isolate;
                    left: 0;
                    right: 0;
                    padding-left: <t t-esc="template.note_x"/>mm;
                    padding-right: 5mm;
                    text-align: <t t-esc="template.note_align"/>;
                }
            </style>
            
            <div class="page">
                <t t-foreach="docs" t-as="partner">
                    <t t-foreach="range(copies)" t-as="copy">
                        <div class="customer-label">
                            <!-- Background -->
                            <t t-if="template.background_image">
                                <div class="label-bg" t-attf-style="background-image: url(data:image/png;base64,#{template.background_image.decode()});"/>
                            </t>
                            
                            <div class="label-content">
                                <!-- Logo -->
                                <t t-if="template.show_logo and template.logo_image">
                                    <img class="logo" t-attf-src="data:image/png;base64,#{template.logo_image.decode()}" alt="Logo"/>
                                </t>
                                
                                <!-- Customer Name -->
                                <t t-if="template.show_name">
                                    <div class="customer-name" t-att-dir="template.name_direction or 'rtl'">
                                        <t t-esc="partner.name"/>
                                    </div>
                                </t>
                                
                                <!-- Phone -->
                                <t t-if="template.show_phone">
                                    <t t-set="customer_info" t-value="customer_data.get(str(partner.id), {})"/>
                                    <t t-set="phone_value" t-value="customer_info.get('phone', '') or partner.phone or ''"/>
                                    <t t-if="phone_value">
                                        <div class="customer-phone" t-att-dir="template.phone_direction or 'rtl'">
                                            <t t-if="template.show_phone_label">هاتف: </t><t t-esc="phone_value"/>
                                        </div>
                                    </t>
                                </t>
                                
                                <!-- Mobile -->
                                <t t-if="template.show_mobile">
                                    <t t-set="customer_info" t-value="customer_data.get(str(partner.id), {})"/>
                                    <t t-set="mobile_value" t-value="customer_info.get('mobile', '') or partner.mobile or ''"/>
                                    <t t-if="mobile_value">
                                        <div class="customer-mobile" t-att-dir="template.mobile_direction or 'rtl'">
                                            <t t-if="template.show_mobile_label">موبايل: </t><t t-esc="mobile_value"/>
                                        </div>
                                    </t>
                                </t>
                                
                                <!-- Invoice Type -->
                                <t t-if="template.show_invoice_type">
                                    <t t-set="customer_info" t-value="customer_data.get(str(partner.id), {})"/>
                                    <t t-set="invoice_type_code" t-value="customer_info.get('invoice_type', '')"/>
                                    <t t-set="invoice_type_display" t-value="customer_info.get('invoice_type_display', '')"/>
                                    <t t-if="not invoice_type_display and invoice_type_code">
                                        <t t-set="invoice_type_map" t-value="{'1': 'زبون محل', '2': 'شركات توصيل', '3': 'نقليات', '4': 'ديلفري', '5': 'NBS', '6': 'شورجة', '7': 'NA', '8': 'مكاتب الشورجة'}"/>
                                        <t t-set="invoice_type_display" t-value="invoice_type_map.get(invoice_type_code, '')"/>
                                    </t>
                                    <t t-if="not invoice_type_display">
                                        <t t-set="invoice_type_display" t-value="partner.get_invoice_type_display_name() or ''"/>
                                    </t>
                                    <!-- Show invoice type if display name exists -->
                                    <t t-if="invoice_type_display">
                                        <div class="customer-invoice-type" t-att-dir="template.invoice_type_direction or 'rtl'">
                                            <t t-if="template.show_invoice_type_label">نوع الفاتورة: </t><t t-esc="invoice_type_display"/>
                                        </div>
                                    </t>
                                </t>
                                
                                <!-- Notes -->
                                <t t-if="template.show_note and note">
                                    <div class="customer-note" t-att-dir="template.note_direction or 'rtl'">
                                        <t t-if="template.show_note_label">ملاحظات: </t><t t-esc="note"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </t>
            </div>
        </t>
    </template>

    <!-- A4 Sheet Template - Multiple Labels -->
    <template id="report_customer_label_a4">
        <t t-call="web.basic_layout">
            <!-- Data is already processed by report model -->
            <t t-set="per_row" t-value="int(template.labels_per_row)"/>
            <t t-set="per_col" t-value="int(template.labels_per_column)"/>
            <t t-set="margin" t-value="float(template.label_margin)"/>
            
            <style>
                * { margin: 0; padding: 0; box-sizing: border-box; }
                body { 
                    margin: 0; 
                    padding: 0; 
                    /* Override inherited direction - each element controls its own direction */
                    direction: ltr !important;
                }
                
                .a4-sheet {
                    width: 210mm;
                    min-height: 297mm;
                    padding: 5mm;
                    page-break-after: always;
                }
                
                .labels-grid {
                    display: grid;
                    grid-template-columns: repeat(<t t-esc="per_row"/>, <t t-esc="template.label_width"/>mm);
                    grid-template-rows: repeat(<t t-esc="per_col"/>, <t t-esc="template.label_height"/>mm);
                    gap: <t t-esc="margin"/>mm;
                    justify-content: center;
                }
                
                .customer-label {
                    width: <t t-esc="template.label_width"/>mm;
                    height: <t t-esc="template.label_height"/>mm;
                    background-color: <t t-esc="template.bg_color"/>;
                    position: relative;
                    font-family: Arial, 'DejaVu Sans', sans-serif;
                    color: <t t-esc="template.text_color"/>;
                    overflow: hidden;
                }
                
                .label-bg {
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    z-index: 0;
                    background-size: cover;
                    background-position: center;
                }
                
                .label-content {
                    position: relative;
                    z-index: 1;
                    width: 100%;
                    height: 100%;
                }
                
                .logo {
                    position: absolute;
                    left: <t t-esc="template.logo_x"/>mm;
                    top: <t t-esc="template.logo_y"/>mm;
                    width: <t t-esc="template.logo_width"/>mm;
                    height: <t t-esc="template.logo_height"/>mm;
                    object-fit: contain;
                }
                
                .customer-name {
                    position: absolute;
                    top: <t t-esc="template.name_y"/>mm;
                    font-size: <t t-esc="template.font_size_name"/>pt;
                    font-weight: <t t-esc="'bold' if template.name_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.name_italic else 'normal'"/>;
                    color: <t t-esc="template.name_color or template.text_color or '#000000'"/>;
                    direction: <t t-esc="template.name_direction or 'rtl'"/> !important;
                    unicode-bidi: isolate;
                    left: 0;
                    right: 0;
                    padding-left: <t t-esc="template.name_x"/>mm;
                    padding-right: 5mm;
                    text-align: <t t-esc="template.name_align"/>;
                }
                
                .customer-phone {
                    position: absolute;
                    top: <t t-esc="template.phone_y"/>mm;
                    font-size: <t t-esc="template.font_size_phone"/>pt;
                    font-weight: <t t-esc="'bold' if template.phone_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.phone_italic else 'normal'"/>;
                    color: <t t-esc="template.phone_color or template.text_color or '#000000'"/>;
                    direction: <t t-esc="template.phone_direction or 'rtl'"/> !important;
                    unicode-bidi: isolate;
                    left: 0;
                    right: 0;
                    padding-left: <t t-esc="template.phone_x"/>mm;
                    padding-right: 5mm;
                    text-align: <t t-esc="template.phone_align"/>;
                }
                
                .customer-mobile {
                    position: absolute;
                    top: <t t-esc="template.mobile_y"/>mm;
                    font-size: <t t-esc="template.font_size_mobile"/>pt;
                    font-weight: <t t-esc="'bold' if template.mobile_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.mobile_italic else 'normal'"/>;
                    color: <t t-esc="template.mobile_color or template.text_color or '#000000'"/>;
                    direction: <t t-esc="template.mobile_direction or 'rtl'"/> !important;
                    unicode-bidi: isolate;
                    left: 0;
                    right: 0;
                    padding-left: <t t-esc="template.mobile_x"/>mm;
                    padding-right: 5mm;
                    text-align: <t t-esc="template.mobile_align"/>;
                }
                
                .customer-invoice-type {
                    position: absolute;
                    top: <t t-esc="template.invoice_type_y"/>mm;
                    font-size: <t t-esc="template.font_size_invoice_type"/>pt;
                    font-weight: <t t-esc="'bold' if template.invoice_type_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.invoice_type_italic else 'normal'"/>;
                    color: <t t-esc="template.invoice_type_color or template.text_color or '#000000'"/>;
                    direction: <t t-esc="template.invoice_type_direction or 'rtl'"/> !important;
                    unicode-bidi: isolate;
                    left: 0;
                    right: 0;
                    padding-left: <t t-esc="template.invoice_type_x"/>mm;
                    padding-right: 5mm;
                    text-align: <t t-esc="template.invoice_type_align"/>;
                }
                
                .customer-note {
                    position: absolute;
                    top: <t t-esc="template.note_y"/>mm;
                    font-size: <t t-esc="template.font_size_note"/>pt;
                    font-weight: <t t-esc="'bold' if template.note_bold else 'normal'"/>;
                    font-style: <t t-esc="'italic' if template.note_italic else 'normal'"/>;
                    color: <t t-esc="template.note_color or template.text_color or '#000000'"/>;
                    direction: <t t-esc="template.note_direction or 'rtl'"/> !important;
                    unicode-bidi: isolate;
                    left: 0;
                    right: 0;
                    padding-left: <t t-esc="template.note_x"/>mm;
                    padding-right: 5mm;
                    text-align: <t t-esc="template.note_align"/>;
                }
            </style>
            
            <div class="page">
                <t t-set="labels_per_page" t-value="per_row * per_col"/>
                <t t-set="all_labels" t-value="[]"/>
                
                <!-- Create label list -->
                <t t-foreach="docs" t-as="partner">
                    <t t-foreach="range(copies)" t-as="copy">
                        <t t-set="dummy" t-value="all_labels.append(partner)"/>
                    </t>
                </t>
                
                <!-- Split into pages -->
                <t t-set="total_labels" t-value="len(all_labels)"/>
                <t t-set="pages" t-value="(total_labels + labels_per_page - 1) // labels_per_page"/>
                
                <t t-foreach="range(pages)" t-as="page_num">
                    <div class="a4-sheet">
                        <div class="labels-grid">
                            <t t-set="start" t-value="page_num * labels_per_page"/>
                            <t t-set="end" t-value="min((page_num + 1) * labels_per_page, total_labels)"/>
                            
                            <t t-foreach="all_labels[start:end]" t-as="partner">
                                <div class="customer-label">
                                    <!-- Background -->
                                    <t t-if="template.background_image">
                                        <div class="label-bg" t-attf-style="background-image: url(data:image/png;base64,#{template.background_image.decode()});"/>
                                    </t>
                                    
                                    <div class="label-content">
                                        <!-- Logo -->
                                        <t t-if="template.show_logo and template.logo_image">
                                            <img class="logo" t-attf-src="data:image/png;base64,#{template.logo_image.decode()}" alt="Logo"/>
                                        </t>
                                        
                                        <!-- Customer Name -->
                                        <t t-if="template.show_name">
                                            <div class="customer-name" t-att-dir="template.name_direction or 'rtl'">
                                                <t t-esc="partner.name"/>
                                            </div>
                                        </t>
                                        
                                        <!-- Phone -->
                                        <t t-if="template.show_phone">
                                            <t t-set="customer_info" t-value="customer_data.get(str(partner.id), {})"/>
                                            <t t-set="phone_value" t-value="customer_info.get('phone', '') or partner.phone or ''"/>
                                            <t t-if="phone_value">
                                                <div class="customer-phone" t-att-dir="template.phone_direction or 'rtl'">
                                                    <t t-if="template.show_phone_label">هاتف: </t><t t-esc="phone_value"/>
                                                </div>
                                            </t>
                                        </t>
                                        
                                        <!-- Mobile -->
                                        <t t-if="template.show_mobile">
                                            <t t-set="customer_info" t-value="customer_data.get(str(partner.id), {})"/>
                                            <t t-set="mobile_value" t-value="customer_info.get('mobile', '') or partner.mobile or ''"/>
                                            <t t-if="mobile_value">
                                                <div class="customer-mobile" t-att-dir="template.mobile_direction or 'rtl'">
                                                    <t t-if="template.show_mobile_label">موبايل: </t><t t-esc="mobile_value"/>
                                                </div>
                                            </t>
                                        </t>
                                        
                                        <!-- Invoice Type -->
                                        <t t-if="template.show_invoice_type">
                                            <t t-set="customer_info" t-value="customer_data.get(str(partner.id), {})"/>
                                            <t t-set="invoice_type_code" t-value="customer_info.get('invoice_type', '')"/>
                                            <t t-set="invoice_type_display" t-value="customer_info.get('invoice_type_display', '')"/>
                                            <t t-if="not invoice_type_display and invoice_type_code">
                                                <t t-set="invoice_type_map" t-value="{'1': 'زبون محل', '2': 'شركات توصيل', '3': 'نقليات', '4': 'ديلفري', '5': 'NBS', '6': 'شورجة', '7': 'NA', '8': 'مكاتب الشورجة'}"/>
                                                <t t-set="invoice_type_display" t-value="invoice_type_map.get(invoice_type_code, '')"/>
                                            </t>
                                            <t t-if="not invoice_type_display">
                                                <t t-set="invoice_type_display" t-value="partner.get_invoice_type_display_name() or ''"/>
                                            </t>
                                            <!-- Show invoice type if display name exists -->
                                            <t t-if="invoice_type_display">
                                                <div class="customer-invoice-type" t-att-dir="template.invoice_type_direction or 'rtl'">
                                                    <t t-if="template.show_invoice_type_label">نوع الفاتورة: </t><t t-esc="invoice_type_display"/>
                                                </div>
                                            </t>
                                        </t>
                                        
                                        <!-- Notes -->
                                        <t t-if="template.show_note and note">
                                            <div class="customer-note" t-att-dir="template.note_direction or 'rtl'">
                                                <t t-if="template.show_note_label">ملاحظات: </t><t t-esc="note"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                            
                            <!-- Fill empty cells -->
                            <t t-set="remaining" t-value="labels_per_page - (end - start)"/>
                            <t t-foreach="range(remaining)" t-as="empty">
                                <div class="customer-label" style="border: 1px dashed #ccc;"/>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>

</odoo>


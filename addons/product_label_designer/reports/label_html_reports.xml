<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- HTML Report - A4 Sheet (will be converted to image then PDF) -->
    <record id="action_report_product_label_a4_html" model="ir.actions.report">
        <field name="name">Product Labels (A4 HTML)</field>
        <field name="model">product.product</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">product_label_designer.report_product_label_a4</field>
        <field name="report_file">product_label_designer.report_product_label_a4</field>
        <field name="paperformat_id" ref="paperformat_a4"/>
    </record>

    <!-- HTML Report - Single Labels -->
    <record id="action_report_product_label_html" model="ir.actions.report">
        <field name="name">Product Labels (HTML)</field>
        <field name="model">product.product</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">product_label_designer.report_product_label</field>
        <field name="report_file">product_label_designer.report_product_label</field>
        <field name="paperformat_id" ref="paperformat_label_80x60"/>
    </record>

</odoo>


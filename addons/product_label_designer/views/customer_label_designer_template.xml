<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="customer_label_designer_template" name="Customer Visual Label Designer">
        <t t-call="web.layout">
            <t t-set="head">
                <link rel="stylesheet" href="/product_label_designer/static/src/css/label_designer.css"/>
                <script type="text/javascript">
                    window.templateData = {
                        id: <t t-out="template.id"/>,
                        label_width: <t t-out="template.label_width"/>,
                        label_height: <t t-out="template.label_height"/>,
                        bg_color: '<t t-out="template.bg_color"/>',
                        text_color: '<t t-out="template.text_color"/>',
                        name_color: '<t t-out="template.name_color or template.text_color"/>',
                        phone_color: '<t t-out="template.phone_color or template.text_color"/>',
                        mobile_color: '<t t-out="template.mobile_color or template.text_color"/>',
                        invoice_type_color: '<t t-out="template.invoice_type_color or template.text_color"/>',
                        note_color: '<t t-out="template.note_color or template.text_color"/>',
                        font_size_name: <t t-out="template.font_size_name"/>,
                        font_size_phone: <t t-out="template.font_size_phone"/>,
                        font_size_mobile: <t t-out="template.font_size_mobile"/>,
                        font_size_invoice_type: <t t-out="template.font_size_invoice_type"/>,
                        show_name: <t t-out="'true' if template.show_name else 'false'"/>,
                        show_phone: <t t-out="'true' if template.show_phone else 'false'"/>,
                        show_mobile: <t t-out="'true' if template.show_mobile else 'false'"/>,
                        show_invoice_type: <t t-out="'true' if template.show_invoice_type else 'false'"/>,
                        show_note: <t t-out="'true' if template.show_note else 'false'"/>,
                        show_logo: <t t-out="'true' if template.show_logo else 'false'"/>,
                        show_phone_label: <t t-out="'true' if template.show_phone_label else 'false'"/>,
                        show_mobile_label: <t t-out="'true' if template.show_mobile_label else 'false'"/>,
                        show_invoice_type_label: <t t-out="'true' if template.show_invoice_type_label else 'false'"/>,
                        show_note_label: <t t-out="'true' if template.show_note_label else 'false'"/>,
                        name_x: <t t-out="template.name_x"/>,
                        name_y: <t t-out="template.name_y"/>,
                        name_width: <t t-out="template.name_width or 70.0"/>,
                        name_height: <t t-out="template.name_height or 10.0"/>,
                        phone_x: <t t-out="template.phone_x"/>,
                        phone_y: <t t-out="template.phone_y"/>,
                        phone_width: <t t-out="template.phone_width or 70.0"/>,
                        phone_height: <t t-out="template.phone_height or 8.0"/>,
                        mobile_x: <t t-out="template.mobile_x"/>,
                        mobile_y: <t t-out="template.mobile_y"/>,
                        mobile_width: <t t-out="template.mobile_width or 70.0"/>,
                        mobile_height: <t t-out="template.mobile_height or 8.0"/>,
                        invoice_type_x: <t t-out="template.invoice_type_x"/>,
                        invoice_type_y: <t t-out="template.invoice_type_y"/>,
                        invoice_type_width: <t t-out="template.invoice_type_width or 70.0"/>,
                        invoice_type_height: <t t-out="template.invoice_type_height or 8.0"/>,
                        note_x: <t t-out="template.note_x"/>,
                        note_y: <t t-out="template.note_y"/>,
                        note_width: <t t-out="template.note_width or 70.0"/>,
                        note_height: <t t-out="template.note_height or 8.0"/>,
                        font_size_note: <t t-out="template.font_size_note"/>,
                        note_bold: <t t-out="'true' if template.note_bold else 'false'"/>,
                        note_italic: <t t-out="'true' if template.note_italic else 'false'"/>,
                        note_align: '<t t-out="template.note_align"/>',
                        note_direction: '<t t-if="template.note_direction"><t t-out="template.note_direction"/></t><t t-else="">rtl</t>',
                        logo_x: <t t-out="template.logo_x"/>,
                        logo_y: <t t-out="template.logo_y"/>,
                        logo_width: <t t-out="template.logo_width"/>,
                        logo_height: <t t-out="template.logo_height"/>,
                        name_bold: <t t-out="'true' if template.name_bold else 'false'"/>,
                        phone_bold: <t t-out="'true' if template.phone_bold else 'false'"/>,
                        mobile_bold: <t t-out="'true' if template.mobile_bold else 'false'"/>,
                        invoice_type_bold: <t t-out="'true' if template.invoice_type_bold else 'false'"/>,
                        name_italic: <t t-out="'true' if template.name_italic else 'false'"/>,
                        phone_italic: <t t-out="'true' if template.phone_italic else 'false'"/>,
                        mobile_italic: <t t-out="'true' if template.mobile_italic else 'false'"/>,
                        invoice_type_italic: <t t-out="'true' if template.invoice_type_italic else 'false'"/>,
                        name_align: '<t t-out="template.name_align"/>',
                        name_direction: '<t t-if="template.name_direction"><t t-out="template.name_direction"/></t><t t-else="">rtl</t>',
                        phone_align: '<t t-out="template.phone_align"/>',
                        phone_direction: '<t t-if="template.phone_direction"><t t-out="template.phone_direction"/></t><t t-else="">rtl</t>',
                        mobile_align: '<t t-out="template.mobile_align"/>',
                        mobile_direction: '<t t-if="template.mobile_direction"><t t-out="template.mobile_direction"/></t><t t-else="">rtl</t>',
                        invoice_type_align: '<t t-out="template.invoice_type_align"/>',
                        invoice_type_direction: '<t t-if="template.invoice_type_direction"><t t-out="template.invoice_type_direction"/></t><t t-else="">rtl</t>',
                        background_image: <t t-if="template.background_image">'<t t-out="template.background_image.decode()"/>'</t><t t-else="">null</t>,
                        logo_image: <t t-if="template.logo_image">'<t t-out="template.logo_image.decode()"/>'</t><t t-else="">null</t>,
                    };
                    
                    console.log('=== Customer Template Data Loaded ===');
                    console.log('Template ID:', window.templateData.id);
                    console.log('Show Name:', window.templateData.show_name);
                    console.log('Show Phone:', window.templateData.show_phone);
                    console.log('Show Mobile:', window.templateData.show_mobile);
                    console.log('Show Invoice Type:', window.templateData.show_invoice_type);
                    console.log('Show Logo:', window.templateData.show_logo);
                    console.log('Has Background:', window.templateData.background_image !== null);
                    console.log('Has Logo Image:', window.templateData.logo_image !== null);
                    console.log('=====================================');
                </script>
                <script src="/product_label_designer/static/src/js/customer_label_designer.js"/>
                <script type="text/javascript">
                    // Global functions for alignment, direction and test text
                    function changeAlignment(align) {
                        if (window.customerLabelDesigner) {
                            window.customerLabelDesigner.changeAlignment(align);
                        }
                    }
                    
                    function changeDirection(direction) {
                        if (window.customerLabelDesigner) {
                            window.customerLabelDesigner.changeDirection(direction);
                        }
                    }
                    
                    function applyTestText() {
                        if (window.customerLabelDesigner) {
                            window.customerLabelDesigner.applyTestText();
                        }
                    }
                    
                    function resetTestText() {
                        if (window.customerLabelDesigner) {
                            window.customerLabelDesigner.resetTestText();
                        }
                    }
                    
                    // Setup alignment and direction buttons
                    document.addEventListener('DOMContentLoaded', function() {
                        document.querySelectorAll('.align-btn').forEach(btn => {
                            btn.addEventListener('click', function() {
                                changeAlignment(this.dataset.align);
                            });
                        });
                        
                        document.querySelectorAll('.direction-btn').forEach(btn => {
                            btn.addEventListener('click', function() {
                                changeDirection(this.dataset.direction);
                            });
                        });
                    });
                </script>
            </t>
            
            <div id="label-designer" class="label-designer-container">
                <div class="designer-sidebar">
                    <h2 style="margin-bottom: 20px; color: #00A09D;">
                        <i class="fa fa-paint-brush"/> Customer Label Designer
                    </h2>
                    
                    <h4>Template: <t t-esc="template.name"/></h4>
                    <p style="color: #666; font-size: 12px;">
                        <t t-esc="template.label_width"/>mm × <t t-esc="template.label_height"/>mm
                    </p>
                    
                    <div class="designer-property-panel">
                        <div class="property-group">
                            <h4>Elements</h4>
                            <ul class="element-list"></ul>
                        </div>
                        
                        <div class="property-group">
                            <h4>Selected Position</h4>
                            <div class="position-inputs">
                                <div>
                                    <label>X (mm)</label>
                                    <input type="number" name="position_x" class="property-input" step="0.1" readonly=""/>
                                </div>
                                <div>
                                    <label>Y (mm)</label>
                                    <input type="number" name="position_y" class="property-input" step="0.1" readonly=""/>
                                </div>
                            </div>
                        </div>
                        
                        <div class="property-group">
                            <h4>Selected Size</h4>
                            <div class="position-inputs">
                                <div>
                                    <label>Width (mm)</label>
                                    <input type="number" name="size_width" class="property-input" step="0.1" readonly=""/>
                                </div>
                                <div>
                                    <label>Height (mm)</label>
                                    <input type="number" name="size_height" class="property-input" step="0.1" readonly=""/>
                                </div>
                            </div>
                        </div>
                        
                        <div class="property-group" id="text-alignment-group" style="display: none;">
                            <h4>Text Alignment</h4>
                            <div class="alignment-buttons" style="display: flex; gap: 5px;">
                                <button class="btn-designer align-btn" data-align="right" title="Right (يمين)" style="flex: 1;">
                                    <i class="fa fa-align-right"/> يمين
                                </button>
                                <button class="btn-designer align-btn" data-align="center" title="Center (وسط)" style="flex: 1;">
                                    <i class="fa fa-align-center"/> وسط
                                </button>
                                <button class="btn-designer align-btn" data-align="left" title="Left (يسار)" style="flex: 1;">
                                    <i class="fa fa-align-left"/> يسار
                                </button>
                            </div>
                        </div>
                        
                        <div class="property-group" id="text-direction-group" style="display: none;">
                            <h4>Text Direction</h4>
                            <div class="direction-buttons" style="display: flex; gap: 5px;">
                                <button class="btn-designer direction-btn" data-direction="rtl" title="Right to Left (RTL)" style="flex: 1;">
                                    <i class="fa fa-arrow-left"/> RTL
                                </button>
                                <button class="btn-designer direction-btn" data-direction="ltr" title="Left to Right (LTR)" style="flex: 1;">
                                    <i class="fa fa-arrow-right"/> LTR
                                </button>
                            </div>
                        </div>
                        
                        <div class="property-group" id="test-text-group" style="display: none;">
                            <h4>Test Text (تجربة النص)</h4>
                            <textarea 
                                id="test-text-input" 
                                class="property-input" 
                                rows="3" 
                                placeholder="أدخل نص تجريبي لاختبار الحجم والشكل..."
                                style="resize: vertical; min-height: 60px;"
                            ></textarea>
                            <button class="btn-designer" onclick="applyTestText()" style="width: 100%; margin-top: 5px;">
                                <i class="fa fa-check"/> Apply Test Text
                            </button>
                            <button class="btn-designer" onclick="resetTestText()" style="width: 100%; margin-top: 5px; background: #f5f5f5;">
                                <i class="fa fa-undo"/> Reset to Default
                            </button>
                        </div>
                        
                        <div class="property-group">
                            <h4>🖼️ Background Image</h4>
                            <div id="background-preview" style="margin-bottom: 10px;">
                                <t t-if="template.background_image">
                                    <img t-attf-src="data:image/png;base64,#{template.background_image.decode()}" 
                                         style="max-width: 100%; height: auto; border: 1px solid #ddd; border-radius: 4px; margin-bottom: 5px;" 
                                         alt="Background"/>
                                </t>
                                <t t-else="">
                                    <div style="padding: 20px; background: #f5f5f5; border: 1px dashed #ccc; border-radius: 4px; text-align: center; color: #999;">
                                        No background
                                    </div>
                                </t>
                            </div>
                            <input type="file" id="background-upload" accept="image/*" style="margin-bottom: 5px;"/>
                            <button class="btn-designer" onclick="removeImage('background')" style="width: 100%;">
                                <i class="fa fa-trash"/> Remove Background
                            </button>
                        </div>
                        
                        <div class="property-group">
                            <h4>🏷️ Logo</h4>
                            <div id="logo-preview" style="margin-bottom: 10px;">
                                <t t-if="template.logo_image">
                                    <img t-attf-src="data:image/png;base64,#{template.logo_image.decode()}" 
                                         style="max-width: 100%; height: auto; border: 1px solid #ddd; border-radius: 4px; margin-bottom: 5px;" 
                                         alt="Logo"/>
                                </t>
                                <t t-else="">
                                    <div style="padding: 20px; background: #f5f5f5; border: 1px dashed #ccc; border-radius: 4px; text-align: center; color: #999;">
                                        No logo
                                    </div>
                                </t>
                            </div>
                            <input type="file" id="logo-upload" accept="image/*" style="margin-bottom: 5px;"/>
                            <button class="btn-designer" onclick="removeImage('logo')" style="width: 100%;">
                                <i class="fa fa-trash"/> Remove Logo
                            </button>
                        </div>
                        
                        <div class="property-group">
                            <h4>Actions</h4>
                            <button class="btn-designer" onclick="savePositions()">
                                <i class="fa fa-save"/> Save Positions
                            </button>
                        </div>
                    </div>
                </div>
                
                <div class="designer-canvas-area">
                    <!-- Canvas will be created by JavaScript -->
                </div>
            </div>
        </t>
    </template>

</odoo>


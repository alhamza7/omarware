<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Template List View -->
    <record id="view_label_template_list" model="ir.ui.view">
        <field name="name">product.label.template.list</field>
        <field name="model">product.label.template</field>
        <field name="arch" type="xml">
            <list string="Label Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="label_width"/>
                <field name="label_height"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Template Form View -->
    <record id="view_label_template_form" model="ir.ui.view">
        <field name="name">product.label.template.form</field>
        <field name="model">product.label.template</field>
        <field name="arch" type="xml">
            <form string="Label Template">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="label_width"/>
                            <field name="label_height"/>
                            <field name="rotate_label"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Display Options" name="display">
                            <group>
                                <group string="Elements">
                                    <field name="show_name"/>
                                    <field name="show_foreign_name"/>
                                    <field name="show_code"/>
                                    <field name="show_price"/>
                                    <field name="show_sub_uom"/>
                                    <field name="show_barcode"/>
                                    <field name="show_qr"/>
                                    <field name="show_logo"/>
                                </group>
                                <group string="Colors">
                                    <field name="text_color" widget="color"/>
                                    <field name="price_color" widget="color"/>
                                    <field name="bg_color" widget="color"/>
                                </group>
                            </group>
                            <group>
                                <group string="Font Sizes">
                                    <field name="font_size_name"/>
                                    <field name="font_size_foreign_name"/>
                                    <field name="font_size_code"/>
                                    <field name="font_size_price"/>
                                    <field name="font_size_sub_uom" invisible="not show_sub_uom"/>
                                    <field name="font_size_barcode"/>
                                </group>
                                <group string="Text Alignment">
                                    <field name="name_align"/>
                                    <field name="foreign_name_align"/>
                                    <field name="code_align"/>
                                    <field name="price_align"/>
                                </group>
                            </group>
                            <group>
                                <group string="Font Weight (Bold)">
                                    <field name="name_bold"/>
                                    <field name="foreign_name_bold"/>
                                    <field name="code_bold"/>
                                    <field name="price_bold"/>
                                </group>
                                <group string="Font Style (Italic)">
                                    <field name="name_italic"/>
                                    <field name="foreign_name_italic"/>
                                    <field name="code_italic"/>
                                    <field name="price_italic"/>
                                </group>
                            </group>
                            <group>
                                <group string="Price Display">
                                    <field name="show_currency_symbol"/>
                                </group>
                            </group>
                            <separator string="Auto Font Sizing (Smart Text Adjustment)"/>
                            <group>
                                <group>
                                    <field name="enable_auto_font_sizing"/>
                                    <div class="alert alert-info" role="alert">
                                        <p><strong>ℹ️ Auto Font Sizing:</strong> يقوم تلقائياً بتعديل حجم خط اسم المنتج بناءً على طول النص</p>
                                        <ul>
                                            <li>نص قصير = خط أكبر</li>
                                            <li>نص طويل = خط أصغر</li>
                                            <li>يضمن احتواء النص داخل المساحة المتاحة</li>
                                        </ul>
                                    </div>
                                </group>
                            </group>
                            <group invisible="not enable_auto_font_sizing">
                                <group string="Font Multipliers (نسب التكبير/التصغير)">
                                    <field name="font_multiplier_very_short"/>
                                    <field name="font_multiplier_short"/>
                                    <field name="font_multiplier_medium"/>
                                    <field name="font_multiplier_long"/>
                                    <field name="font_multiplier_very_long"/>
                                </group>
                                <group string="Character Thresholds (حدود عدد الأحرف)">
                                    <field name="char_threshold_very_short"/>
                                    <field name="char_threshold_short"/>
                                    <field name="char_threshold_medium"/>
                                    <field name="char_threshold_long"/>
                                </group>
                            </group>
                        </page>
                        <page string="A4 Layout" name="a4_layout">
                            <group>
                                <group string="Labels per Page">
                                    <field name="labels_per_row"/>
                                    <field name="labels_per_column"/>
                                    <field name="label_margin"/>
                                </group>
                                <group string="Info">
                                    <div class="alert alert-info" style="margin-top: 10px;">
                                        <p><strong>💡 Grid Configuration:</strong></p>
                                        <p>Configure how many labels to print per A4 page.</p>
                                        <p><strong>Recommended:</strong> 2×4 (8 labels) for 80×60mm</p>
                                        <p><strong>Other options:</strong> 3×6, 4×8, etc.</p>
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="SAP Integration" name="sap_integration">
                            <group>
                                <group string="SAP Connection Settings">
                                    <field name="sap_mode_enabled"/>
                                    <field name="sap_backend_id" 
                                           options="{'no_create': True, 'no_open': True}"
                                           invisible="not sap_mode_enabled"
                                           required="sap_mode_enabled"
                                           domain="[('active', '=', True)]"/>
                                </group>
                                <group string="SAP UoM Display">
                                    <field name="show_sap_uom" invisible="not sap_mode_enabled"/>
                                    <field name="sap_uom_format" invisible="not show_sap_uom or not sap_mode_enabled"/>
                                </group>
                            </group>
                            <group invisible="not sap_mode_enabled">
                                <div class="alert alert-success" style="margin: 10px;">
                                    <p><strong>✓ وضع SAP مُفعّل</strong></p>
                                    <p>سيتم استخدام هذا القالب للطباعة المستمرة من SAP</p>
                                    <p><strong>الميزات:</strong></p>
                                    <ul>
                                        <li>مسح الباركود التلقائي</li>
                                        <li>البحث في SAP مباشرة عن طريق Barcode أو ItemCode</li>
                                        <li>طباعة فورية بدون تدخل</li>
                                        <li>عرض اسم المنتج ووحدة القياس من SAP</li>
                                        <li>إنشاء أو تحديث المنتج في Odoo تلقائياً</li>
                                    </ul>
                                </div>
                            </group>
                            <group invisible="not sap_mode_enabled" string="SAP Element Positions &amp; Styling">
                                <group string="SAP Product Name">
                                    <field name="sap_name_x" invisible="not sap_mode_enabled"/>
                                    <field name="sap_name_y" invisible="not sap_mode_enabled"/>
                                    <field name="sap_name_width" invisible="not sap_mode_enabled"/>
                                    <field name="sap_name_height" invisible="not sap_mode_enabled"/>
                                    <field name="font_size_sap_name" invisible="not sap_mode_enabled"/>
                                    <field name="sap_name_align" invisible="not sap_mode_enabled"/>
                                    <field name="sap_name_bold" invisible="not sap_mode_enabled"/>
                                    <field name="sap_name_italic" invisible="not sap_mode_enabled"/>
                                </group>
                                <group string="SAP Unit of Measure" invisible="not show_sap_uom">
                                    <field name="sap_uom_x" invisible="not show_sap_uom or not sap_mode_enabled"/>
                                    <field name="sap_uom_y" invisible="not show_sap_uom or not sap_mode_enabled"/>
                                    <field name="sap_uom_width" invisible="not show_sap_uom or not sap_mode_enabled"/>
                                    <field name="sap_uom_height" invisible="not show_sap_uom or not sap_mode_enabled"/>
                                    <field name="font_size_sap_uom" invisible="not show_sap_uom or not sap_mode_enabled"/>
                                    <field name="sap_uom_align" invisible="not show_sap_uom or not sap_mode_enabled"/>
                                    <field name="sap_uom_bold" invisible="not show_sap_uom or not sap_mode_enabled"/>
                                    <field name="sap_uom_italic" invisible="not show_sap_uom or not sap_mode_enabled"/>
                                </group>
                            </group>
                        </page>
                        <page string="Visual Designer" name="designer">
                            <group>
                                <group string="Name Position & Size">
                                    <field name="name_x"/>
                                    <field name="name_y"/>
                                    <field name="name_width"/>
                                    <field name="name_height"/>
                                    <field name="name_wrap"/>
                                    <field name="name_rotation"/>
                                </group>
                                <group string="Foreign Name Position & Size">
                                    <field name="foreign_name_x"/>
                                    <field name="foreign_name_y"/>
                                    <field name="foreign_name_width"/>
                                    <field name="foreign_name_height"/>
                                    <field name="foreign_name_wrap"/>
                                    <field name="foreign_name_rotation"/>
                                </group>
                            </group>
                            <group>
                                <group string="Code Position & Size">
                                    <field name="code_x"/>
                                    <field name="code_y"/>
                                    <field name="code_width"/>
                                    <field name="code_rotation"/>
                                </group>
                                <group string="Price Position & Size">
                                    <field name="price_x"/>
                                    <field name="price_y"/>
                                    <field name="price_width"/>
                                    <field name="price_rotation"/>
                                </group>
                            </group>
                            <group invisible="not show_sub_uom">
                                <group string="Sub UoM Position & Size">
                                    <field name="sub_uom_x" invisible="not show_sub_uom"/>
                                    <field name="sub_uom_y" invisible="not show_sub_uom"/>
                                    <field name="sub_uom_width" invisible="not show_sub_uom"/>
                                    <field name="sub_uom_rotation" invisible="not show_sub_uom"/>
                                </group>
                                <group/>
                            </group>
                            <group>
                                <group string="Barcode Position">
                                    <field name="barcode_x"/>
                                    <field name="barcode_y"/>
                                </group>
                                <group string="QR Code Position &amp; Size">
                                    <field name="qr_x"/>
                                    <field name="qr_y"/>
                                    <field name="qr_size"/>
                                </group>
                            </group>
                            <group>
                                <group string="Logo Position &amp; Size">
                                    <field name="logo_x"/>
                                    <field name="logo_y"/>
                                    <field name="logo_width"/>
                                    <field name="logo_height"/>
                                </group>
                            </group>
                            <group>
                                <button name="action_open_designer" string="Open Visual Designer" type="object" class="btn-primary" icon="fa-paint-brush"/>
                            </group>
                        </page>
                        <page string="Images" name="images">
                            <group>
                                <group string="Background">
                                    <field name="background_image" widget="image"/>
                                </group>
                                <group string="Logo">
                                    <field name="logo_image" widget="image"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_label_template" model="ir.actions.act_window">
        <field name="name">Label Templates</field>
        <field name="res_model">product.label.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Product Selection View for Printing -->
    <record id="view_product_label_printing_list" model="ir.ui.view">
        <field name="name">product.product.label.printing.list</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list string="Select Products to Print">
                <field name="default_code"/>
                <field name="name"/>
                <field name="foreign_name"/>
                <field name="list_price"/>
                <field name="barcode"/>
                <field name="categ_id"/>
            </list>
        </field>
    </record>

    <!-- Action to open product selection -->
    <record id="action_print_product_labels" model="ir.actions.act_window">
        <field name="name">Print Product Labels</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_product_label_printing_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Select products to print labels
            </p>
            <p>
                Select one or more products and use the "Print Labels" action to print.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_label_root" name="Product Labels" parent="stock.menu_stock_root" sequence="20"/>
    
    <menuitem id="menu_label_templates" name="Label Templates" parent="menu_label_root" 
              action="action_label_template" sequence="10"/>
    
    <menuitem id="menu_print_labels" name="Select Products" parent="menu_label_root"
              action="action_print_product_labels" sequence="20"/>
    
    <!-- SAP Continuous Printing Menu -->
    <record id="action_sap_label_printer" model="ir.actions.act_url">
        <field name="name">SAP Label Printer</field>
        <field name="url">/sap/label/printer</field>
        <field name="target">new</field>
    </record>
    
    <menuitem id="menu_sap_label_printer" name="SAP Label Printer (Barcode Scan)" 
              parent="menu_label_root"
              action="action_sap_label_printer" 
              sequence="5"/>

    <!-- Add foreign name field to product form -->
    <record id="view_product_form_foreign_name" model="ir.ui.view">
        <field name="name">product.product.form.foreign.name</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="foreign_name" placeholder="e.g., Perfume Bottle 30ml"/>
                <field name="sap_product_name" readonly="1" invisible="not sap_product_name"/>
                <field name="sap_uom" readonly="1" invisible="not sap_uom"/>
                <field name="last_sap_sync" readonly="1" invisible="not last_sap_sync"/>
            </xpath>
        </field>
    </record>

    <!-- Add button to product form -->
    <record id="view_product_form_button" model="ir.ui.view">
        <field name="name">product.product.form.label.button</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_print_label" type="object" class="oe_stat_button" icon="fa-print">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Print Label</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>


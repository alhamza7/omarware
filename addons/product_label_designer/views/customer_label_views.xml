<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Template List View -->
    <record id="view_customer_label_template_list" model="ir.ui.view">
        <field name="name">customer.label.template.list</field>
        <field name="model">customer.label.template</field>
        <field name="arch" type="xml">
            <list string="Customer Label Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="label_width"/>
                <field name="label_height"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Template Form View -->
    <record id="view_customer_label_template_form" model="ir.ui.view">
        <field name="name">customer.label.template.form</field>
        <field name="model">customer.label.template</field>
        <field name="arch" type="xml">
            <form string="Customer Label Template">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="label_width"/>
                            <field name="label_height"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Display Options" name="display">
                            <group>
                                <group string="Elements">
                                    <field name="show_name"/>
                                    <field name="show_phone"/>
                                    <field name="show_mobile"/>
                                    <field name="show_invoice_type"/>
                                    <field name="show_logo"/>
                                </group>
                                <group string="Colors">
                                    <field name="text_color" widget="color"/>
                                    <field name="bg_color" widget="color"/>
                                </group>
                            </group>
                            <group>
                                <group string="Font Sizes">
                                    <field name="font_size_name"/>
                                    <field name="font_size_phone"/>
                                    <field name="font_size_mobile"/>
                                    <field name="font_size_invoice_type"/>
                                </group>
                                <group string="Text Alignment">
                                    <field name="name_align"/>
                                    <field name="phone_align"/>
                                    <field name="mobile_align"/>
                                    <field name="invoice_type_align"/>
                                </group>
                            </group>
                            <group>
                                <group string="Font Weight (Bold)">
                                    <field name="name_bold"/>
                                    <field name="phone_bold"/>
                                    <field name="mobile_bold"/>
                                    <field name="invoice_type_bold"/>
                                </group>
                                <group string="Font Style (Italic)">
                                    <field name="name_italic"/>
                                    <field name="phone_italic"/>
                                    <field name="mobile_italic"/>
                                    <field name="invoice_type_italic"/>
                                </group>
                            </group>
                        </page>
                        <page string="A4 Layout" name="a4_layout">
                            <group>
                                <group string="Labels per Page">
                                    <field name="labels_per_row"/>
                                    <field name="labels_per_column"/>
                                    <field name="label_margin"/>
                                </group>
                                <group string="Info">
                                    <div class="alert alert-info" style="margin-top: 10px;">
                                        <p><strong>💡 Grid Configuration:</strong></p>
                                        <p>Configure how many labels to print per A4 page.</p>
                                        <p><strong>Recommended:</strong> 2×4 (8 labels) for 80×60mm</p>
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Visual Designer" name="designer">
                            <group>
                                <group string="Name Position">
                                    <field name="name_x"/>
                                    <field name="name_y"/>
                                </group>
                                <group string="Phone Position">
                                    <field name="phone_x"/>
                                    <field name="phone_y"/>
                                </group>
                            </group>
                            <group>
                                <group string="Mobile Position">
                                    <field name="mobile_x"/>
                                    <field name="mobile_y"/>
                                </group>
                                <group string="Invoice Type Position">
                                    <field name="invoice_type_x"/>
                                    <field name="invoice_type_y"/>
                                </group>
                            </group>
                            <group>
                                <group string="Logo Position &amp; Size">
                                    <field name="logo_x"/>
                                    <field name="logo_y"/>
                                    <field name="logo_width"/>
                                    <field name="logo_height"/>
                                </group>
                            </group>
                            <group>
                                <button name="action_open_designer" string="Open Visual Designer" type="object" class="btn-primary" icon="fa-paint-brush"/>
                            </group>
                        </page>
                        <page string="Images" name="images">
                            <group>
                                <group string="Background">
                                    <field name="background_image" widget="image"/>
                                </group>
                                <group string="Logo">
                                    <field name="logo_image" widget="image"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_customer_label_template" model="ir.actions.act_window">
        <field name="name">Customer Label Templates</field>
        <field name="res_model">customer.label.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
    </record>

    <!-- Menu in Product Labels -->
    <menuitem id="menu_customer_label_templates" name="Customer Label Templates" 
              parent="menu_label_root" 
              action="action_customer_label_template" 
              sequence="30"
              groups="base.group_user"/>
    
    <!-- Menu in Contacts (if contacts module is installed) -->
    <menuitem id="menu_customer_label_templates_contacts" name="Customer Label Templates" 
              parent="contacts.menu_contacts" 
              action="action_customer_label_template" 
              sequence="100"
              groups="base.group_user"/>

    <!-- Add button to customer form -->
    <record id="view_partner_form_customer_label_button" model="ir.ui.view">
        <field name="name">res.partner.form.customer.label.button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_print_customer_label" type="object" class="oe_stat_button" icon="fa-print">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Print Label</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>


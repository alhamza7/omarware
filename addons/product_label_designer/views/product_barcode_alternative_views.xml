<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Alternative Barcode Tree View -->
    <record id="view_product_barcode_alternative_tree" model="ir.ui.view">
        <field name="name">product.barcode.alternative.tree</field>
        <field name="model">product.barcode.alternative</field>
        <field name="arch" type="xml">
            <list string="Alternative Barcodes" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="product_id" readonly="1"/>
                <field name="barcode"/>
                <field name="uom_name"/>
                <field name="uom_id"/>
                <field name="sap_uom_entry"/>
                <field name="active"/>
                <field name="last_sync"/>
            </list>
        </field>
    </record>

    <!-- Product Alternative Barcode Form View -->
    <record id="view_product_barcode_alternative_form" model="ir.ui.view">
        <field name="name">product.barcode.alternative.form</field>
        <field name="model">product.barcode.alternative</field>
        <field name="arch" type="xml">
            <form string="Alternative Barcode">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="barcode"/>
                            <field name="uom_name"/>
                        </group>
                        <group>
                            <field name="uom_id"/>
                            <field name="sap_uom_entry"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="last_sync"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Product Form View Inherit - Add Alternative Barcodes -->
    <record id="view_product_product_form_inherit_alt_barcode" model="ir.ui.view">
        <field name="name">product.product.form.inherit.alt.barcode</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="alternative_barcode_count" invisible="1"/>
                <button name="action_view_alternative_barcodes" 
                        type="object" 
                        string="Alternative Barcodes" 
                        class="oe_stat_button" 
                        icon="fa-barcode"
                        invisible="alternative_barcode_count == 0">
                    <field name="alternative_barcode_count" widget="statinfo" string="Alt. Barcodes"/>
                </button>
            </xpath>
            
            <xpath expr="//notebook" position="inside">
                <page string="Alternative Barcodes" name="alternative_barcodes">
                    <field name="alternative_barcode_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="barcode"/>
                            <field name="uom_name"/>
                            <field name="uom_id"/>
                            <field name="sap_uom_entry"/>
                            <field name="active"/>
                            <field name="last_sync"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Action for Alternative Barcodes -->
    <record id="action_product_barcode_alternative" model="ir.actions.act_window">
        <field name="name">Alternative Barcodes</field>
        <field name="res_model">product.barcode.alternative</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No alternative barcodes found
            </p>
            <p>
                Alternative barcodes are synchronized from SAP for sub-unit measures.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_product_barcode_alternative"
              name="Alternative Barcodes"
              parent="stock.menu_stock_config_settings"
              action="action_product_barcode_alternative"
              sequence="100"/>

</odoo>


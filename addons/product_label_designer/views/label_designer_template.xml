<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="label_designer_template" name="Visual Label Designer">
        <t t-call="web.layout">
            <t t-set="head">
                <link rel="stylesheet" href="/product_label_designer/static/src/css/label_designer.css"/>
                <script type="text/javascript">
                    window.templateData = {
                        id: <t t-out="template.id"/>,
                        label_width: <t t-out="template.label_width"/>,
                        label_height: <t t-out="template.label_height"/>,
                        bg_color: '<t t-out="template.bg_color"/>',
                        text_color: '<t t-out="template.text_color"/>',
                        price_color: '<t t-out="template.price_color"/>',
                        font_size_name: <t t-out="template.font_size_name"/>,
                        font_size_code: <t t-out="template.font_size_code"/>,
                        font_size_price: <t t-out="template.font_size_price"/>,
                        show_name: <t t-out="'true' if template.show_name else 'false'"/>,
                        show_foreign_name: <t t-out="'true' if template.show_foreign_name else 'false'"/>,
                        show_code: <t t-out="'true' if template.show_code else 'false'"/>,
                        show_price: <t t-out="'true' if template.show_price else 'false'"/>,
                        show_barcode: <t t-out="'true' if template.show_barcode else 'false'"/>,
                        show_qr: <t t-out="'true' if template.show_qr else 'false'"/>,
                        show_logo: <t t-out="'true' if template.show_logo else 'false'"/>,
                        // Positions
                        name_x: <t t-out="template.name_x"/>,
                        name_y: <t t-out="template.name_y"/>,
                        name_rotation: <t t-out="template.name_rotation or 0"/>,
                        foreign_name_x: <t t-out="template.foreign_name_x"/>,
                        foreign_name_y: <t t-out="template.foreign_name_y"/>,
                        foreign_name_rotation: <t t-out="template.foreign_name_rotation or 0"/>,
                        code_x: <t t-out="template.code_x"/>,
                        code_y: <t t-out="template.code_y"/>,
                        code_rotation: <t t-out="template.code_rotation or 0"/>,
                        price_x: <t t-out="template.price_x"/>,
                        price_y: <t t-out="template.price_y"/>,
                        price_rotation: <t t-out="template.price_rotation or 0"/>,
                        barcode_x: <t t-out="template.barcode_x"/>,
                        barcode_y: <t t-out="template.barcode_y"/>,
                        barcode_width: <t t-out="template.barcode_width or 60"/>,
                        barcode_height: <t t-out="template.barcode_height or 12"/>,
                        barcode_rotation: <t t-out="template.barcode_rotation or 0"/>,
                        barcode_scale: <t t-out="template.barcode_scale or 1"/>,
                        qr_x: <t t-out="template.qr_x"/>,
                        qr_y: <t t-out="template.qr_y"/>,
                        qr_size: <t t-out="template.qr_size"/>,
                        qr_rotation: <t t-out="template.qr_rotation or 0"/>,
                        logo_x: <t t-out="template.logo_x"/>,
                        logo_y: <t t-out="template.logo_y"/>,
                        logo_width: <t t-out="template.logo_width"/>,
                        logo_height: <t t-out="template.logo_height"/>,
                        logo_rotation: <t t-out="template.logo_rotation or 0"/>,
                        background_image: <t t-if="template.background_image">'<t t-out="template.background_image.decode()"/>'</t><t t-else="">null</t>,
                        logo_image: <t t-if="template.logo_image">'<t t-out="template.logo_image.decode()"/>'</t><t t-else="">null</t>,
                    };
                    
                    console.log('=== Template Data Loaded ===');
                    console.log('Template ID:', window.templateData.id);
                    console.log('Show QR:', window.templateData.show_qr);
                    console.log('Show Logo:', window.templateData.show_logo);
                    console.log('Has Background:', window.templateData.background_image !== null);
                    console.log('Has Logo Image:', window.templateData.logo_image !== null);
                    console.log('Rotation fields available:', {
                        name: window.templateData.name_rotation,
                        barcode: window.templateData.barcode_rotation,
                        price: window.templateData.price_rotation
                    });
                    console.log('===========================');
                </script>
                <script src="/product_label_designer/static/src/js/label_designer.js"/>
            </t>
            
            <div id="label-designer" class="label-designer-container">
                <div class="designer-sidebar">
                    <h2 style="margin-bottom: 20px; color: #00A09D;">
                        <i class="fa fa-paint-brush"/> Label Designer
                    </h2>
                    
                    <h4>Template: <t t-esc="template.name"/></h4>
                    <p style="color: #666; font-size: 12px;">
                        <t t-esc="template.label_width"/>mm × <t t-esc="template.label_height"/>mm
                    </p>
                    
                    <div class="designer-property-panel">
                        <div class="property-group">
                            <h4>Elements</h4>
                            <ul class="element-list"></ul>
                        </div>
                        
                        <div class="property-group">
                            <h4>Selected Position</h4>
                            <div class="position-inputs">
                                <div>
                                    <label>X (mm)</label>
                                    <input type="number" name="position_x" class="property-input" step="0.1" readonly=""/>
                                </div>
                                <div>
                                    <label>Y (mm)</label>
                                    <input type="number" name="position_y" class="property-input" step="0.1" readonly=""/>
                                </div>
                            </div>
                        </div>
                        
                        <div class="property-group">
                            <h4>🔄 Rotation &amp; Scale</h4>
                            <div class="position-inputs">
                                <div>
                                    <label>Rotation (°)</label>
                                    <input type="number" name="rotation" class="property-input" step="1" min="0" max="360" 
                                           onchange="window.labelDesigner.updateRotation(this.value)"/>
                                </div>
                                <div id="scale-controls" style="display: none;">
                                    <label>Scale</label>
                                    <input type="number" name="scale" class="property-input" step="0.1" min="0.1" max="3" 
                                           onchange="window.labelDesigner.updateScale(this.value)"/>
                                </div>
                            </div>
                            <p style="font-size: 11px; color: #666; margin-top: 5px;">
                                💡 Hold Shift + drag to rotate<br/>
                                💡 Hold Ctrl + scroll to scale
                            </p>
                        </div>
                        
                        <div class="property-group">
                            <h4>🖼️ Background Image</h4>
                            <div id="background-preview" style="margin-bottom: 10px;">
                                <t t-if="template.background_image">
                                    <img t-attf-src="data:image/png;base64,#{template.background_image.decode()}" 
                                         style="max-width: 100%; height: auto; border: 1px solid #ddd; border-radius: 4px; margin-bottom: 5px;" 
                                         alt="Background"/>
                                </t>
                                <t t-else="">
                                    <div style="padding: 20px; background: #f5f5f5; border: 1px dashed #ccc; border-radius: 4px; text-align: center; color: #999;">
                                        No background
                                    </div>
                                </t>
                            </div>
                            <input type="file" id="background-upload" accept="image/*" style="display: none;"/>
                            <button class="btn-designer" onclick="document.getElementById('background-upload').click()" style="width: 100%; margin-bottom: 5px;">
                                <i class="fa fa-upload"/> Upload Background
                            </button>
                            <button class="btn-designer" onclick="window.labelDesigner.removeImage('background')" style="width: 100%;">
                                <i class="fa fa-trash"/> Remove Background
                            </button>
                        </div>
                        
                        <div class="property-group">
                            <h4>🏷️ Logo Image</h4>
                            <div id="logo-preview" style="margin-bottom: 10px;">
                                <t t-if="template.logo_image">
                                    <img t-attf-src="data:image/png;base64,#{template.logo_image.decode()}" 
                                         style="max-width: 100%; height: auto; border: 1px solid #ddd; border-radius: 4px; margin-bottom: 5px;" 
                                         alt="Logo"/>
                                </t>
                                <t t-else="">
                                    <div style="padding: 20px; background: #f5f5f5; border: 1px dashed #ccc; border-radius: 4px; text-align: center; color: #999;">
                                        No logo
                                    </div>
                                </t>
                            </div>
                            <input type="file" id="logo-upload" accept="image/*" style="display: none;"/>
                            <button class="btn-designer" onclick="document.getElementById('logo-upload').click()" style="width: 100%; margin-bottom: 5px;">
                                <i class="fa fa-upload"/> Upload Logo
                            </button>
                            <button class="btn-designer" onclick="window.labelDesigner.removeImage('logo')" style="width: 100%;">
                                <i class="fa fa-trash"/> Remove Logo
                            </button>
                        </div>
                        
                        <div class="property-group">
                            <h4>⌨️ Shortcuts</h4>
                            <ul style="font-size: 12px; color: #666; list-style: none; padding: 0;">
                                <li>⬅️ ➡️ ⬆️ ⬇️ Move 1mm</li>
                                <li>Shift + Arrows: Move 10mm</li>
                                <li>Click to select</li>
                                <li>Drag to move</li>
                                <li>🔄 Shift + Drag: Rotate</li>
                                <li>📏 Ctrl + Scroll: Scale</li>
                                <li>R key: Reset rotation</li>
                            </ul>
                        </div>
                        
                        <button class="btn-designer primary" onclick="window.labelDesigner.savePositions()" style="width: 100%; margin-top: 20px;">
                            <i class="fa fa-save"/> Save Positions
                        </button>
                        
                        <a href="/web#action=product_label_designer.action_label_template" class="btn-designer" style="display: block; text-align: center; margin-top: 10px; text-decoration: none;">
                            <i class="fa fa-arrow-left"/> Back to Templates
                        </a>
                    </div>
                </div>
                
                <div class="designer-canvas-area">
                    <!-- Canvas will be created here by JavaScript -->
                </div>
                
                <div class="zoom-controls">
                    <button class="btn-designer" onclick="alert('Zoom feature coming soon')">
                        <i class="fa fa-search-minus"/>
                    </button>
                    <button class="btn-designer" onclick="alert('Zoom feature coming soon')">
                        <i class="fa fa-search-plus"/>
                    </button>
                </div>
            </div>
        </t>
    </template>

</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tag Tree -->
    <record id="view_perfume_tag_tree" model="ir.ui.view">
        <field name="name">perfume.tag.tree</field>
        <field name="model">perfume.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" decoration-muted="not active">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Tag Form -->
    <record id="view_perfume_tag_form" model="ir.ui.view">
        <field name="name">perfume.tag.form</field>
        <field name="model">perfume.tag</field>
        <field name="arch" type="xml">
            <form string="Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Perfumes">
                            <field name="perfume_ids" readonly="1">
                                <list string="Perfumes">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="brand_id"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tag Search -->
    <record id="view_perfume_tag_search" model="ir.ui.view">
        <field name="name">perfume.tag.search</field>
        <field name="model">perfume.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Tag Action -->
    <record id="action_perfume_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">perfume.tag</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_perfume_tag_search"/>
    </record>
</odoo>



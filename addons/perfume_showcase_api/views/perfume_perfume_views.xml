<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_perfume_perfume_tree" model="ir.ui.view">
        <field name="name">perfume.perfume.tree</field>
        <field name="model">perfume.perfume</field>
        <field name="arch" type="xml">
            <list string="Perfumes" decoration-muted="not active">
                <field name="name"/>
                <field name="code"/>
                <field name="brand_id"/>
                <field name="longevity"/>
                <field name="sillage"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_perfume_perfume_form" model="ir.ui.view">
        <field name="name">perfume.perfume.form</field>
        <field name="model">perfume.perfume</field>
        <field name="arch" type="xml">
            <form string="Perfume">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="brand_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image_128', 'size': [90, 90]}"/>
                            <field name="image_url" placeholder="https://example.com/image.jpg"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="longevity"/>
                            <field name="sillage"/>
                        </group>
                        <group>
                            <!-- Simple tags without color_field to avoid requiring a 'color' field on the related model -->
                            <field name="season_ids" widget="many2many_tags"/>
                            <field name="occasion_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Enter perfume description..."/>
                    </group>
                    <group>
                        <field name="tag_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <group>
                                <group string="Top Notes">
                                    <field name="top_note_ids" widget="many2many_tags" nolabel="1"/>
                                </group>
                                <group string="Middle Notes">
                                    <field name="middle_note_ids" widget="many2many_tags" nolabel="1"/>
                                </group>
                                <group string="Base Notes">
                                    <field name="base_note_ids" widget="many2many_tags" nolabel="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_perfume_perfume" model="ir.actions.act_window">
        <field name="name">Perfumes</field>
        <field name="res_model">perfume.perfume</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_active': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first perfume!
            </p>
            <p>
                Add perfumes with all their details: notes, seasons, occasions, and descriptions.
            </p>
        </field>
    </record>

    <!-- Note Views -->
    <record id="view_perfume_note_tree" model="ir.ui.view">
        <field name="name">perfume.note.tree</field>
        <field name="model">perfume.note</field>
        <field name="arch" type="xml">
            <list string="Notes" decoration-muted="not active">
                <field name="name"/>
                <field name="category"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_perfume_note_form" model="ir.ui.view">
        <field name="name">perfume.note.form</field>
        <field name="model">perfume.note</field>
        <field name="arch" type="xml">
            <form string="Note">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_perfume_note" model="ir.actions.act_window">
        <field name="name">Notes</field>
        <field name="res_model">perfume.note</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Season Views -->
    <record id="view_perfume_season_tree" model="ir.ui.view">
        <field name="name">perfume.season.tree</field>
        <field name="model">perfume.season</field>
        <field name="arch" type="xml">
            <list string="Seasons" decoration-muted="not active">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_perfume_season_form" model="ir.ui.view">
        <field name="name">perfume.season.form</field>
        <field name="model">perfume.season</field>
        <field name="arch" type="xml">
            <form string="Season">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_perfume_season" model="ir.actions.act_window">
        <field name="name">Seasons</field>
        <field name="res_model">perfume.season</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Occasion Views -->
    <record id="view_perfume_occasion_tree" model="ir.ui.view">
        <field name="name">perfume.occasion.tree</field>
        <field name="model">perfume.occasion</field>
        <field name="arch" type="xml">
            <list string="Occasions" decoration-muted="not active">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_perfume_occasion_form" model="ir.ui.view">
        <field name="name">perfume.occasion.form</field>
        <field name="model">perfume.occasion</field>
        <field name="arch" type="xml">
            <form string="Occasion">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_perfume_occasion" model="ir.actions.act_window">
        <field name="name">Occasions</field>
        <field name="res_model">perfume.occasion</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>


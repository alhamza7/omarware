<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_perfume_brand_tree" model="ir.ui.view">
        <field name="name">perfume.brand.tree</field>
        <field name="model">perfume.brand</field>
        <field name="arch" type="xml">
            <list string="Brands" decoration-muted="not active">
                <field name="name"/>
                <field name="code"/>
                <field name="country"/>
                <field name="perfume_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_perfume_brand_form" model="ir.ui.view">
        <field name="name">perfume.brand.form</field>
        <field name="model">perfume.brand</field>
        <field name="arch" type="xml">
            <form string="Brand">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="country"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="perfume_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Perfumes" name="perfumes">
                            <field name="perfumes" nolabel="1">
                                <list string="Perfumes" editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_perfume_brand_search" model="ir.ui.view">
        <field name="name">perfume.brand.search</field>
        <field name="model">perfume.brand</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="country"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_perfume_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">perfume.brand</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_perfume_brand_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first brand!
            </p>
            <p>
                Brands represent perfume houses (e.g., Louis Vuitton, Dior, Chanel).
            </p>
        </field>
    </record>
</odoo>


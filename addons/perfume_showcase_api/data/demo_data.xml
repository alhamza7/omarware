<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Demo Data for Perfume Showcase -->
    <!-- This file can be used to import initial data -->
    
    <!-- Seasons -->
    <record id="season_spring" model="perfume.season">
        <field name="name">Spring</field>
    </record>
    
    <record id="season_summer" model="perfume.season">
        <field name="name">Summer</field>
    </record>
    
    <record id="season_fall" model="perfume.season">
        <field name="name">Fall</field>
    </record>
    
    <record id="season_winter" model="perfume.season">
        <field name="name">Winter</field>
    </record>
    
    <record id="season_all" model="perfume.season">
        <field name="name">All Seasons</field>
    </record>
    
    <!-- Occasions -->
    <record id="occasion_daytime" model="perfume.occasion">
        <field name="name">Daytime</field>
    </record>
    
    <record id="occasion_evening" model="perfume.occasion">
        <field name="name">Evening</field>
    </record>
    
    <record id="occasion_office" model="perfume.occasion">
        <field name="name">Office</field>
    </record>
    
    <record id="occasion_casual" model="perfume.occasion">
        <field name="name">Casual</field>
    </record>
    
    <record id="occasion_special" model="perfume.occasion">
        <field name="name">Special Events</field>
    </record>
    
    <record id="occasion_romantic" model="perfume.occasion">
        <field name="name">Romantic</field>
    </record>
    
    <record id="occasion_sport" model="perfume.occasion">
        <field name="name">Sport</field>
    </record>
    
    <record id="occasion_vacation" model="perfume.occasion">
        <field name="name">Vacation</field>
    </record>
    
    <!-- Notes - Top -->
    <record id="note_bergamot" model="perfume.note">
        <field name="name">Bergamot</field>
        <field name="category">top</field>
    </record>
    
    <record id="note_incense" model="perfume.note">
        <field name="name">Incense</field>
        <field name="category">top</field>
    </record>
    
    <record id="note_raspberry" model="perfume.note">
        <field name="name">Raspberry</field>
        <field name="category">top</field>
    </record>
    
    <!-- Notes - Middle -->
    <record id="note_rose" model="perfume.note">
        <field name="name">Rose</field>
        <field name="category">middle</field>
    </record>
    
    <record id="note_saffron" model="perfume.note">
        <field name="name">Saffron</field>
        <field name="category">middle</field>
    </record>
    
    <!-- Notes - Base -->
    <record id="note_oud" model="perfume.note">
        <field name="name">Oud Wood</field>
        <field name="category">base</field>
    </record>
    
    <record id="note_musk" model="perfume.note">
        <field name="name">Musk</field>
        <field name="category">base</field>
    </record>
    
    <record id="note_vanilla" model="perfume.note">
        <field name="name">Vanilla</field>
        <field name="category">base</field>
    </record>
</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_upload_wizard_form" model="ir.ui.view">
        <field name="name">nbs.upload.wizard.form</field>
        <field name="model">nbs.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Document">
                <group>
                    <field name="department_id"/>
                    <field name="document_type_id"/>
                    <field name="title"/>
                    <field name="file_name" invisible="1"/>
                    <field name="file_data" filename="file_name"/>
                    <field name="tags" widget="many2many_tags"/>
                    <field name="confidentiality_level"/>
                </group>
                <footer>
                    <button string="Upload" type="object" name="action_upload_document" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_upload_wizard" model="ir.actions.act_window">
        <field name="name">Upload Document</field>
        <field name="res_model">nbs.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>



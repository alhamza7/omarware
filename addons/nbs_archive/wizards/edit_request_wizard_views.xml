<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edit_request_wizard_form" model="ir.ui.view">
        <field name="name">nbs.edit.request.wizard.form</field>
        <field name="model">nbs.edit.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Edit">
                <group>
                    <field name="document_id" readonly="1"/>
                    <field name="reason" placeholder="Please explain why you need to edit this document..."/>
                </group>
                <footer>
                    <button string="Submit Request" type="object" name="action_submit_request" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>



<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nbs_document_type_tree" model="ir.ui.view">
        <field name="name">nbs.document.type.tree</field>
        <field name="model">nbs.document.type</field>
        <field name="arch" type="xml">
            <tree string="Document Types">
                <field name="name"/>
                <field name="code"/>
                <field name="department_id"/>
            </tree>
        </field>
    </record>

    <record id="action_nbs_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">nbs.document.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_nbs_document_type"
              name="Document Types"
              parent="menu_nbs_configuration"
              action="action_nbs_document_type"
              sequence="20"/>
</odoo>



<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_nbs_department_tree" model="ir.ui.view">
        <field name="name">nbs.department.tree</field>
        <field name="model">nbs.department</field>
        <field name="arch" type="xml">
            <tree string="Departments">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_nbs_department_form" model="ir.ui.view">
        <field name="name">nbs.department.form</field>
        <field name="model">nbs.department</field>
        <field name="arch" type="xml">
            <form string="Department">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_nbs_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">nbs.department</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_nbs_department"
              name="Departments"
              parent="menu_nbs_configuration"
              action="action_nbs_department"
              sequence="10"/>
</odoo>



<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nbs_audit_log_tree" model="ir.ui.view">
        <field name="name">nbs.audit.log.tree</field>
        <field name="model">nbs.audit.log</field>
        <field name="arch" type="xml">
            <tree string="Audit Logs" create="false" edit="false" delete="false">
                <field name="user_id"/>
                <field name="action"/>
                <field name="document_id"/>
                <field name="timestamp"/>
            </tree>
        </field>
    </record>

    <record id="action_nbs_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Logs</field>
        <field name="res_model">nbs.audit.log</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_nbs_audit_log"
              name="Audit Logs"
              parent="menu_nbs_configuration"
              action="action_nbs_audit_log"
              sequence="90"/>
</odoo>



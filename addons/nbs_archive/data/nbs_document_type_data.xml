<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Document Types for Supply Chain -->
        <record id="doctype_shipping" model="nbs.document.type">
            <field name="name">Shipping Documents</field>
            <field name="code">SHIP</field>
            <field name="department_id" ref="dept_supply_chain"/>
        </record>
        
        <record id="doctype_invoice" model="nbs.document.type">
            <field name="name">Invoice</field>
            <field name="code">INV</field>
            <field name="department_id" ref="dept_finance"/>
        </record>
        
        <record id="doctype_contract" model="nbs.document.type">
            <field name="name">Contract</field>
            <field name="code">CONTRACT</field>
            <field name="department_id" ref="dept_finance"/>
        </record>
        
        <record id="doctype_qc_report" model="nbs.document.type">
            <field name="name">QC Report</field>
            <field name="code">QC_RPT</field>
            <field name="department_id" ref="dept_qc"/>
        </record>
        
    </data>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Document Types for Supply Chain -->
        <record id="doctype_shipping" model="nbs.document.type">
            <field name="name">Shipping Documents</field>
            <field name="code">SHIP</field>
            <field name="department_id" ref="dept_supply_chain"/>
        </record>
        
        <record id="doctype_invoice" model="nbs.document.type">
            <field name="name">Invoice</field>
            <field name="code">INV</field>
            <field name="department_id" ref="dept_finance"/>
        </record>
        
        <record id="doctype_contract" model="nbs.document.type">
            <field name="name">Contract</field>
            <field name="code">CONTRACT</field>
            <field name="department_id" ref="dept_finance"/>
        </record>
        
        <record id="doctype_qc_report" model="nbs.document.type">
            <field name="name">QC Report</field>
            <field name="code">QC_RPT</field>
            <field name="department_id" ref="dept_qc"/>
        </record>
        
        <record id="doctype_employee_file" model="nbs.document.type">
            <field name="name">Employee File</field>
            <field name="code">EMP_FILE</field>
            <field name="department_id" ref="dept_hr"/>
        </record>
        
        <record id="doctype_po" model="nbs.document.type">
            <field name="name">Purchase Order</field>
            <field name="code">PO</field>
            <field name="department_id" ref="dept_supply_chain"/>
        </record>
        
        <record id="doctype_delivery" model="nbs.document.type">
            <field name="name">Delivery Note</field>
            <field name="code">DN</field>
            <field name="department_id" ref="dept_supply_chain"/>
        </record>
        
        <record id="doctype_receipt" model="nbs.document.type">
            <field name="name">Receipt</field>
            <field name="code">RCPT</field>
            <field name="department_id" ref="dept_finance"/>
        </record>
        
        <record id="doctype_agreement" model="nbs.document.type">
            <field name="name">Agreement</field>
            <field name="code">AGR</field>
            <field name="department_id" ref="dept_legal"/>
        </record>
        
        <record id="doctype_policy" model="nbs.document.type">
            <field name="name">Company Policy</field>
            <field name="code">POLICY</field>
            <field name="department_id" ref="dept_management"/>
        </record>
        
        <record id="doctype_memo" model="nbs.document.type">
            <field name="name">Internal Memo</field>
            <field name="code">MEMO</field>
            <field name="department_id" ref="dept_management"/>
        </record>
        
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Always enable WebSocket rollout.
            Using set_param() (upsert) so re-installs never fail with
            a unique-constraint error if the key already exists in the DB.
        -->
        <function model="ir.config_parameter" name="set_param">
            <value eval="'ws.rollout.enabled'"/>
            <value eval="'True'"/>
        </function>
        <!-- Keep authenticated WS sessions valid for one year (server side).
             The browser cookie/expires_in in ws_session.py uses the same value.
             Logout still invalidates the session immediately. -->
        <function model="ir.config_parameter" name="set_param">
            <value eval="'sessions.max_inactivity_seconds'"/>
            <value eval="'31536000'"/>
        </function>
    </data>
</odoo>

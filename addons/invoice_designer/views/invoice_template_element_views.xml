<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Invoice Template Element Form View -->
        <record id="view_invoice_template_element_form" model="ir.ui.view">
            <field name="name">invoice.template.element.form</field>
            <field name="model">invoice.template.element</field>
            <field name="arch" type="xml">
                <form string="Template Element">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="element_type"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="z_index"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <!-- Position & Size -->
                            <page string="Position &amp; Size">
                                <group>
                                    <group string="Position">
                                        <field name="position"/>
                                        <field name="x"/>
                                        <field name="y"/>
                                    </group>
                                    <group string="Size">
                                        <field name="width"/>
                                        <field name="height"/>
                                        <field name="rotation"/>
                                    </group>
                                </group>
                            </page>
                            
                            <!-- Content -->
                            <page string="Content" invisible="element_type not in ['text', 'field']">
                                <group>
                                    <field name="content" invisible="element_type != 'text'"/>
                                    <field name="field_name" invisible="element_type != 'field'"/>
                                    <field name="field_format" invisible="element_type != 'field'"/>
                                </group>
                            </page>
                            
                            <!-- Font & Text -->
                            <page string="Font &amp; Text" invisible="element_type not in ['text', 'field']">
                                <group>
                                    <group string="Font">
                                        <field name="font_family_name"/>
                                        <field name="custom_font_name" invisible="font_family_name != 'custom'"/>
                                        <field name="font_size"/>
                                        <field name="font_weight"/>
                                        <field name="font_style"/>
                                    </group>
                                    <group string="Text Style">
                                        <field name="text_align"/>
                                        <field name="text_decoration"/>
                                        <field name="text_transform"/>
                                        <field name="letter_spacing"/>
                                        <field name="line_height"/>
                                        <field name="text_shadow"/>
                                    </group>
                                </group>
                            </page>
                            
                            <!-- Colors -->
                            <page string="Colors">
                                <group>
                                    <group string="Text &amp; Background">
                                        <field name="color" widget="color"/>
                                        <field name="background_color" widget="color"/>
                                        <field name="opacity"/>
                                    </group>
                                    <group string="Gradient" invisible="not background_gradient">
                                        <field name="background_gradient"/>
                                        <field name="gradient_type" invisible="not background_gradient"/>
                                        <field name="gradient_direction" invisible="not background_gradient or gradient_type != 'linear'"/>
                                        <field name="gradient_color_start" widget="color" invisible="not background_gradient"/>
                                        <field name="gradient_color_end" widget="color" invisible="not background_gradient"/>
                                    </group>
                                </group>
                            </page>
                            
                            <!-- Borders -->
                            <page string="Borders">
                                <group>
                                    <group string="Border Width">
                                        <field name="border_top_width"/>
                                        <field name="border_right_width"/>
                                        <field name="border_bottom_width"/>
                                        <field name="border_left_width"/>
                                    </group>
                                    <group string="Border Style">
                                        <field name="border_top_style"/>
                                        <field name="border_top_color" widget="color"/>
                                    </group>
                                </group>
                                <group>
                                    <group string="Border Radius">
                                        <field name="border_top_left_radius"/>
                                        <field name="border_top_right_radius"/>
                                        <field name="border_bottom_right_radius"/>
                                        <field name="border_bottom_left_radius"/>
                                    </group>
                                </group>
                            </page>
                            
                            <!-- Box Shadow -->
                            <page string="Shadow">
                                <group>
                                    <field name="box_shadow_enabled"/>
                                    <group invisible="not box_shadow_enabled">
                                        <field name="box_shadow_x"/>
                                        <field name="box_shadow_y"/>
                                        <field name="box_shadow_blur"/>
                                        <field name="box_shadow_spread"/>
                                        <field name="box_shadow_color" widget="color"/>
                                        <field name="box_shadow_inset"/>
                                    </group>
                                </group>
                            </page>
                            
                            <!-- TABLE SETTINGS - الجزء المهم -->
                            <page string="Table Settings" invisible="element_type != 'table'">
                                <group string="Table Font &amp; Direction">
                                    <group>
                                        <field name="table_font_family"/>
                                        <field name="table_custom_font" invisible="table_font_family != 'custom'"/>
                                    </group>
                                    <group>
                                        <field name="table_direction"/>
                                    </group>
                                </group>
                                
                                <group string="Column Visibility">
                                    <group>
                                        <field name="show_column_product"/>
                                        <field name="show_column_description"/>
                                        <field name="show_column_qty"/>
                                        <field name="show_column_uom"/>
                                    </group>
                                    <group>
                                        <field name="show_column_price"/>
                                        <field name="show_column_discount"/>
                                        <field name="show_column_tax"/>
                                        <field name="show_column_subtotal"/>
                                    </group>
                                </group>
                                
                                <group string="Column Order (Sequence)">
                                    <group>
                                        <field name="column_order_product" invisible="not show_column_product"/>
                                        <field name="column_order_description" invisible="not show_column_description"/>
                                        <field name="column_order_qty" invisible="not show_column_qty"/>
                                        <field name="column_order_uom" invisible="not show_column_uom"/>
                                    </group>
                                    <group>
                                        <field name="column_order_price" invisible="not show_column_price"/>
                                        <field name="column_order_discount" invisible="not show_column_discount"/>
                                        <field name="column_order_tax" invisible="not show_column_tax"/>
                                        <field name="column_order_subtotal" invisible="not show_column_subtotal"/>
                                    </group>
                                </group>
                                
                                <group string="Column Widths (%)">
                                    <group>
                                        <field name="column_width_product" invisible="not show_column_product"/>
                                        <field name="column_width_description" invisible="not show_column_description"/>
                                        <field name="column_width_qty" invisible="not show_column_qty"/>
                                        <field name="column_width_uom" invisible="not show_column_uom"/>
                                    </group>
                                    <group>
                                        <field name="column_width_price" invisible="not show_column_price"/>
                                        <field name="column_width_discount" invisible="not show_column_discount"/>
                                        <field name="column_width_tax" invisible="not show_column_tax"/>
                                        <field name="column_width_subtotal" invisible="not show_column_subtotal"/>
                                    </group>
                                </group>
                                
                                <group string="Column Alignment">
                                    <group>
                                        <field name="column_align_product" invisible="not show_column_product"/>
                                        <field name="column_align_description" invisible="not show_column_description"/>
                                        <field name="column_align_qty" invisible="not show_column_qty"/>
                                        <field name="column_align_uom" invisible="not show_column_uom"/>
                                    </group>
                                    <group>
                                        <field name="column_align_price" invisible="not show_column_price"/>
                                        <field name="column_align_discount" invisible="not show_column_discount"/>
                                        <field name="column_align_tax" invisible="not show_column_tax"/>
                                        <field name="column_align_subtotal" invisible="not show_column_subtotal"/>
                                    </group>
                                </group>
                                
                                <group string="Column Headers (Arabic)">
                                    <group>
                                        <field name="header_product" invisible="not show_column_product"/>
                                        <field name="header_description" invisible="not show_column_description"/>
                                        <field name="header_qty" invisible="not show_column_qty"/>
                                        <field name="header_uom" invisible="not show_column_uom"/>
                                    </group>
                                    <group>
                                        <field name="header_price" invisible="not show_column_price"/>
                                        <field name="header_discount" invisible="not show_column_discount"/>
                                        <field name="header_tax" invisible="not show_column_tax"/>
                                        <field name="header_subtotal" invisible="not show_column_subtotal"/>
                                    </group>
                                </group>
                                
                                <group string="Table Header Style">
                                    <group>
                                        <field name="table_header_bg" widget="color"/>
                                        <field name="table_header_color" widget="color"/>
                                        <field name="table_header_font_size"/>
                                        <field name="table_header_font_weight"/>
                                    </group>
                                </group>
                                
                                <group string="Table Row Style">
                                    <group>
                                        <field name="table_row_bg" widget="color"/>
                                        <field name="table_row_alternate_bg" widget="color"/>
                                    </group>
                                    <group>
                                        <field name="table_row_color" widget="color"/>
                                        <field name="table_row_font_size"/>
                                    </group>
                                </group>
                                
                                <group string="Table Borders">
                                    <group>
                                        <field name="table_border_color" widget="color"/>
                                        <field name="table_border_width"/>
                                        <field name="table_cell_padding"/>
                                    </group>
                                </group>
                                
                                <group string="Table Footer">
                                    <field name="show_table_footer"/>
                                    <field name="table_footer_text" invisible="not show_table_footer"/>
                                </group>
                                
                                <group string="Pagination">
                                    <field name="table_max_rows_per_page"/>
                                    <label for="table_max_rows_per_page" string="(0 = no limit)"/>
                                </group>
                            </page>
                            
                            <!-- Spacing -->
                            <page string="Spacing">
                                <group>
                                    <group string="Padding">
                                        <field name="padding_top"/>
                                        <field name="padding_right"/>
                                        <field name="padding_bottom"/>
                                        <field name="padding_left"/>
                                    </group>
                                    <group string="Margin">
                                        <field name="margin_top"/>
                                        <field name="margin_right"/>
                                        <field name="margin_bottom"/>
                                        <field name="margin_left"/>
                                    </group>
                                </group>
                            </page>
                            
                            <!-- Advanced -->
                            <page string="Advanced">
                                <group>
                                    <field name="display"/>
                                    <field name="custom_css" widget="text"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Invoice Template Element Tree View -->
        <record id="view_invoice_template_element_tree" model="ir.ui.view">
            <field name="name">invoice.template.element.tree</field>
            <field name="model">invoice.template.element</field>
            <field name="arch" type="xml">
                <list string="Template Elements" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="element_type"/>
                    <field name="x"/>
                    <field name="y"/>
                    <field name="width"/>
                    <field name="height"/>
                    <field name="z_index"/>
                </list>
            </field>
        </record>
        
    </data>
</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Sale Order Form: Add Invoice Template Field -->
    <record id="view_order_form_invoice_designer" model="ir.ui.view">
        <field name="name">sale.order.form.invoice.designer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
            <!-- Add Print button in header -->
            <xpath expr="//header" position="inside">
                <button name="action_print_with_designer" 
                        string="Print with Designer" 
                        type="object"
                        class="btn-primary"
                        icon="fa-print"
                        invisible="state not in ['sale', 'done']"/>
            </xpath>
            
            <!-- Add template field in other info -->
            <xpath expr="//page[@name='other_information']" position="inside">
                <group string="Invoice Designer">
                    <field name="invoice_template_id"/>
                </group>
            </xpath>
            
        </field>
    </record>
    
    
    <!-- POS Order Form: Add Invoice Template Field -->
    <record id="view_pos_order_form_invoice_designer" model="ir.ui.view">
        <field name="name">pos.order.form.invoice.designer</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            
            <!-- Add Print button -->
            <xpath expr="//header" position="inside">
                <button name="action_print_with_designer" 
                        string="Print Receipt" 
                        type="object"
                        class="btn-secondary"
                        icon="fa-print"/>
            </xpath>
            
            <!-- Add template field -->
            <xpath expr="//group[@name='info']" position="after">
                <group string="Receipt Template">
                    <field name="invoice_template_id"/>
                </group>
            </xpath>
            
        </field>
    </record>
    
</odoo>


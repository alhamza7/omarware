<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- ==================== MENU ==================== -->
        
        <menuitem id="menu_invoice_designer_root"
                  name="Invoice Designer"
                  sequence="50"/>
        
        <menuitem id="menu_invoice_designer_templates"
                  name="Templates"
                  parent="menu_invoice_designer_root"
                  sequence="10"/>
        
        
        <!-- ==================== ACTION ==================== -->
        
        <record id="action_invoice_template_designer" model="ir.actions.act_window">
            <field name="name">Invoice Templates</field>
            <field name="res_model">invoice.template.designer</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first invoice template!
                </p>
            </field>
        </record>
        
        <menuitem id="menu_invoice_template_designer"
                  name="Invoice Templates"
                  parent="menu_invoice_designer_templates"
                  action="action_invoice_template_designer"
                  sequence="10"/>
        
        <!-- Template Elements Menu (for direct access) -->
        <menuitem id="menu_invoice_template_elements"
                  name="Template Elements"
                  parent="menu_invoice_designer_templates"
                  action="invoice_template_element_views.action_invoice_template_element"
                  sequence="20"/>
        
        
        <!-- ==================== TREE VIEW ==================== -->
        
        <record id="view_invoice_template_designer_tree_minimal" model="ir.ui.view">
            <field name="name">invoice.template.designer.tree.minimal</field>
            <field name="model">invoice.template.designer</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <list string="Templates">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="template_type"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        
        
        <!-- ==================== FORM VIEW ==================== -->
        
        <record id="view_invoice_template_designer_form_minimal" model="ir.ui.view">
            <field name="name">invoice.template.designer.form.minimal</field>
            <field name="model">invoice.template.designer</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <form string="Invoice Template">
                    <header>
                        <button name="action_open_visual_designer" 
                                string="Open Visual Designer" 
                                type="object" 
                                class="oe_highlight"
                                icon="fa-paint-brush"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="template_type"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        
                        <notebook>
                            <page string="Page Settings">
                                <group>
                                    <field name="page_format"/>
                                    <field name="page_width"/>
                                    <field name="page_height"/>
                                    <field name="page_orientation"/>
                                </group>
                            </page>
                            
                            <page string="Margins">
                                <group>
                                    <field name="margin_top"/>
                                    <field name="margin_right"/>
                                    <field name="margin_bottom"/>
                                    <field name="margin_left"/>
                                </group>
                            </page>
                            
                            <page string="Default Font &amp; Direction">
                                <group string="Default Font for Entire Invoice">
                                    <group>
                                        <field name="default_font_family"/>
                                        <field name="default_custom_font" invisible="default_font_family != 'custom'"/>
                                        <field name="default_font_size"/>
                                    </group>
                                </group>
                                <group string="Default Direction">
                                    <field name="default_direction"/>
                                </group>
                                <separator string="ملاحظة"/>
                                <div class="text-muted">
                                    <p>• الخط والاتجاه الافتراضي يُطبق على الفاتورة بالكامل</p>
                                    <p>• يمكن للعناصر الفردية تجاوز هذه الإعدادات</p>
                                    <p>• RTL (من اليمين لليسار) للعربية</p>
                                    <p>• LTR (من اليسار لليمين) للإنجليزية</p>
                                </div>
                            </page>
                            
                            <page string="Description">
                                <field name="description"/>
                            </page>
                            
                            <page string="Elements">
                                <field name="element_ids" context="{'default_template_id': active_id}">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="element_type"/>
                                        <field name="x"/>
                                        <field name="y"/>
                                        <field name="width"/>
                                        <field name="height"/>
                                        <field name="visible"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
    </data>
</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Categories -->
        <record id="module_category_invoice_designer" model="ir.module.category">
            <field name="name">Invoice Designer</field>
            <field name="description">Manage invoice templates and designer</field>
            <field name="sequence">50</field>
        </record>
        
        <!-- Groups -->
        <record id="group_invoice_designer_user" model="res.groups">
            <field name="name">Invoice Designer User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <record id="group_invoice_designer_manager" model="res.groups">
            <field name="name">Invoice Designer Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_invoice_designer_user'))]"/>
        </record>
        
    </data>
</odoo>

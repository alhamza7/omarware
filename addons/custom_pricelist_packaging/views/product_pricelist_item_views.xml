<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Add Packaging field to Pricelist Item form view -->
        <record id="product_pricelist_item_form_view_inherit_packaging" model="ir.ui.view">
            <field name="name">product.pricelist.item.form.inherit.packaging</field>
            <field name="model">product.pricelist.item</field>
            <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
            <field name="arch" type="xml">
                <!-- Add packaging field after product_id field -->
                <field name="product_id" position="after">
                    <field name="product_packaging_id"
                           invisible="display_applied_on not in ('1_product', '0_product_variant')"
                           options="{'no_create': True, 'no_create_edit': True}"
                           placeholder="Select a packaging..."/>
                </field>
            </field>
        </record>

        <!-- Add Packaging field to Sale Order Line form view (inside order form) -->
        <record id="sale_order_line_form_view_inherit_packaging" model="ir.ui.view">
            <field name="name">sale.order.line.form.inherit.packaging</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- Add packaging field after product_uom_id in order line nested form -->
                <xpath expr="//field[@name='order_line']//field[@name='product_uom_id']" position="after">
                    <field name="product_packaging_id"
                           groups="uom.group_uom"
                           optional="hide"
                           column_invisible="1"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                </xpath>
            </field>
        </record>

        <!-- Add Packaging field to Sale Order Line tree view -->
        <record id="sale_order_line_tree_view_inherit_packaging" model="ir.ui.view">
            <field name="name">sale.order.line.tree.inherit.packaging</field>
            <field name="model">sale.order.line</field>
            <field name="inherit_id" ref="sale.view_order_line_tree"/>
            <field name="arch" type="xml">
                <!-- Add packaging column in order line tree view -->
                <field name="product_uom_id" position="after">
                    <field name="product_packaging_id"
                           groups="uom.group_uom"
                           optional="hide"
                           column_invisible="1"/>
                </field>
            </field>
        </record>
    </data>
</odoo>


# User systemd (no sudo): copies to ~/.config/systemd/user/odoo-nbs.service
# Boot without login: sudo loginctl enable-linger lugalai  (once)

[Unit]
Description=Odoo 19 (nbs_lugalai) user service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/lugalai/Lugal-ai
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/lugalai/Lugal-ai/venv/bin/python3 /home/lugalai/Lugal-ai/odoo-bin -c /home/lugalai/Lugal-ai/odoo_simple.conf
Restart=always
RestartSec=15
StartLimitIntervalSec=300
StartLimitBurst=5
KillMode=mixed
TimeoutStopSec=120

[Install]
WantedBy=default.target

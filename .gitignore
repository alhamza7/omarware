# sphinx build directories
_build/

# dotfiles
.*
!.gitignore
!.gitkeep
!.github
!.mailmap
!.weblate.json

# compiled python files
*.py[co]
__pycache__/

# setup.py egg_info
*.egg-info

# emacs backup files
*~

# hg stuff
*.orig
status

# odoo filestore
odoo/filestore

# maintenance migration scripts
odoo/addons/base/maintenance

# windows installation config file
install/win32/*.bat
install/win32/meta.py

# needed only when building for win32
setup/win32/static/less/
setup/win32/static/wkhtmltopdf/
setup/win32/static/postgresql*.exe

# js tooling
node_modules
jsconfig.json
tsconfig.json
package-lock.json
package.json
.husky
odoo.log
odoo.conf

# various virtualenv folders
/bin/
/build/
/dist/
/include/
/lib/
/man/
/share/
/src/

# استثناءات ضرورية لمجلد bootstrap داخل addons
!addons/web/static/lib/bootstrap/
!addons/web/static/lib/bootstrap/**

# استثناءات عامة للمجلدات التي قد تحتاج ترفعها في addons/web/static
!addons/web/static/
!addons/web/static/**


# PostgreSQL Configuration
POSTGRES_DB=odoo_new
POSTGRES_USER=odoo_user
POSTGRES_PASSWORD=root
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Odoo Configuration
ODOO_ADMIN_PASSWORD=admin
ODOO_DB_FILTER=^odoo_new$

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# OpenSearch Configuration
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200

# Frontend Configuration
VITE_API_URL=http://localhost:8069
VITE_WS_URL=ws://localhost:8069
VITE_APP_NAME=NBS Archive System
VITE_DEFAULT_LANGUAGE=ar

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET_KEY=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OCR Configuration
TESSERACT_LANGUAGES=ara+eng
TESSERACT_DPI=300

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=100
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx,xls,xlsx












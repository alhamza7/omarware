# ============================================
# تكوين SAP Business One Service Layer
# ============================================

# تفعيل/تعطيل التكامل مع SAP
# true = مفعل | false = معطل
SAP_ENABLED=false

# عنوان SAP Service Layer
# مثال: https://192.168.1.100:50000/b1s/v1
SAP_SERVICE_LAYER_URL=https://your-sap-server:50000/b1s/v1

# اسم قاعدة بيانات الشركة في SAP
SAP_COMPANY_DB=SBODEMOUS

# بيانات الدخول
SAP_USERNAME=manager
SAP_PASSWORD=your_password_here

# ============================================
# مطابقة المخازن (اختياري)
# ============================================
# إذا كانت أكواد المخازن في SAP مختلفة عن WH01, WH02, إلخ
# يمكنك تخصيصها هنا

SAP_WH_01=WH01
SAP_WH_02=WH02
SAP_WH_03=WH03
SAP_WH_04=WH04
SAP_WH_05=WH05
SAP_WH_06=WH06
SAP_WH_07=WH07
SAP_WH_08=WH08
SAP_WH_09=WH09
SAP_WH_10=WH10
SAP_WH_11=WH11
SAP_WH_12=WH12
SAP_WH_13=WH13
SAP_WH_14=WH14
SAP_WH_15=WH15
SAP_WH_16=WH16
SAP_WH_17=WH17
SAP_WH_18=WH18







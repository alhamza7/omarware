<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>تفاصيل الصنف</title>
    <link rel="stylesheet" href="/static/styles.css" />
  </head>
  <body class="page">
    <header class="topbar">
      <div class="topbar__left">
        <strong>تفاصيل الصنف</strong>
      </div>
      <div class="topbar__right">
        <a class="btn" href="/reports">التقارير</a>
        <a class="btn" href="/inventory">الجرد</a>
        <a class="btn" href="/warehouse">مخزن: <%= warehouseId %></a>
        <span class="muted">مرحباً، <%= username %></span>
        <form method="post" action="/logout">
          <button class="btn" type="submit">خروج</button>
        </form>
      </div>
    </header>

    <main class="container">
      <section class="card">
        <h1><%= item.item_code %></h1>
        <p class="muted"><%= item.item_name %></p>

        <div class="divider"></div>
        <h3>الباركودات</h3>
        <div id="barcodes" class="muted">جاري التحميل...</div>

        <div class="divider"></div>
        <h3>سجل الجرد</h3>
        <div class="muted" id="modified"></div>
        <div id="counts" class="muted">جاري التحميل...</div>
      </section>
    </main>

    <script>
      const ITEM_ID = <%- JSON.stringify(item.id) %>;
    </script>
    <script src="/static/item.js"></script>
  </body>
</html>



<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>لوحة تحكم الإدارة</title>
  <link rel="stylesheet" href="/static/styles.css">
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #f5f5f5;
      margin: 0;
      padding: 20px;
      min-height: 100vh;
    }

    .admin-container {
      max-width: 1400px;
      margin: 0 auto;
      background: white;
      border: 3px solid #000;
      box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    .admin-header {
      background: #000;
      color: white;
      padding: 25px 30px;
      border-bottom: 3px solid #000;
    }

    .admin-header h1 {
      margin: 0 0 8px 0;
      font-size: 2em;
      font-weight: 700;
    }

    .admin-header p {
      margin: 0;
      font-size: 1.05em;
      font-weight: 600;
    }

    .admin-content {
      padding: 30px;
    }

    .section {
      background: #fff;
      border: 3px solid #000;
      padding: 25px;
      margin-bottom: 25px;
    }

    .section h2 {
      margin-top: 0;
      color: #000;
      border-bottom: 3px solid #000;
      padding-bottom: 12px;
      margin-bottom: 20px;
      font-size: 1.5em;
      font-weight: 700;
    }

    .upload-area {
      border: 3px dashed #000;
      padding: 40px;
      text-align: center;
      background: #fafafa;
      transition: all 0.2s;
      cursor: pointer;
    }

    .upload-area:hover {
      background: #f0f0f0;
      border-color: #333;
    }

    .upload-area.dragover {
      background: #e8e8e8;
      border-color: #000;
      border-style: solid;
    }

    .file-input {
      display: none;
    }

    .upload-icon {
      font-size: 48px;
      margin-bottom: 15px;
      color: #000;
    }

    .upload-area h3 {
      color: #000;
      margin: 10px 0;
      font-weight: 600;
    }

    .upload-area p {
      color: #666;
      margin: 5px 0;
    }

    .btn {
      padding: 14px 24px;
      border: 3px solid #000;
      background: #fff;
      color: #000;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
      margin: 5px;
      text-decoration: none;
      display: inline-block;
    }

    .btn:hover {
      background: #000;
      color: #fff;
      transform: translateY(-1px);
    }

    .btn-primary {
      background: #000;
      color: #fff;
    }

    .btn-primary:hover {
      background: #333;
      border-color: #333;
    }

    .btn-success {
      background: #000;
      color: #fff;
      border-color: #000;
    }

    .btn-success:hover {
      background: #333;
      border-color: #333;
    }

    .btn-danger {
      background: #fff;
      color: #000;
      border-color: #000;
    }

    .btn-danger:hover {
      background: #000;
      color: #fff;
    }

    .btn-warning {
      background: #fff;
      color: #000;
      border: 3px solid #666;
    }

    .btn-warning:hover {
      background: #666;
      color: #fff;
      border-color: #666;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      margin-bottom: 20px;
    }

    .stat-card {
      background: #fff;
      border: 3px solid #000;
      padding: 25px;
      text-align: center;
    }

    .stat-card h3 {
      margin: 0 0 10px 0;
      font-size: 3em;
      color: #000;
      font-weight: 800;
    }

    .stat-card p {
      margin: 0;
      color: #000;
      font-size: 1.1em;
      font-weight: 600;
    }

    .data-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
      background: white;
      border: 2px solid #000;
    }

    .data-table th {
      background: #000;
      color: white;
      padding: 15px;
      text-align: right;
      font-weight: 700;
      border: 2px solid #000;
      font-size: 15px;
    }

    .data-table td {
      padding: 12px 15px;
      border: 2px solid #000;
      color: #000;
      font-weight: 500;
      font-size: 14px;
      background: #fff;
    }

    .data-table tbody tr:nth-child(even) td {
      background: #f5f5f5;
    }

    .data-table tbody tr:hover td {
      background: #e8e8e8;
    }

    .loading {
      text-align: center;
      padding: 40px;
      font-size: 20px;
      color: #000;
      font-weight: 700;
    }

    .loading::after {
      content: '⏳';
      display: inline-block;
      margin-right: 10px;
    }

    .alert {
      padding: 18px 24px;
      border: 3px solid #000;
      margin-bottom: 20px;
      font-weight: 700;
      font-size: 15px;
    }

    .alert-success {
      background: #f5f5f5;
      color: #000;
      border-color: #000;
    }

    .alert-error {
      background: #fff;
      color: #000;
      border-color: #000;
    }

    .alert-info {
      background: #fafafa;
      color: #000;
      border-color: #000;
    }

    .file-list {
      list-style: none;
      padding: 0;
    }

    .file-list li {
      background: white;
      padding: 18px;
      margin-bottom: 12px;
      border: 3px solid #000;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .file-info {
      flex: 1;
    }

    .file-name {
      font-weight: 700;
      color: #000;
      font-size: 15px;
    }

    .file-meta {
      font-size: 14px;
      color: #000;
      margin-top: 5px;
      font-weight: 500;
    }

    .nav-links {
      text-align: center;
      padding: 20px;
      background: #fafafa;
      border-top: 2px solid #000;
    }

    .sap-status {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 18px;
      background: white;
      border: 3px solid #000;
      margin-bottom: 20px;
      font-weight: 700;
      font-size: 16px;
    }

    .sap-status.connected {
      background: #f5f5f5;
      color: #000;
    }

    .sap-status.disconnected {
      background: #fff;
      color: #000;
    }

    .status-dot {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      animation: pulse 2s infinite;
    }

    .status-dot.connected {
      background: #000;
      border: 2px solid #000;
    }

    .status-dot.disconnected {
      background: #666;
      border: 2px solid #666;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    .button-group {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 15px;
      margin-top: 15px;
    }

    .button-group .btn {
      margin: 0;
      width: 100%;
    }

    /* Modal Styles */
    .modal {
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0,0,0,0.7);
    }

    .modal.active {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal-content {
      background: #fff;
      border: 3px solid #000;
      max-width: 600px;
      width: 90%;
      max-height: 90vh;
      overflow-y: auto;
    }

    .modal-header {
      background: #000;
      color: #fff;
      padding: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .modal-header h3 {
      margin: 0;
      font-size: 1.3em;
    }

    .modal-close {
      background: none;
      border: none;
      color: #fff;
      font-size: 30px;
      cursor: pointer;
      line-height: 1;
    }

    .modal-body {
      padding: 25px;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      font-weight: 700;
      margin-bottom: 8px;
      color: #000;
    }

    .form-group input,
    .form-group select {
      width: 100%;
      padding: 12px;
      border: 2px solid #000;
      font-size: 15px;
      font-family: inherit;
    }

    .form-group input:focus,
    .form-group select:focus {
      outline: none;
      border-color: #333;
    }

    .form-actions {
      display: flex;
      gap: 10px;
      margin-top: 25px;
    }

    .form-actions .btn {
      flex: 1;
    }

    .action-buttons {
      display: flex;
      gap: 5px;
    }

    .btn-sm {
      padding: 8px 12px;
      font-size: 13px;
    }
  </style>
</head>
<body>
  <div class="admin-container">
    <div class="admin-header">
      <h1>🎛️ لوحة تحكم الإدارة</h1>
      <p>المستخدم: <%= username %> | المخزن: <%= warehouseId %></p>
    </div>

    <div class="admin-content">
      <!-- SAP Status -->
      <div id="sapStatus" class="sap-status disconnected">
        <div class="status-dot disconnected"></div>
        <span>جاري التحقق من اتصال SAP...</span>
      </div>

      <!-- Statistics Section -->
      <div class="section">
        <h2>📊 إحصائيات النظام</h2>
        <div class="stats-grid" id="statsGrid">
          <div class="loading">جاري تحميل الإحصائيات...</div>
        </div>
      </div>

      <!-- Excel Import Section -->
      <div class="section">
        <h2>📥 استيراد ملفات Excel</h2>
        <div class="upload-area" id="uploadArea">
          <div class="upload-icon">📁</div>
          <h3>اسحب الملفات هنا أو انقر للاختيار</h3>
          <p>يدعم ملفات Excel (.xlsx, .xls)</p>
          <input type="file" id="fileInput" class="file-input" accept=".xlsx,.xls" multiple>
        </div>
        <div id="uploadStatus"></div>
        <ul id="fileList" class="file-list"></ul>
      </div>

      <!-- Data Management Section -->
      <div class="section">
        <h2>🗄️ إدارة البيانات</h2>
        <div class="button-group">
          <button class="btn btn-primary" onclick="viewItems()">📦 عرض الأصناف</button>
          <button class="btn btn-primary" onclick="viewUsers()">👥 عرض المستخدمين</button>
          <button class="btn btn-primary" onclick="viewBarcodes()">🔖 عرض الباركودات</button>
          <button class="btn btn-primary" onclick="viewCounts()">📊 عرض الجردات</button>
          <button class="btn btn-warning" onclick="testSAPConnection()">🔌 اختبار SAP</button>
          <button class="btn btn-danger" onclick="resetWarehouseCounts()">🗑️ حذف جردات المخزن</button>
          <button class="btn btn-danger" onclick="resetAllCounts()">⚠️ حذف كل الجردات</button>
        </div>
      </div>

      <!-- Data View Section -->
      <div class="section">
        <h2 id="dataViewTitle">📋 عرض البيانات</h2>
        <div id="dataView"></div>
      </div>
    </div>

    <div class="nav-links">
      <a href="/inventory" class="btn btn-primary">📊 الجرد</a>
      <a href="/reports" class="btn btn-primary">📈 التقارير</a>
      <a href="/warehouse" class="btn btn-warning">🏭 تغيير المخزن</a>
      <form action="/logout" method="POST" style="display: inline;">
        <button type="submit" class="btn btn-danger">🚪 تسجيل خروج</button>
      </form>
    </div>
  </div>

  <!-- Modals -->
  
  <!-- User Modal -->
  <div id="userModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="userModalTitle">إضافة مستخدم</h3>
        <button class="modal-close" onclick="closeUserModal()">&times;</button>
      </div>
      <div class="modal-body">
        <form id="userForm" onsubmit="saveUser(event)">
          <input type="hidden" id="userId">
          
          <div class="form-group">
            <label>الاسم الكامل</label>
            <input type="text" id="userFullName" placeholder="أحمد محمد">
          </div>
          
          <div class="form-group">
            <label>اسم المستخدم *</label>
            <input type="text" id="userUsername" required placeholder="ahmad">
          </div>
          
          <div class="form-group">
            <label>كلمة المرور <span id="passwordOptional"></span></label>
            <input type="password" id="userPassword" placeholder="••••••••">
          </div>
          
          <div class="form-group">
            <label>الدور *</label>
            <select id="userRole" required>
              <option value="user">مستخدم عادي</option>
              <option value="admin">مدير</option>
            </select>
          </div>
          
          <div class="form-group">
            <label>المخزن الافتراضي *</label>
            <select id="userWarehouse" required>
              <option value="1">المخزن 1</option>
              <option value="2">المخزن 2</option>
              <option value="3">المخزن 3</option>
              <option value="4">المخزن 4</option>
              <option value="5">المخزن 5</option>
              <option value="6">المخزن 6</option>
              <option value="7">المخزن 7</option>
              <option value="8">المخزن 8</option>
              <option value="9">المخزن 9</option>
              <option value="10">المخزن 10</option>
              <option value="11">المخزن 11</option>
              <option value="12">المخزن 12</option>
              <option value="13">المخزن 13</option>
              <option value="14">المخزن 14</option>
              <option value="15">المخزن 15</option>
              <option value="16">المخزن 16</option>
              <option value="17">المخزن 17</option>
              <option value="18">المخزن 18</option>
            </select>
          </div>
          
          <div class="form-actions">
            <button type="submit" class="btn btn-primary">💾 حفظ</button>
            <button type="button" class="btn btn-danger" onclick="closeUserModal()">❌ إلغاء</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Item Modal -->
  <div id="itemModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="itemModalTitle">إضافة صنف</h3>
        <button class="modal-close" onclick="closeItemModal()">&times;</button>
      </div>
      <div class="modal-body">
        <form id="itemForm" onsubmit="saveItem(event)">
          <input type="hidden" id="itemId">
          
          <div class="form-group">
            <label>كود الصنف *</label>
            <input type="text" id="itemCode" required placeholder="ITEM001">
          </div>
          
          <div class="form-group">
            <label>اسم الصنف *</label>
            <input type="text" id="itemName" required placeholder="صنف مثال">
          </div>
          
          <div class="form-actions">
            <button type="submit" class="btn btn-primary">💾 حفظ</button>
            <button type="button" class="btn btn-danger" onclick="closeItemModal()">❌ إلغاء</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Barcode Modal -->
  <div id="barcodeModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="barcodeModalTitle">إضافة باركود</h3>
        <button class="modal-close" onclick="closeBarcodeModal()">&times;</button>
      </div>
      <div class="modal-body">
        <form id="barcodeForm" onsubmit="saveBarcode(event)">
          <input type="hidden" id="barcodeId">
          
          <div class="form-group">
            <label>الصنف *</label>
            <select id="barcodeItemId" required>
              <option value="">اختر صنف...</option>
            </select>
          </div>
          
          <div class="form-group">
            <label>الباركود *</label>
            <input type="text" id="barcodeValue" required placeholder="1234567890123">
          </div>
          
          <div class="form-group">
            <label>وحدة القياس</label>
            <input type="text" id="barcodeUom" placeholder="PCS, BOX, KG...">
          </div>
          
          <div class="form-actions">
            <button type="submit" class="btn btn-primary">💾 حفظ</button>
            <button type="button" class="btn btn-danger" onclick="closeBarcodeModal()">❌ إلغاء</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Count Modal -->
  <div id="countModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3>تعديل جردة</h3>
        <button class="modal-close" onclick="closeCountModal()">&times;</button>
      </div>
      <div class="modal-body">
        <form id="countForm" onsubmit="saveCount(event)">
          <input type="hidden" id="countId">
          
          <div class="form-group">
            <label>الكمية *</label>
            <input type="number" step="0.01" id="countQty" required>
          </div>
          
          <div class="form-group">
            <label>ملاحظة</label>
            <input type="text" id="countNote" placeholder="ملاحظة اختيارية">
          </div>
          
          <div class="form-actions">
            <button type="submit" class="btn btn-primary">💾 حفظ</button>
            <button type="button" class="btn btn-danger" onclick="closeCountModal()">❌ إلغاء</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    const warehouseId = <%= warehouseId %>;

    // Load statistics
    async function loadStats() {
      try {
        const response = await fetch('/api/admin/stats');
        const data = await response.json();
        
        const statsGrid = document.getElementById('statsGrid');
        statsGrid.innerHTML = `
          <div class="stat-card">
            <h3>${data.totalItems || 0}</h3>
            <p>إجمالي الأصناف</p>
          </div>
          <div class="stat-card">
            <h3>${data.totalBarcodes || 0}</h3>
            <p>إجمالي الباركودات</p>
          </div>
          <div class="stat-card">
            <h3>${data.totalUsers || 0}</h3>
            <p>إجمالي المستخدمين</p>
          </div>
          <div class="stat-card">
            <h3>${data.totalCounts || 0}</h3>
            <p>إجمالي الجردات</p>
          </div>
        `;
      } catch (error) {
        console.error('Error loading stats:', error);
      }
    }

    // Check SAP status
    async function checkSAPStatus() {
      try {
        const response = await fetch('/api/sap/status');
        const data = await response.json();
        
        const statusDiv = document.getElementById('sapStatus');
        if (data.enabled && data.connected) {
          statusDiv.className = 'sap-status connected';
          statusDiv.innerHTML = `
            <div class="status-dot connected"></div>
            <span>✅ SAP متصل: ${data.serviceLayerUrl}</span>
          `;
        } else if (data.enabled) {
          statusDiv.className = 'sap-status disconnected';
          statusDiv.innerHTML = `
            <div class="status-dot disconnected"></div>
            <span>⚠️ SAP مفعل ولكن غير متصل</span>
          `;
        } else {
          statusDiv.className = 'sap-status disconnected';
          statusDiv.innerHTML = `
            <div class="status-dot disconnected"></div>
            <span>❌ SAP غير مفعل</span>
          `;
        }
      } catch (error) {
        console.error('Error checking SAP status:', error);
      }
    }

    // Test SAP connection
    async function testSAPConnection() {
      const dataView = document.getElementById('dataView');
      dataView.innerHTML = '<div class="loading">جاري اختبار الاتصال...</div>';
      
      try {
        const response = await fetch('/api/admin/test-sap');
        const data = await response.json();
        
        if (data.success) {
          dataView.innerHTML = `<div class="alert alert-success">✅ ${data.message}</div>`;
        } else {
          dataView.innerHTML = `<div class="alert alert-error">❌ ${data.error}</div>`;
        }
        
        checkSAPStatus();
      } catch (error) {
        dataView.innerHTML = `<div class="alert alert-error">❌ فشل الاختبار: ${error.message}</div>`;
      }
    }

    // File upload handling
    const uploadArea = document.getElementById('uploadArea');
    const fileInput = document.getElementById('fileInput');
    const uploadStatus = document.getElementById('uploadStatus');
    const fileList = document.getElementById('fileList');

    uploadArea.addEventListener('click', () => fileInput.click());

    uploadArea.addEventListener('dragover', (e) => {
      e.preventDefault();
      uploadArea.classList.add('dragover');
    });

    uploadArea.addEventListener('dragleave', () => {
      uploadArea.classList.remove('dragover');
    });

    uploadArea.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadArea.classList.remove('dragover');
      handleFiles(e.dataTransfer.files);
    });

    fileInput.addEventListener('change', (e) => {
      handleFiles(e.target.files);
    });

    async function handleFiles(files) {
      uploadStatus.innerHTML = '';
      
      for (const file of files) {
        await uploadFile(file);
      }
    }

    async function uploadFile(file) {
      const formData = new FormData();
      formData.append('file', file);

      uploadStatus.innerHTML = `<div class="loading">جاري رفع ${file.name}...</div>`;

      try {
        const response = await fetch('/api/admin/import-excel', {
          method: 'POST',
          body: formData
        });

        const data = await response.json();

        if (response.ok) {
          uploadStatus.innerHTML = `<div class="alert alert-success">✅ تم رفع ${file.name} بنجاح: ${data.imported} صنف</div>`;
          loadStats();
        } else {
          uploadStatus.innerHTML = `<div class="alert alert-error">❌ فشل رفع ${file.name}: ${data.error}</div>`;
        }
      } catch (error) {
        uploadStatus.innerHTML = `<div class="alert alert-error">❌ خطأ: ${error.message}</div>`;
      }
    }

    // View functions
    async function viewItems() {
      const dataView = document.getElementById('dataView');
      const title = document.getElementById('dataViewTitle');
      title.textContent = '📦 الأصناف';
      dataView.innerHTML = '<div class="loading">جاري تحميل الأصناف...</div>';

      try {
        const response = await fetch('/api/admin/items');
        const data = await response.json();

        let html = `
          <button class="btn btn-success" onclick="openItemModal()" style="margin-bottom: 15px;">➕ إضافة صنف</button>
          <table class="data-table">
          <thead>
            <tr>
              <th>رقم</th>
              <th>كود الصنف</th>
              <th>اسم الصنف</th>

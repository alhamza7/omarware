    async function resetWarehouseCounts() {
      if (!confirm('هل أنت متأكد من حذف جميع جردات المخزن الحالي؟')) return;

      try {
        const response = await fetch('/api/counts/reset', {
          method: 'DELETE'
        });

        const data = await response.json();
        alert(`✅ تم حذف ${data.deleted} جردة من المخزن ${warehouseId}`);
        loadStats();
      } catch (error) {
        alert(`❌ فشل الحذف: ${error.message}`);
      }
    }

    async function resetAllCounts() {
      if (!confirm('⚠️ هل أنت متأكد من حذف جميع الجردات من جميع المخازن؟ هذا الإجراء لا يمكن التراجع عنه!')) return;

      try {
        const response = await fetch('/api/counts/reset-all', {
          method: 'DELETE'
        });

        const data = await response.json();
        alert(`✅ تم حذف ${data.deleted} جردة من جميع المخازن`);
        loadStats();
      } catch (error) {
        alert(`❌ فشل الحذف: ${error.message}`);
      }
    }

    // Initialize
    loadStats();
    checkSAPStatus();

    // User Management Functions
    function openUserModal(user = null) {
      const modal = document.getElementById('userModal');
      const title = document.getElementById('userModalTitle');
      const form = document.getElementById('userForm');
      const passwordField = document.getElementById('userPassword');
      const passwordOptional = document.getElementById('passwordOptional');
      
      form.reset();
      
      if (user) {
        title.textContent = 'تعديل مستخدم';
        document.getElementById('userId').value = user.id;
        document.getElementById('userFullName').value = user.full_name || '';
        document.getElementById('userUsername').value = user.username;
        document.getElementById('userRole').value = user.role;
        document.getElementById('userWarehouse').value = user.warehouse_id;
        passwordField.removeAttribute('required');
        passwordOptional.textContent = '(اختياري - اتركه فارغاً لعدم التغيير)';
      } else {
        title.textContent = 'إضافة مستخدم';
        document.getElementById('userId').value = '';
        passwordField.setAttribute('required', 'required');
        passwordOptional.textContent = '';
      }
      
      modal.classList.add('active');
    }

    function closeUserModal() {
      document.getElementById('userModal').classList.remove('active');
    }

    async function saveUser(event) {
      event.preventDefault();
      
      const userId = document.getElementById('userId').value;
      const data = {
        full_name: document.getElementById('userFullName').value,
        username: document.getElementById('userUsername').value,
        password: document.getElementById('userPassword').value,
        role: document.getElementById('userRole').value,
        warehouse_id: parseInt(document.getElementById('userWarehouse').value)
      };
      
      try {
        let response;
        if (userId) {
          response = await fetch(`/api/admin/users/${userId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
        } else {
          response = await fetch('/api/admin/users', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
        }
        
        const result = await response.json();
        
        if (response.ok) {
          alert(userId ? '✅ تم تحديث المستخدم بنجاح' : '✅ تم إضافة المستخدم بنجاح');
          closeUserModal();
          viewUsers();
          loadStats();
        } else {
          if (result.error === 'username_exists') {
            alert('❌ اسم المستخدم موجود مسبقاً');
          } else {
            alert('❌ فشل حفظ المستخدم: ' + result.error);
          }
        }
      } catch (error) {
        alert('❌ خطأ: ' + error.message);
      }
    }

    function editUser(user) {
      openUserModal(user);
    }

    async function deleteUser(id, username) {
      if (!confirm(`⚠️ هل أنت متأكد من حذف المستخدم: ${username}؟`)) return;
      
      try {
        const response = await fetch(`/api/admin/users/${id}`, { method: 'DELETE' });
        const result = await response.json();
        
        if (response.ok) {
          alert('✅ تم حذف المستخدم');
          viewUsers();
          loadStats();
        } else {
          if (result.error === 'cannot_delete_yourself') {
            alert('❌ لا يمكنك حذف حسابك الخاص');
          } else {
            alert('❌ فشل الحذف: ' + result.error);
          }
        }
      } catch (error) {
        alert('❌ خطأ: ' + error.message);
      }
    }

    // Item Management Functions
    function openItemModal(item = null) {
      const modal = document.getElementById('itemModal');
      const title = document.getElementById('itemModalTitle');
      const form = document.getElementById('itemForm');
      
      form.reset();
      
      if (item) {
        title.textContent = 'تعديل صنف';
        document.getElementById('itemId').value = item.id;
        document.getElementById('itemCode').value = item.item_code;
        document.getElementById('itemName').value = item.item_name;
      } else {
        title.textContent = 'إضافة صنف';
        document.getElementById('itemId').value = '';
      }
      
      modal.classList.add('active');
    }

    function closeItemModal() {
      document.getElementById('itemModal').classList.remove('active');
    }

    async function saveItem(event) {
      event.preventDefault();
      
      const itemId = document.getElementById('itemId').value;
      const data = {
        item_code: document.getElementById('itemCode').value,
        item_name: document.getElementById('itemName').value
      };
      
      try {
        let response;
        if (itemId) {
          response = await fetch(`/api/admin/items/${itemId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
        } else {
          response = await fetch('/api/admin/items', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
        }
        
        const result = await response.json();
        
        if (response.ok) {
          alert(itemId ? '✅ تم تحديث الصنف بنجاح' : '✅ تم إضافة الصنف بنجاح');
          closeItemModal();
          viewItems();
          loadStats();
        } else {
          if (result.error === 'item_code_exists') {
            alert('❌ كود الصنف موجود مسبقاً');
          } else {
            alert('❌ فشل حفظ الصنف: ' + result.error);
          }
        }
      } catch (error) {
        alert('❌ خطأ: ' + error.message);
      }
    }

    function editItem(item) {
      openItemModal(item);
    }

    async function deleteItem(id, itemCode) {
      if (!confirm(`⚠️ هل أنت متأكد من حذف الصنف: ${itemCode}؟\n\nسيتم حذف جميع الباركودات والجردات المرتبطة به.`)) return;
      
      try {
        const response = await fetch(`/api/admin/items/${id}`, { method: 'DELETE' });
        
        if (response.ok) {
          alert('✅ تم حذف الصنف وجميع بياناته');
          viewItems();
          loadStats();
        } else {
          alert('❌ فشل الحذف');
        }
      } catch (error) {
        alert('❌ خطأ: ' + error.message);
      }
    }

    // Barcode Management Functions
    async function openBarcodeModal(barcode = null) {
      const modal = document.getElementById('barcodeModal');
      const title = document.getElementById('barcodeModalTitle');
      const form = document.getElementById('barcodeForm');
      
      // Load items for dropdown
      try {
        const response = await fetch('/api/admin/items');
        const data = await response.json();
        
        const select = document.getElementById('barcodeItemId');
        select.innerHTML = '<option value="">اختر صنف...</option>';
        data.items.forEach(item => {
          select.innerHTML += `<option value="${item.id}">${item.item_code} - ${item.item_name}</option>`;
        });
      } catch (error) {
        console.error('Error loading items:', error);
      }
      
      form.reset();
      
      if (barcode) {
        title.textContent = 'تعديل باركود';
        document.getElementById('barcodeId').value = barcode.id;
        document.getElementById('barcodeItemId').value = barcode.item_id;
        document.getElementById('barcodeValue').value = barcode.barcode;
        document.getElementById('barcodeUom').value = barcode.uom || '';
      } else {
        title.textContent = 'إضافة باركود';
        document.getElementById('barcodeId').value = '';
      }
      
      modal.classList.add('active');
    }

    function closeBarcodeModal() {
      document.getElementById('barcodeModal').classList.remove('active');
    }

    async function saveBarcode(event) {
      event.preventDefault();
      
      const barcodeId = document.getElementById('barcodeId').value;
      const data = {
        item_id: parseInt(document.getElementById('barcodeItemId').value),
        barcode: document.getElementById('barcodeValue').value,
        uom: document.getElementById('barcodeUom').value
      };
      
      try {
        let response;
        if (barcodeId) {
          response = await fetch(`/api/admin/barcodes/${barcodeId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
        } else {
          response = await fetch('/api/admin/barcodes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
        }
        
        const result = await response.json();
        
        if (response.ok) {
          alert(barcodeId ? '✅ تم تحديث الباركود بنجاح' : '✅ تم إضافة الباركود بنجاح');
          closeBarcodeModal();
          viewBarcodes();
          loadStats();
        } else {
          if (result.error === 'barcode_exists') {
            alert('❌ الباركود موجود مسبقاً');
          } else {
            alert('❌ فشل حفظ الباركود: ' + result.error);
          }
        }
      } catch (error) {
        alert('❌ خطأ: ' + error.message);
      }
    }

    function editBarcode(barcode) {
      openBarcodeModal(barcode);
    }

    async function deleteBarcode(id, barcodeValue) {
      if (!confirm(`⚠️ هل أنت متأكد من حذف الباركود: ${barcodeValue}؟`)) return;
      
      try {
        const response = await fetch(`/api/admin/barcodes/${id}`, { method: 'DELETE' });
        
        if (response.ok) {
          alert('✅ تم حذف الباركود');
          viewBarcodes();
          loadStats();
        } else {
          alert('❌ فشل الحذف');
        }
      } catch (error) {
        alert('❌ خطأ: ' + error.message);
      }
    }

    // Count Management Functions
    async function viewCounts() {
      const dataView = document.getElementById('dataView');
      const title = document.getElementById('dataViewTitle');
      title.textContent = '📊 الجردات';
      dataView.innerHTML = '<div class="loading">جاري تحميل الجردات...</div>';

      try {
        const response = await fetch('/api/admin/counts');
        const data = await response.json();

        let html = `<table class="data-table">
          <thead>
            <tr>
              <th>رقم</th>
              <th>كود الصنف</th>
              <th>اسم الصنف</th>
              <th>المخزن</th>
              <th>الكمية</th>
              <th>المستخدم</th>
              <th>التاريخ</th>
              <th>إجراءات</th>
            </tr>
          </thead>
          <tbody>`;

        data.counts.forEach(count => {
          const userName = count.full_name || count.username;
          html += `<tr>
            <td>${count.id}</td>
            <td>${count.item_code}</td>
            <td>${count.item_name}</td>
            <td>${count.warehouse_id}</td>
            <td>${count.qty}</td>
            <td>${userName}</td>
            <td>${new Date(count.created_at).toLocaleString('ar-EG')}</td>
            <td>
              <div class="action-buttons">
                <button class="btn btn-sm btn-primary" onclick='editCount(${JSON.stringify(count)})'>✏️</button>
                <button class="btn btn-sm btn-danger" onclick="deleteCount(${count.id})">🗑️</button>
              </div>
            </td>
          </tr>`;
        });

        html += '</tbody></table>';
        dataView.innerHTML = html;
      } catch (error) {
        dataView.innerHTML = `<div class="alert alert-error">❌ فشل تحميل الجردات: ${error.message}</div>`;
      }
    }

    function editCount(count) {
      const modal = document.getElementById('countModal');
      const form = document.getElementById('countForm');
      
      document.getElementById('countId').value = count.id;
      document.getElementById('countQty').value = count.qty;
      document.getElementById('countNote').value = count.note || '';
      
      modal.classList.add('active');
    }

    function closeCountModal() {
      document.getElementById('countModal').classList.remove('active');
    }

    async function saveCount(event) {
      event.preventDefault();
      
      const countId = document.getElementById('countId').value;
      const data = {
        qty: parseFloat(document.getElementById('countQty').value),
        note: document.getElementById('countNote').value
      };
      
      try {
        const response = await fetch(`/api/admin/counts/${countId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        
        if (response.ok) {
          alert('✅ تم تحديث الجردة بنجاح');
          closeCountModal();
          viewCounts();
        } else {
          alert('❌ فشل التحديث');
        }
      } catch (error) {
        alert('❌ خطأ: ' + error.message);
      }
    }

    async function deleteCount(id) {
      if (!confirm(`⚠️ هل أنت متأكد من حذف هذه الجردة؟`)) return;
      
      try {
        const response = await fetch(`/api/admin/counts/${id}`, { method: 'DELETE' });
        
        if (response.ok) {
          alert('✅ تم حذف الجردة');
          viewCounts();
          loadStats();
        } else {
          alert('❌ فشل الحذف');
        }
      } catch (error) {
        alert('❌ خطأ: ' + error.message);
      }
    }
  </script>

          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('success true', () => pm.expect(j.success).to.be.true);"
            ]}
          }]
        },
        {
          "name": "GET /setup",
          "request": {
            "method": "GET",
            "header": [],

  },
  "variable": [
    { "key": "base_url",     "value": "http://localhost:8070/api/pos_perfume/v1", "type": "string" },
    { "key": "api_key",      "value": "YOUR_API_KEY_HERE",                         "type": "string" },
    { "key": "customer_id",  "value": "",                                           "type": "string" },
    { "key": "order_id",     "value": "",                                           "type": "string" },
    { "key": "line_id",      "value": "",                                           "type": "string" },
    { "key": "product_id",   "value": "1",                                          "type": "string" },
    { "key": "warehouse_id", "value": "1",                                          "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{api_key}}", "type": "string" }]
  },
